// Test file to demonstrate constants in Burn

fun testMath(): int {
    const PI = 3.14159
    const RADIUS = 5.0
    
    // Calculate area of circle
    return PI * RADIUS * RADIUS
}

fun testStrings(): string {
    const GREETING = "Hello"
    const NAME = "Burn"
    
    // Concatenate constants
    return GREETING + ", " + NAME + "!"
}

fun main() {
    // Numeric constants
    const MAX_VALUE = 100
    const MIN_VALUE = 0
    const FACTOR = 2.5
    
    println("MAX_VALUE: " + toString(MAX_VALUE))
    println("MIN_VALUE: " + toString(MIN_VALUE))
    println("FACTOR: " + toString(FACTOR))
    
    // Cannot reassign constants
    // MAX_VALUE = 200  // This would cause an error
    
    // Using constants in expressions
    var result = MAX_VALUE * FACTOR
    println("MAX_VALUE * FACTOR = " + toString(result))
    
    // Using constants from functions
    println("Circle area: " + toString(testMath()))
    println("Greeting: " + testStrings())
    
    // Boolean constants
    const IS_DEBUG = true
    const IS_PRODUCTION = false
    
    if (IS_DEBUG) {
        println("Debug mode is enabled")
    }
    
    if (!IS_PRODUCTION) {
        println("Not in production mode")
    }
}