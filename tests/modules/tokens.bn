pub def enum Token {
    Word(text: string),
    Number(value: int),
    Symbol(char: string),
    End
}

pub fun tokenize(src: string): [Token] {
    var out: [Token] = []
    var i = 0
    while (i < len(src)) {
        var c = src[i]
        if (c == " ") {
            i += 1
        } else if (isInt(c)) {
            var start = i
            while (i < len(src) && isInt(src[i])) {
                i += 1
            }
            out.push(Token.Number(toInt(substring(src, start, i))))
        } else if (c >= "a" && c <= "z") {
            var start = i
            while (i < len(src) && src[i] >= "a" && src[i] <= "z") {
                i += 1
            }
            out.push(Token.Word(substring(src, start, i)))
        } else {
            out.push(Token.Symbol(c))
            i += 1
        }
    }
    out.push(Token.End)
    return out
}
