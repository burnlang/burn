print(x & 3 == 0, 1 + 2 << 1, 6 & 3 | 8)

fun popcount(n: int): int {
    var count = 0
    var v = n
    while v != 0 {
        count += v & 1
        v = v >>> 1
    }
    return count
}

fun hash(text: string): int {
    var h = 5381
    for c in text.chars() {
        h = ((h << 5) + h) ^ charCode(c)
        h = h & 0xFFFFFFFF
    }
    return h
}

print(popcount(255), popcount(1023), popcount(0))
print(hash("burn"), hash("Burn"))
Map<string, Map<string, int>> nested = {"a": {"b": 1}}
print(nested["a"]!!["b"])
var big = 64
print(1 << big)
