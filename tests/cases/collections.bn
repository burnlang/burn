var numbers = [5, 3, 8, 1]
push(numbers, 7)
numbers.push(2)
print(numbers, len(numbers), numbers.length)
sort(numbers)
print(numbers, numbers[0], numbers[numbers.length - 1])
reverse(numbers)
print(numbers, contains(numbers, 8), indexOf(numbers, 3), numbers.contains(100))
print(pop(numbers), numbers)
insert(numbers, 0, 99)
print(remove(numbers, 1), numbers)
print(slice(numbers, 1, 3), join(numbers, "-"), [1, 2] + [3])
var words = split("a,b,c", ",")
print(words, join(words, "+"))

[[int]] grid = [[1, 2], [3, 4]]
grid[1][0] = 30
print(grid, grid[1][0])

var ages = {"alice": 30, "bob": 25}
ages["carol"] = 41
print(ages, ages["bob"], len(ages), has(ages, "alice"), has(ages, "zed"))
print(keys(ages), values(ages), ages.keys)
remove(ages, "bob")
print(ages, get(ages, "nobody", -1))
for name, age in ages {
    print(name, "is", age)
}
for i, w in ["x", "y"] {
    print(i, w)
}
for ch in "héllo" {
    write(ch + ".")
}
print("")

{string: [int]} scores = {}
scores["math"] = [90, 80]
push(scores["math"]!!, 70)
print(scores)

var counts: {string: int} = {}
for w in split("the cat the dog the end", " ") {
    counts[w] = get(counts, w, 0) + 1
}
print(counts)

var empty: [string] = []
print(empty, len(empty))
var copied = copy(numbers)
copied[0] = -1
print(numbers[0], copied[0])
var cfg = { debug: true }
print(cfg.debug)
var m: {string: any} = { name: "burn", version: 2 }
print(m)
