def interface Shape {
    fun area(): float
    fun name(): string
}

def interface Named {
    fun name(): string
}

def class Circle: Shape, Named {
    float radius

    fun area(): float {
        return 3.14159 * radius * radius
    }

    fun name(): string {
        return "circle"
    }
}

def class Rect: Shape {
    float w
    float h

    fun area(): float {
        return w * h
    }

    fun name(): string {
        return "rect"
    }

    fun scale(k: float) {
        self.w *= k
        h = h * k
    }
}

def class Counter {
    priv int value = 0
    string label

    fun init(label: string) {
        self.label = label
    }

    fun increment(): Counter {
        value += 1
        return self
    }

    fun get(): int {
        return value
    }

    static fun named(label: string): Counter {
        return Counter(label)
    }
}

def class Human {
    fun create(name: string, age: int): Human {
        return Human { name: name, age: age }
    }

    string name
    int age

    static fun make(name: string, age: int): Human {
        return Human { name: name, age: age }
    }

    fun greet(): string {
        return "Hello, " + name + "!"
    }
}

fun totalArea(shapes: [Shape]): float {
    var total = 0.0
    for s in shapes {
        total += s.area()
    }
    return total
}

var shapes: [Shape] = [Circle { radius: 1 }, Rect { w: 2, h: 3 }]
for s in shapes {
    print(s.name(), s.area())
}
print(totalArea(shapes))

var r = Rect(1, 2)
r.scale(3)
print(r, r.area())

var counter = Counter.named("clicks")
counter.increment().increment().increment()
print(counter.label, counter.get())

var john = Human.make("John", 30)
print(john.greet())
print(Human.greet(john))

var s: Shape = Circle { radius: 2 }
if (s is Circle) {
    print("circle with radius", s.radius)
}
var n: Named = Circle { radius: 1 }
print(n.name())
print(s)
