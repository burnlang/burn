def interface Shows<T> {
    fun show(x: T): string
}

def interface Store<K, V> {
    fun put(k: K, v: V)
    fun get(k: K): V?
}

def struct IntShow :: Shows<int> {
    fun show(x: int): string {
        return "#" + str(x)
    }
}

def struct TextShow :: Shows<string> {
    fun show(x: string): string {
        return "'" + x + "'"
    }
}

def struct MapStore :: Store<string, int> {
    {string: int} items = {}

    fun put(k: string, v: int) {
        items[k] = v
    }

    fun get(k: string): int? {
        return items[k]
    }
}

fun render(s: Shows<int>, xs: [int]): string {
    var out = ""
    for x in xs {
        out += s.show(x)
    }
    return out
}

fun main() {
    Shows<int> a = new IntShow()
    Shows<string> b = new TextShow()
    print(a.show(3), b.show("hi"))
    print(render(new IntShow(), [1, 2]))
    Store<string, int> st = new MapStore()
    st.put("a", 1)
    print(st.get("a"), st.get("b"))
    var any: Shows<int> = new IntShow()
    if (any is IntShow) {
        print("is IntShow")
    }
    more()
}

def struct Echo<T>(tag: string) :: Shows<T> {
    fun show(x: T): string {
        return "${tag}:${x}"
    }
}

fun showAll<T>(s: Shows<T>, xs: [T]): [string] {
    [string] out = []
    for x in xs {
        out.push(s.show(x))
    }
    return out
}

fun more() {
    Shows<float> e = new Echo<float>("f")
    print(e.show(1.5))
    print(showAll(new Echo<int>("i"), [1, 2]))
    print(showAll(e, [0.25]))
}
