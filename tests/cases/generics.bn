fun first<T>(items: [T]): T? {
    if len(items) == 0 {
        return null
    }
    return items[0]
}

fun swap<A, B>(a: A, b: B): [any] {
    return [b, a]
}

fun mapList<T, U>(items: [T], f: fun(T): U): [U] {
    [U] out = []
    for x in items {
        out.push(f(x))
    }
    return out
}

fun largest<T>(items: [T]): T {
    var best = items[0]
    for x in items {
        if x > best {
            best = x
        }
    }
    return best
}

print(first([3, 4]), first(["a"]), first([1.5]))
[int] none = []
print(first(none))
print(swap(1, "x"))
print(mapList([1, 2, 3], fun(x: int): string {
    return "#${x}"
}))
print(largest([3, 9, 2]), largest(["pear", "apple"]), [1, 2].largest())

def type Pair<A, B> {
    first: A
    second: B
}

var p = Pair { first: 1, second: "one" }
Pair<string, bool> q = Pair { first: "yes", second: true }
print(p, p.first + 1, q.second)
var r = Pair(2.5, [1])
print(r.first, len(r.second))

def struct Stack<T>() {
    [T] items = []

    fun push(item: T) {
        items.push(item)
    }

    fun pop(): T? {
        if len(items) == 0 {
            return null
        }
        return items.pop()
    }

    fun peek(): T? {
        return first(items)
    }

    fun size(): int {
        return len(items)
    }
}

var s = new Stack<int>()
s.push(1)
s.push(2)
print(s.size(), s.peek(), s.pop(), s.pop(), s.pop())
var names = new Stack<string>()
names.push("ada")
print(names.peek()!!.upper())

def struct Node<T>(value: T) {
    Node<T>? next = null
}

def struct LinkedList<T>() {
    Node<T>? head = null
    int count = 0

    fun add(v: T) {
        var n = new Node<T>(v)
        n.next = head
        head = n
        count += 1
    }

    fun toList(): [T] {
        [T] out = []
        var cur = head
        while cur != null {
            out.push(cur.value)
            cur = cur.next
        }
        return out
    }
}

var list = new LinkedList<string>()
list.add("c")
list.add("b")
list.add("a")
print(list.toList(), list.count)

def interface Shape {
    fun area(): float
}

def struct Box<T>(item: T) :: Shape {
    fun area(): float {
        return 1.0
    }

    fun get(): T {
        return item
    }
}

[Shape] shapes = [new Box<int>(1), new Box<string>("x")]
for sh in shapes {
    print(sh.area())
}
print(new Box(42).get() + 1)

fun wrap<T>(v: T): Pair<T, T> {
    return Pair { first: v, second: v }
}
print(wrap("w"), wrap(3).second)

def struct Cell<T>(value: T) {
    fun get(): T {
        return value
    }

    fun map<U>(f: fun(T): U): Cell<U> {
        return new Cell<U>(f(value))
    }

    fun pair<U>(other: U): string {
        return "${value}/${other}"
    }

    fun twice<U>(f: fun(T): U): [U] {
        return [map(f).get(), f(value)]
    }
}

def struct Tools {
    static fun firstOf<T>(xs: [T]): T {
        return xs[0]
    }

    fun pick<T>(xs: [T], i: int): T {
        return xs[i]
    }

    fun empty<T>(): [T] {
        return []
    }
}

def struct Named(name: string) {
    fun with<T>(x: T): string {
        return "${name}=${x}"
    }
}

def struct Special(name: string) : Named(name) {
}

var cell = new Cell<int>(2)
var shown = cell.map(fun(x: int): string {
    return "v" + str(x)
})
print(cell.get(), shown.get(), cell.map(fun(x: int): float {
    return toFloat(x) / 4.0
}).get())
print(cell.pair("x"), cell.pair(true), shown.pair(3))
print(cell.twice(fun(x: int): int {
    return x * 10
}))
var tools = new Tools()
[string] nothing = tools.empty()
print(Tools.firstOf(["a", "b"]), Tools.firstOf([7, 8]), tools.pick(["x", "y"], 1), tools.pick([1.5, 2.5], 0), len(nothing))
print(new Named("n").with(1), new Special("s").with("str"))
