fun greet(name: string): string {
    return "hello " + name
}

fun total(a: int, b: int): int {
    return a + b
}

fun shout(text: string) {
    print(text.upper())
}

fun legacy(): string {
    return "old"
}

fun announce(name: string) {
    print("announcing " + name)
    shout(name)
}

@Inject(target: "greet", at: "head")
fun beforeGreet(name: string) {
    print("[head] " + name)
}

@Inject(target: "greet", at: "return")
fun afterGreet(name: string, result: string): string {
    return result + "!"
}

@Inject(target: "total", at: "head", cancellable: true)
fun guardTotal(a: int, b: int): int {
    if (a < 0) {
        return -1
    }
    return 0
}

@Overwrite(target: "legacy")
fun modern(): string {
    return "new"
}

@Redirect(target: "announce", call: "shout")
fun whisper(text: string) {
    print(text.lower())
}

@Deprecated("use greet")
fun oldGreet(): string {
    return "hi"
}

fun main() {
    print(greet("Burn"))
    print(total(2, 3))
    print(total(-5, 3))
    print(legacy())
    announce("MiXiN")
    print(oldGreet())
}
