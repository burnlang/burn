import "std/math"

def interface Shape {
    fun area(): float
}

def struct Square(side: float) :: Shape {
    fun area(): float {
        return side * side
    }
}

def type Pair {
    int a
    int b
}

fun main() {
    var s = new Square(2)
    var total = 0
    total = 1
    var p: Pair = Pair(1, 2)
    print(s.area(), total, p.a)
    print(sqrt(4.0))
    if (total > 0 && true) {
        print("never")
    }
}
