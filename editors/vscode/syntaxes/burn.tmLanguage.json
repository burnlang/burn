{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Burn",
  "scopeName": "source.burn",
  "fileTypes": ["bn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#definitions" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.burn", "match": "//.*$" },
        { "name": "comment.block.burn", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(def)\\s+(type|struct|record|interface|trait|class|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.burn" },
            "2": { "name": "storage.type.burn" },
            "3": { "name": "entity.name.type.burn" }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.burn" },
            "2": { "name": "entity.name.function.burn" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.burn", "match": "\\b(if|else|while|for|in|return|break|continue|await|import)\\b" },
        { "name": "keyword.declaration.burn", "match": "\\b(fun|var|const|def|async|static|pub|priv)\\b" },
        { "name": "keyword.operator.word.burn", "match": "\\b(is|as)\\b" },
        { "name": "constant.language.burn", "match": "\\b(true|false|null)\\b" },
        { "name": "variable.language.self.burn", "match": "\\bself\\b" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.burn",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.burn",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#escapes" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.burn",
      "match": "\\\\(n|t|r|0|\"|'|\\\\|\\$|u\\{[0-9A-Fa-f]+\\})"
    },
    "interpolation": {
      "name": "meta.interpolation.burn",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.burn" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.burn" } },
      "patterns": [{ "include": "$self" }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.burn", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.burn", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.burn", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.burn", "match": "\\b(int|float|string|bool|void|any|Int|Float|String|Bool|Void|Any|Future)\\b" },
        { "name": "entity.name.type.burn", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.burn" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.burn", "match": "\\.\\.=?" },
        { "name": "keyword.operator.comparison.burn", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.burn", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.burn", "match": "\\+=|-=|\\*=|/=|%=|=" },
        { "name": "keyword.operator.arithmetic.burn", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.nullable.burn", "match": "\\?" }
      ]
    }
  }
}
