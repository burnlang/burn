{
  "name": "burn-language-server",
  "displayName": "Burn Language Support",
  "description": "Burn language support: diagnostics, completion, signature help, inlay type hints, hover, go to definition (also into the standard library and built-ins), find references, rename, formatting and quick fixes",
  "version": "26.2.0",
  "publisher": "burn",
  "icon": "images/icon.png",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/burnlang/burn"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:burn"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "burn",
        "aliases": [
          "Burn",
          "burn"
        ],
        "extensions": [
          ".bn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "burn",
        "scopeName": "source.burn",
        "path": "./syntaxes/burn.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "burn",
        "path": "./snippets/burn.json"
      }
    ],
    "commands": [
      {
        "command": "burn.run",
        "title": "Burn: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "burn.runNative",
        "title": "Burn: Compile and Run Current File Natively"
      },
      {
        "command": "burn.build",
        "title": "Burn: Build Executable"
      },
      {
        "command": "burn.restartServer",
        "title": "Burn: Restart Language Server"
      },
      {
        "command": "burn.openStdlib",
        "title": "Burn: Open Standard Library Module..."
      },
      {
        "command": "burn.openBuiltins",
        "title": "Burn: Show Built-in Functions"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Burn",
      "properties": {
        "burn.path": {
          "type": "string",
          "default": "burn",
          "description": "Path to the burn executable used for the language server and commands. By default ~/.burn/bin/burn (installed by burnup) is used when it exists, otherwise burn from PATH."
        },
        "burn.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Burn language server."
        },
        "burn.codeLens.run": {
          "type": "boolean",
          "default": true,
          "description": "Show Run, Run natively and Build above `fun main()`."
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "burn.run",
          "when": "resourceLangId == burn",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "burn.run",
          "when": "editorLangId == burn"
        },
        {
          "command": "burn.runNative",
          "when": "editorLangId == burn"
        },
        {
          "command": "burn.build",
          "when": "editorLangId == burn"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
