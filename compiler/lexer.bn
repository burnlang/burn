import "std/strings"

/** The kind of a token. The names match the variants of `Tok` in the Rust lexer. */
pub def enum Kind {
    Ident, Int, BigInt, Float, Str, Template,
    Fun, Var, Const, Def, If, Else, While, For, In, Return, Break, Continue, True, False, Null, Import, Pub, Priv, Async, Await, Is, As,
    Plus, Minus, Star, Slash, Percent, Assign, PlusEq, MinusEq, StarEq, SlashEq, PercentEq, EqEq, NotEq, Lt, Gt, Le, Ge, AndAnd, OrOr, Bang,
    LParen, RParen, LBrace, RBrace, LBracket, RBracket, Comma, Semi, Colon, ColonColon, Dot, DotDot, DotDotEq,
    Question, QuestionDot, QuestionQuestion, Arrow, At, Amp, Pipe, Caret, Tilde, Shl, Shr, UShr,
    AmpEq, PipeEq, CaretEq, ShlEq, ShrEq, UShrEq, FatArrow, Eof
}

/**
 * One token. `start` and `end` are byte offsets into the source, and `nl` is true when a line break comes before it.
 * `text` holds the name of an identifier, the value of a string, or the decimal digits of a `BigInt`.
 * `value` holds an `Int`, and is 1 for a `BigInt` written with a `0x`, `0b` or `0o` prefix.
 */
pub def type Token {
    Kind kind
    int start
    int end
    bool nl
    string text
    int value
    float number
    [Part] parts
}

/** A piece of a string template: literal text, or the tokens of an embedded `${...}` expression. */
pub def enum Part {
    Lit(text: string),
    Code(tokens: [Token], start: int, end: int)
}

/** A lexer error at a byte range of the source. */
pub def type Diag {
    int start
    int end
    string message
}

/** The tokens of a source file, ending with `Eof`, and the errors found while reading them. */
pub def type Lexed {
    [Token] tokens
    [Diag] diags
}

const LF = 10
const TAB = 9
const CR = 13
const SPACE = 32
const BANG = 33
const DQUOTE = 34
const HASH = 35
const DOLLAR = 36
const PERCENT = 37
const AMP = 38
const SQUOTE = 39
const LPAREN = 40
const RPAREN = 41
const STAR = 42
const PLUS = 43
const COMMA = 44
const MINUS = 45
const DOT = 46
const SLASH = 47
const ZERO = 48
const NINE = 57
const COLON = 58
const SEMI = 59
const LT = 60
const EQ = 61
const GT = 62
const QUESTION = 63
const AT = 64
const LBRACKET = 91
const BACKSLASH = 92
const RBRACKET = 93
const CARET = 94
const UNDERSCORE = 95
const LBRACE = 123
const PIPE = 124
const RBRACE = 125
const TILDE = 126
const U64_MAX = "18446744073709551615"

const KEYWORDS: {string: Kind} = {
    "fun": Kind.Fun,
    "var": Kind.Var,
    "const": Kind.Const,
    "def": Kind.Def,
    "if": Kind.If,
    "else": Kind.Else,
    "while": Kind.While,
    "for": Kind.For,
    "in": Kind.In,
    "return": Kind.Return,
    "break": Kind.Break,
    "continue": Kind.Continue,
    "true": Kind.True,
    "false": Kind.False,
    "null": Kind.Null,
    "import": Kind.Import,
    "pub": Kind.Pub,
    "priv": Kind.Priv,
    "async": Kind.Async,
    "await": Kind.Await,
    "is": Kind.Is,
    "as": Kind.As
}

fun isAsciiLetter(c: int): bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fun isAsciiDigit(c: int): bool {
    return c >= ZERO && c <= NINE
}

fun charLen(lead: int): int {
    if (lead < 128) {
        return 1
    }
    if (lead >= 240) {
        return 4
    }
    if (lead >= 224) {
        return 3
    }
    if (lead >= 192) {
        return 2
    }
    return 1
}

fun withoutUnderscores(s: string): string {
    if (!contains(s, "_")) {
        return s
    }
    return replace(s, "_", "")
}

fun digitValue(c: string): int {
    var k = charCode(lower(c))
    if (k >= ZERO && k <= NINE) {
        return k - ZERO
    }
    if (k >= 97 && k <= 122) {
        return k - 87
    }
    return 99
}

/** The decimal form of `digits` read in base `radix`, or null when it is not a number that fits in 64 unsigned bits. */
fun unsignedDecimal(digits: string, radix: int): string? {
    if (len(digits) == 0) {
        return null
    }
    [int] acc = []
    for c in digits {
        var carry = digitValue(c)
        if (carry >= radix) {
            return null
        }
        for k in 0..len(acc) {
            var x = acc[k] * radix + carry
            acc[k] = x % 10
            carry = x / 10
        }
        while (carry > 0) {
            acc.push(carry % 10)
            carry = carry / 10
        }
    }
    if (len(acc) == 0) {
        return "0"
    }
    var out = ""
    var k = len(acc) - 1
    while (k >= 0) {
        out += toString(acc[k])
        k -= 1
    }
    if (len(out) > len(U64_MAX) || (len(out) == len(U64_MAX) && out > U64_MAX)) {
        return null
    }
    return out
}

fun unicodeScalar(hex: string): int {
    var digits = hex
    if (startsWith(digits, "+")) {
        digits = substring(digits, 1)
    }
    if (len(digits) == 0 || startsWith(digits, "+") || startsWith(digits, "-") || !isInt(digits, 16)) {
        return -1
    }
    var code = toInt(digits, 16)
    if (code > 1114111 || (code >= 55296 && code <= 57343)) {
        return -1
    }
    return code
}

def struct Lexer(src: string, bytes: [uint8], pos: int, stop: int) {
    [Token] tokens = []
    [Diag] diags = []
    bool nl = true

    fun peek(off: int): int {
        if (pos + off < stop) {
            return bytes[pos + off] as int
        }
        return 0
    }

    fun raw(at: int): int {
        if (at < len(bytes)) {
            return bytes[at] as int
        }
        return -1
    }

    fun text(from: int, to: int): string {
        return fromBytes(slice(bytes, from, to))
    }

    fun token(kind: Kind, start: int): Token {
        var t = Token { kind: kind, start: start, end: pos, nl: nl, text: "", value: 0, number: 0.0, parts: [] }
        nl = false
        return t
    }

    fun push(kind: Kind, start: int) {
        tokens.push(token(kind, start))
    }

    fun error(start: int, message: string) {
        var end = pos
        if (end < start + 1) {
            end = start + 1
        }
        var limit = stop
        if (limit < start) {
            limit = start
        }
        if (end > limit) {
            end = limit
        }
        diags.push(Diag { start: start, end: end, message: message })
    }

    fun unexpected(start: int) {
        var n = charLen(bytes[pos] as int)
        var ch = text(pos, pos + n)
        pos += n
        diags.push(Diag { start: start, end: pos, message: "unexpected character `${ch}`" })
    }

    fun run(): void {
        if (pos == 0 && startsWith(src, "#!")) {
            while (pos < stop && bytes[pos] != LF) {
                pos += 1
            }
        }
        while (true) {
            skipTrivia()
            if (pos >= stop) {
                tokens.push(Token { kind: Kind.Eof, start: stop, end: stop, nl: true, text: "", value: 0, number: 0.0, parts: [] })
                return
            }
            var start = pos
            var c = bytes[pos] as int
            if (isAsciiLetter(c) || c == UNDERSCORE || c >= 128) {
                ident(start)
                continue
            }
            if (isAsciiDigit(c)) {
                number(start)
                continue
            }
            if (c == DQUOTE || c == SQUOTE) {
                string(start, c)
                continue
            }
            var c1 = peek(1)
            var c2 = peek(2)
            if (c == GT && c1 == GT && c2 == GT && peek(3) == EQ) {
                pos += 4
                push(Kind.UShrEq, start)
                continue
            }
            if (c == GT && c1 == GT && c2 == GT) {
                pos += 3
                push(Kind.UShr, start)
                continue
            }
            if (c == GT && c1 == GT && c2 == EQ) {
                pos += 3
                push(Kind.ShrEq, start)
                continue
            }
            if (c == LT && c1 == LT && c2 == EQ) {
                pos += 3
                push(Kind.ShlEq, start)
                continue
            }
            if (c == GT && c1 == GT) {
                pos += 2
                push(Kind.Shr, start)
                continue
            }
            if (c == LT && c1 == LT) {
                pos += 2
                push(Kind.Shl, start)
                continue
            }
            var two = pair(c, c1)
            if (two != Kind.Eof) {
                pos += 2
                push(two, start)
                continue
            }
            if (c == DOT && c1 == DOT) {
                if (c2 == EQ) {
                    pos += 3
                    push(Kind.DotDotEq, start)
                } else {
                    pos += 2
                    push(Kind.DotDot, start)
                }
                continue
            }
            if (c == COLON && raw(pos + 1) == COLON) {
                pos += 2
                push(Kind.ColonColon, start)
                continue
            }
            if (c == QUESTION && raw(pos + 1) == DOT) {
                pos += 2
                push(Kind.QuestionDot, start)
                continue
            }
            if (c == QUESTION && raw(pos + 1) == QUESTION) {
                pos += 2
                push(Kind.QuestionQuestion, start)
                continue
            }
            var one = single(c)
            if (one == Kind.Eof) {
                unexpected(start)
                continue
            }
            pos += 1
            push(one, start)
        }
    }

    fun pair(c: int, d: int): Kind {
        if (d == EQ) {
            return match c {
                AMP => Kind.AmpEq
                PIPE => Kind.PipeEq
                CARET => Kind.CaretEq
                PLUS => Kind.PlusEq
                MINUS => Kind.MinusEq
                STAR => Kind.StarEq
                SLASH => Kind.SlashEq
                PERCENT => Kind.PercentEq
                EQ => Kind.EqEq
                BANG => Kind.NotEq
                LT => Kind.Le
                GT => Kind.Ge
                else => Kind.Eof
            }
        }
        if (c == EQ && d == GT) {
            return Kind.FatArrow
        }
        if (c == AMP && d == AMP) {
            return Kind.AndAnd
        }
        if (c == PIPE && d == PIPE) {
            return Kind.OrOr
        }
        if (c == MINUS && d == GT) {
            return Kind.Arrow
        }
        return Kind.Eof
    }

    fun single(c: int): Kind {
        return match c {
            PLUS => Kind.Plus
            MINUS => Kind.Minus
            STAR => Kind.Star
            SLASH => Kind.Slash
            PERCENT => Kind.Percent
            EQ => Kind.Assign
            LT => Kind.Lt
            GT => Kind.Gt
            BANG => Kind.Bang
            LPAREN => Kind.LParen
            RPAREN => Kind.RParen
            LBRACE => Kind.LBrace
            RBRACE => Kind.RBrace
            LBRACKET => Kind.LBracket
            RBRACKET => Kind.RBracket
            COMMA => Kind.Comma
            SEMI => Kind.Semi
            COLON => Kind.Colon
            DOT => Kind.Dot
            QUESTION => Kind.Question
            AT => Kind.At
            AMP => Kind.Amp
            PIPE => Kind.Pipe
            CARET => Kind.Caret
            TILDE => Kind.Tilde
            else => Kind.Eof
        }
    }

    fun skipTrivia() {
        while (pos < stop) {
            var c = bytes[pos] as int
            if (c == LF) {
                nl = true
                pos += 1
            } else if (c == SPACE || c == TAB || c == CR) {
                pos += 1
            } else if (c == SLASH && peek(1) == SLASH) {
                while (pos < stop && bytes[pos] != LF) {
                    pos += 1
                }
            } else if (c == SLASH && peek(1) == STAR) {
                var start = pos
                pos += 2
                var depth = 1
                while (pos < stop && depth > 0) {
                    var b = bytes[pos] as int
                    if (b == STAR && peek(1) == SLASH) {
                        depth -= 1
                        pos += 2
                    } else if (b == SLASH && peek(1) == STAR) {
                        depth += 1
                        pos += 2
                    } else {
                        if (b == LF) {
                            nl = true
                        }
                        pos += 1
                    }
                }
                if (depth > 0) {
                    error(start, "unterminated block comment")
                }
            } else {
                return
            }
        }
    }

    fun identChar(): int {
        var c = bytes[pos] as int
        if (c < 128) {
            if (isAsciiLetter(c) || isAsciiDigit(c) || c == UNDERSCORE) {
                return 1
            }
            return 0
        }
        var n = charLen(c)
        if (isAlphanumeric(text(pos, pos + n))) {
            return n
        }
        return 0
    }

    fun ident(start: int) {
        while (pos < stop) {
            var n = identChar()
            if (n == 0) {
                break
            }
            pos += n
        }
        if (pos == start) {
            unexpected(start)
            return
        }
        var name = text(start, pos)
        var kw = KEYWORDS[name]
        if (kw != null) {
            push(kw, start)
            return
        }
        var t = token(Kind.Ident, start)
        t.text = name
        tokens.push(t)
    }

    fun digits(radixed: bool) {
        while (pos < stop) {
            var b = bytes[pos] as int
            if (isAsciiDigit(b) || b == UNDERSCORE || (radixed && isAsciiLetter(b))) {
                pos += 1
            } else {
                break
            }
        }
    }

    fun number(start: int) {
        var p1 = peek(1)
        if (bytes[pos] == ZERO && (p1 == 120 || p1 == 88 || p1 == 98 || p1 == 66 || p1 == 111 || p1 == 79)) {
            var radix = 8
            if (p1 == 120 || p1 == 88) {
                radix = 16
            } else if (p1 == 98 || p1 == 66) {
                radix = 2
            }
            pos += 2
            var ds = pos
            digits(true)
            var ds2 = withoutUnderscores(text(ds, pos))
            if (isInt(ds2, radix)) {
                var t = token(Kind.Int, start)
                t.value = toInt(ds2, radix)
                tokens.push(t)
                return
            }
            var big = unsignedDecimal(ds2, radix)
            if (big != null) {
                var t = token(Kind.BigInt, start)
                t.text = big
                t.value = 1
                tokens.push(t)
                return
            }
            error(start, "invalid number literal")
            push(Kind.Int, start)
            return
        }
        var float = false
        digits(false)
        if (peek(0) == DOT && isAsciiDigit(peek(1))) {
            float = true
            pos += 1
            digits(false)
        }
        var e = peek(0)
        var e1 = peek(1)
        if ((e == 101 || e == 69) && (isAsciiDigit(e1) || ((e1 == PLUS || e1 == MINUS) && isAsciiDigit(peek(2))))) {
            float = true
            pos += 2
            while (pos < stop && isAsciiDigit(bytes[pos] as int)) {
                pos += 1
            }
        }
        var lit = withoutUnderscores(text(start, pos))
        if (float) {
            var t = token(Kind.Float, start)
            t.number = toFloat(lit)
            tokens.push(t)
            return
        }
        if (isInt(lit)) {
            var t = token(Kind.Int, start)
            t.value = toInt(lit)
            tokens.push(t)
            return
        }
        var big = unsignedDecimal(lit, 10)
        if (big != null) {
            var t = token(Kind.BigInt, start)
            t.text = big
            tokens.push(t)
            return
        }
        error(start, "integer literal is too large")
        var t = token(Kind.Float, start)
        t.number = toFloat(lit)
        tokens.push(t)
    }

    fun escape(cur: string, escStart: int): string {
        pos += 1
        var e = peek(0)
        pos += 1
        if (e == 110) {
            return cur + "\n"
        }
        if (e == 116) {
            return cur + "\t"
        }
        if (e == 114) {
            return cur + "\r"
        }
        if (e == ZERO) {
            return cur + fromCharCode(0)
        }
        if (e == BACKSLASH) {
            return cur + "\\"
        }
        if (e == DQUOTE) {
            return cur + "\""
        }
        if (e == SQUOTE) {
            return cur + "'"
        }
        if (e == DOLLAR) {
            return cur + "\$"
        }
        if (e == 117) {
            if (peek(0) != LBRACE) {
                error(escStart, "expected `{` after `\\u`")
                return cur
            }
            var hs = pos + 1
            var he = hs
            while (he < stop && bytes[he] != RBRACE) {
                he += 1
            }
            var code = unicodeScalar(text(hs, he))
            pos = he + 1
            if (pos > stop) {
                pos = stop
            }
            if (code < 0) {
                error(escStart, "invalid unicode escape")
                return cur
            }
            return cur + fromCharCode(code)
        }
        while (pos < stop && bytes[pos] >= 128 && bytes[pos] < 192) {
            pos += 1
        }
        error(escStart, "unknown escape sequence")
        return cur
    }

    fun templateEnd(from: int): int {
        var i = from
        var depth = 1
        while (i < stop && depth > 0) {
            var b = bytes[i] as int
            if (b == LBRACE) {
                depth += 1
            } else if (b == RBRACE) {
                depth -= 1
            } else if (b == DQUOTE || b == SQUOTE) {
                i += 1
                while (i < stop && bytes[i] != b && bytes[i] != LF) {
                    if (bytes[i] == BACKSLASH) {
                        i += 1
                    }
                    i += 1
                }
            } else if (b == LF) {
                break
            }
            if (depth > 0) {
                i += 1
            }
        }
        if (depth != 0) {
            return -1 - i
        }
        return i
    }

    fun string(start: int, quote: int) {
        pos += 1
        [Part] parts = []
        var cur = ""
        var closed = false
        while (pos < stop) {
            var c = bytes[pos] as int
            if (c == quote) {
                pos += 1
                closed = true
                break
            }
            if (c == LF) {
                break
            }
            if (c == BACKSLASH) {
                cur = escape(cur, pos)
                continue
            }
            if (c == DOLLAR && peek(1) == LBRACE) {
                var exprStart = pos + 2
                var i = templateEnd(exprStart)
                if (i < 0) {
                    pos = -1 - i
                    error(start, "unterminated `\${` in string template")
                    break
                }
                if (len(cur) > 0) {
                    parts.push(Part.Lit(cur))
                    cur = ""
                }
                var inner = new Lexer(src, bytes, exprStart, i)
                inner.run()
                for d in inner.diags {
                    diags.push(d)
                }
                if (len(inner.tokens) > 0) {
                    inner.tokens[0].nl = false
                }
                parts.push(Part.Code(inner.tokens, exprStart, i))
                pos = i + 1
                continue
            }
            var run = pos
            while (pos < stop) {
                var b = bytes[pos] as int
                if (b == quote || b == LF || b == BACKSLASH || (b == DOLLAR && peek(1) == LBRACE)) {
                    break
                }
                pos += 1
            }
            cur += text(run, pos)
        }
        if (!closed) {
            error(start, "unterminated string literal")
        }
        if (len(parts) == 0) {
            var t = token(Kind.Str, start)
            t.text = cur
            tokens.push(t)
            return
        }
        if (len(cur) > 0) {
            parts.push(Part.Lit(cur))
        }
        var t = token(Kind.Template, start)
        t.parts = parts
        tokens.push(t)
    }
}

/** Splits Burn source into tokens, the same way the compiler written in Rust does. */
pub fun lex(src: string): Lexed {
    var l = new Lexer(src, src.bytes(), 0, len(src.bytes()))
    l.run()
    return Lexed { tokens: l.tokens, diags: l.diags }
}
