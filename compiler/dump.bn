import "astdump.bn"
import "diag.bn"
import "lexer.bn"
import "parser.bn"
import "std/fs"
import "std/process"

fun flag(b: bool): int {
    if (b) {
        return 1
    }
    return 0
}

fun base(radixed: int): string {
    if (radixed == 1) {
        return "hex"
    }
    return "dec"
}

fun dumpTokens(tokens: [Token], depth: int): string {
    var pad = repeat("  ", depth)
    var out = ""
    for t in tokens {
        var head = "${pad}${t.start} ${t.end} ${flag(t.nl)} ${t.kind}"
        out += match t.kind {
            Kind.Ident => "${head} ${t.text}\n"
            Kind.Int => "${head} ${t.value}\n"
            Kind.BigInt => "${head} ${t.text} ${base(t.value)}\n"
            Kind.Float => "${head} ${t.number}\n"
            Kind.Str => "${head} ${quoted(t.text)}\n"
            else => "${head}\n"
        }
        for p in t.parts {
            match p {
                Part.Lit(text) => out += "${pad}  lit ${quoted(text)}\n"
                Part.Code(inner, start, end) => {
                    out += "${pad}  expr ${start} ${end}\n"
                    out += dumpTokens(inner, depth + 2)
                }
            }
        }
    }
    return out
}

fun dump(src: string): string {
    var lexed = lex(src)
    var out = dumpTokens(lexed.tokens, 0)
    for d in lexed.diags {
        out += "error ${d.start} ${d.end} ${d.message}\n"
    }
    return out
}

fun diagnostics(name: string, src: string): string {
    var f = new SourceFile(name, src)
    var out = ""
    for d in parse(src).diags {
        out += render(f, d)
    }
    return out
}

fun main() {
    var files = args()
    var mode = "--tokens"
    if (len(files) > 0 && (files[0] == "--ast" || files[0] == "--tokens" || files[0] == "--diagnostics")) {
        mode = files[0]
        files = slice(files, 1, len(files))
    }
    for f in files {
        if (len(files) > 1) {
            print("file ${f}")
        }
        var src = readFile(f)
        if (mode == "--ast") {
            write(dumpAst(src))
        } else if (mode == "--diagnostics") {
            write(diagnostics(f, src))
        } else {
            write(dump(src))
        }
    }
}
