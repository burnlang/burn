type ExprKind.Call = record { callee: Expr, args: #520 } implements ExprKind
type ExprKind.Field = record { obj: Expr, name: Ident } implements ExprKind
type ExprKind.Index = record { obj: Expr, index: Expr } implements ExprKind
type ExprKind.Array = record { items: #520 } implements ExprKind
type ExprKind.StructLit = record { ty: #513, fields: #539 } implements ExprKind
type ExprKind.MapLit = record { pairs: #540 } implements ExprKind
type ExprKind.Is = record { value: Expr, ty: TypeExpr } implements ExprKind
type ExprKind.As = record { value: Expr, ty: TypeExpr } implements ExprKind
type ExprKind.Await = record { value: Expr } implements ExprKind
type ExprKind.Lambda = record { decl: FunDecl } implements ExprKind
type ExprKind.NotNull = record { value: Expr } implements ExprKind
type ExprKind.New = record { ty: Ident, targs: #531, args: #520 } implements ExprKind
type ExprKind.SafeGet = record { obj: Expr, name: Ident, args: #521 } implements ExprKind
type ExprKind.Coalesce = record { left: Expr, right: Expr } implements ExprKind
type ExprKind.SafeAs = record { value: Expr, ty: TypeExpr } implements ExprKind
type ExprKind.Match = record { subject: #519, arms: #541 } implements ExprKind
type Parser = struct { toks: #542, pos: int, diags: #543, speculative: int, noStruct: bool, hasDestroy: bool, splits: [int], aliases: #544, nested: #512 }
type Parsed = record { module: Module, diags: #543 }
type Kind = enum { Ident, Int, BigInt, Float, Str, Template, Fun, Var, Const, Def, If, Else, While, For, In, Return, Break, Continue, True, False, Null, Import, Pub, Priv, Async, Await, Is, As, Plus, Minus, Star, Slash, Percent, Assign, PlusEq, MinusEq, StarEq, SlashEq, PercentEq, EqEq, NotEq, Lt, Gt, Le, Ge, AndAnd, OrOr, Bang, LParen, RParen, LBrace, RBrace, LBracket, RBracket, Comma, Semi, Colon, ColonColon, Dot, DotDot, DotDotEq, Question, QuestionDot, QuestionQuestion, Arrow, At, Amp, Pipe, Caret, Tilde, Shl, Shr, UShr, AmpEq, PipeEq, CaretEq, ShlEq, ShrEq, UShrEq, FatArrow, AsmText, Eof }
