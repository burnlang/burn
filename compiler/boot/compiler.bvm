    str "testing"
    str "priv var passed = 0\npriv var failed = 0\npriv var running = \"\"\npriv var currentFailed = false\n\npriv fun fail(message: string) {\n    currentFailed = true\n    if running == \"\" {\n        failed += 1\n        print(\"FAIL \" + message)\n    } else {\n        print(\"     \" + message)\n    }\n}\n\n/**\n * Runs one named test and prints whether it passed.\n *\n * A test fails when one of the `expect` functions fails inside it. The\n * other tests still run; call `finish` at the end to get the exit code.\n *\n * @param name what the test checks\n * @param body the test\n * @see finish\n * @since 26.1\n * @example\n *     test(\"adds\", fun() {\n *         expectEqual(1 + 2, 3)\n *     })\n */\npub fun test(name: string, body: fun()) {\n    running = name\n    currentFailed = false\n    body()\n    if currentFailed {\n        failed += 1\n        print(\"FAIL \" + name)\n    } else {\n        passed += 1\n        print(\"ok   \" + name)\n    }\n    running = \"\"\n}\n\n/**\n * Checks that a condition is true.\n *\n * @param condition the condition\n * @param message what went wrong if it is false\n * @since 26.1\n */\npub fun expect(condition: bool, message: string) {\n    if !condition {\n        fail(message)\n    }\n}\n\n/**\n * Checks that two values are equal, comparing them like `==`.\n *\n * @param actual the value the code produced\n * @param expected the value it should be\n * @since 26.1\n */\npub fun expectEqual<T>(actual: T, expected: T) {\n    if actual != expected {\n        fail(\"expected ${expected} but got ${actual}\")\n    }\n}\n\n/**\n * Checks that two values are different.\n *\n * @param actual the value the code produced\n * @param unwanted the value it must not be\n * @since 26.1\n */\npub fun expectNotEqual<T>(actual: T, unwanted: T) {\n    if actual == unwanted {\n        fail(\"did not expect ${unwanted}\")\n    }\n}\n\n/**\n * Checks that two numbers are close to each other.\n *\n * @param actual the number the code produced\n * @param expected the number it should be\n * @param tolerance how far apart they may be\n * @since 26.1\n */\npub fun expectNear(actual: float, expected: float, tolerance: float) {\n    if abs(actual - expected) > tolerance {\n        fail(\"expected ${expected} (within ${tolerance}) but got ${actual}\")\n    }\n}\n\n/**\n * Prints how many tests passed and ends the program with exit code 1 if\n * any failed.\n *\n * @since 26.1\n */\npub fun finish() {\n    print(\"${passed} passed, ${failed} failed\")\n    if failed > 0 {\n        exit(1)\n    }\n}\n"
    new StdModule
