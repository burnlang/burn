    str "path"
    str "/**\n * Joins two parts of a file path with `/`.\n *\n * If `child` is absolute it is returned unchanged.\n *\n * @param base the first part\n * @param child the part to add\n * @return the joined path\n * @since 26.1\n * @example\n *     joinPath(\"src\", \"main.bn\")   // \"src/main.bn\"\n *     joinPath(\"src/\", \"/etc\")     // \"/etc\"\n */\npub fun joinPath(base: string, child: string): string {\n    if child.startsWith(\"/\") || base == \"\" {\n        return child\n    }\n    if child == \"\" {\n        return base\n    }\n    if base.endsWith(\"/\") {\n        return base + child\n    }\n    return base + \"/\" + child\n}\n\n/**\n * Joins several parts of a file path with `/`.\n *\n * @param parts the parts\n * @return the joined path\n * @see joinPath\n * @since 26.1\n */\npub fun joinAll(parts: [string]): string {\n    var out = \"\"\n    for p in parts {\n        out = joinPath(out, p)\n    }\n    return out\n}\n\n/**\n * Removes `.` parts, resolves `..` parts and repeated slashes.\n *\n * @param path the path to clean\n * @return the shortest equivalent path, `\".\"` for an empty result\n * @since 26.1\n * @example\n *     normalize(\"a/./b/../c//d\")  // \"a/c/d\"\n */\npub fun normalize(path: string): string {\n    var absolute = path.startsWith(\"/\")\n    [string] parts = []\n    for p in split(path, \"/\") {\n        if p == \"\" || p == \".\" {\n            continue\n        }\n        if p == \"..\" {\n            if len(parts) > 0 && parts[len(parts) - 1] != \"..\" {\n                parts.pop()\n            } else if !absolute {\n                parts.push(\"..\")\n            }\n            continue\n        }\n        parts.push(p)\n    }\n    var joined = join(parts, \"/\")\n    if absolute {\n        return \"/\" + joined\n    }\n    if joined == \"\" {\n        return \".\"\n    }\n    return joined\n}\n\n/**\n * Returns the last part of a path.\n *\n * @param path the path\n * @return the file or folder name, without the folders before it\n * @since 26.1\n * @example\n *     baseName(\"src/lib/main.bn\")  // \"main.bn\"\n */\npub fun baseName(path: string): string {\n    var p = path\n    while len(p) > 1 && p.endsWith(\"/\") {\n        p = substring(p, 0, len(p) - 1)\n    }\n    var parts = split(p, \"/\")\n    return parts[len(parts) - 1]\n}\n\n/**\n * Returns the folder part of a path.\n *\n * @param path the path\n * @return everything before the last part, `\".\"` if there is none\n * @since 26.1\n * @example\n *     dirName(\"src/lib/main.bn\")  // \"src/lib\"\n */\npub fun dirName(path: string): string {\n    var p = path\n    while len(p) > 1 && p.endsWith(\"/\") {\n        p = substring(p, 0, len(p) - 1)\n    }\n    var i = len(p) - 1\n    while i >= 0 && charAt(p, i) != \"/\" {\n        i -= 1\n    }\n    if i < 0 {\n        return \".\"\n    }\n    if i == 0 {\n        return \"/\"\n    }\n    return substring(p, 0, i)\n}\n\n/**\n * Returns the extension of a file name, including the dot.\n *\n * @param path the path\n * @return for example `\".bn\"`, or `\"\"` when the name has no extension\n * @since 26.1\n */\npub fun extension(path: string): string {\n    var name = baseName(path)\n    var i = len(name) - 1\n    while i > 0 && charAt(name, i) != \".\" {\n        i -= 1\n    }\n    if i <= 0 {\n        return \"\"\n    }\n    return substring(name, i, len(name))\n}\n\n/**\n * Returns a file name without its extension.\n *\n * @param path the path\n * @return the last part of the path, without the extension\n * @since 26.1\n * @example\n *     stem(\"src/main.bn\")  // \"main\"\n */\npub fun stem(path: string): string {\n    var name = baseName(path)\n    var ext = extension(name)\n    return substring(name, 0, len(name) - len(ext))\n}\n\n/**\n * Tells whether a path starts at the root of the file system.\n *\n * @param path the path\n * @return `true` if it starts with `/`\n * @since 26.1\n */\npub fun isAbsolute(path: string): bool {\n    return path.startsWith(\"/\")\n}\n"
