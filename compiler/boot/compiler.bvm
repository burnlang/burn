    str "list"
    str "/**\n * Makes a new array with the result of a function for every item.\n *\n * @param items the items to transform\n * @param f the function to call for each item\n * @return the results, in the same order\n * @since 26.1\n * @example\n *     [1, 2, 3].map(fun(x: int): int { return x * 2 })  // [2, 4, 6]\n */\npub fun map<T, U>(items: [T], f: fun(T): U): [U] {\n    [U] out = []\n    for x in items {\n        out.push(f(x))\n    }\n    return out\n}\n\n/**\n * Makes a new array with the items for which a test returns true.\n *\n * @param items the items to test\n * @param keep the test\n * @return the items that passed, in the same order\n * @since 26.1\n * @example\n *     [1, 2, 3, 4].filter(fun(x: int): bool { return x % 2 == 0 })  // [2, 4]\n */\npub fun filter<T>(items: [T], keep: fun(T): bool): [T] {\n    [T] out = []\n    for x in items {\n        if keep(x) {\n            out.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Combines all items into one value, from left to right.\n *\n * @param items the items to combine\n * @param start the value to start with\n * @param f gets the value so far and the next item, and returns the new value\n * @return the final value, or `start` for an empty array\n * @since 26.1\n * @example\n *     [1, 2, 3].reduce(0, fun(sum: int, x: int): int { return sum + x })  // 6\n */\npub fun reduce<T, R>(items: [T], start: R, f: fun(R, T): R): R {\n    var acc = start\n    for x in items {\n        acc = f(acc, x)\n    }\n    return acc\n}\n\n/**\n * Calls a function for every item.\n *\n * @param items the items\n * @param f the function to call\n * @since 26.1\n */\npub fun each<T>(items: [T], f: fun(T)) {\n    for x in items {\n        f(x)\n    }\n}\n\n/**\n * Finds the first item for which a test returns true.\n *\n * @param items the items to search\n * @param test the test\n * @return the first matching item, or `null`\n * @see findIndex\n * @since 26.1\n */\npub fun find<T>(items: [T], test: fun(T): bool): T? {\n    for x in items {\n        if test(x) {\n            return x\n        }\n    }\n    return null\n}\n\n/**\n * Finds the position of the first item for which a test returns true.\n *\n * @param items the items to search\n * @param test the test\n * @return the index of the first matching item, or `-1`\n * @see find\n * @since 26.1\n */\npub fun findIndex<T>(items: [T], test: fun(T): bool): int {\n    for i, x in items {\n        if test(x) {\n            return i\n        }\n    }\n    return -1\n}\n\n/**\n * Tells whether a test returns true for at least one item.\n *\n * @param items the items to test\n * @param test the test\n * @return `true` if any item passes; `false` for an empty array\n * @since 26.1\n */\npub fun any<T>(items: [T], test: fun(T): bool): bool {\n    for x in items {\n        if test(x) {\n            return true\n        }\n    }\n    return false\n}\n\n/**\n * Tells whether a test returns true for every item.\n *\n * @param items the items to test\n * @param test the test\n * @return `true` if every item passes; `true` for an empty array\n * @since 26.1\n */\npub fun all<T>(items: [T], test: fun(T): bool): bool {\n    for x in items {\n        if !test(x) {\n            return false\n        }\n    }\n    return true\n}\n\n/**\n * Counts the items for which a test returns true.\n *\n * @param items the items to test\n * @param test the test\n * @return the number of items that passed\n * @since 26.1\n */\npub fun countWhere<T>(items: [T], test: fun(T): bool): int {\n    var n = 0\n    for x in items {\n        if test(x) {\n            n += 1\n        }\n    }\n    return n\n}\n\n/**\n * Adds up all items with `+`.\n *\n * Works for any item type that supports `+`, such as `int`, `float` and\n * `string`.\n *\n * @param items the items to add\n * @param zero the value for an empty array\n * @return the sum\n * @since 26.1\n * @example\n *     [1, 2, 3].total(0)        // 6\n *     [\"a\", \"b\"].total(\"\")      // \"ab\"\n */\npub fun total<T>(items: [T], zero: T): T {\n    var acc = zero\n    for x in items {\n        acc = acc + x\n    }\n    return acc\n}\n\n/**\n * Returns the first item.\n *\n * @param items the items\n * @return the first item, or `null` for an empty array\n * @since 26.1\n */\npub fun first<T>(items: [T]): T? {\n    if len(items) == 0 {\n        return null\n    }\n    return items[0]\n}\n\n/**\n * Returns the last item.\n *\n * @param items the items\n * @return the last item, or `null` for an empty array\n * @since 26.1\n */\npub fun last<T>(items: [T]): T? {\n    if len(items) == 0 {\n        return null\n    }\n    return items[len(items) - 1]\n}\n\n/**\n * Returns the first items.\n *\n * @param items the items\n * @param n how many to take\n * @return at most `n` items from the start\n * @since 26.1\n */\npub fun take<T>(items: [T], n: int): [T] {\n    if n <= 0 {\n        [T] none = []\n        return none\n    }\n    return slice(items, 0, min(n, len(items)))\n}\n\n/**\n * Returns the items after the first ones.\n *\n * @param items the items\n * @param n how many to skip\n * @return the items from position `n` on\n * @since 26.1\n */\npub fun drop<T>(items: [T], n: int): [T] {\n    if n >= len(items) {\n        [T] none = []\n        return none\n    }\n    return slice(items, max(n, 0), len(items))\n}\n\n/**\n * Splits the items into groups of a fixed size. The last group can be\n * smaller.\n *\n * @param items the items\n * @param size the size of each group, at least 1\n * @return the groups, in order\n * @since 26.1\n * @example\n *     [1, 2, 3, 4, 5].chunk(2)  // [[1, 2], [3, 4], [5]]\n */\npub fun chunk<T>(items: [T], size: int): [[T]] {\n    [[T]] out = []\n    var step = max(size, 1)\n    var i = 0\n    while i < len(items) {\n        out.push(slice(items, i, min(i + step, len(items))))\n        i += step\n    }\n    return out\n}\n\n/**\n * Joins a list of arrays into one array.\n *\n * @param lists the arrays\n * @return all items, in order\n * @since 26.1\n */\npub fun flatten<T>(lists: [[T]]): [T] {\n    [T] out = []\n    for l in lists {\n        for x in l {\n            out.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Removes repeated items, keeping the first of each.\n *\n * @param items the items\n * @return the items without repeats, in order\n * @since 26.1\n */\npub fun unique<T>(items: [T]): [T] {\n    [T] out = []\n    for x in items {\n        if !out.contains(x) {\n            out.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Sorts items by a key, without changing the original array.\n *\n * The sort is stable: items with equal keys keep their order. Keys are\n * compared with `<`, so they can be numbers or strings.\n *\n * @param items the items to sort\n * @param key gives the value to sort by\n * @return a new, sorted array\n * @see sortWith\n * @since 26.1\n * @example\n *     [\"pear\", \"fig\", \"apple\"].sortBy(fun(s: string): int { return len(s) })  // [\"fig\", \"pear\", \"apple\"]\n */\npub fun sortBy<T, K>(items: [T], key: fun(T): K): [T] {\n    var keys = items.map(key)\n    var order = range(0, len(items))\n    var sorted = order.sortWith(fun(a: int, b: int): bool {\n        return keys[a] < keys[b]\n    })\n    return sorted.map(fun(i: int): T {\n        return items[i]\n    })\n}\n\n/**\n * Sorts items with a comparison, without changing the original array.\n *\n * The sort is stable: items that are not less than each other keep their\n * order.\n *\n * @param items the items to sort\n * @param less tells whether the first item belongs before the second\n * @return a new, sorted array\n * @see sortBy\n * @since 26.1\n */\npub fun sortWith<T>(items: [T], less: fun(T, T): bool): [T] {\n    if len(items) <= 1 {\n        return copy(items)\n    }\n    var mid = len(items) / 2\n    var left = sortWith(slice(items, 0, mid), less)\n    var right = sortWith(slice(items, mid, len(items)), less)\n    [T] out = []\n    var i = 0\n    var j = 0\n    while i < len(left) && j < len(right) {\n        if less(right[j], left[i]) {\n            out.push(right[j])\n            j += 1\n        } else {\n            out.push(left[i])\n            i += 1\n        }\n    }\n    while i < len(left) {\n        out.push(left[i])\n        i += 1\n    }\n    while j < len(right) {\n        out.push(right[j])\n        j += 1\n    }\n    return out\n}\n\n/**\n * Groups items by a key.\n *\n * @param items the items\n * @param key gives the group of each item; it must be a string, int, bool or enum\n * @return a map from each key to its items, in order\n * @since 26.1\n */\npub fun groupBy<T, K>(items: [T], key: fun(T): K): {K: [T]} {\n    {K: [T]} out = {}\n    for x in items {\n        var k = key(x)\n        var group = out[k]\n        if group == null {\n            out[k] = [x]\n        } else {\n            group.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Splits items into those that pass a test and those that do not.\n *\n * @param items the items\n * @param test the test\n * @return two arrays: the items that passed, then the others\n * @since 26.1\n */\npub fun partition<T>(items: [T], test: fun(T): bool): [[T]] {\n    [T] yes = []\n    [T] no = []\n    for x in items {\n        if test(x) {\n            yes.push(x)\n        } else {\n            no.push(x)\n        }\n    }\n    return [yes, no]\n}\n\n/**\n * Combines two arrays item by item.\n *\n * @param a the first array\n * @param b the second array\n * @param f gets one item of each and returns the combined value\n * @return one result per pair; as long as the shorter array\n * @since 26.1\n */\npub fun zipWith<A, B, R>(a: [A], b: [B], f: fun(A, B): R): [R] {\n    [R] out = []\n    for i in 0..min(len(a), len(b)) {\n        out.push(f(a[i], b[i]))\n    }\n    return out\n}\n\n/**\n * Finds the item with the largest key.\n *\n * @param items the items\n * @param key gives the value to compare, with `>`\n * @return the first item with the largest key, or `null` for an empty array\n * @since 26.1\n */\npub fun maxBy<T, K>(items: [T], key: fun(T): K): T? {\n    if len(items) == 0 {\n        return null\n    }\n    var best = items[0]\n    var bestKey = key(best)\n    for x in items {\n        var k = key(x)\n        if k > bestKey {\n            best = x\n            bestKey = k\n        }\n    }\n    return best\n}\n\n/**\n * Finds the item with the smallest key.\n *\n * @param items the items\n * @param key gives the value to compare, with `<`\n * @return the first item with the smallest key, or `null` for an empty array\n * @since 26.1\n */\npub fun minBy<T, K>(items: [T], key: fun(T): K): T? {\n    if len(items) == 0 {\n        return null\n    }\n    var best = items[0]\n    var bestKey = key(best)\n    for x in items {\n        var k = key(x)\n        if k < bestKey {\n            best = x\n            bestKey = k\n        }\n    }\n    return best\n}\n\n/**\n * Makes an array of whole numbers.\n *\n * @param start the first number\n * @param end the number to stop before\n * @return `start`, `start + 1`, ... up to `end - 1`; empty when `end <= start`\n * @since 26.1\n */\npub fun range(start: int, end: int): [int] {\n    [int] out = []\n    for i in start..end {\n        out.push(i)\n    }\n    return out\n}\n\n/**\n * Makes an array with the same value several times.\n *\n * @param value the value\n * @param n how many times\n * @return `n` copies of `value`\n * @since 26.1\n */\npub fun fill<T>(value: T, n: int): [T] {\n    [T] out = []\n    for i in 0..n {\n        out.push(value)\n    }\n    return out\n}\n"
