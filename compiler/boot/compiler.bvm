    str "collections"
    str "/**\n * A collection of unique values, kept in the order they were first added.\n *\n * The values must be strings, ints, bools or enums.\n *\n * @since 26.1\n * @example\n *     var seen = new Set<string>()\n *     seen.add(\"a\")\n *     seen.add(\"a\")\n *     print(seen.size())  // 1\n */\npub def struct Set<T>() {\n    {T: bool} entries = {}\n\n    /**\n     * Adds a value.\n     *\n     * @param value the value to add\n     * @return `true` if it was not in the set yet\n     */\n    fun add(value: T): bool {\n        if has(entries, value) {\n            return false\n        }\n        entries[value] = true\n        return true\n    }\n\n    /**\n     * Adds every value of an array.\n     *\n     * @param values the values to add\n     */\n    fun addAll(values: [T]) {\n        for v in values {\n            entries[v] = true\n        }\n    }\n\n    /**\n     * Removes a value.\n     *\n     * @param value the value to remove\n     * @return `true` if it was in the set\n     */\n    fun delete(value: T): bool {\n        if !has(entries, value) {\n            return false\n        }\n        remove(entries, value)\n        return true\n    }\n\n    /**\n     * Tells whether a value is in the set.\n     *\n     * @param value the value to look for\n     * @return `true` if it is in the set\n     */\n    fun includes(value: T): bool {\n        return has(entries, value)\n    }\n\n    /**\n     * Counts the values.\n     *\n     * @return the number of values\n     */\n    fun size(): int {\n        return len(entries)\n    }\n\n    /**\n     * Lists the values.\n     *\n     * @return the values, in the order they were added\n     */\n    fun items(): [T] {\n        return keys(entries)\n    }\n\n    /**\n     * Removes every value.\n     */\n    fun clearAll() {\n        entries = {}\n    }\n\n    /**\n     * Makes a set with the values of this set and another one.\n     *\n     * @param other the other set\n     * @return a new set\n     */\n    fun union(other: Set<T>): Set<T> {\n        var out = new Set<T>()\n        out.addAll(items())\n        out.addAll(other.items())\n        return out\n    }\n\n    /**\n     * Makes a set with the values that are in both sets.\n     *\n     * @param other the other set\n     * @return a new set\n     */\n    fun intersect(other: Set<T>): Set<T> {\n        var out = new Set<T>()\n        for v in items() {\n            if other.includes(v) {\n                out.add(v)\n            }\n        }\n        return out\n    }\n\n    /**\n     * Makes a set with the values of this set that are not in another one.\n     *\n     * @param other the other set\n     * @return a new set\n     */\n    fun difference(other: Set<T>): Set<T> {\n        var out = new Set<T>()\n        for v in items() {\n            if !other.includes(v) {\n                out.add(v)\n            }\n        }\n        return out\n    }\n}\n\n/**\n * Makes a set from the values of an array.\n *\n * @param values the values\n * @return a set with each value once\n * @since 26.1\n */\npub fun setOf<T>(values: [T]): Set<T> {\n    var s = new Set<T>()\n    s.addAll(values)\n    return s\n}\n\n/**\n * A first-in, first-out queue: values come out in the order they went in.\n *\n * Adding and taking values are fast, even for long queues.\n *\n * @since 26.1\n * @example\n *     var q = new Queue<int>()\n *     q.enqueue(1)\n *     q.enqueue(2)\n *     print(q.dequeue())  // 1\n */\npub def struct Queue<T>() {\n    [T] items = []\n    int head = 0\n\n    /**\n     * Adds a value at the back.\n     *\n     * @param value the value to add\n     */\n    fun enqueue(value: T) {\n        items.push(value)\n    }\n\n    /**\n     * Takes the value at the front.\n     *\n     * @return the oldest value, or `null` if the queue is empty\n     */\n    fun dequeue(): T? {\n        if head >= len(items) {\n            return null\n        }\n        var v = items[head]\n        head += 1\n        if head > 32 && head * 2 > len(items) {\n            items = slice(items, head, len(items))\n            head = 0\n        }\n        return v\n    }\n\n    /**\n     * Looks at the value at the front without taking it.\n     *\n     * @return the oldest value, or `null` if the queue is empty\n     */\n    fun peek(): T? {\n        if head >= len(items) {\n            return null\n        }\n        return items[head]\n    }\n\n    /**\n     * Counts the values.\n     *\n     * @return the number of values waiting\n     */\n    fun size(): int {\n        return len(items) - head\n    }\n\n    /**\n     * Tells whether the queue has no values.\n     *\n     * @return `true` if it is empty\n     */\n    fun isEmpty(): bool {\n        return head >= len(items)\n    }\n}\n\n/**\n * A last-in, first-out stack: the value added last comes out first.\n *\n * @since 26.1\n */\npub def struct Stack<T>() {\n    [T] items = []\n\n    /**\n     * Adds a value on top.\n     *\n     * @param value the value to add\n     */\n    fun push(value: T) {\n        items.push(value)\n    }\n\n    /**\n     * Takes the value on top.\n     *\n     * @return the newest value, or `null` if the stack is empty\n     */\n    fun pop(): T? {\n        if len(items) == 0 {\n            return null\n        }\n        return items.pop()\n    }\n\n    /**\n     * Looks at the value on top without taking it.\n     *\n     * @return the newest value, or `null` if the stack is empty\n     */\n    fun peek(): T? {\n        if len(items) == 0 {\n            return null\n        }\n        return items[len(items) - 1]\n    }\n\n    /**\n     * Counts the values.\n     *\n     * @return the number of values\n     */\n    fun size(): int {\n        return len(items)\n    }\n\n    /**\n     * Tells whether the stack has no values.\n     *\n     * @return `true` if it is empty\n     */\n    fun isEmpty(): bool {\n        return len(items) == 0\n    }\n}\n\n/**\n * Counts how often each value appears.\n *\n * The values must be strings, ints, bools or enums.\n *\n * @since 26.1\n * @example\n *     var c = new Counter<string>()\n *     c.addAll([\"a\", \"b\", \"a\"])\n *     print(c.count(\"a\"))  // 2\n */\npub def struct Counter<T>() {\n    {T: int} counts = {}\n\n    /**\n     * Counts one more of a value.\n     *\n     * @param value the value\n     */\n    fun add(value: T) {\n        counts[value] = (counts[value] ?? 0) + 1\n    }\n\n    /**\n     * Counts every value of an array.\n     *\n     * @param values the values\n     */\n    fun addAll(values: [T]) {\n        for v in values {\n            add(v)\n        }\n    }\n\n    /**\n     * Tells how often a value was counted.\n     *\n     * @param value the value\n     * @return its count, `0` if it never appeared\n     */\n    fun count(value: T): int {\n        return counts[value] ?? 0\n    }\n\n    /**\n     * Lists the values that appear most often.\n     *\n     * @param n how many values to return\n     * @return at most `n` values, the most frequent first; ties keep the order they first appeared in\n     */\n    fun mostCommon(n: int): [T] {\n        [T] out = []\n        var vs: [T] = keys(counts)\n        var used: {T: bool} = {}\n        while len(out) < n && len(out) < len(vs) {\n            var best = vs[0]\n            var bestCount = -1\n            for v in vs {\n                var c = counts[v]!!\n                if !has(used, v) && c > bestCount {\n                    best = v\n                    bestCount = c\n                }\n            }\n            used[best] = true\n            out.push(best)\n        }\n        return out\n    }\n\n    /**\n     * Counts the different values.\n     *\n     * @return the number of distinct values\n     */\n    fun size(): int {\n        return len(counts)\n    }\n}\n"
