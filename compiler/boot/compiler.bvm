string "date"
string "/**\n * Formats a number with at least two digits, adding a leading zero.\n *\n * @param n the number, usually a month or a day\n * @return the number as text, for example `\"07\"` for `7`\n * @since 26.1\n */\npriv fun pad2(n: int): string {\n    if (n < 10) {\n        return \"0${n}\"\n    }\n    return toString(n)\n}\n\n/**\n * Converts a calendar date to the number of days since 1970-01-01.\n *\n * Uses the proleptic Gregorian calendar, so it works for any year,\n * including years before 1970 (negative results) and before year 1.\n * A day past the end of the month simply counts on into the next month.\n *\n * @param year the year\n * @param month the month, from 1 to 12\n * @param day the day of the month\n * @return the number of days since 1970-01-01, negative for earlier dates\n * @see civilFromDays\n * @since 26.1\n */\npriv fun daysFromCivil(year: int, month: int, day: int): int {\n    var y = year\n    if (month <= 2) {\n        y -= 1\n    }\n    var era = y / 400\n    if (y < 0) {\n        era = (y - 399) / 400\n    }\n    var yoe = y - era * 400\n    var mp = month + 9\n    if (month > 2) {\n        mp = month - 3\n    }\n    var doy = (153 * mp + 2) / 5 + day - 1\n    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy\n    return era * 146097 + doe - 719468\n}\n\n/**\n * Converts a number of days since 1970-01-01 to a calendar date.\n *\n * This is the inverse of {@link daysFromCivil} and always returns a\n * valid date.\n *\n * @param days the number of days since 1970-01-01, negative for earlier dates\n * @return the date that many days after 1970-01-01\n * @see daysFromCivil\n * @since 26.1\n */\npriv fun civilFromDays(days: int): Date {\n    var z = days + 719468\n    var era = z / 146097\n    if (z < 0) {\n        era = (z - 146096) / 146097\n    }\n    var doe = z - era * 146097\n    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365\n    var y = yoe + era * 400\n    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n    var mp = (5 * doy + 2) / 153\n    var d = doy - (153 * mp + 2) / 5 + 1\n    var m = mp + 3\n    if (mp >= 10) {\n        m = mp - 9\n    }\n    if (m <= 2) {\n        y += 1\n    }\n    return new Date(y, m, d)\n}\n\n/**\n * A calendar date without a time of day.\n *\n * Dates use the proleptic Gregorian calendar. The constructor does not\n * validate its arguments: `new Date(2024, 2, 30)` is accepted, and the\n * day arithmetic such as {@link Date.addDays} normalizes it to\n * 2024-03-01.\n *\n * @param year the year, for example `2024`\n * @param month the month, from 1 to 12\n * @param day the day of the month, from 1 to 31\n * @see Date.create\n * @since 26.1\n * @example\n *     var d = new Date(2024, 3, 5)\n *     d.format()  // \"2024-03-05\"\n */\npub def struct Date(year: int, month: int, day: int) {\n    /**\n     * Returns today's date in the local time zone.\n     *\n     * @return today's date\n     * @see Date.today\n     * @since 26.1\n     * @example\n     *     var today = Date.now()\n     *     print(\"Year: ${today.year}\")\n     */\n    static fun now(): Date {\n        var t = __localTime()\n        return new Date(t[0], t[1], t[2])\n    }\n\n    /**\n     * Returns today's date in the local time zone as `YYYY-MM-DD` text.\n     *\n     * @return today's date, for example `\"2024-03-05\"`\n     * @see Date.now\n     * @see Date.formatDate\n     * @since 26.1\n     * @example\n     *     print(\"Today is \" + Date.today())\n     */\n    static fun today(): string {\n        return Date.formatDate(Date.now())\n    }\n\n    /**\n     * Creates a date from a year, a month and a day.\n     *\n     * Same as {@link Date.create}.\n     *\n     * @param year the year, for example `2024`\n     * @param month the month, from 1 to 12\n     * @param day the day of the month, from 1 to 31\n     * @return the new date, not validated\n     * @see Date.create\n     * @since 26.1\n     */\n    static fun createDate(year: int, month: int, day: int): Date {\n        return new Date(year, month, day)\n    }\n\n    /**\n     * Creates a date from a year, a month and a day.\n     *\n     * The arguments are not validated, see {@link Date}.\n     *\n     * @param year the year, for example `2024`\n     * @param month the month, from 1 to 12\n     * @param day the day of the month, from 1 to 31\n     * @return the new date\n     * @since 26.1\n     * @example\n     *     Date.create(1990, 5, 15).format()  // \"1990-05-15\"\n     */\n    static fun create(year: int, month: int, day: int): Date {\n        return new Date(year, month, day)\n    }\n\n    /**\n     * Formats a date as `YYYY-MM-DD` text.\n     *\n     * The month and the day always have two digits; the year is written\n     * as is, without padding.\n     *\n     * @param date the date to format\n     * @return the formatted date, for example `\"2024-03-05\"`\n     * @see Date.format\n     * @see Date.parse\n     * @since 26.1\n     * @example\n     *     Date.formatDate(Date.create(2024, 3, 5))  // \"2024-03-05\"\n     */\n    static fun formatDate(date: Date): string {\n        return \"${date.year}-${pad2(date.month)}-${pad2(date.day)}\"\n    }\n\n    /**\n     * Parses a date written as `YYYY-MM-DD`.\n     *\n     * Whitespace around the text is ignored and the parts do not need\n     * leading zeros, so `\"2024-3-5\"` also works. The month and the day are\n     * not range-checked. Negative years cannot be parsed.\n     *\n     * @param text the text to parse, for example `\"2024-03-05\"`\n     * @return the parsed date\n     * @throws when the text is not three whole numbers separated by `-`\n     * @see Date.formatDate\n     * @since 26.1\n     * @example\n     *     var d = Date.parse(\"2024-03-05\")\n     *     d.month  // 3\n     */\n    static fun parse(text: string): Date {\n        var parts = split(trim(text), \"-\")\n        if (len(parts) != 3) {\n            panic(\"invalid date \\\"${text}\\\", expected YYYY-MM-DD\")\n        }\n        return new Date(toInt(parts[0]), toInt(parts[1]), toInt(parts[2]))\n    }\n\n    /**\n     * Returns the current year in the local time zone.\n     *\n     * @return the current year, for example `2024`\n     * @since 26.1\n     */\n    static fun currentYear(): int {\n        return __localTime()[0]\n    }\n\n    /**\n     * Returns the current month in the local time zone.\n     *\n     * @return the current month, from 1 to 12\n     * @since 26.1\n     */\n    static fun currentMonth(): int {\n        return __localTime()[1]\n    }\n\n    /**\n     * Returns the current day of the month in the local time zone.\n     *\n     * @return the current day of the month, from 1 to 31\n     * @since 26.1\n     */\n    static fun currentDay(): int {\n        return __localTime()[2]\n    }\n\n    /**\n     * Tells whether a year is a leap year in the Gregorian calendar.\n     *\n     * A year is a leap year when it is divisible by 4, except for years\n     * divisible by 100 that are not divisible by 400.\n     *\n     * @param year the year, for example `2024`\n     * @return `true` if the year has 366 days\n     * @since 26.1\n     * @example\n     *     Date.isLeapYear(2024)  // true\n     *     Date.isLeapYear(1900)  // false\n     *     Date.isLeapYear(2000)  // true\n     */\n    static fun isLeapYear(year: int): bool {\n        return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0\n    }\n\n    /**\n     * Returns the number of days in a month.\n     *\n     * February has 29 days in leap years, see {@link Date.isLeapYear}.\n     *\n     * @param year the year, for example `2024`\n     * @param month the month, from 1 to 12\n     * @return the number of days, from 28 to 31\n     * @see Date.isLeapYear\n     * @since 26.1\n     * @example\n     *     Date.daysInMonth(2024, 2)  // 29\n     *     Date.daysInMonth(2023, 4)  // 30\n     */\n    static fun daysInMonth(year: int, month: int): int {\n        if (month == 2) {\n            if (Date.isLeapYear(year)) {\n                return 29\n            }\n            return 28\n        }\n        if (month == 4 || month == 6 || month == 9 || month == 11) {\n            return 30\n        }\n        return 31\n    }\n\n    /**\n     * Returns the day of the week of a date as a number.\n     *\n     * The week starts on Saturday: 0 is Saturday, 1 is Sunday, 2 is Monday\n     * and so on up to 6 for Friday.\n     *\n     * @param date the date\n     * @return the day of the week, from 0 (Saturday) to 6 (Friday)\n     * @see Date.dayName\n     * @since 26.1\n     * @example\n     *     Date.dayOfWeek(Date.create(2024, 1, 1))  // 2, a Monday\n     */\n    static fun dayOfWeek(date: Date): int {\n        var d = daysFromCivil(date.year, date.month, date.day)\n        return ((d + 5) % 7 + 7) % 7\n    }\n\n    /**\n     * Returns the English name of the day of the week of a date.\n     *\n     * @param date the date\n     * @return the name of the day, from `\"Monday\"` to `\"Sunday\"`\n     * @see Date.dayOfWeek\n     * @since 26.1\n     * @example\n     *     Date.dayName(Date.create(2024, 1, 1))  // \"Monday\"\n     */\n    static fun dayName(date: Date): string {\n        var names = [\"Saturday\", \"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"]\n        return names[Date.dayOfWeek(date)]\n    }\n\n    /**\n     * Returns the date a number of days after another date.\n     *\n     * Month and year boundaries and leap years are handled; a negative\n     * number of days goes back in time.\n     *\n     * @param date the start date\n     * @param days the number of days to add, may be negative\n     * @return a new date; the given date is not changed\n     * @see Date.subtractDays\n     * @see Date.plusDays\n     * @since 26.1\n     * @example\n     *     Date.addDays(Date.create(2024, 2, 28), 2).format()  // \"2024-03-01\"\n     */\n    static fun addDays(date: Date, days: int): Date {\n        return civilFromDays(daysFromCivil(date.year, date.month, date.day) + days)\n    }\n\n    /**\n     * Returns the date a number of days before another date.\n     *\n     * @param date the start date\n     * @param days the number of days to subtract, may be negative\n     * @return a new date; the given date is not changed\n     * @see Date.addDays\n     * @since 26.1\n     * @example\n     *     Date.subtractDays(Date.create(2024, 1, 1), 1).format()  // \"2023-12-31\"\n     */\n    static fun subtractDays(date: Date, days: int): Date {\n        return civilFromDays(daysFromCivil(date.year, date.month, date.day) - days)\n    }\n\n    /**\n     * Returns the number of days from one date to another.\n     *\n     * @param from the start date\n     * @param to the end date\n     * @return the number of days, negative when `to` is before `from`\n     * @since 26.1\n     * @example\n     *     Date.daysBetween(Date.create(2024, 1, 1), Date.create(2025, 1, 1))  // 366\n     */\n    static fun daysBetween(from: Date, to: Date): int {\n        return daysFromCivil(to.year, to.month, to.day) - daysFromCivil(from.year, from.month, from.day)\n    }\n\n    /**\n     * Formats this date as `YYYY-MM-DD` text.\n     *\n     * @return the formatted date, for example `\"2024-03-05\"`\n     * @see Date.formatDate\n     * @since 26.1\n     * @example\n     *     Date.create(2024, 3, 5).format()  // \"2024-03-05\"\n     */\n    fun format(): string {\n        return Date.formatDate(self)\n    }\n\n    /**\n     * Returns the date a number of days after this date.\n     *\n     * @param days the number of days to add, may be negative\n     * @return a new date; this date is not changed\n     * @see Date.addDays\n     * @since 26.1\n     * @example\n     *     Date.create(2024, 12, 31).plusDays(1).format()  // \"2025-01-01\"\n     */\n    fun plusDays(days: int): Date {\n        return Date.addDays(self, days)\n    }\n\n    /**\n     * Tells whether this date is before another date.\n     *\n     * @param other the date to compare with\n     * @return `true` if this date is strictly earlier, `false` for the same day\n     * @see Date.isAfter\n     * @since 26.1\n     * @example\n     *     Date.create(2024, 1, 1).isBefore(Date.create(2024, 1, 2))  // true\n     */\n    fun isBefore(other: Date): bool {\n        return Date.daysBetween(self, other) > 0\n    }\n\n    /**\n     * Tells whether this date is after another date.\n     *\n     * @param other the date to compare with\n     * @return `true` if this date is strictly later, `false` for the same day\n     * @see Date.isBefore\n     * @since 26.1\n     * @example\n     *     Date.create(2024, 1, 1).isAfter(Date.create(2024, 1, 2))  // false\n     */\n    fun isAfter(other: Date): bool {\n        return Date.daysBetween(self, other) < 0\n    }\n}\n"
string "time"
string "/**\n * Formats a number with leading zeros up to a given width.\n *\n * @param n the number, not negative\n * @param width the minimum number of digits\n * @return the number as text, for example `\"007\"` for `pad(7, 3)`\n * @since 26.1\n */\npriv fun pad(n: int, width: int): string {\n    var s = toString(n)\n    while (len(s) < width) {\n        s = \"0\" + s\n    }\n    return s\n}\n\n/**\n * A time of day or a duration, with millisecond precision.\n *\n * The fields are not validated or wrapped around: hours can go past 23,\n * which makes `Time` usable for durations as well.\n *\n * @param hours the hours, usually from 0 to 23\n * @param minutes the minutes, from 0 to 59\n * @param seconds the seconds, from 0 to 59\n * @param milliseconds the milliseconds, from 0 to 999\n * @see Time.create\n * @since 26.1\n * @example\n *     var t = new Time(9, 5, 30, 250)\n *     t.formatWithMs()  // \"09:05:30.250\"\n */\npub def struct Time(hours: int, minutes: int, seconds: int, milliseconds: int) {\n    /**\n     * Creates a time from its parts.\n     *\n     * @param hours the hours, usually from 0 to 23\n     * @param minutes the minutes, from 0 to 59\n     * @param seconds the seconds, from 0 to 59\n     * @param milliseconds the milliseconds, from 0 to 999\n     * @return the new time, not validated\n     * @see createTime\n     * @since 26.1\n     * @example\n     *     Time.create(14, 30, 0, 0).format()  // \"14:30:00\"\n     */\n    static fun create(hours: int, minutes: int, seconds: int, milliseconds: int): Time {\n        return new Time(hours, minutes, seconds, milliseconds)\n    }\n\n    /**\n     * Returns the current time of day in the local time zone.\n     *\n     * @return the current time\n     * @see currentTime\n     * @since 26.1\n     * @example\n     *     print(\"It is \" + Time.now().format())\n     */\n    static fun now(): Time {\n        var t = __localTime()\n        return new Time(t[3], t[4], t[5], t[6])\n    }\n\n    /**\n     * Converts a number of milliseconds to a time.\n     *\n     * The milliseconds are split into hours, minutes, seconds and\n     * milliseconds. Hours are not wrapped at 24. A negative number gives negative\n     * fields.\n     *\n     * @param ms the number of milliseconds, not negative\n     * @return the time\n     * @see Time.toMilliseconds\n     * @since 26.1\n     * @example\n     *     Time.fromMilliseconds(3723004).formatWithMs()  // \"01:02:03.004\"\n     */\n    static fun fromMilliseconds(ms: int): Time {\n        var rest = ms\n        var h = rest / 3600000\n        rest -= h * 3600000\n        var m = rest / 60000\n        rest -= m * 60000\n        var s = rest / 1000\n        rest -= s * 1000\n        return new Time(h, m, s, rest)\n    }\n\n    /**\n     * Converts a number of seconds to a time.\n     *\n     * The seconds are rounded to the nearest millisecond.\n     *\n     * @param seconds the number of seconds, not negative\n     * @return the time\n     * @see Time.toSeconds\n     * @since 26.1\n     * @example\n     *     Time.fromSeconds(90.5).formatWithMs()  // \"00:01:30.500\"\n     */\n    static fun fromSeconds(seconds: float): Time {\n        return Time.fromMilliseconds(round(seconds * 1000.0))\n    }\n\n    /**\n     * Parses a time written as `H:MM:SS` with optional milliseconds.\n     *\n     * Accepts `H`, `H:MM` or `H:MM:SS`, optionally followed by a fraction\n     * of a second such as `.5`, `.25` or `.250`. Missing parts are 0, and\n     * the parts do not need leading zeros. Nothing is range-checked.\n     *\n     * @param text the text to parse, for example `\"09:05:30.250\"`\n     * @return the parsed time\n     * @throws when a part is not a whole number\n     * @see Time.format\n     * @see parseTime\n     * @since 26.1\n     * @example\n     *     Time.parse(\"1:02:03.5\").formatWithMs()  // \"01:02:03.500\"\n     */\n    static fun parse(text: string): Time {\n        var main = text\n        var ms = 0\n        var dot = indexOf(text, \".\")\n        if (dot >= 0) {\n            main = substring(text, 0, dot)\n            var frac = substring(text, dot + 1)\n            ms = toInt(frac)\n            if (len(frac) == 1) {\n                ms *= 100\n            } else if (len(frac) == 2) {\n                ms *= 10\n            }\n        }\n        var parts = split(main, \":\")\n        var h = 0\n        var m = 0\n        var s = 0\n        if (len(parts) >= 1) {\n            h = toInt(parts[0])\n        }\n        if (len(parts) >= 2) {\n            m = toInt(parts[1])\n        }\n        if (len(parts) >= 3) {\n            s = toInt(parts[2])\n        }\n        return new Time(h, m, s, ms)\n    }\n\n    /**\n     * Returns this time as a total number of milliseconds.\n     *\n     * @return the total number of milliseconds\n     * @see Time.fromMilliseconds\n     * @since 26.1\n     * @example\n     *     Time.create(0, 1, 30, 0).toMilliseconds()  // 90000\n     */\n    fun toMilliseconds(): int {\n        return self.hours * 3600000 + self.minutes * 60000 + self.seconds * 1000 + self.milliseconds\n    }\n\n    /**\n     * Returns this time as a total number of seconds.\n     *\n     * @return the total number of seconds, including the milliseconds as a fraction\n     * @see Time.fromSeconds\n     * @since 26.1\n     * @example\n     *     Time.create(0, 1, 30, 500).toSeconds()  // 90.5\n     */\n    fun toSeconds(): float {\n        return self.toMilliseconds() / 1000.0\n    }\n\n    /**\n     * Adds another time to this one.\n     *\n     * The result is not wrapped at 24 hours.\n     *\n     * @param other the time to add\n     * @return a new time; this time is not changed\n     * @see Time.subtract\n     * @since 26.1\n     * @example\n     *     Time.create(1, 45, 0, 0).add(Time.create(0, 30, 0, 0)).format()  // \"02:15:00\"\n     */\n    fun add(other: Time): Time {\n        return Time.fromMilliseconds(self.toMilliseconds() + other.toMilliseconds())\n    }\n\n    /**\n     * Subtracts another time from this one.\n     *\n     * If `other` is longer than this time, the result has negative fields,\n     * see {@link Time.fromMilliseconds}.\n     *\n     * @param other the time to subtract\n     * @return a new time; this time is not changed\n     * @see Time.add\n     * @since 26.1\n     * @example\n     *     Time.create(2, 15, 0, 0).subtract(Time.create(0, 30, 0, 0)).format()  // \"01:45:00\"\n     */\n    fun subtract(other: Time): Time {\n        return Time.fromMilliseconds(self.toMilliseconds() - other.toMilliseconds())\n    }\n\n    /**\n     * Formats this time as `HH:MM:SS` text.\n     *\n     * Each field has at least two digits. The milliseconds are left out,\n     * see {@link Time.formatWithMs}.\n     *\n     * @return the formatted time, for example `\"09:05:30\"`\n     * @see Time.formatWithMs\n     * @since 26.1\n     * @example\n     *     Time.create(9, 5, 30, 250).format()  // \"09:05:30\"\n     */\n    fun format(): string {\n        return \"${pad(self.hours, 2)}:${pad(self.minutes, 2)}:${pad(self.seconds, 2)}\"\n    }\n\n    /**\n     * Formats this time as `HH:MM:SS.mmm` text.\n     *\n     * @return the formatted time, for example `\"09:05:30.250\"`\n     * @see Time.format\n     * @since 26.1\n     * @example\n     *     Time.create(9, 5, 30, 7).formatWithMs()  // \"09:05:30.007\"\n     */\n    fun formatWithMs(): string {\n        return \"${self.format()}.${pad(self.milliseconds, 3)}\"\n    }\n}\n\n/**\n * Creates a time from its parts.\n *\n * Same as {@link Time.create}.\n *\n * @param hours the hours, usually from 0 to 23\n * @param minutes the minutes, from 0 to 59\n * @param seconds the seconds, from 0 to 59\n * @param milliseconds the milliseconds, from 0 to 999\n * @return the new time, not validated\n * @see Time.create\n * @since 26.1\n */\npub fun createTime(hours: int, minutes: int, seconds: int, milliseconds: int): Time {\n    return Time.create(hours, minutes, seconds, milliseconds)\n}\n\n/**\n * Formats a number of seconds as `HH:MM:SS` text.\n *\n * The seconds are rounded to the nearest millisecond, and the\n * milliseconds are then left out.\n *\n * @param totalSeconds the number of seconds, not negative\n * @return the formatted time, for example `\"01:02:05\"`\n * @see parseTime\n * @since 26.1\n * @example\n *     formatTime(3725.0)  // \"01:02:05\"\n */\npub fun formatTime(totalSeconds: float): string {\n    return Time.fromSeconds(totalSeconds).format()\n}\n\n/**\n * Parses a time written as `H:MM:SS` and returns it in seconds.\n *\n * Accepts the same forms as {@link Time.parse}.\n *\n * @param text the text to parse, for example `\"01:02:05.5\"`\n * @return the total number of seconds\n * @throws when a part is not a whole number\n * @see formatTime\n * @since 26.1\n * @example\n *     parseTime(\"01:02:05.5\")  // 3725.5\n */\npub fun parseTime(text: string): float {\n    return Time.parse(text).toSeconds()\n}\n\n/**\n * Returns the current local time of day as `HH:MM:SS` text.\n *\n * @return the current time, for example `\"14:30:00\"`\n * @see Time.now\n * @since 26.1\n * @example\n *     print(\"It is \" + currentTime())\n */\npub fun currentTime(): string {\n    return Time.now().format()\n}\n\n/**\n * Converts hours to minutes.\n *\n * @param hours the number of hours\n * @return the number of minutes\n * @see minutesToHours\n * @since 26.1\n * @example\n *     hoursToMinutes(1.5)  // 90.0\n */\npub fun hoursToMinutes(hours: float): float {\n    return hours * 60.0\n}\n\n/**\n * Converts minutes to hours.\n *\n * @param minutes the number of minutes\n * @return the number of hours\n * @see hoursToMinutes\n * @since 26.1\n * @example\n *     minutesToHours(90.0)  // 1.5\n */\npub fun minutesToHours(minutes: float): float {\n    return minutes / 60.0\n}\n\n/**\n * Converts hours to seconds.\n *\n * @param hours the number of hours\n * @return the number of seconds\n * @see secondsToHours\n * @since 26.1\n * @example\n *     hoursToSeconds(2.0)  // 7200.0\n */\npub fun hoursToSeconds(hours: float): float {\n    return hours * 3600.0\n}\n\n/**\n * Converts seconds to hours.\n *\n * @param seconds the number of seconds\n * @return the number of hours\n * @see hoursToSeconds\n * @since 26.1\n * @example\n *     secondsToHours(5400.0)  // 1.5\n */\npub fun secondsToHours(seconds: float): float {\n    return seconds / 3600.0\n}\n\n/**\n * Converts minutes to seconds.\n *\n * @param minutes the number of minutes\n * @return the number of seconds\n * @see secondsToMinutes\n * @since 26.1\n * @example\n *     minutesToSeconds(2.5)  // 150.0\n */\npub fun minutesToSeconds(minutes: float): float {\n    return minutes * 60.0\n}\n\n/**\n * Converts seconds to minutes.\n *\n * @param seconds the number of seconds\n * @return the number of minutes\n * @see minutesToSeconds\n * @since 26.1\n * @example\n *     secondsToMinutes(150.0)  // 2.5\n */\npub fun secondsToMinutes(seconds: float): float {\n    return seconds / 60.0\n}\n\n/**\n * Converts seconds to milliseconds.\n *\n * @param seconds the number of seconds\n * @return the number of milliseconds\n * @see msToSeconds\n * @since 26.1\n * @example\n *     secondsToMs(1.25)  // 1250.0\n */\npub fun secondsToMs(seconds: float): float {\n    return seconds * 1000.0\n}\n\n/**\n * Converts milliseconds to seconds.\n *\n * @param ms the number of milliseconds\n * @return the number of seconds\n * @see secondsToMs\n * @since 26.1\n * @example\n *     msToSeconds(1250.0)  // 1.25\n */\npub fun msToSeconds(ms: float): float {\n    return ms / 1000.0\n}\n"
string "http"
string "import \"json\"\n\n/**\n * The response to an HTTP request.\n *\n * @param statusCode the HTTP status code, for example `200`, or `0` if the request failed\n * @param body the response body, or the error message if `statusCode` is `0`\n * @param headers the response header lines in the form `Name: value`, without the status line\n * @see HTTP.request\n * @since 26.1\n */\npub def type HTTPResponse {\n    int statusCode\n    string body\n    [string] headers\n}\n\n/**\n * The header lines sent with every request.\n *\n * Starts with a `BurnLang/26.1` user agent and an `Accept` header that\n * accepts any content type. Change it with {@link HTTP.setHeaders} and\n * {@link HTTP.addHeader}.\n *\n * @since 26.1\n */\npriv var defaultHeaders: [string] = [\"User-Agent: BurnLang/26.1\", \"Accept: */*\"]\n\n/**\n * A simple HTTP client.\n *\n * `http://` URLs are handled by the runtime itself, `https://` URLs are\n * sent through the `curl` command, which must be installed. Redirects are\n * not followed. Requests never stop the program: a failure is reported as\n * a response with status code `0`.\n *\n * @see HTTPResponse\n * @since 26.1\n * @example\n *     var response = HTTP.get(\"https://example.com\")\n *     if (response.statusCode == 200) {\n *         print(response.body)\n *     }\n */\npub def static struct HTTP {\n    /**\n     * Sends an HTTP request with the default headers.\n     *\n     * @param method the HTTP method, for example `\"GET\"` or `\"POST\"`\n     * @param url the `http://` or `https://` URL to request\n     * @param body the request body, or `\"\"` to send none\n     * @return the response, with status code `0` and the error message as body if the request failed\n     * @see HTTP.get\n     * @see HTTP.post\n     * @since 26.1\n     * @example\n     *     var response = HTTP.request(\"OPTIONS\", \"https://example.com\", \"\")\n     *     print(response.statusCode)\n     */\n    static fun request(method: string, url: string, body: string): HTTPResponse {\n        var raw = __httpRequest(method, url, body, defaultHeaders)\n        var headers: [string] = []\n        for line in split(raw[2], \"\\n\") {\n            if (len(trim(line)) > 0) {\n                push(headers, line)\n            }\n        }\n        return HTTPResponse { statusCode: toInt(raw[0]), body: raw[1], headers: headers }\n    }\n\n    /**\n     * Sends a `GET` request.\n     *\n     * @param url the URL to request\n     * @return the response\n     * @see HTTP.request\n     * @since 26.1\n     * @example\n     *     var response = HTTP.get(\"https://example.com\")\n     *     print(response.body)\n     */\n    static fun get(url: string): HTTPResponse {\n        return HTTP.request(\"GET\", url, \"\")\n    }\n\n    /**\n     * Sends a `POST` request with a body.\n     *\n     * @param url the URL to request\n     * @param body the request body\n     * @return the response\n     * @see HTTP.request\n     * @since 26.1\n     * @example\n     *     HTTP.addHeader(\"Content-Type: application/json\")\n     *     var response = HTTP.post(\"https://example.com/items\", JSON.stringify({\"name\": \"Ada\"}))\n     */\n    static fun post(url: string, body: string): HTTPResponse {\n        return HTTP.request(\"POST\", url, body)\n    }\n\n    /**\n     * Sends a `PUT` request with a body.\n     *\n     * @param url the URL to request\n     * @param body the request body\n     * @return the response\n     * @see HTTP.request\n     * @since 26.1\n     */\n    static fun put(url: string, body: string): HTTPResponse {\n        return HTTP.request(\"PUT\", url, body)\n    }\n\n    /**\n     * Sends a `PATCH` request with a body.\n     *\n     * @param url the URL to request\n     * @param body the request body\n     * @return the response\n     * @see HTTP.request\n     * @since 26.1\n     */\n    static fun patch(url: string, body: string): HTTPResponse {\n        return HTTP.request(\"PATCH\", url, body)\n    }\n\n    /**\n     * Sends a `DELETE` request.\n     *\n     * @param url the URL to request\n     * @return the response\n     * @see HTTP.request\n     * @since 26.1\n     */\n    static fun delete(url: string): HTTPResponse {\n        return HTTP.request(\"DELETE\", url, \"\")\n    }\n\n    /**\n     * Replaces the header lines sent with every request.\n     *\n     * The list is copied, so changing it later does not affect requests.\n     *\n     * @param headers the header lines in the form `Name: value`\n     * @return always `true`\n     * @see HTTP.addHeader\n     * @since 26.1\n     * @example\n     *     HTTP.setHeaders([\"User-Agent: my-app/1.0\", \"Accept: application/json\"])\n     */\n    static fun setHeaders(headers: [string]): bool {\n        defaultHeaders = copy(headers)\n        return true\n    }\n\n    /**\n     * Adds a header line to the headers sent with every request.\n     *\n     * @param header the header line in the form `Name: value`\n     * @see HTTP.setHeaders\n     * @since 26.1\n     * @example\n     *     HTTP.addHeader(\"Authorization: Bearer my-token\")\n     */\n    static fun addHeader(header: string) {\n        push(defaultHeaders, header)\n    }\n\n    /**\n     * Returns the value of a response header.\n     *\n     * The name is matched without regard to case, and the first matching\n     * header wins.\n     *\n     * @param response the response to search\n     * @param name the header name, for example `\"Content-Type\"`\n     * @return the trimmed header value, or `\"\"` if the response has no such header\n     * @since 26.1\n     * @example\n     *     var response = HTTP.get(\"https://example.com\")\n     *     var contentType = HTTP.getHeader(response, \"content-type\")\n     */\n    static fun getHeader(response: HTTPResponse, name: string): string {\n        var wanted = lower(name)\n        for header in response.headers {\n            var i = indexOf(header, \":\")\n            if (i > 0 && lower(trim(substring(header, 0, i))) == wanted) {\n                return trim(substring(header, i + 1))\n            }\n        }\n        return \"\"\n    }\n\n    /**\n     * Parses a response body as JSON.\n     *\n     * Same as {@link JSON.parse}.\n     *\n     * @param body the JSON text, usually `response.body`\n     * @return the parsed value\n     * @throws when the body is not valid JSON\n     * @see JSON.parse\n     * @since 26.1\n     * @example\n     *     var response = HTTP.get(\"https://api.example.com/user\")\n     *     var user = HTTP.parseJSON(response.body)\n     */\n    static fun parseJSON(body: string): any {\n        return JSON.parse(body)\n    }\n}\n"
string "math"
string "/**\n * The ratio of a circle's circumference to its diameter, about `3.14159`.\n *\n * @see TAU\n * @since 26.1\n */\npub const PI = 3.141592653589793\n\n/**\n * Euler's number, the base of the natural logarithm, about `2.71828`.\n *\n * @since 26.1\n */\npub const E = 2.718281828459045\n\n/**\n * The ratio of a circle's circumference to its radius, equal to `2 * PI`.\n *\n * @see PI\n * @since 26.1\n */\npub const TAU = 6.283185307179586\n\n/**\n * Math helpers that complement the built-in math functions.\n *\n * Importing `std/math` also gives the basic functions `sqrt`, `pow`, `abs`,\n * `floor`, `ceil`, `round`, `min`, `max`, the trigonometric functions,\n * `log`, `log10` and `exp`.\n *\n * @since 26.1\n */\npub def static struct Math {\n    /**\n     * Limits a number to a range.\n     *\n     * If `low` is greater than `high`, the result is always `low`.\n     *\n     * @param x the number to limit\n     * @param low the lower bound\n     * @param high the upper bound\n     * @return `low` if `x` is below the range, `high` if it is above, `x` otherwise\n     * @since 26.1\n     * @example\n     *     Math.clamp(12.5, 0.0, 10.0)  // 10.0\n     *     Math.clamp(-3.0, 0.0, 10.0)  // 0.0\n     */\n    static fun clamp(x: float, low: float, high: float): float {\n        return max(low, min(high, x))\n    }\n\n    /**\n     * Interpolates linearly between two numbers.\n     *\n     * `t` is not limited to the range 0 to 1, so values outside it\n     * extrapolate.\n     *\n     * @param a the start value, returned for `t = 0`\n     * @param b the end value, returned for `t = 1`\n     * @param t the position between `a` and `b`\n     * @return `a + (b - a) * t`\n     * @since 26.1\n     * @example\n     *     Math.lerp(10.0, 20.0, 0.25)  // 12.5\n     */\n    static fun lerp(a: float, b: float, t: float): float {\n        return a + (b - a) * t\n    }\n\n    /**\n     * Converts an angle from degrees to radians.\n     *\n     * @param degrees the angle in degrees\n     * @return the angle in radians\n     * @see Math.toDegrees\n     * @since 26.1\n     * @example\n     *     Math.toRadians(180.0)  // 3.141592653589793\n     */\n    static fun toRadians(degrees: float): float {\n        return degrees * PI / 180.0\n    }\n\n    /**\n     * Converts an angle from radians to degrees.\n     *\n     * @param radians the angle in radians\n     * @return the angle in degrees\n     * @see Math.toRadians\n     * @since 26.1\n     * @example\n     *     Math.toDegrees(PI / 2.0)  // 90.0\n     */\n    static fun toDegrees(radians: float): float {\n        return radians * 180.0 / PI\n    }\n\n    /**\n     * Returns the sign of a number.\n     *\n     * @param x the number\n     * @return `1` if `x` is positive, `-1` if it is negative, `0` otherwise\n     * @since 26.1\n     * @example\n     *     Math.sign(-2.5)  // -1\n     */\n    static fun sign(x: float): int {\n        if (x > 0.0) {\n            return 1\n        }\n        if (x < 0.0) {\n            return -1\n        }\n        return 0\n    }\n\n    /**\n     * Returns the length of the hypotenuse of a right triangle.\n     *\n     * @param a the length of one side\n     * @param b the length of the other side\n     * @return `sqrt(a * a + b * b)`\n     * @since 26.1\n     * @example\n     *     Math.hypot(3.0, 4.0)  // 5.0\n     */\n    static fun hypot(a: float, b: float): float {\n        return sqrt(a * a + b * b)\n    }\n\n    /**\n     * Returns the greatest common divisor of two integers.\n     *\n     * Uses Euclid's algorithm on the absolute values.\n     *\n     * @param a the first integer\n     * @param b the second integer\n     * @return the greatest common divisor, never negative; `0` when both are `0`\n     * @see Math.lcm\n     * @since 26.1\n     * @example\n     *     Math.gcd(12, 18)  // 6\n     */\n    static fun gcd(a: int, b: int): int {\n        var x = abs(a)\n        var y = abs(b)\n        while (y != 0) {\n            var t = x % y\n            x = y\n            y = t\n        }\n        return x\n    }\n\n    /**\n     * Returns the least common multiple of two integers.\n     *\n     * @param a the first integer\n     * @param b the second integer\n     * @return the least common multiple, never negative; `0` when either is `0`\n     * @see Math.gcd\n     * @since 26.1\n     * @example\n     *     Math.lcm(4, 6)  // 12\n     */\n    static fun lcm(a: int, b: int): int {\n        if (a == 0 || b == 0) {\n            return 0\n        }\n        return abs(a / Math.gcd(a, b) * b)\n    }\n\n    /**\n     * Returns the factorial of a number.\n     *\n     * The factorial is the product of all integers from 1 to `n`. The\n     * result overflows for `n` greater than 20.\n     *\n     * @param n the number\n     * @return `n!`, or `1` when `n` is less than 2\n     * @since 26.1\n     * @example\n     *     Math.factorial(5)  // 120\n     */\n    static fun factorial(n: int): int {\n        var r = 1\n        for i in 2..=n {\n            r *= i\n        }\n        return r\n    }\n\n    /**\n     * Tells whether a number is prime.\n     *\n     * Uses trial division, so it is meant for small numbers.\n     *\n     * @param n the number\n     * @return `true` if `n` is prime; `false` for numbers below 2\n     * @since 26.1\n     * @example\n     *     Math.isPrime(97)  // true\n     *     Math.isPrime(91)  // false\n     */\n    static fun isPrime(n: int): bool {\n        if (n < 2) {\n            return false\n        }\n        var i = 2\n        while (i * i <= n) {\n            if (n % i == 0) {\n                return false\n            }\n            i += 1\n        }\n        return true\n    }\n\n    /**\n     * Returns the sum of a list of numbers.\n     *\n     * @param values the numbers to add\n     * @return the sum, `0.0` for an empty list\n     * @see Math.average\n     * @since 26.1\n     * @example\n     *     Math.sum([1.5, 2.5, 3.0])  // 7.0\n     */\n    static fun sum(values: [float]): float {\n        var total = 0.0\n        for v in values {\n            total += v\n        }\n        return total\n    }\n\n    /**\n     * Returns the arithmetic mean of a list of numbers.\n     *\n     * @param values the numbers\n     * @return the average, `0.0` for an empty list\n     * @see Math.sum\n     * @since 26.1\n     * @example\n     *     Math.average([1.0, 2.0, 6.0])  // 3.0\n     */\n    static fun average(values: [float]): float {\n        if (len(values) == 0) {\n            return 0.0\n        }\n        return Math.sum(values) / len(values)\n    }\n}\n"
string "strings"
string "/**\n * Pads text on the left until it is at least a given length.\n *\n * Text that is already long enough is returned unchanged. With a fill of\n * more than one character the result can be longer than `width`. An empty\n * fill returns the text unchanged.\n *\n * @param text the text to pad\n * @param width the minimum length, in characters\n * @param fill the text to add in front\n * @return the padded text\n * @see padRight\n * @since 26.1\n * @example\n *     padLeft(\"42\", 5, \"0\")  // \"00042\"\n */\npub fun padLeft(text: string, width: int, fill: string): string {\n    var s = text\n    while (len(s) < width && len(fill) > 0) {\n        s = fill + s\n    }\n    return s\n}\n\n/**\n * Pads text on the right until it is at least a given length.\n *\n * Text that is already long enough is returned unchanged. With a fill of\n * more than one character the result can be longer than `width`. An empty\n * fill returns the text unchanged.\n *\n * @param text the text to pad\n * @param width the minimum length, in characters\n * @param fill the text to add at the end\n * @return the padded text\n * @see padLeft\n * @since 26.1\n * @example\n *     padRight(\"ab\", 5, \".\")  // \"ab...\"\n */\npub fun padRight(text: string, width: int, fill: string): string {\n    var s = text\n    while (len(s) < width && len(fill) > 0) {\n        s = s + fill\n    }\n    return s\n}\n\n/**\n * Tells whether text is empty.\n *\n * @param text the text to test\n * @return `true` if the text has no characters\n * @see isBlank\n * @since 26.1\n * @example\n *     isEmpty(\"\")   // true\n *     isEmpty(\" \")  // false\n */\npub fun isEmpty(text: string): bool {\n    return len(text) == 0\n}\n\n/**\n * Tells whether text is empty or contains only whitespace.\n *\n * @param text the text to test\n * @return `true` if nothing is left after trimming whitespace\n * @see isEmpty\n * @since 26.1\n * @example\n *     isBlank(\"  \\t\")  // true\n */\npub fun isBlank(text: string): bool {\n    return len(trim(text)) == 0\n}\n\n/**\n * Makes the first character of text uppercase.\n *\n * The rest of the text is left unchanged.\n *\n * @param text the text to capitalize\n * @return the capitalized text, or `\"\"` for empty text\n * @since 26.1\n * @example\n *     capitalize(\"hello world\")  // \"Hello world\"\n */\npub fun capitalize(text: string): string {\n    if (len(text) == 0) {\n        return text\n    }\n    return upper(substring(text, 0, 1)) + substring(text, 1)\n}\n\n/**\n * Counts the occurrences of a piece of text.\n *\n * Occurrences do not overlap: `\"aa\"` occurs twice in `\"aaaa\"`.\n *\n * @param text the text to search\n * @param part the text to count\n * @return the number of occurrences, `0` when `part` is empty\n * @since 26.1\n * @example\n *     countOf(\"banana\", \"an\")  // 2\n */\npub fun countOf(text: string, part: string): int {\n    if (len(part) == 0) {\n        return 0\n    }\n    return len(split(text, part)) - 1\n}\n\n/**\n * Splits text into lines.\n *\n * Both `\\n` and `\\r\\n` line endings are recognized. A line break at the\n * end of the text gives an empty last line.\n *\n * @param text the text to split\n * @return the lines, without their line endings\n * @since 26.1\n * @example\n *     lines(\"one\\r\\ntwo\\nthree\")  // [\"one\", \"two\", \"three\"]\n */\npub fun lines(text: string): [string] {\n    return split(replace(text, \"\\r\\n\", \"\\n\"), \"\\n\")\n}\n\n/**\n * Splits text into words separated by spaces.\n *\n * Runs of spaces are treated as one separator. Only the space character\n * separates words; tabs and line breaks do not.\n *\n * @param text the text to split\n * @return the non-empty words\n * @since 26.1\n * @example\n *     words(\"  the quick  fox \")  // [\"the\", \"quick\", \"fox\"]\n */\npub fun words(text: string): [string] {\n    var out: [string] = []\n    for w in split(text, \" \") {\n        if (len(w) > 0) {\n            push(out, w)\n        }\n    }\n    return out\n}\n\n/**\n * Tells whether text consists only of the digits `0` to `9`.\n *\n * Signs, decimal points and spaces are not digits.\n *\n * @param text the text to test\n * @return `true` if the text is not empty and every character is a digit\n * @see isAlpha\n * @since 26.1\n * @example\n *     isDigits(\"2024\")  // true\n *     isDigits(\"-1\")    // false\n */\npub fun isDigits(text: string): bool {\n    if (len(text) == 0) {\n        return false\n    }\n    for c in text {\n        if (c < \"0\" || c > \"9\") {\n            return false\n        }\n    }\n    return true\n}\n\n/**\n * Tells whether text consists only of ASCII letters.\n *\n * Letters are `a` to `z` and `A` to `Z`; accented letters do not count.\n *\n * @param text the text to test\n * @return `true` if the text is not empty and every character is a letter\n * @see isDigits\n * @since 26.1\n * @example\n *     isAlpha(\"Burn\")   // true\n *     isAlpha(\"Burn2\")  // false\n */\npub fun isAlpha(text: string): bool {\n    if (len(text) == 0) {\n        return false\n    }\n    for c in text {\n        var lc = lower(c)\n        if (lc < \"a\" || lc > \"z\") {\n            return false\n        }\n    }\n    return true\n}\n"
string "json"
string "/**\n * Helpers to read and write JSON.\n *\n * Parsed JSON is returned as `any`: objects become `{string: any}` maps,\n * arrays become `[any]` lists, and numbers, strings, booleans and `null`\n * become the matching Burn values.\n *\n * @since 26.1\n */\npub def static struct JSON {\n    /**\n     * Parses JSON text.\n     *\n     * @param text the JSON text\n     * @return the parsed value\n     * @throws when the text is not valid JSON\n     * @see JSON.stringify\n     * @since 26.1\n     * @example\n     *     var data = JSON.parse(\"{\\\"name\\\": \\\"Ada\\\", \\\"tags\\\": [\\\"x\\\", \\\"y\\\"]}\")\n     *     JSON.get(data, \"name\")  // \"Ada\"\n     */\n    static fun parse(text: string): any {\n        return parseJSON(text)\n    }\n\n    /**\n     * Converts a value to compact JSON text.\n     *\n     * @param value the value to convert\n     * @return the JSON text, without spaces or line breaks\n     * @see JSON.parse\n     * @since 26.1\n     * @example\n     *     JSON.stringify([1, 2, 3])  // \"[1,2,3]\"\n     */\n    static fun stringify(value: any): string {\n        return toJSON(value)\n    }\n\n    /**\n     * Returns the value stored under a key of a JSON object.\n     *\n     * @param value the JSON object\n     * @param key the key to look up\n     * @return the value for `key`, or `null` if the object has no such key\n     * @throws when `value` cannot be indexed, for example a number\n     * @see JSON.at\n     * @since 26.1\n     * @example\n     *     var data = JSON.parse(\"{\\\"id\\\": 7}\")\n     *     JSON.get(data, \"id\")  // 7\n     */\n    static fun get(value: any, key: string): any {\n        return value[key]\n    }\n\n    /**\n     * Returns the element at a position of a JSON array.\n     *\n     * @param value the JSON array\n     * @param index the position, from 0 to the length minus 1\n     * @return the element at `index`\n     * @throws when the index is out of bounds or `value` cannot be indexed\n     * @see JSON.get\n     * @since 26.1\n     * @example\n     *     var list = JSON.parse(\"[10, 20, 30]\")\n     *     JSON.at(list, 1)  // 20\n     */\n    static fun at(value: any, index: int): any {\n        return value[index]\n    }\n\n    /**\n     * Tells whether a parsed JSON value is an object.\n     *\n     * @param value the value to test\n     * @return `true` if `value` is a `{string: any}` map\n     * @see JSON.isArray\n     * @since 26.1\n     * @example\n     *     JSON.isObject(JSON.parse(\"{}\"))  // true\n     */\n    static fun isObject(value: any): bool {\n        return value is {string: any}\n    }\n\n    /**\n     * Tells whether a parsed JSON value is an array.\n     *\n     * @param value the value to test\n     * @return `true` if `value` is an `[any]` list\n     * @see JSON.isObject\n     * @since 26.1\n     * @example\n     *     JSON.isArray(JSON.parse(\"[1, 2]\"))  // true\n     */\n    static fun isArray(value: any): bool {\n        return value is [any]\n    }\n}\n"
string "process"
string "/**\n * The result of a program run with {@link Process.output}.\n *\n * @param code the exit code, `0` on success, or `-1` if the program could not be started\n * @param out everything the program wrote to standard output\n * @param err everything the program wrote to standard error, or why it could not be started\n * @see Process.output\n * @since 26.1\n */\npub def type ProcessOutput {\n    int code\n    string out\n    string err\n}\n\n/**\n * Runs other programs and works with the current directory.\n *\n * Programs are found through `PATH`. {@link Process.run} shares the terminal\n * with the program, {@link Process.output} collects what it prints. The\n * `shell` variants hand a whole command line to `sh`, so pipes and `&&` work.\n *\n * @see ProcessOutput\n * @since 26.1\n * @example\n *     var code = Process.run(\"git\", [\"status\"])\n *     var branch = Process.output(\"git\", [\"branch\", \"--show-current\"]).out\n */\npub def static struct Process {\n    /**\n     * Runs a program in the terminal and waits for it.\n     *\n     * @param program the program to run\n     * @param args its arguments\n     * @return the exit code, or `-1` if the program could not be started\n     * @see Process.output\n     * @since 26.1\n     * @example\n     *     Process.run(\"git\", [\"init\"])\n     */\n    static fun run(program: string, args: [string]): int {\n        return toInt(__exec(program, args, false)[0])\n    }\n\n    /**\n     * Runs a program and collects its output.\n     *\n     * @param program the program to run\n     * @param args its arguments\n     * @return the exit code and both outputs\n     * @see Process.run\n     * @since 26.1\n     * @example\n     *     var r = Process.output(\"git\", [\"rev-parse\", \"HEAD\"])\n     *     if (r.code == 0) {\n     *         print(trim(r.out))\n     *     }\n     */\n    static fun output(program: string, args: [string]): ProcessOutput {\n        var raw = __exec(program, args, true)\n        return ProcessOutput { code: toInt(raw[0]), out: raw[1], err: raw[2] }\n    }\n\n    /**\n     * Runs a command line with `sh` in the terminal and waits for it.\n     *\n     * @param command the command line, for example `\"burnc src/main.bn -o build/app\"`\n     * @return the exit code\n     * @see Process.shellOutput\n     * @since 26.1\n     * @example\n     *     Process.shell(\"ls src | wc -l\")\n     */\n    static fun shell(command: string): int {\n        return Process.run(\"sh\", [\"-c\", command])\n    }\n\n    /**\n     * Runs a command line with `sh` and collects its output.\n     *\n     * @param command the command line\n     * @return the exit code and both outputs\n     * @see Process.shell\n     * @since 26.1\n     * @example\n     *     print(Process.shellOutput(\"echo $HOME\").out)\n     */\n    static fun shellOutput(command: string): ProcessOutput {\n        return Process.output(\"sh\", [\"-c\", command])\n    }\n\n    /**\n     * Returns the current working directory.\n     *\n     * @return its absolute path\n     * @see Process.setCwd\n     * @since 26.1\n     * @example\n     *     print(Process.cwd())\n     */\n    static fun cwd(): string {\n        return __cwd()\n    }\n\n    /**\n     * Changes the current working directory.\n     *\n     * Relative paths and programs started afterwards use the new directory.\n     *\n     * @param path the new working directory\n     * @return `true` when the directory exists and was entered\n     * @see Process.cwd\n     * @since 26.1\n     * @example\n     *     Process.setCwd(\"build\")\n     */\n    static fun setCwd(path: string): bool {\n        return __fsOp(\"chdir\", path, \"\")\n    }\n}\n"
string "fs"
string "/**\n * Works with files and directories.\n *\n * Importing `std/fs` gives `readFile`, `writeFile`, `appendFile` and\n * `fileExists` for file contents; `Files` adds what is needed to manage\n * whole directories. No function stops the program: failures are\n * reported by the return value.\n *\n * @since 26.1\n * @example\n *     Files.makeDir(\"build/cache\")\n *     for (name in Files.list(\"src\")) {\n *         print(name)\n *     }\n */\npub def static struct Files {\n    /**\n     * Creates a directory together with any missing parents.\n     *\n     * @param path the directory to create\n     * @return `true` when the directory exists afterwards\n     * @since 26.1\n     * @example\n     *     Files.makeDir(\"build/cache\")\n     */\n    static fun makeDir(path: string): bool {\n        return __fsOp(\"mkdir\", path, \"\")\n    }\n\n    /**\n     * Removes a file, or a directory with everything in it.\n     *\n     * @param path the file or directory\n     * @return `true` when nothing is left at `path`\n     * @since 26.1\n     * @example\n     *     Files.remove(\"build\")\n     */\n    static fun remove(path: string): bool {\n        return __fsOp(\"remove\", path, \"\")\n    }\n\n    /**\n     * Moves or renames a file or directory.\n     *\n     * @param from the current path\n     * @param to the new path\n     * @return `true` on success\n     * @since 26.1\n     * @example\n     *     Files.rename(\"draft.txt\", \"final.txt\")\n     */\n    static fun rename(from: string, to: string): bool {\n        return __fsOp(\"rename\", from, to)\n    }\n\n    /**\n     * Copies a file.\n     *\n     * @param from the file to copy\n     * @param to the path of the copy, replaced if it exists\n     * @return `true` on success\n     * @since 26.1\n     * @example\n     *     Files.copy(\"burn.toml\", \"burn.toml.bak\")\n     */\n    static fun copy(from: string, to: string): bool {\n        return __fsOp(\"copy\", from, to)\n    }\n\n    /**\n     * Lists the names in a directory, sorted.\n     *\n     * @param path the directory\n     * @return the entry names without the directory, or `[]` if it cannot be read\n     * @since 26.1\n     * @example\n     *     Files.list(\".\")  // for example [\"burn.toml\", \"src\"]\n     */\n    static fun list(path: string): [string] {\n        return __listDir(path)\n    }\n\n    /**\n     * Checks whether a path is a directory.\n     *\n     * @param path the path to check\n     * @return `true` for an existing directory\n     * @see Files.isFile\n     * @since 26.1\n     * @example\n     *     Files.isDir(\"src\")  // true\n     */\n    static fun isDir(path: string): bool {\n        return __fsOp(\"isDir\", path, \"\")\n    }\n\n    /**\n     * Checks whether a path is a regular file.\n     *\n     * @param path the path to check\n     * @return `true` for an existing file\n     * @see Files.isDir\n     * @since 26.1\n     * @example\n     *     Files.isFile(\"burn.toml\")  // true\n     */\n    static fun isFile(path: string): bool {\n        return __fsOp(\"isFile\", path, \"\")\n    }\n\n    /**\n     * Joins path parts with `/`.\n     *\n     * Empty parts are skipped and doubled slashes between parts are avoided.\n     *\n     * @param parts the parts to join\n     * @return the joined path\n     * @since 26.1\n     * @example\n     *     Files.join([\"build\", \"out\", \"app.js\"])  // \"build/out/app.js\"\n     */\n    static fun join(parts: [string]): string {\n        var out = \"\"\n        for (p in parts) {\n            if (p == \"\") {\n                continue\n            }\n            if (out == \"\") {\n                out = p\n            } else if (endsWith(out, \"/\") && startsWith(p, \"/\")) {\n                out = out + substring(p, 1)\n            } else if (endsWith(out, \"/\") || startsWith(p, \"/\")) {\n                out = out + p\n            } else {\n                out = out + \"/\" + p\n            }\n        }\n        return out\n    }\n}\n"
string "list"
string "/**\n * Makes a new array with the result of a function for every item.\n *\n * @param items the items to transform\n * @param f the function to call for each item\n * @return the results, in the same order\n * @since 26.1\n * @example\n *     [1, 2, 3].map(fun(x: int): int { return x * 2 })  // [2, 4, 6]\n */\npub fun map<T, U>(items: [T], f: fun(T): U): [U] {\n    [U] out = []\n    for x in items {\n        out.push(f(x))\n    }\n    return out\n}\n\n/**\n * Makes a new array with the items for which a test returns true.\n *\n * @param items the items to test\n * @param keep the test\n * @return the items that passed, in the same order\n * @since 26.1\n * @example\n *     [1, 2, 3, 4].filter(fun(x: int): bool { return x % 2 == 0 })  // [2, 4]\n */\npub fun filter<T>(items: [T], keep: fun(T): bool): [T] {\n    [T] out = []\n    for x in items {\n        if keep(x) {\n            out.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Combines all items into one value, from left to right.\n *\n * @param items the items to combine\n * @param start the value to start with\n * @param f gets the value so far and the next item, and returns the new value\n * @return the final value, or `start` for an empty array\n * @since 26.1\n * @example\n *     [1, 2, 3].reduce(0, fun(sum: int, x: int): int { return sum + x })  // 6\n */\npub fun reduce<T, R>(items: [T], start: R, f: fun(R, T): R): R {\n    var acc = start\n    for x in items {\n        acc = f(acc, x)\n    }\n    return acc\n}\n\n/**\n * Calls a function for every item.\n *\n * @param items the items\n * @param f the function to call\n * @since 26.1\n */\npub fun each<T>(items: [T], f: fun(T)) {\n    for x in items {\n        f(x)\n    }\n}\n\n/**\n * Finds the first item for which a test returns true.\n *\n * @param items the items to search\n * @param test the test\n * @return the first matching item, or `null`\n * @see findIndex\n * @since 26.1\n */\npub fun find<T>(items: [T], test: fun(T): bool): T? {\n    for x in items {\n        if test(x) {\n            return x\n        }\n    }\n    return null\n}\n\n/**\n * Finds the position of the first item for which a test returns true.\n *\n * @param items the items to search\n * @param test the test\n * @return the index of the first matching item, or `-1`\n * @see find\n * @since 26.1\n */\npub fun findIndex<T>(items: [T], test: fun(T): bool): int {\n    for i, x in items {\n        if test(x) {\n            return i\n        }\n    }\n    return -1\n}\n\n/**\n * Tells whether a test returns true for at least one item.\n *\n * @param items the items to test\n * @param test the test\n * @return `true` if any item passes; `false` for an empty array\n * @since 26.1\n */\npub fun any<T>(items: [T], test: fun(T): bool): bool {\n    for x in items {\n        if test(x) {\n            return true\n        }\n    }\n    return false\n}\n\n/**\n * Tells whether a test returns true for every item.\n *\n * @param items the items to test\n * @param test the test\n * @return `true` if every item passes; `true` for an empty array\n * @since 26.1\n */\npub fun all<T>(items: [T], test: fun(T): bool): bool {\n    for x in items {\n        if !test(x) {\n            return false\n        }\n    }\n    return true\n}\n\n/**\n * Counts the items for which a test returns true.\n *\n * @param items the items to test\n * @param test the test\n * @return the number of items that passed\n * @since 26.1\n */\npub fun countWhere<T>(items: [T], test: fun(T): bool): int {\n    var n = 0\n    for x in items {\n        if test(x) {\n            n += 1\n        }\n    }\n    return n\n}\n\n/**\n * Adds up all items with `+`.\n *\n * Works for any item type that supports `+`, such as `int`, `float` and\n * `string`.\n *\n * @param items the items to add\n * @param zero the value for an empty array\n * @return the sum\n * @since 26.1\n * @example\n *     [1, 2, 3].total(0)        // 6\n *     [\"a\", \"b\"].total(\"\")      // \"ab\"\n */\npub fun total<T>(items: [T], zero: T): T {\n    var acc = zero\n    for x in items {\n        acc = acc + x\n    }\n    return acc\n}\n\n/**\n * Returns the first item.\n *\n * @param items the items\n * @return the first item, or `null` for an empty array\n * @since 26.1\n */\npub fun first<T>(items: [T]): T? {\n    if len(items) == 0 {\n        return null\n    }\n    return items[0]\n}\n\n/**\n * Returns the last item.\n *\n * @param items the items\n * @return the last item, or `null` for an empty array\n * @since 26.1\n */\npub fun last<T>(items: [T]): T? {\n    if len(items) == 0 {\n        return null\n    }\n    return items[len(items) - 1]\n}\n\n/**\n * Returns the first items.\n *\n * @param items the items\n * @param n how many to take\n * @return at most `n` items from the start\n * @since 26.1\n */\npub fun take<T>(items: [T], n: int): [T] {\n    if n <= 0 {\n        [T] none = []\n        return none\n    }\n    return slice(items, 0, min(n, len(items)))\n}\n\n/**\n * Returns the items after the first ones.\n *\n * @param items the items\n * @param n how many to skip\n * @return the items from position `n` on\n * @since 26.1\n */\npub fun drop<T>(items: [T], n: int): [T] {\n    if n >= len(items) {\n        [T] none = []\n        return none\n    }\n    return slice(items, max(n, 0), len(items))\n}\n\n/**\n * Splits the items into groups of a fixed size. The last group can be\n * smaller.\n *\n * @param items the items\n * @param size the size of each group, at least 1\n * @return the groups, in order\n * @since 26.1\n * @example\n *     [1, 2, 3, 4, 5].chunk(2)  // [[1, 2], [3, 4], [5]]\n */\npub fun chunk<T>(items: [T], size: int): [[T]] {\n    [[T]] out = []\n    var step = max(size, 1)\n    var i = 0\n    while i < len(items) {\n        out.push(slice(items, i, min(i + step, len(items))))\n        i += step\n    }\n    return out\n}\n\n/**\n * Joins a list of arrays into one array.\n *\n * @param lists the arrays\n * @return all items, in order\n * @since 26.1\n */\npub fun flatten<T>(lists: [[T]]): [T] {\n    [T] out = []\n    for l in lists {\n        for x in l {\n            out.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Removes repeated items, keeping the first of each.\n *\n * @param items the items\n * @return the items without repeats, in order\n * @since 26.1\n */\npub fun unique<T>(items: [T]): [T] {\n    [T] out = []\n    for x in items {\n        if !out.contains(x) {\n            out.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Sorts items by a key, without changing the original array.\n *\n * The sort is stable: items with equal keys keep their order. Keys are\n * compared with `<`, so they can be numbers or strings.\n *\n * @param items the items to sort\n * @param key gives the value to sort by\n * @return a new, sorted array\n * @see sortWith\n * @since 26.1\n * @example\n *     [\"pear\", \"fig\", \"apple\"].sortBy(fun(s: string): int { return len(s) })  // [\"fig\", \"pear\", \"apple\"]\n */\npub fun sortBy<T, K>(items: [T], key: fun(T): K): [T] {\n    var keys = items.map(key)\n    var order = range(0, len(items))\n    var sorted = order.sortWith(fun(a: int, b: int): bool {\n        return keys[a] < keys[b]\n    })\n    return sorted.map(fun(i: int): T {\n        return items[i]\n    })\n}\n\n/**\n * Sorts items with a comparison, without changing the original array.\n *\n * The sort is stable: items that are not less than each other keep their\n * order.\n *\n * @param items the items to sort\n * @param less tells whether the first item belongs before the second\n * @return a new, sorted array\n * @see sortBy\n * @since 26.1\n */\npub fun sortWith<T>(items: [T], less: fun(T, T): bool): [T] {\n    if len(items) <= 1 {\n        return copy(items)\n    }\n    var mid = len(items) / 2\n    var left = sortWith(slice(items, 0, mid), less)\n    var right = sortWith(slice(items, mid, len(items)), less)\n    [T] out = []\n    var i = 0\n    var j = 0\n    while i < len(left) && j < len(right) {\n        if less(right[j], left[i]) {\n            out.push(right[j])\n            j += 1\n        } else {\n            out.push(left[i])\n            i += 1\n        }\n    }\n    while i < len(left) {\n        out.push(left[i])\n        i += 1\n    }\n    while j < len(right) {\n        out.push(right[j])\n        j += 1\n    }\n    return out\n}\n\n/**\n * Groups items by a key.\n *\n * @param items the items\n * @param key gives the group of each item; it must be a string, int, bool or enum\n * @return a map from each key to its items, in order\n * @since 26.1\n */\npub fun groupBy<T, K>(items: [T], key: fun(T): K): {K: [T]} {\n    {K: [T]} out = {}\n    for x in items {\n        var k = key(x)\n        var group = out[k]\n        if group == null {\n            out[k] = [x]\n        } else {\n            group.push(x)\n        }\n    }\n    return out\n}\n\n/**\n * Splits items into those that pass a test and those that do not.\n *\n * @param items the items\n * @param test the test\n * @return two arrays: the items that passed, then the others\n * @since 26.1\n */\npub fun partition<T>(items: [T], test: fun(T): bool): [[T]] {\n    [T] yes = []\n    [T] no = []\n    for x in items {\n        if test(x) {\n            yes.push(x)\n        } else {\n            no.push(x)\n        }\n    }\n    return [yes, no]\n}\n\n/**\n * Combines two arrays item by item.\n *\n * @param a the first array\n * @param b the second array\n * @param f gets one item of each and returns the combined value\n * @return one result per pair; as long as the shorter array\n * @since 26.1\n */\npub fun zipWith<A, B, R>(a: [A], b: [B], f: fun(A, B): R): [R] {\n    [R] out = []\n    for i in 0..min(len(a), len(b)) {\n        out.push(f(a[i], b[i]))\n    }\n    return out\n}\n\n/**\n * Finds the item with the largest key.\n *\n * @param items the items\n * @param key gives the value to compare, with `>`\n * @return the first item with the largest key, or `null` for an empty array\n * @since 26.1\n */\npub fun maxBy<T, K>(items: [T], key: fun(T): K): T? {\n    if len(items) == 0 {\n        return null\n    }\n    var best = items[0]\n    var bestKey = key(best)\n    for x in items {\n        var k = key(x)\n        if k > bestKey {\n            best = x\n            bestKey = k\n        }\n    }\n    return best\n}\n\n/**\n * Finds the item with the smallest key.\n *\n * @param items the items\n * @param key gives the value to compare, with `<`\n * @return the first item with the smallest key, or `null` for an empty array\n * @since 26.1\n */\npub fun minBy<T, K>(items: [T], key: fun(T): K): T? {\n    if len(items) == 0 {\n        return null\n    }\n    var best = items[0]\n    var bestKey = key(best)\n    for x in items {\n        var k = key(x)\n        if k < bestKey {\n            best = x\n            bestKey = k\n        }\n    }\n    return best\n}\n\n/**\n * Makes an array of whole numbers.\n *\n * @param start the first number\n * @param end the number to stop before\n * @return `start`, `start + 1`, ... up to `end - 1`; empty when `end <= start`\n * @since 26.1\n */\npub fun range(start: int, end: int): [int] {\n    [int] out = []\n    for i in start..end {\n        out.push(i)\n    }\n    return out\n}\n\n/**\n * Makes an array with the same value several times.\n *\n * @param value the value\n * @param n how many times\n * @return `n` copies of `value`\n * @since 26.1\n */\npub fun fill<T>(value: T, n: int): [T] {\n    [T] out = []\n    for i in 0..n {\n        out.push(value)\n    }\n    return out\n}\n"
string "collections"
string "/**\n * A collection of unique values, kept in the order they were first added.\n *\n * The values must be strings, ints, bools or enums.\n *\n * @since 26.1\n * @example\n *     var seen = new Set<string>()\n *     seen.add(\"a\")\n *     seen.add(\"a\")\n *     print(seen.size())  // 1\n */\npub def struct Set<T>() {\n    {T: bool} entries = {}\n\n    /**\n     * Adds a value.\n     *\n     * @param value the value to add\n     * @return `true` if it was not in the set yet\n     */\n    fun add(value: T): bool {\n        if has(entries, value) {\n            return false\n        }\n        entries[value] = true\n        return true\n    }\n\n    /**\n     * Adds every value of an array.\n     *\n     * @param values the values to add\n     */\n    fun addAll(values: [T]) {\n        for v in values {\n            entries[v] = true\n        }\n    }\n\n    /**\n     * Removes a value.\n     *\n     * @param value the value to remove\n     * @return `true` if it was in the set\n     */\n    fun delete(value: T): bool {\n        if !has(entries, value) {\n            return false\n        }\n        remove(entries, value)\n        return true\n    }\n\n    /**\n     * Tells whether a value is in the set.\n     *\n     * @param value the value to look for\n     * @return `true` if it is in the set\n     */\n    fun includes(value: T): bool {\n        return has(entries, value)\n    }\n\n    /**\n     * Counts the values.\n     *\n     * @return the number of values\n     */\n    fun size(): int {\n        return len(entries)\n    }\n\n    /**\n     * Lists the values.\n     *\n     * @return the values, in the order they were added\n     */\n    fun items(): [T] {\n        return keys(entries)\n    }\n\n    /**\n     * Removes every value.\n     */\n    fun clearAll() {\n        entries = {}\n    }\n\n    /**\n     * Makes a set with the values of this set and another one.\n     *\n     * @param other the other set\n     * @return a new set\n     */\n    fun union(other: Set<T>): Set<T> {\n        var out = new Set<T>()\n        out.addAll(items())\n        out.addAll(other.items())\n        return out\n    }\n\n    /**\n     * Makes a set with the values that are in both sets.\n     *\n     * @param other the other set\n     * @return a new set\n     */\n    fun intersect(other: Set<T>): Set<T> {\n        var out = new Set<T>()\n        for v in items() {\n            if other.includes(v) {\n                out.add(v)\n            }\n        }\n        return out\n    }\n\n    /**\n     * Makes a set with the values of this set that are not in another one.\n     *\n     * @param other the other set\n     * @return a new set\n     */\n    fun difference(other: Set<T>): Set<T> {\n        var out = new Set<T>()\n        for v in items() {\n            if !other.includes(v) {\n                out.add(v)\n            }\n        }\n        return out\n    }\n}\n\n/**\n * Makes a set from the values of an array.\n *\n * @param values the values\n * @return a set with each value once\n * @since 26.1\n */\npub fun setOf<T>(values: [T]): Set<T> {\n    var s = new Set<T>()\n    s.addAll(values)\n    return s\n}\n\n/**\n * A first-in, first-out queue: values come out in the order they went in.\n *\n * Adding and taking values are fast, even for long queues.\n *\n * @since 26.1\n * @example\n *     var q = new Queue<int>()\n *     q.enqueue(1)\n *     q.enqueue(2)\n *     print(q.dequeue())  // 1\n */\npub def struct Queue<T>() {\n    [T] items = []\n    int head = 0\n\n    /**\n     * Adds a value at the back.\n     *\n     * @param value the value to add\n     */\n    fun enqueue(value: T) {\n        items.push(value)\n    }\n\n    /**\n     * Takes the value at the front.\n     *\n     * @return the oldest value, or `null` if the queue is empty\n     */\n    fun dequeue(): T? {\n        if head >= len(items) {\n            return null\n        }\n        var v = items[head]\n        head += 1\n        if head > 32 && head * 2 > len(items) {\n            items = slice(items, head, len(items))\n            head = 0\n        }\n        return v\n    }\n\n    /**\n     * Looks at the value at the front without taking it.\n     *\n     * @return the oldest value, or `null` if the queue is empty\n     */\n    fun peek(): T? {\n        if head >= len(items) {\n            return null\n        }\n        return items[head]\n    }\n\n    /**\n     * Counts the values.\n     *\n     * @return the number of values waiting\n     */\n    fun size(): int {\n        return len(items) - head\n    }\n\n    /**\n     * Tells whether the queue has no values.\n     *\n     * @return `true` if it is empty\n     */\n    fun isEmpty(): bool {\n        return head >= len(items)\n    }\n}\n\n/**\n * A last-in, first-out stack: the value added last comes out first.\n *\n * @since 26.1\n */\npub def struct Stack<T>() {\n    [T] items = []\n\n    /**\n     * Adds a value on top.\n     *\n     * @param value the value to add\n     */\n    fun push(value: T) {\n        items.push(value)\n    }\n\n    /**\n     * Takes the value on top.\n     *\n     * @return the newest value, or `null` if the stack is empty\n     */\n    fun pop(): T? {\n        if len(items) == 0 {\n            return null\n        }\n        return items.pop()\n    }\n\n    /**\n     * Looks at the value on top without taking it.\n     *\n     * @return the newest value, or `null` if the stack is empty\n     */\n    fun peek(): T? {\n        if len(items) == 0 {\n            return null\n        }\n        return items[len(items) - 1]\n    }\n\n    /**\n     * Counts the values.\n     *\n     * @return the number of values\n     */\n    fun size(): int {\n        return len(items)\n    }\n\n    /**\n     * Tells whether the stack has no values.\n     *\n     * @return `true` if it is empty\n     */\n    fun isEmpty(): bool {\n        return len(items) == 0\n    }\n}\n\n/**\n * Counts how often each value appears.\n *\n * The values must be strings, ints, bools or enums.\n *\n * @since 26.1\n * @example\n *     var c = new Counter<string>()\n *     c.addAll([\"a\", \"b\", \"a\"])\n *     print(c.count(\"a\"))  // 2\n */\npub def struct Counter<T>() {\n    {T: int} counts = {}\n\n    /**\n     * Counts one more of a value.\n     *\n     * @param value the value\n     */\n    fun add(value: T) {\n        counts[value] = (counts[value] ?? 0) + 1\n    }\n\n    /**\n     * Counts every value of an array.\n     *\n     * @param values the values\n     */\n    fun addAll(values: [T]) {\n        for v in values {\n            add(v)\n        }\n    }\n\n    /**\n     * Tells how often a value was counted.\n     *\n     * @param value the value\n     * @return its count, `0` if it never appeared\n     */\n    fun count(value: T): int {\n        return counts[value] ?? 0\n    }\n\n    /**\n     * Lists the values that appear most often.\n     *\n     * @param n how many values to return\n     * @return at most `n` values, the most frequent first; ties keep the order they first appeared in\n     */\n    fun mostCommon(n: int): [T] {\n        [T] out = []\n        var vs: [T] = keys(counts)\n        var used: {T: bool} = {}\n        while len(out) < n && len(out) < len(vs) {\n            var best = vs[0]\n            var bestCount = -1\n            for v in vs {\n                var c = counts[v]!!\n                if !has(used, v) && c > bestCount {\n                    best = v\n                    bestCount = c\n                }\n            }\n            used[best] = true\n            out.push(best)\n        }\n        return out\n    }\n\n    /**\n     * Counts the different values.\n     *\n     * @return the number of distinct values\n     */\n    fun size(): int {\n        return len(counts)\n    }\n}\n"
string "/**\n * Joins two parts of a file path with `/`.\n *\n * If `child` is absolute it is returned unchanged.\n *\n * @param base the first part\n * @param child the part to add\n * @return the joined path\n * @since 26.1\n * @example\n *     joinPath(\"src\", \"main.bn\")   // \"src/main.bn\"\n *     joinPath(\"src/\", \"/etc\")     // \"/etc\"\n */\npub fun joinPath(base: string, child: string): string {\n    if child.startsWith(\"/\") || base == \"\" {\n        return child\n    }\n    if child == \"\" {\n        return base\n    }\n    if base.endsWith(\"/\") {\n        return base + child\n    }\n    return base + \"/\" + child\n}\n\n/**\n * Joins several parts of a file path with `/`.\n *\n * @param parts the parts\n * @return the joined path\n * @see joinPath\n * @since 26.1\n */\npub fun joinAll(parts: [string]): string {\n    var out = \"\"\n    for p in parts {\n        out = joinPath(out, p)\n    }\n    return out\n}\n\n/**\n * Removes `.` parts, resolves `..` parts and repeated slashes.\n *\n * @param path the path to clean\n * @return the shortest equivalent path, `\".\"` for an empty result\n * @since 26.1\n * @example\n *     normalize(\"a/./b/../c//d\")  // \"a/c/d\"\n */\npub fun normalize(path: string): string {\n    var absolute = path.startsWith(\"/\")\n    [string] parts = []\n    for p in split(path, \"/\") {\n        if p == \"\" || p == \".\" {\n            continue\n        }\n        if p == \"..\" {\n            if len(parts) > 0 && parts[len(parts) - 1] != \"..\" {\n                parts.pop()\n            } else if !absolute {\n                parts.push(\"..\")\n            }\n            continue\n        }\n        parts.push(p)\n    }\n    var joined = join(parts, \"/\")\n    if absolute {\n        return \"/\" + joined\n    }\n    if joined == \"\" {\n        return \".\"\n    }\n    return joined\n}\n\n/**\n * Returns the last part of a path.\n *\n * @param path the path\n * @return the file or folder name, without the folders before it\n * @since 26.1\n * @example\n *     baseName(\"src/lib/main.bn\")  // \"main.bn\"\n */\npub fun baseName(path: string): string {\n    var p = path\n    while len(p) > 1 && p.endsWith(\"/\") {\n        p = substring(p, 0, len(p) - 1)\n    }\n    var parts = split(p, \"/\")\n    return parts[len(parts) - 1]\n}\n\n/**\n * Returns the folder part of a path.\n *\n * @param path the path\n * @return everything before the last part, `\".\"` if there is none\n * @since 26.1\n * @example\n *     dirName(\"src/lib/main.bn\")  // \"src/lib\"\n */\npub fun dirName(path: string): string {\n    var p = path\n    while len(p) > 1 && p.endsWith(\"/\") {\n        p = substring(p, 0, len(p) - 1)\n    }\n    var i = len(p) - 1\n    while i >= 0 && charAt(p, i) != \"/\" {\n        i -= 1\n    }\n    if i < 0 {\n        return \".\"\n    }\n    if i == 0 {\n        return \"/\"\n    }\n    return substring(p, 0, i)\n}\n\n/**\n * Returns the extension of a file name, including the dot.\n *\n * @param path the path\n * @return for example `\".bn\"`, or `\"\"` when the name has no extension\n * @since 26.1\n */\npub fun extension(path: string): string {\n    var name = baseName(path)\n    var i = len(name) - 1\n    while i > 0 && charAt(name, i) != \".\" {\n        i -= 1\n    }\n    if i <= 0 {\n        return \"\"\n    }\n    return substring(name, i, len(name))\n}\n\n/**\n * Returns a file name without its extension.\n *\n * @param path the path\n * @return the last part of the path, without the extension\n * @since 26.1\n * @example\n *     stem(\"src/main.bn\")  // \"main\"\n */\npub fun stem(path: string): string {\n    var name = baseName(path)\n    var ext = extension(name)\n    return substring(name, 0, len(name) - len(ext))\n}\n\n/**\n * Tells whether a path starts at the root of the file system.\n *\n * @param path the path\n * @return `true` if it starts with `/`\n * @since 26.1\n */\npub fun isAbsolute(path: string): bool {\n    return path.startsWith(\"/\")\n}\n"
string "/**\n * Makes a shuffled copy of an array.\n *\n * Every order is equally likely. Use `seed` first to get the same order\n * every time.\n *\n * @param items the items to shuffle\n * @return a new array with the same items in random order\n * @since 26.1\n */\npub fun shuffled<T>(items: [T]): [T] {\n    var out = copy(items)\n    var i = len(out) - 1\n    while i > 0 {\n        var j = randomInt(0, i)\n        var tmp = out[i]\n        out[i] = out[j]\n        out[j] = tmp\n        i -= 1\n    }\n    return out\n}\n\n/**\n * Picks a random item.\n *\n * @param items the items to pick from\n * @return one of the items, or `null` for an empty array\n * @since 26.1\n */\npub fun pick<T>(items: [T]): T? {\n    if len(items) == 0 {\n        return null\n    }\n    return items[randomInt(0, len(items) - 1)]\n}\n\n/**\n * Picks several different items at random.\n *\n * @param items the items to pick from\n * @param n how many to pick\n * @return at most `n` items, each from a different position\n * @since 26.1\n */\npub fun sample<T>(items: [T], n: int): [T] {\n    var all = shuffled(items)\n    return slice(all, 0, max(0, min(n, len(all))))\n}\n\n/**\n * Returns `true` with a given probability.\n *\n * @param probability a number from 0 (never) to 1 (always)\n * @return `true` in about `probability` of the calls\n * @since 26.1\n * @example\n *     if chance(0.25) {\n *         print(\"rare\")\n *     }\n */\npub fun chance(probability: float): bool {\n    return random() < probability\n}\n\n/**\n * Makes a random string.\n *\n * @param length how many characters\n * @param alphabet the characters to choose from\n * @return a string of `length` characters taken from `alphabet`\n * @since 26.1\n * @example\n *     randomString(8, \"abcdef0123456789\")  // for example \"3fa09c1e\"\n */\npub fun randomString(length: int, alphabet: string): string {\n    var cs = chars(alphabet)\n    if len(cs) == 0 {\n        return \"\"\n    }\n    [string] parts = []\n    for i in 0..length {\n        parts.push(cs[randomInt(0, len(cs) - 1)])\n    }\n    return join(parts, \"\")\n}\n"
string "testing"
string "priv var passed = 0\npriv var failed = 0\npriv var running = \"\"\npriv var currentFailed = false\n\npriv fun fail(message: string) {\n    currentFailed = true\n    if running == \"\" {\n        failed += 1\n        print(\"FAIL \" + message)\n    } else {\n        print(\"     \" + message)\n    }\n}\n\n/**\n * Runs one named test and prints whether it passed.\n *\n * A test fails when one of the `expect` functions fails inside it. The\n * other tests still run; call `finish` at the end to get the exit code.\n *\n * @param name what the test checks\n * @param body the test\n * @see finish\n * @since 26.1\n * @example\n *     test(\"adds\", fun() {\n *         expectEqual(1 + 2, 3)\n *     })\n */\npub fun test(name: string, body: fun()) {\n    running = name\n    currentFailed = false\n    body()\n    if currentFailed {\n        failed += 1\n        print(\"FAIL \" + name)\n    } else {\n        passed += 1\n        print(\"ok   \" + name)\n    }\n    running = \"\"\n}\n\n/**\n * Checks that a condition is true.\n *\n * @param condition the condition\n * @param message what went wrong if it is false\n * @since 26.1\n */\npub fun expect(condition: bool, message: string) {\n    if !condition {\n        fail(message)\n    }\n}\n\n/**\n * Checks that two values are equal, comparing them like `==`.\n *\n * @param actual the value the code produced\n * @param expected the value it should be\n * @since 26.1\n */\npub fun expectEqual<T>(actual: T, expected: T) {\n    if actual != expected {\n        fail(\"expected ${expected} but got ${actual}\")\n    }\n}\n\n/**\n * Checks that two values are different.\n *\n * @param actual the value the code produced\n * @param unwanted the value it must not be\n * @since 26.1\n */\npub fun expectNotEqual<T>(actual: T, unwanted: T) {\n    if actual == unwanted {\n        fail(\"did not expect ${unwanted}\")\n    }\n}\n\n/**\n * Checks that two numbers are close to each other.\n *\n * @param actual the number the code produced\n * @param expected the number it should be\n * @param tolerance how far apart they may be\n * @since 26.1\n */\npub fun expectNear(actual: float, expected: float, tolerance: float) {\n    if abs(actual - expected) > tolerance {\n        fail(\"expected ${expected} (within ${tolerance}) but got ${actual}\")\n    }\n}\n\n/**\n * Prints how many tests passed and ends the program with exit code 1 if\n * any failed.\n *\n * @since 26.1\n */\npub fun finish() {\n    print(\"${passed} passed, ${failed} failed\")\n    if failed > 0 {\n        exit(1)\n    }\n}\n"
string "memory"
string "/**\n * Raw memory: blocks of bytes outside Burn's own values, addressed by plain `int`s.\n *\n * Every function is unsafe, so it can only be called in an `unsafe` block or an\n * `unsafe fun`. Nothing checks an address: reading or writing outside a block,\n * after `free`, or through an address that never came from `alloc` breaks the\n * program. Blocks are not reference counted; each one lives until `free`.\n *\n * Loads and stores read and write little-endian numbers of 8, 16, 32 or 64 bits.\n * The smaller loads give the value without a sign (`load8` gives 0 to 255).\n * Addresses do not need to be aligned.\n *\n * @since 26.1\n * @example\n *     import \"std/memory\"\n *\n *     unsafe {\n *         var p = Memory.alloc(16)\n *         Memory.store64(p, 42)\n *         Memory.store8(p + 8, 255)\n *         print(Memory.load64(p), Memory.load8(p + 8))  // 42 255\n *         Memory.free(p)\n *     }\n */\npub def static struct Memory {\n    /**\n     * Reserves a block of `size` bytes, all zero, and gives its address.\n     *\n     * The address is aligned to 16 bytes. A size of 0 gives a block that holds\n     * nothing but can still be resized and freed.\n     *\n     * @param size how many bytes, not negative\n     * @return the address of the block, or `0` if it cannot be made\n     */\n    unsafe fun alloc(size: int): int {\n        return __mem(0, size, 0, 0)\n    }\n\n    /**\n     * Gives a block back. Freeing `0` does nothing.\n     *\n     * @param address an address that `alloc` or `resize` gave and that was not freed yet\n     */\n    unsafe fun free(address: int) {\n        __mem(1, address, 0, 0)\n    }\n\n    /**\n     * Makes a block larger or smaller, keeping its bytes. New bytes are zero.\n     *\n     * The block may move: use the returned address from now on, not the old one.\n     * Resizing `0` is the same as `alloc`.\n     *\n     * @param address the block, from `alloc` or `resize`\n     * @param size the new size in bytes, not negative\n     * @return the address of the block, or `0` if it cannot be resized (the old block stays valid)\n     */\n    unsafe fun resize(address: int, size: int): int {\n        return __mem(2, address, size, 0)\n    }\n\n    /**\n     * Reads one byte.\n     *\n     * @param address where to read\n     * @return the byte, from 0 to 255\n     */\n    unsafe fun load8(address: int): int {\n        return __mem(3, address, 0, 0)\n    }\n\n    /**\n     * Reads a 16-bit number.\n     *\n     * @param address where to read\n     * @return the number, from 0 to 65535\n     */\n    unsafe fun load16(address: int): int {\n        return __mem(4, address, 0, 0)\n    }\n\n    /**\n     * Reads a 32-bit number.\n     *\n     * @param address where to read\n     * @return the number, from 0 to 4294967295\n     */\n    unsafe fun load32(address: int): int {\n        return __mem(5, address, 0, 0)\n    }\n\n    /**\n     * Reads a 64-bit number.\n     *\n     * @param address where to read\n     * @return the number as an `int`\n     */\n    unsafe fun load64(address: int): int {\n        return __mem(6, address, 0, 0)\n    }\n\n    /**\n     * Reads a 64-bit float.\n     *\n     * @param address where to read\n     * @return the float stored there\n     */\n    unsafe fun loadFloat(address: int): float {\n        return __memLoadFloat(address)\n    }\n\n    /**\n     * Writes one byte: the lowest 8 bits of `value`.\n     *\n     * @param address where to write\n     * @param value the value, of which only the lowest 8 bits are kept\n     */\n    unsafe fun store8(address: int, value: int) {\n        __mem(7, address, value, 0)\n    }\n\n    /**\n     * Writes the lowest 16 bits of `value`.\n     *\n     * @param address where to write\n     * @param value the value, of which only the lowest 16 bits are kept\n     */\n    unsafe fun store16(address: int, value: int) {\n        __mem(8, address, value, 0)\n    }\n\n    /**\n     * Writes the lowest 32 bits of `value`.\n     *\n     * @param address where to write\n     * @param value the value, of which only the lowest 32 bits are kept\n     */\n    unsafe fun store32(address: int, value: int) {\n        __mem(9, address, value, 0)\n    }\n\n    /**\n     * Writes a 64-bit number.\n     *\n     * @param address where to write\n     * @param value the value\n     */\n    unsafe fun store64(address: int, value: int) {\n        __mem(10, address, value, 0)\n    }\n\n    /**\n     * Writes a 64-bit float.\n     *\n     * @param address where to write\n     * @param value the float\n     */\n    unsafe fun storeFloat(address: int, value: float) {\n        __memStoreFloat(address, value)\n    }\n\n    /**\n     * Copies `size` bytes from one place to another. The two may overlap.\n     *\n     * @param to where to write\n     * @param from where to read\n     * @param size how many bytes; nothing happens when it is 0 or less\n     */\n    unsafe fun copy(to: int, from: int, size: int) {\n        __mem(13, to, from, size)\n    }\n\n    /**\n     * Sets `size` bytes to the same byte.\n     *\n     * @param address where to start\n     * @param byte the byte, of which only the lowest 8 bits are kept\n     * @param size how many bytes; nothing happens when it is 0 or less\n     */\n    unsafe fun fill(address: int, byte: int, size: int) {\n        __mem(14, address, byte, size)\n    }\n}\n"
string "tools/fmt"
string "import \"std/strings\"\nimport \"std/math\"\nimport \"std/process\"\nimport \"std/fs\"\n\npriv const VERSION = \"2.0.0\"\n\npriv def enum Kind { Word, Num, Str, Comment, Op, Open, Close, Comma, Semi, Colon, Dot, GOpen, GClose }\n\npriv def type Tok {\n    Kind kind\n    string text\n    bool tight\n}\n\npriv var KEYWORDS_SPACE = [\n    \"if\", \"while\", \"for\", \"return\", \"else\", \"import\", \"fun\", \"var\", \"const\", \"def\", \"pub\", \"priv\", \"async\", \"await\", \"in\", \"is\", \"as\", \"static\", \"match\"\n]\n\npriv var TWO_CHAR_OPS = [\"==\", \"!=\", \"<=\", \">=\", \"&&\", \"||\", \"+=\", \"-=\", \"*=\", \"/=\", \"%=\", \"&=\", \"|=\", \"^=\", \"<<\", \">>\", \"=>\", \"..\", \"->\", \"!!\", \"::\", \"??\"]\npriv var THREE_CHAR_OPS = [\"..=\", \">>>\", \"<<=\", \">>=\"]\n\npriv var GENERIC_TYPES = [\"Future\", \"Task\", \"Map\", \"Array\"]\n\npriv var DECL_WORDS = [\"fun\", \"static\", \"def\", \"async\", \"pub\", \"priv\"]\n\npriv fun isAsciiDigit(c: string): bool {\n    return c >= \"0\" && c <= \"9\"\n}\n\npriv fun isAsciiAlnum(c: string): bool {\n    return isAsciiDigit(c) || (c >= \"a\" && c <= \"z\") || (c >= \"A\" && c <= \"Z\")\n}\n\npriv fun isWordStart(c: string): bool {\n    return c == \"_\" || isLetter(c)\n}\n\npriv fun isWordChar(c: string): bool {\n    return c == \"_\" || isAlphanumeric(c)\n}\n\npriv fun isSpace(c: string): bool {\n    return isWhitespace(c)\n}\n\npriv fun tok(kind: Kind, text: string): Tok {\n    return Tok { kind: kind, text: text, tight: false }\n}\n\npriv var GENERIC_CHARS = [\" \", \",\", \"[\", \"]\", \"{\", \"}\", \":\", \"?\", \"(\", \")\"]\n\npriv fun genericMarks(cs: [string], open: int): [int] {\n    [int] none = []\n    if (open == 0 || !isWordChar(cs[open - 1])) {\n        return none\n    }\n    var depth = 0\n    [int] marks = []\n    var j = open\n    while (j < len(cs)) {\n        var c = cs[j]\n        if (c == \"<\") {\n            depth += 1\n            marks.push(j)\n        } else if (c == \">\") {\n            depth -= 1\n            marks.push(j)\n            if (depth == 0) {\n                return marks\n            }\n        } else if (!(isWordChar(c) || contains(GENERIC_CHARS, c))) {\n            return none\n        }\n        j += 1\n    }\n    return none\n}\n\npriv fun lexLine(line: string): [Tok] {\n    var cs = chars(line)\n    var n = len(cs)\n    var out: [Tok] = []\n    [int] generic = []\n    var i = 0\n    while (i < n) {\n        var c = cs[i]\n        if (contains(generic, i)) {\n            if (c == \"<\") {\n                out.push(tok(Kind.GOpen, c))\n            } else {\n                out.push(tok(Kind.GClose, c))\n            }\n            i += 1\n            continue\n        }\n        if (c == \"<\") {\n            var marks = genericMarks(cs, i)\n            if (len(marks) > 0) {\n                generic = marks\n                out.push(tok(Kind.GOpen, c))\n                i += 1\n                continue\n            }\n        }\n        if (c == \" \" || c == \"\\t\") {\n            i += 1\n            continue\n        }\n        if (c == \"/\" && i + 1 < n && cs[i + 1] == \"/\") {\n            out.push(tok(Kind.Comment, join(slice(cs, i, n), \"\")))\n            break\n        }\n        if (c == \"\\\"\" || c == \"'\") {\n            var start = i\n            i += 1\n            var depth = 0\n            while (i < n) {\n                if (cs[i] == \"\\\\\") {\n                    i += 2\n                    continue\n                }\n                if (cs[i] == \"$\" && i + 1 < n && cs[i + 1] == \"{\") {\n                    depth += 1\n                    i += 2\n                    continue\n                }\n                if (depth > 0 && cs[i] == \"}\") {\n                    depth -= 1\n                    i += 1\n                    continue\n                }\n                if (depth == 0 && cs[i] == c) {\n                    i += 1\n                    break\n                }\n                i += 1\n            }\n            out.push(tok(Kind.Str, join(slice(cs, start, min(i, n)), \"\")))\n            continue\n        }\n        if (isWordStart(c)) {\n            var start = i\n            while (i < n && isWordChar(cs[i])) {\n                i += 1\n            }\n            out.push(tok(Kind.Word, join(slice(cs, start, i), \"\")))\n            continue\n        }\n        if (isAsciiDigit(c)) {\n            var start = i\n            var hex = false\n            while (i < n) {\n                var d = cs[i]\n                if (d == \"x\" || d == \"X\") {\n                    hex = true\n                }\n                var exponentSign = (d == \"-\" || d == \"+\") && (cs[i - 1] == \"e\" || cs[i - 1] == \"E\") && !hex\n                if (isAsciiAlnum(d) || d == \"_\" || (d == \".\" && i + 1 < n && isAsciiDigit(cs[i + 1])) || exponentSign) {\n                    i += 1\n                } else {\n                    break\n                }\n            }\n            out.push(tok(Kind.Num, join(slice(cs, start, i), \"\")))\n            continue\n        }\n        var two = join(slice(cs, i, min(i + 2, n)), \"\")\n        var three = join(slice(cs, i, min(i + 3, n)), \"\")\n        var four = join(slice(cs, i, min(i + 4, n)), \"\")\n        if (four == \">>>=\") {\n            out.push(tok(Kind.Op, four))\n            i += 4\n            continue\n        }\n        if (contains(THREE_CHAR_OPS, three)) {\n            out.push(tok(Kind.Op, three))\n            i += 3\n            continue\n        }\n        if (contains(TWO_CHAR_OPS, two)) {\n            out.push(tok(Kind.Op, two))\n            i += 2\n            continue\n        }\n        if (c == \"(\" || c == \"[\" || c == \"{\") {\n            out.push(Tok { kind: Kind.Open, text: c, tight: i + 1 < n && !isSpace(cs[i + 1]) })\n        } else if (c == \")\" || c == \"]\" || c == \"}\") {\n            out.push(Tok { kind: Kind.Close, text: c, tight: i > 0 && !isSpace(cs[i - 1]) })\n        } else if (c == \",\") {\n            out.push(tok(Kind.Comma, c))\n        } else if (c == \";\") {\n            out.push(tok(Kind.Semi, c))\n        } else if (c == \":\") {\n            out.push(tok(Kind.Colon, c))\n        } else if (c == \".\") {\n            out.push(tok(Kind.Dot, c))\n        } else {\n            out.push(tok(Kind.Op, c))\n        }\n        i += 1\n    }\n    return out\n}\n\npriv fun isOperandEnd(t: Tok): bool {\n    if (t.kind == Kind.Word) {\n        return !contains(KEYWORDS_SPACE, t.text) || t.text == \"self\"\n    }\n    if (t.kind == Kind.Num || t.kind == Kind.Str || t.kind == Kind.Close || t.kind == Kind.GClose) {\n        return true\n    }\n    if (t.kind == Kind.Op) {\n        return t.text == \"?\" || t.text == \"!!\"\n    }\n    return false\n}\n\npriv fun isRange(t: Tok): bool {\n    return t.kind == Kind.Op && (t.text == \"..\" || t.text == \"..=\")\n}\n\npriv fun isOpen(t: Tok, c: string): bool {\n    return t.kind == Kind.Open && t.text == c\n}\n\npriv fun isClose(t: Tok, c: string): bool {\n    return t.kind == Kind.Close && t.text == c\n}\n\npriv fun isPunct(t: Tok): bool {\n    return t.kind == Kind.Comma || t.kind == Kind.Semi || t.kind == Kind.Colon\n}\n\npriv fun isStructHead(toks: [Tok]): bool {\n    var words: [string] = []\n    for t in toks {\n        if (len(words) == 5) {\n            break\n        }\n        if (t.kind == Kind.Word) {\n            words.push(t.text)\n        } else {\n            words.push(\"\")\n        }\n    }\n    var start = 0\n    if (len(words) > 0 && (words[0] == \"pub\" || words[0] == \"priv\")) {\n        start = 1\n    }\n    if (len(words) <= start || words[start] != \"def\") {\n        return false\n    }\n    for i in start + 1..min(start + 3, len(words)) {\n        if (words[i] == \"struct\") {\n            return true\n        }\n    }\n    return false\n}\n\npriv fun renderLine(toks: [Tok]): string {\n    var parts: [string] = []\n    var genericDepth = 0\n    var head = isStructHead(toks)\n    var parens = 0\n    for idx, t in toks {\n        var space = true\n        if (idx == 0) {\n            space = false\n        } else {\n            var p = toks[idx - 1]\n            if (t.kind == Kind.GOpen || p.kind == Kind.GOpen || t.kind == Kind.GClose) {\n                space = false\n            } else if (p.kind == Kind.GClose && (isOpen(t, \"(\") || isOpen(t, \"[\"))) {\n                space = false\n            } else if (t.kind == Kind.Colon && head && parens == 0) {\n                space = true\n            } else if (t.kind == Kind.Comment) {\n                space = true\n            } else if (p.kind == Kind.Op && p.text == \"@\") {\n                space = false\n            } else if (isOpen(p, \"{\")) {\n                space = !p.tight && !isClose(t, \"}\")\n            } else if (p.kind == Kind.Open) {\n                space = false\n            } else if (isClose(t, \"}\")) {\n                space = !t.tight && !isOpen(p, \"{\")\n            } else if (t.kind == Kind.Close) {\n                space = false\n            } else if (isPunct(t)) {\n                space = false\n            } else if (isPunct(p)) {\n                space = true\n            } else if (t.kind == Kind.Dot || p.kind == Kind.Dot) {\n                space = false\n            } else if (isRange(p) || isRange(t)) {\n                space = false\n            } else if (p.kind == Kind.Op && p.text == \"!!\") {\n                space = !(t.kind == Kind.Dot || isOpen(t, \"(\") || isOpen(t, \"[\"))\n            } else if (t.kind == Kind.Op && (t.text == \"!!\" || t.text == \"?\")) {\n                space = false\n            } else if (p.kind == Kind.Op && (p.text == \"!\" || p.text == \"~\") && isOpen(t, \"(\")) {\n                space = false\n            } else if (p.kind == Kind.Word && isOpen(t, \"(\")) {\n                space = contains(KEYWORDS_SPACE, p.text) && p.text != \"fun\"\n            } else if (p.kind == Kind.Word && t.kind == Kind.Op && t.text == \"<\" && contains(GENERIC_TYPES, p.text)) {\n                genericDepth += 1\n                space = false\n            } else if (p.kind == Kind.Op && p.text == \"<\" && genericDepth > 0) {\n                space = false\n            } else if (t.kind == Kind.Op && t.text == \">\" && genericDepth > 0) {\n                genericDepth -= 1\n                space = false\n            } else if (t.kind == Kind.Op && t.text == \">>\" && genericDepth > 1) {\n                genericDepth -= 2\n                space = false\n            } else if (isOpen(t, \"{\")) {\n                space = true\n            } else if (isOpen(t, \"(\") || isOpen(t, \"[\")) {\n                space = !isOperandEnd(p) || (p.kind == Kind.Word && contains(KEYWORDS_SPACE, p.text))\n            } else if (p.kind == Kind.Op && p.text == \"~\") {\n                space = false\n            } else if (p.kind == Kind.Op && (p.text == \"-\" || p.text == \"!\")) {\n                space = idx >= 2 && isOperandEnd(toks[idx - 2]) && p.text == \"-\"\n            } else {\n                space = true\n            }\n        }\n        if (space && len(parts) > 0) {\n            parts.push(\" \")\n        }\n        parts.push(t.text)\n        if (isOpen(t, \"(\")) {\n            parens += 1\n        } else if (isClose(t, \")\")) {\n            parens -= 1\n        }\n    }\n    return join(parts, \"\")\n}\n\npriv fun splitSegments(toks: [Tok]): [[Tok]] {\n    var n = len(toks)\n    [bool] openMatched = []\n    [bool] closeLocal = []\n    for i in 0..n {\n        openMatched.push(false)\n        closeLocal.push(false)\n    }\n    [int] stack = []\n    for i, t in toks {\n        if (isOpen(t, \"{\")) {\n            stack.push(i)\n        } else if (isClose(t, \"}\") && len(stack) > 0) {\n            var o = pop(stack)\n            openMatched[o] = true\n            closeLocal[i] = true\n        }\n    }\n    [[Tok]] segs = []\n    [Tok] cur = []\n    for i, t in toks {\n        if (isClose(t, \"}\") && !closeLocal[i] && len(cur) > 0) {\n            segs.push(cur)\n            cur = []\n        }\n        cur.push(t)\n        if (isOpen(t, \"{\") && !openMatched[i] && i + 1 < n) {\n            segs.push(cur)\n            cur = []\n        }\n    }\n    if (len(cur) > 0) {\n        segs.push(cur)\n    }\n    [[Tok]] merged = []\n    for seg in segs {\n        if (len(seg) == 1 && seg[0].kind == Kind.Comment && len(merged) > 0) {\n            merged[len(merged) - 1].push(seg[0])\n            continue\n        }\n        merged.push(seg)\n    }\n    return merged\n}\n\npriv fun sourceLines(src: string): [string] {\n    var lines = split(src, \"\\n\")\n    if (len(lines) > 0 && lines[len(lines) - 1] == \"\") {\n        pop(lines)\n    }\n    return lines\n}\n\npriv fun trimEnd(text: string): string {\n    var cs = chars(text)\n    var end = len(cs)\n    while (end > 0 && isSpace(cs[end - 1])) {\n        end -= 1\n    }\n    return join(slice(cs, 0, end), \"\")\n}\n\npriv var ASM_TARGETS = [\"x86_64\", \"arm64\", \"aarch64\", \"bvm\", \"js\"]\n\npriv fun braceBalance(line: string): int {\n    var n = 0\n    for c in chars(line) {\n        if (c == \"{\") {\n            n += 1\n        } else if (c == \"}\") {\n            n -= 1\n        }\n    }\n    return n\n}\n\npriv fun asmSectionHead(line: string): string? {\n    var open = indexOf(line, \"{\")\n    if (open < 0) {\n        return null\n    }\n    var name = trim(substring(line, 0, open))\n    if (!contains(ASM_TARGETS, name)) {\n        return null\n    }\n    return name\n}\n\npriv fun leadingSpace(line: string): int {\n    var n = 0\n    for c in chars(line) {\n        if (c != \" \" && c != \"\\t\") {\n            break\n        }\n        n += 1\n    }\n    return n\n}\n\npriv fun reindented(lines: [string], depth: int): [string] {\n    var anchor = -1\n    for line in lines {\n        var t = trim(line)\n        if (t != \"\" && !endsWith(t, \":\")) {\n            anchor = leadingSpace(line)\n            break\n        }\n    }\n    if (anchor < 0) {\n        anchor = 4 * depth\n    }\n    [string] out = []\n    for line in lines {\n        var t = trim(line)\n        if (t == \"\") {\n            out.push(\"\\n\")\n        } else {\n            var n = leadingSpace(line) - anchor + 4 * depth\n            if (n < 0) {\n                n = 0\n            }\n            out.push(repeat(\" \", n) + trimEnd(t) + \"\\n\")\n        }\n    }\n    return out\n}\n\npriv fun indentFor(seg: [Tok], levels: [int]): int {\n    var before = len(levels)\n    var touched = 0\n    var partial = false\n    var i = 0\n    while (i < len(seg) && seg[i].kind == Kind.Close) {\n        if (len(levels) > 0) {\n            var top = len(levels) - 1\n            levels[top] = levels[top] - 1\n            partial = levels[top] > 0\n            if (!partial) {\n                levels.pop()\n                touched += 1\n            }\n        }\n        i += 1\n    }\n    var indent = before - touched\n    if (i > 0 && partial) {\n        indent = before - touched - 1\n    }\n    var fresh = 0\n    for j in i..len(seg) {\n        var t = seg[j]\n        if (t.kind == Kind.Open) {\n            fresh += 1\n        } else if (t.kind == Kind.Close) {\n            if (fresh > 0) {\n                fresh -= 1\n            } else if (len(levels) > 0) {\n                var top = len(levels) - 1\n                levels[top] = levels[top] - 1\n                if (levels[top] <= 0) {\n                    levels.pop()\n                }\n            }\n        }\n    }\n    if (fresh > 0) {\n        if (i > 0 && partial && len(levels) > 0) {\n            levels[len(levels) - 1] = levels[len(levels) - 1] + fresh\n        } else {\n            levels.push(fresh)\n        }\n    }\n    return indent\n}\n\n/**\n * Formats Burn source code the way `burn fmt` and `burnfmt` do: indentation of four spaces per level, spacing\n * around operators and commas, and blank lines between declarations.\n * @param src the source code of a Burn file\n * @return the formatted source\n * @example\n * import \"tools/fmt\"\n *\n * print(format(\"fun f(){\\nreturn 1\\n}\"))\n */\npub fun format(src: string): string {\n    [string] out = []\n    [int] levels = []\n    var blank = 0\n    var inBlockComment = false\n    var started = false\n    var lastWasClose = false\n    var asmLevel = -1\n    var rawDepth = 0\n    [string] rawLines = []\n    for raw in sourceLines(src) {\n        var line = trim(raw)\n        if (rawDepth > 0) {\n            rawDepth += braceBalance(line)\n            if (rawDepth > 0) {\n                rawLines.push(raw)\n                continue\n            }\n            rawDepth = 0\n            if (line != \"}\") {\n                rawLines.push(raw)\n                for l in reindented(rawLines, len(levels)) {\n                    out.push(l)\n                }\n                rawLines = []\n                indentFor(lexLine(\"}\"), levels)\n                lastWasClose = true\n                continue\n            }\n            for l in reindented(rawLines, len(levels)) {\n                out.push(l)\n            }\n            rawLines = []\n        }\n        if (asmLevel >= 0 && len(levels) == asmLevel + 1 && asmSectionHead(line) != null) {\n            out.push(repeat(\"    \", len(levels)) + line + \"\\n\")\n            var balance = braceBalance(line)\n            if (balance > 0) {\n                indentFor(lexLine(\"{\"), levels)\n                rawDepth = balance\n            }\n            lastWasClose = false\n            blank = 0\n            started = true\n            continue\n        }\n        if (asmLevel >= 0 && len(levels) <= asmLevel) {\n            asmLevel = -1\n        }\n        if (line == \"asm {\" && asmLevel < 0) {\n            asmLevel = len(levels)\n        }\n        if (inBlockComment) {\n            if (startsWith(line, \"*\")) {\n                out.push(repeat(\"    \", len(levels)) + \" \" + line + \"\\n\")\n            } else {\n                out.push(trimEnd(raw) + \"\\n\")\n            }\n            if (contains(line, \"*/\")) {\n                inBlockComment = false\n            }\n            continue\n        }\n        if (startsWith(line, \"/*\")) {\n            if ((started && blank > 0) || lastWasClose) {\n                out.push(\"\\n\")\n            }\n            blank = 0\n            lastWasClose = false\n            started = true\n            out.push(repeat(\"    \", len(levels)) + line + \"\\n\")\n            inBlockComment = !contains(line, \"*/\")\n            continue\n        }\n        if (line == \"\") {\n            blank += 1\n            continue\n        }\n        var first = started && blank > 0\n        blank = 0\n        for si, seg in splitSegments(lexLine(line)) {\n            var leadingClose = 0\n            while (leadingClose < len(seg) && seg[leadingClose].kind == Kind.Close) {\n                leadingClose += 1\n            }\n            var isDecl = (seg[0].kind == Kind.Word && contains(DECL_WORDS, seg[0].text)) || (seg[0].kind == Kind.Op && seg[0].text == \"@\")\n            if ((si == 0 && first && !(leadingClose > 0 && len(seg) == 1)) || (isDecl && lastWasClose)) {\n                out.push(\"\\n\")\n            }\n            lastWasClose = len(seg) == 1 && isClose(seg[0], \"}\")\n            out.push(repeat(\"    \", indentFor(seg, levels)) + renderLine(seg) + \"\\n\")\n        }\n        started = true\n    }\n    for l in rawLines {\n        out.push(trimEnd(l) + \"\\n\")\n    }\n    return join(out, \"\")\n}\n\npriv fun usage() {\n    print(\"burnfmt ${VERSION} - the Burn code formatter, written in Burn\")\n    print(\"\")\n    print(\"Usage:\")\n    print(\"  burnfmt [options] [file...]\")\n    print(\"\")\n    print(\"Options:\")\n    print(\"  -w, --write     write the result back to the files\")\n    print(\"  -l, --check     list files that are not formatted and exit with 1\")\n    print(\"  -h, --help      show this help\")\n    print(\"  -v, --version   show the version\")\n    print(\"\")\n    print(\"Without files, burnfmt formats standard input.\")\n}\n\npriv fun main() {\n    var writeBack = false\n    var check = false\n    [string] files = []\n    for a in args() {\n        if (a == \"-w\" || a == \"--write\") {\n            writeBack = true\n        } else if (a == \"-l\" || a == \"--list\" || a == \"--check\") {\n            check = true\n        } else if (a == \"-h\" || a == \"--help\") {\n            usage()\n            return\n        } else if (a == \"-v\" || a == \"--version\") {\n            print(\"burnfmt ${VERSION}\")\n            return\n        } else if (startsWith(a, \"-\")) {\n            eprint(\"burnfmt: unknown option ${a}\")\n            exit(2)\n        } else {\n            files.push(a)\n        }\n    }\n    if (len(files) == 0) {\n        write(format(readStdin()))\n        return\n    }\n    var code = 0\n    for f in files {\n        if (!fileExists(f)) {\n            eprint(\"burnfmt: cannot read ${f}\")\n            code = 1\n            continue\n        }\n        var src = readFile(f)\n        var formatted = format(src)\n        if (check) {\n            if (formatted != src) {\n                print(\"${f} is not formatted\")\n                code = 1\n            }\n        } else if (writeBack) {\n            if (formatted != src && !writeFile(f, formatted)) {\n                eprint(\"burnfmt: cannot write ${f}\")\n                code = 1\n            }\n        } else {\n            write(formatted)\n        }\n    }\n    exit(code)\n}\n"
