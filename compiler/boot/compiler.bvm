; bvm module, format 2
@RefCounted
module main

type #12 = int8
type #13 = uint8
type #14 = int16
type #15 = uint16
type #16 = int32
type #17 = uint32
type #18 = uint64
type #19 = float32
type Built = record { diagnostics: string, module: #492 }
type HGlobal = record { name: string, ty: int, module: string }
type HInit = record { key: string, func: int }
type HProgram = record { name: string, entry: int, main: #493, noStd: bool, funcs: #494, globals: #495, inits: #496 }
type CheckResult = record { checker: Checker, program: #497, diags: #498 }
type Severity = enum { Error, Warning }
type Edit = record { start: int, end: int, text: string }
type Suggestion = record { message: string, edits: #499, applicable: bool }
type Diag = record { severity: Severity, start: int, end: int, message: string, notes: [string], helps: [string], suggestions: #500 }
type SourceFile = struct { name: string, src: string, path: #492, bytes: #501, lineStarts: [int] }
type Patch = record { line: int, text: string, marks: string }
type Paint = record { red: string, yellow: string, blue: string, cyan: string, green: string, bold: string, reset: string }
type ImportRef = record { target: int, start: int, end: int, alias: #492, local: bool }
type LoadedModule = record { file: int, ast: Module, imports: #502, libs: #502, key: string }
type LoadedLib = record { name: string, path: string, info: #492 }
type LoadDiag = record { file: int, diag: Diag }
type Loaded = record { files: #503, modules: #504, libs: #505, order: [int], diags: #498, root: int, noStd: bool }
type PackageBuilder = interface
type Loader = struct { files: #503, modules: #504, libs: #505, diags: #498, byKey: #506, overrides: #507, std: #508, projectTried: bool, project: #509, projectError: string, builder: #510 }
type Span = record { start: int, end: int }
type Ident = record { name: string, span: Span }
type Vis = enum { Default, Pub, Priv }
type StructKind = enum { Normal, Abstract, Static }
type UnOp = enum { Neg, Not, BitNot }
type BinOp = enum { Add, Sub, Mul, Div, Mod, Eq, Ne, Lt, Gt, Le, Ge, And, Or, BitAnd, BitOr, BitXor, Shl, Shr, UShr }
type Module = record { items: #511, hasDestroy: bool, nested: #512 }
type AnnArg = record { key: #513, value: Expr }
type Annotation = record { name: Ident, args: #514, span: Span }
type Item = record { kind: ItemKind, vis: Vis, span: Span, annotations: #515 }
type ImportPath = record { path: string, span: Span, alias: #513 }
type ItemKind = interface
type ItemKind.Import = record { paths: #512 } implements ItemKind
type ItemKind.Fun = record { decl: FunDecl } implements ItemKind
type ItemKind.Definition = record { d: Def } implements ItemKind
type ItemKind.Statement = record { stmt: Stmt } implements ItemKind
type Param = record { name: Ident, ty: TypeExpr }
type FunDecl = record { name: Ident, params: #516, ret: #517, body: Block, isAsync: bool, isStatic: bool, span: Span, annotations: #515, bodyless: bool, isAbstract: bool, tparams: #518, isUnsafe: bool }
type FunSig = record { name: Ident, params: #516, ret: #517, isAsync: bool }
type Field = record { name: Ident, ty: TypeExpr, value: #519, vis: Vis, annotations: #515 }
type SuperRef = record { name: Ident, args: #521 }
type StaticVal = record { name: Ident, ty: #517, init: Expr, isConst: bool, vis: Vis }
type Method = record { vis: Vis, decl: FunDecl }
type StructDef = record { name: Ident, kind: StructKind, params: #516, paramAnns: #522, extends: #523, supers: #524, colonExtra: int, fields: #525, methods: #526, statics: #527, tparams: #518 }
type Variant = record { name: Ident, fields: #528 }
type Def = interface
type Def.Type = record { name: Ident, fields: #525, tparams: #518 } implements Def
type Def.Alias = record { name: Ident, ty: TypeExpr } implements Def
type Def.Interface = record { name: Ident, methods: #529 } implements Def
type Def.Struct = record { s: StructDef } implements Def
type Def.Enum = record { name: Ident, variants: #530 } implements Def
type Def.Annotation = record { name: Ident, fields: #525 } implements Def
type TypeExpr = record { kind: TypeKind, span: Span }
type TypeKind = interface
type TypeKind.Named = record { name: string, args: #531 } implements TypeKind
type TypeKind.Array = record { elem: TypeExpr } implements TypeKind
type TypeKind.Optional = record { inner: TypeExpr } implements TypeKind
type TypeKind.Map = record { key: TypeExpr, value: TypeExpr } implements TypeKind
type TypeKind.Func = record { params: #531, ret: #517 } implements TypeKind
type Block = record { stmts: #532, span: Span }
type Stmt = record { kind: StmtKind, span: Span }
type ForIter = interface
type ForIter.Range = record { from: Expr, to: Expr, inclusive: bool } implements ForIter
type ForIter.Over = record { value: Expr } implements ForIter
type StmtKind = interface
type StmtKind.Var = record { name: Ident, ty: #517, init: #519, isConst: bool } implements StmtKind
type StmtKind.Eval = record { value: Expr } implements StmtKind
type StmtKind.If = record { cond: Expr, then: Block, els: #533 } implements StmtKind
type StmtKind.While = record { cond: Expr, body: Block } implements StmtKind
type StmtKind.For = record { init: #534, cond: #519, step: #519, body: Block } implements StmtKind
type StmtKind.ForIn = record { binding: Ident, index: #513, iter: ForIter, body: Block } implements StmtKind
type StmtKind.Return = record { value: #519 } implements StmtKind
type StmtKind.Break = record {} implements StmtKind
type StmtKind.Continue = record {} implements StmtKind
type StmtKind.Nested = record { block: Block } implements StmtKind
type StmtKind.Extend = record { target: Ident, decl: FunDecl } implements StmtKind
type StmtKind.Destroy = record { target: Ident, args: #520 } implements StmtKind
type StmtKind.Unsafe = record { block: Block } implements StmtKind
type StmtKind.Asm = record { sections: #535, fallback: #533 } implements StmtKind
type StmtKind.Import = record { paths: #512 } implements StmtKind
type AsmSection = record { target: Ident, code: string, span: Span }
type AsmOperand = record { name: string, offset: int }
type Expr = record { kind: ExprKind, span: Span }
type FieldInit = record { name: Ident, value: Expr }
type MapPair = record { key: Expr, value: Expr }
type TplExpr = interface
type TplExpr.Lit = record { text: string } implements TplExpr
type TplExpr.Code = record { value: Expr } implements TplExpr
type Pattern = interface
