    str "json"
    str "/**\n * Helpers to read and write JSON.\n *\n * Parsed JSON is returned as `any`: objects become `{string: any}` maps,\n * arrays become `[any]` lists, and numbers, strings, booleans and `null`\n * become the matching Burn values.\n *\n * @since 26.1\n */\npub def static struct JSON {\n    /**\n     * Parses JSON text.\n     *\n     * @param text the JSON text\n     * @return the parsed value\n     * @throws when the text is not valid JSON\n     * @see JSON.stringify\n     * @since 26.1\n     * @example\n     *     var data = JSON.parse(\"{\\\"name\\\": \\\"Ada\\\", \\\"tags\\\": [\\\"x\\\", \\\"y\\\"]}\")\n     *     JSON.get(data, \"name\")  // \"Ada\"\n     */\n    static fun parse(text: string): any {\n        return parseJSON(text)\n    }\n\n    /**\n     * Converts a value to compact JSON text.\n     *\n     * @param value the value to convert\n     * @return the JSON text, without spaces or line breaks\n     * @see JSON.parse\n     * @since 26.1\n     * @example\n     *     JSON.stringify([1, 2, 3])  // \"[1,2,3]\"\n     */\n    static fun stringify(value: any): string {\n        return toJSON(value)\n    }\n\n    /**\n     * Returns the value stored under a key of a JSON object.\n     *\n     * @param value the JSON object\n     * @param key the key to look up\n     * @return the value for `key`, or `null` if the object has no such key\n     * @throws when `value` cannot be indexed, for example a number\n     * @see JSON.at\n     * @since 26.1\n     * @example\n     *     var data = JSON.parse(\"{\\\"id\\\": 7}\")\n     *     JSON.get(data, \"id\")  // 7\n     */\n    static fun get(value: any, key: string): any {\n        return value[key]\n    }\n\n    /**\n     * Returns the element at a position of a JSON array.\n     *\n     * @param value the JSON array\n     * @param index the position, from 0 to the length minus 1\n     * @return the element at `index`\n     * @throws when the index is out of bounds or `value` cannot be indexed\n     * @see JSON.get\n     * @since 26.1\n     * @example\n     *     var list = JSON.parse(\"[10, 20, 30]\")\n     *     JSON.at(list, 1)  // 20\n     */\n    static fun at(value: any, index: int): any {\n        return value[index]\n    }\n\n    /**\n     * Tells whether a parsed JSON value is an object.\n     *\n     * @param value the value to test\n     * @return `true` if `value` is a `{string: any}` map\n     * @see JSON.isArray\n     * @since 26.1\n     * @example\n     *     JSON.isObject(JSON.parse(\"{}\"))  // true\n     */\n    static fun isObject(value: any): bool {\n        return value is {string: any}\n    }\n\n    /**\n     * Tells whether a parsed JSON value is an array.\n     *\n     * @param value the value to test\n     * @return `true` if `value` is an `[any]` list\n     * @see JSON.isObject\n     * @since 26.1\n     * @example\n     *     JSON.isArray(JSON.parse(\"[1, 2]\"))  // true\n     */\n    static fun isArray(value: any): bool {\n        return value is [any]\n    }\n}\n"
    new StdModule
