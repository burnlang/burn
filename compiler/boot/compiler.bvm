    str ":root {\n  --bg: #ffffff;\n  --panel: #f7f7f5;\n  --text: #1d1d1f;\n  --muted: #6b6b70;\n  --line: #e4e4e0;\n  --accent: #d9480f;\n  --accent-soft: #fff1ea;\n  --code-bg: #f4f3f0;\n  --kw: #a626a4;\n  --ty: #0b6bcb;\n  --str: #2f8a3c;\n  --num: #b35c00;\n  --com: #8a8a8f;\n  --mono: ui-monospace, SFMono-Regular, \"JetBrains Mono\", Menlo, Consolas, monospace;\n  --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #151517;\n    --panel: #1c1c1f;\n    --text: #e9e9ec;\n    --muted: #9a9aa2;\n    --line: #2d2d31;\n    --accent: #ff7a3d;\n    --accent-soft: #2a1d16;\n    --code-bg: #202024;\n    --kw: #d38ae6;\n    --ty: #66adff;\n    --str: #7fcf8a;\n    --num: #f0a45b;\n    --com: #7c7c85;\n  }\n}\n* { box-sizing: border-box; }\nhtml { scroll-padding-top: 72px; }\nbody { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.6 var(--sans); }\na { color: var(--accent); text-decoration: none; }\na:hover { text-decoration: underline; }\ncode, pre { font-family: var(--mono); font-size: 13.5px; }\np code, li code, td code, dd code { background: var(--code-bg); padding: 1px 5px; border-radius: 4px; }\ntd a code, dd a code, p a code, li a code { color: var(--accent); }\n.top {\n  position: sticky; top: 0; z-index: 10; height: 56px; display: flex; align-items: center; gap: 24px;\n  padding: 0 24px; background: var(--bg); border-bottom: 1px solid var(--line);\n}\n.brand { color: var(--text); font-weight: 650; font-size: 16px; white-space: nowrap; }\n.brand:hover { text-decoration: none; }\n.flame { font-size: 17px; }\n.search { position: relative; flex: 1; max-width: 460px; margin-left: auto; }\n.search input {\n  width: 100%; padding: 7px 12px; border: 1px solid var(--line); border-radius: 8px;\n  background: var(--panel); color: var(--text); font: inherit; font-size: 14px; outline: none;\n}\n.search input:focus { border-color: var(--accent); }\n#results {\n  position: absolute; top: 40px; left: 0; right: 0; max-height: 420px; overflow: auto;\n  background: var(--bg); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 32px rgba(0,0,0,.14);\n}\n#results a { display: block; padding: 8px 12px; color: var(--text); border-bottom: 1px solid var(--line); }\n#results a:last-child { border-bottom: 0; }\n#results a.sel, #results a:hover { background: var(--accent-soft); text-decoration: none; }\n#results .rk { float: right; color: var(--muted); font-size: 12px; }\n#results .rs { display: block; color: var(--muted); font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.wrap { display: flex; max-width: 1280px; margin: 0 auto; }\n.side {\n  width: 250px; flex-shrink: 0; padding: 20px 16px 40px 24px; position: sticky; top: 56px;\n  height: calc(100vh - 56px); overflow: auto; border-right: 1px solid var(--line);\n}\n.side ul { list-style: none; margin: 0 0 18px; padding: 0; }\n.side li a { display: block; padding: 3px 8px; border-radius: 6px; color: var(--text); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.side li a:hover { background: var(--panel); text-decoration: none; }\n.side li a.on { background: var(--accent-soft); color: var(--accent); font-weight: 600; }\n.nav-h { font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 6px 8px 6px; }\n.ic { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 8px; vertical-align: 1px; }\n.i-fn { background: #8f5bd8; } .i-st { background: var(--accent); } .i-if { background: #1f9d74; }\n.i-en { background: #c28a00; } .i-ty { background: #0b6bcb; } .i-va { background: #888; }\nmain { flex: 1; min-width: 0; padding: 28px 40px 60px; max-width: 980px; }\nh1 { font-size: 30px; line-height: 1.25; margin: 6px 0 14px; letter-spacing: -.01em; }\nh1 .kind { display: block; font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 2px; }\nh2 { font-size: 19px; margin: 34px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }\nh3 { font-size: 16px; margin: 0 0 8px; font-family: var(--mono); }\nh3 a { color: var(--text); }\n.crumbs { font-size: 13px; color: var(--muted); }\n.hier { font-family: var(--mono); font-size: 13px; color: var(--muted); margin-bottom: 8px; }\npre.sig {\n  background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--accent);\n  border-radius: 6px; padding: 10px 14px; overflow-x: auto; white-space: pre-wrap; margin: 8px 0 14px;\n}\npre.code { background: var(--code-bg); border-radius: 6px; padding: 10px 14px; overflow-x: auto; margin: 6px 0 12px; }\n.kw, .k { color: var(--kw); }\n.fn { font-weight: 650; }\n.pn { color: var(--text); }\n.prim, .ty, a.ty, .t { color: var(--ty); }\n.s { color: var(--str); } .n { color: var(--num); } .c { color: var(--com); font-style: italic; }\ntable.summary { width: 100%; border-collapse: collapse; font-size: 14.5px; }\ntable.summary td { padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }\ntable.summary tr:hover td { background: var(--panel); }\ntable.summary td.name { width: 38%; }\n.mini { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 2px; word-break: break-word; }\n.badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 0 6px; border-radius: 4px; background: var(--panel); border: 1px solid var(--line); color: var(--muted); vertical-align: 1px; }\n.badge.dep { color: #b42318; border-color: #f3c3bd; background: #fdf1ef; }\nsection.member { padding: 18px 0 8px; border-bottom: 1px solid var(--line); }\nsection.member:target { background: linear-gradient(90deg, var(--accent-soft), transparent 70%); margin: 0 -16px; padding-left: 16px; padding-right: 16px; }\ndl.tags { display: grid; grid-template-columns: 120px 1fr; gap: 6px 16px; margin: 10px 0; font-size: 14px; }\ndl.tags > dt { font-weight: 600; color: var(--muted); }\ndl.tags > dd { margin: 0; }\ndl.params { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 3px 12px; }\ndl.params dt, dl.params dd { margin: 0; }\n.example .label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-top: 10px; }\n.deprecated { border-left: 3px solid #d92d20; background: #fdf1ef; color: #7a271a; padding: 8px 12px; border-radius: 4px; margin: 8px 0; }\n@media (prefers-color-scheme: dark) { .deprecated { background: #2c1714; color: #f5b5ab; } .badge.dep { background: #2c1714; border-color: #5c2a22; color: #f5b5ab; } }\n.ann { font-family: var(--mono); font-size: 13px; color: var(--muted); }\n.inherited { font-size: 14px; margin: 12px 0; color: var(--muted); }\n.undoc { color: var(--muted); font-style: italic; }\nfooter { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }\n@media (max-width: 860px) {\n  .side { display: none; }\n  main { padding: 20px 16px 48px; }\n  .top { padding: 0 16px; gap: 12px; }\n  table.summary td.name { width: 45%; }\n  dl.tags { grid-template-columns: 1fr; }\n}\n"
