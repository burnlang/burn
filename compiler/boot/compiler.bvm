    str "process"
    str "/**\n * The result of a program run with {@link Process.output}.\n *\n * @param code the exit code, `0` on success, or `-1` if the program could not be started\n * @param out everything the program wrote to standard output\n * @param err everything the program wrote to standard error, or why it could not be started\n * @see Process.output\n * @since 26.1\n */\npub def type ProcessOutput {\n    int code\n    string out\n    string err\n}\n\n/**\n * Runs other programs and works with the current directory.\n *\n * Programs are found through `PATH`. {@link Process.run} shares the terminal\n * with the program, {@link Process.output} collects what it prints. The\n * `shell` variants hand a whole command line to `sh`, so pipes and `&&` work.\n *\n * @see ProcessOutput\n * @since 26.1\n * @example\n *     var code = Process.run(\"git\", [\"status\"])\n *     var branch = Process.output(\"git\", [\"branch\", \"--show-current\"]).out\n */\npub def static struct Process {\n    /**\n     * Runs a program in the terminal and waits for it.\n     *\n     * @param program the program to run\n     * @param args its arguments\n     * @return the exit code, or `-1` if the program could not be started\n     * @see Process.output\n     * @since 26.1\n     * @example\n     *     Process.run(\"git\", [\"init\"])\n     */\n    static fun run(program: string, args: [string]): int {\n        return toInt(__exec(program, args, false)[0])\n    }\n\n    /**\n     * Runs a program and collects its output.\n     *\n     * @param program the program to run\n     * @param args its arguments\n     * @return the exit code and both outputs\n     * @see Process.run\n     * @since 26.1\n     * @example\n     *     var r = Process.output(\"git\", [\"rev-parse\", \"HEAD\"])\n     *     if (r.code == 0) {\n     *         print(trim(r.out))\n     *     }\n     */\n    static fun output(program: string, args: [string]): ProcessOutput {\n        var raw = __exec(program, args, true)\n        return ProcessOutput { code: toInt(raw[0]), out: raw[1], err: raw[2] }\n    }\n\n    /**\n     * Runs a command line with `sh` in the terminal and waits for it.\n     *\n     * @param command the command line, for example `\"burnc src/main.bn -o build/app\"`\n     * @return the exit code\n     * @see Process.shellOutput\n     * @since 26.1\n     * @example\n     *     Process.shell(\"ls src | wc -l\")\n     */\n    static fun shell(command: string): int {\n        return Process.run(\"sh\", [\"-c\", command])\n    }\n\n    /**\n     * Runs a command line with `sh` and collects its output.\n     *\n     * @param command the command line\n     * @return the exit code and both outputs\n     * @see Process.shell\n     * @since 26.1\n     * @example\n     *     print(Process.shellOutput(\"echo $HOME\").out)\n     */\n    static fun shellOutput(command: string): ProcessOutput {\n        return Process.output(\"sh\", [\"-c\", command])\n    }\n\n    /**\n     * Returns the current working directory.\n     *\n     * @return its absolute path\n     * @see Process.setCwd\n     * @since 26.1\n     * @example\n     *     print(Process.cwd())\n     */\n    static fun cwd(): string {\n        return __cwd()\n    }\n\n    /**\n     * Changes the current working directory.\n     *\n     * Relative paths and programs started afterwards use the new directory.\n     *\n     * @param path the new working directory\n     * @return `true` when the directory exists and was entered\n     * @see Process.cwd\n     * @since 26.1\n     * @example\n     *     Process.setCwd(\"build\")\n     */\n    static fun setCwd(path: string): bool {\n        return __fsOp(\"chdir\", path, \"\")\n    }\n}\n"
