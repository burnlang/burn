    str "time"
    str "/**\n * Formats a number with leading zeros up to a given width.\n *\n * @param n the number, not negative\n * @param width the minimum number of digits\n * @return the number as text, for example `\"007\"` for `pad(7, 3)`\n * @since 26.1\n */\npriv fun pad(n: int, width: int): string {\n    var s = toString(n)\n    while (len(s) < width) {\n        s = \"0\" + s\n    }\n    return s\n}\n\n/**\n * A time of day or a duration, with millisecond precision.\n *\n * The fields are not validated or wrapped around: hours can go past 23,\n * which makes `Time` usable for durations as well.\n *\n * @param hours the hours, usually from 0 to 23\n * @param minutes the minutes, from 0 to 59\n * @param seconds the seconds, from 0 to 59\n * @param milliseconds the milliseconds, from 0 to 999\n * @see Time.create\n * @since 26.1\n * @example\n *     var t = new Time(9, 5, 30, 250)\n *     t.formatWithMs()  // \"09:05:30.250\"\n */\npub def struct Time(hours: int, minutes: int, seconds: int, milliseconds: int) {\n    /**\n     * Creates a time from its parts.\n     *\n     * @param hours the hours, usually from 0 to 23\n     * @param minutes the minutes, from 0 to 59\n     * @param seconds the seconds, from 0 to 59\n     * @param milliseconds the milliseconds, from 0 to 999\n     * @return the new time, not validated\n     * @see createTime\n     * @since 26.1\n     * @example\n     *     Time.create(14, 30, 0, 0).format()  // \"14:30:00\"\n     */\n    static fun create(hours: int, minutes: int, seconds: int, milliseconds: int): Time {\n        return new Time(hours, minutes, seconds, milliseconds)\n    }\n\n    /**\n     * Returns the current time of day in the local time zone.\n     *\n     * @return the current time\n     * @see currentTime\n     * @since 26.1\n     * @example\n     *     print(\"It is \" + Time.now().format())\n     */\n    static fun now(): Time {\n        var t = __localTime()\n        return new Time(t[3], t[4], t[5], t[6])\n    }\n\n    /**\n     * Converts a number of milliseconds to a time.\n     *\n     * The milliseconds are split into hours, minutes, seconds and\n     * milliseconds. Hours are not wrapped at 24. A negative number gives negative\n     * fields.\n     *\n     * @param ms the number of milliseconds, not negative\n     * @return the time\n     * @see Time.toMilliseconds\n     * @since 26.1\n     * @example\n     *     Time.fromMilliseconds(3723004).formatWithMs()  // \"01:02:03.004\"\n     */\n    static fun fromMilliseconds(ms: int): Time {\n        var rest = ms\n        var h = rest / 3600000\n        rest -= h * 3600000\n        var m = rest / 60000\n        rest -= m * 60000\n        var s = rest / 1000\n        rest -= s * 1000\n        return new Time(h, m, s, rest)\n    }\n\n    /**\n     * Converts a number of seconds to a time.\n     *\n     * The seconds are rounded to the nearest millisecond.\n     *\n     * @param seconds the number of seconds, not negative\n     * @return the time\n     * @see Time.toSeconds\n     * @since 26.1\n     * @example\n     *     Time.fromSeconds(90.5).formatWithMs()  // \"00:01:30.500\"\n     */\n    static fun fromSeconds(seconds: float): Time {\n        return Time.fromMilliseconds(round(seconds * 1000.0))\n    }\n\n    /**\n     * Parses a time written as `H:MM:SS` with optional milliseconds.\n     *\n     * Accepts `H`, `H:MM` or `H:MM:SS`, optionally followed by a fraction\n     * of a second such as `.5`, `.25` or `.250`. Missing parts are 0, and\n     * the parts do not need leading zeros. Nothing is range-checked.\n     *\n     * @param text the text to parse, for example `\"09:05:30.250\"`\n     * @return the parsed time\n     * @throws when a part is not a whole number\n     * @see Time.format\n     * @see parseTime\n     * @since 26.1\n     * @example\n     *     Time.parse(\"1:02:03.5\").formatWithMs()  // \"01:02:03.500\"\n     */\n    static fun parse(text: string): Time {\n        var main = text\n        var ms = 0\n        var dot = indexOf(text, \".\")\n        if (dot >= 0) {\n            main = substring(text, 0, dot)\n            var frac = substring(text, dot + 1)\n            ms = toInt(frac)\n            if (len(frac) == 1) {\n                ms *= 100\n            } else if (len(frac) == 2) {\n                ms *= 10\n            }\n        }\n        var parts = split(main, \":\")\n        var h = 0\n        var m = 0\n        var s = 0\n        if (len(parts) >= 1) {\n            h = toInt(parts[0])\n        }\n        if (len(parts) >= 2) {\n            m = toInt(parts[1])\n        }\n        if (len(parts) >= 3) {\n            s = toInt(parts[2])\n        }\n        return new Time(h, m, s, ms)\n    }\n\n    /**\n     * Returns this time as a total number of milliseconds.\n     *\n     * @return the total number of milliseconds\n     * @see Time.fromMilliseconds\n     * @since 26.1\n     * @example\n     *     Time.create(0, 1, 30, 0).toMilliseconds()  // 90000\n     */\n    fun toMilliseconds(): int {\n        return self.hours * 3600000 + self.minutes * 60000 + self.seconds * 1000 + self.milliseconds\n    }\n\n    /**\n     * Returns this time as a total number of seconds.\n     *\n     * @return the total number of seconds, including the milliseconds as a fraction\n     * @see Time.fromSeconds\n     * @since 26.1\n     * @example\n     *     Time.create(0, 1, 30, 500).toSeconds()  // 90.5\n     */\n    fun toSeconds(): float {\n        return self.toMilliseconds() / 1000.0\n    }\n\n    /**\n     * Adds another time to this one.\n     *\n     * The result is not wrapped at 24 hours.\n     *\n     * @param other the time to add\n     * @return a new time; this time is not changed\n     * @see Time.subtract\n     * @since 26.1\n     * @example\n     *     Time.create(1, 45, 0, 0).add(Time.create(0, 30, 0, 0)).format()  // \"02:15:00\"\n     */\n    fun add(other: Time): Time {\n        return Time.fromMilliseconds(self.toMilliseconds() + other.toMilliseconds())\n    }\n\n    /**\n     * Subtracts another time from this one.\n     *\n     * If `other` is longer than this time, the result has negative fields,\n     * see {@link Time.fromMilliseconds}.\n     *\n     * @param other the time to subtract\n     * @return a new time; this time is not changed\n     * @see Time.add\n     * @since 26.1\n     * @example\n     *     Time.create(2, 15, 0, 0).subtract(Time.create(0, 30, 0, 0)).format()  // \"01:45:00\"\n     */\n    fun subtract(other: Time): Time {\n        return Time.fromMilliseconds(self.toMilliseconds() - other.toMilliseconds())\n    }\n\n    /**\n     * Formats this time as `HH:MM:SS` text.\n     *\n     * Each field has at least two digits. The milliseconds are left out,\n     * see {@link Time.formatWithMs}.\n     *\n     * @return the formatted time, for example `\"09:05:30\"`\n     * @see Time.formatWithMs\n     * @since 26.1\n     * @example\n     *     Time.create(9, 5, 30, 250).format()  // \"09:05:30\"\n     */\n    fun format(): string {\n        return \"${pad(self.hours, 2)}:${pad(self.minutes, 2)}:${pad(self.seconds, 2)}\"\n    }\n\n    /**\n     * Formats this time as `HH:MM:SS.mmm` text.\n     *\n     * @return the formatted time, for example `\"09:05:30.250\"`\n     * @see Time.format\n     * @since 26.1\n     * @example\n     *     Time.create(9, 5, 30, 7).formatWithMs()  // \"09:05:30.007\"\n     */\n    fun formatWithMs(): string {\n        return \"${self.format()}.${pad(self.milliseconds, 3)}\"\n    }\n}\n\n/**\n * Creates a time from its parts.\n *\n * Same as {@link Time.create}.\n *\n * @param hours the hours, usually from 0 to 23\n * @param minutes the minutes, from 0 to 59\n * @param seconds the seconds, from 0 to 59\n * @param milliseconds the milliseconds, from 0 to 999\n * @return the new time, not validated\n * @see Time.create\n * @since 26.1\n */\npub fun createTime(hours: int, minutes: int, seconds: int, milliseconds: int): Time {\n    return Time.create(hours, minutes, seconds, milliseconds)\n}\n\n/**\n * Formats a number of seconds as `HH:MM:SS` text.\n *\n * The seconds are rounded to the nearest millisecond, and the\n * milliseconds are then left out.\n *\n * @param totalSeconds the number of seconds, not negative\n * @return the formatted time, for example `\"01:02:05\"`\n * @see parseTime\n * @since 26.1\n * @example\n *     formatTime(3725.0)  // \"01:02:05\"\n */\npub fun formatTime(totalSeconds: float): string {\n    return Time.fromSeconds(totalSeconds).format()\n}\n\n/**\n * Parses a time written as `H:MM:SS` and returns it in seconds.\n *\n * Accepts the same forms as {@link Time.parse}.\n *\n * @param text the text to parse, for example `\"01:02:05.5\"`\n * @return the total number of seconds\n * @throws when a part is not a whole number\n * @see formatTime\n * @since 26.1\n * @example\n *     parseTime(\"01:02:05.5\")  // 3725.5\n */\npub fun parseTime(text: string): float {\n    return Time.parse(text).toSeconds()\n}\n\n/**\n * Returns the current local time of day as `HH:MM:SS` text.\n *\n * @return the current time, for example `\"14:30:00\"`\n * @see Time.now\n * @since 26.1\n * @example\n *     print(\"It is \" + currentTime())\n */\npub fun currentTime(): string {\n    return Time.now().format()\n}\n\n/**\n * Converts hours to minutes.\n *\n * @param hours the number of hours\n * @return the number of minutes\n * @see minutesToHours\n * @since 26.1\n * @example\n *     hoursToMinutes(1.5)  // 90.0\n */\npub fun hoursToMinutes(hours: float): float {\n    return hours * 60.0\n}\n\n/**\n * Converts minutes to hours.\n *\n * @param minutes the number of minutes\n * @return the number of hours\n * @see hoursToMinutes\n * @since 26.1\n * @example\n *     minutesToHours(90.0)  // 1.5\n */\npub fun minutesToHours(minutes: float): float {\n    return minutes / 60.0\n}\n\n/**\n * Converts hours to seconds.\n *\n * @param hours the number of hours\n * @return the number of seconds\n * @see secondsToHours\n * @since 26.1\n * @example\n *     hoursToSeconds(2.0)  // 7200.0\n */\npub fun hoursToSeconds(hours: float): float {\n    return hours * 3600.0\n}\n\n/**\n * Converts seconds to hours.\n *\n * @param seconds the number of seconds\n * @return the number of hours\n * @see hoursToSeconds\n * @since 26.1\n * @example\n *     secondsToHours(5400.0)  // 1.5\n */\npub fun secondsToHours(seconds: float): float {\n    return seconds / 3600.0\n}\n\n/**\n * Converts minutes to seconds.\n *\n * @param minutes the number of minutes\n * @return the number of seconds\n * @see secondsToMinutes\n * @since 26.1\n * @example\n *     minutesToSeconds(2.5)  // 150.0\n */\npub fun minutesToSeconds(minutes: float): float {\n    return minutes * 60.0\n}\n\n/**\n * Converts seconds to minutes.\n *\n * @param seconds the number of seconds\n * @return the number of minutes\n * @see minutesToSeconds\n * @since 26.1\n * @example\n *     secondsToMinutes(150.0)  // 2.5\n */\npub fun secondsToMinutes(seconds: float): float {\n    return seconds / 60.0\n}\n\n/**\n * Converts seconds to milliseconds.\n *\n * @param seconds the number of seconds\n * @return the number of milliseconds\n * @see msToSeconds\n * @since 26.1\n * @example\n *     secondsToMs(1.25)  // 1250.0\n */\npub fun secondsToMs(seconds: float): float {\n    return seconds * 1000.0\n}\n\n/**\n * Converts milliseconds to seconds.\n *\n * @param ms the number of milliseconds\n * @return the number of seconds\n * @see secondsToMs\n * @since 26.1\n * @example\n *     msToSeconds(1250.0)  // 1.25\n */\npub fun msToSeconds(ms: float): float {\n    return ms / 1000.0\n}\n"
