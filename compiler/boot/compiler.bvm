    str "tools/fmt"
    str "import \"std/strings\"\nimport \"std/math\"\nimport \"std/process\"\nimport \"std/fs\"\n\npriv const VERSION = \"2.0.0\"\n\npriv def enum Kind { Word, Num, Str, Comment, Op, Open, Close, Comma, Semi, Colon, Dot, GOpen, GClose }\n\npriv def type Tok {\n    Kind kind\n    string text\n    bool tight\n}\n\npriv var KEYWORDS_SPACE = [\n    \"if\", \"while\", \"for\", \"return\", \"else\", \"import\", \"fun\", \"var\", \"const\", \"def\", \"pub\", \"priv\", \"async\", \"await\", \"in\", \"is\", \"as\", \"static\", \"match\"\n]\n\npriv var TWO_CHAR_OPS = [\"==\", \"!=\", \"<=\", \">=\", \"&&\", \"||\", \"+=\", \"-=\", \"*=\", \"/=\", \"%=\", \"&=\", \"|=\", \"^=\", \"<<\", \">>\", \"=>\", \"..\", \"->\", \"!!\", \"::\", \"??\"]\npriv var THREE_CHAR_OPS = [\"..=\", \">>>\", \"<<=\", \">>=\"]\n\npriv var GENERIC_TYPES = [\"Future\", \"Task\", \"Map\", \"Array\"]\n\npriv var DECL_WORDS = [\"fun\", \"static\", \"def\", \"async\", \"pub\", \"priv\"]\n\npriv fun isAsciiDigit(c: string): bool {\n    return c >= \"0\" && c <= \"9\"\n}\n\npriv fun isAsciiAlnum(c: string): bool {\n    return isAsciiDigit(c) || (c >= \"a\" && c <= \"z\") || (c >= \"A\" && c <= \"Z\")\n}\n\npriv fun isWordStart(c: string): bool {\n    return c == \"_\" || isLetter(c)\n}\n\npriv fun isWordChar(c: string): bool {\n    return c == \"_\" || isAlphanumeric(c)\n}\n\npriv fun isSpace(c: string): bool {\n    return isWhitespace(c)\n}\n\npriv fun tok(kind: Kind, text: string): Tok {\n    return Tok { kind: kind, text: text, tight: false }\n}\n\npriv var GENERIC_CHARS = [\" \", \",\", \"[\", \"]\", \"{\", \"}\", \":\", \"?\", \"(\", \")\"]\n\npriv fun genericMarks(cs: [string], open: int): [int] {\n    [int] none = []\n    if (open == 0 || !isWordChar(cs[open - 1])) {\n        return none\n    }\n    var depth = 0\n    [int] marks = []\n    var j = open\n    while (j < len(cs)) {\n        var c = cs[j]\n        if (c == \"<\") {\n            depth += 1\n            marks.push(j)\n        } else if (c == \">\") {\n            depth -= 1\n            marks.push(j)\n            if (depth == 0) {\n                return marks\n            }\n        } else if (!(isWordChar(c) || contains(GENERIC_CHARS, c))) {\n            return none\n        }\n        j += 1\n    }\n    return none\n}\n\npriv fun lexLine(line: string): [Tok] {\n    var cs = chars(line)\n    var n = len(cs)\n    var out: [Tok] = []\n    [int] generic = []\n    var i = 0\n    while (i < n) {\n        var c = cs[i]\n        if (contains(generic, i)) {\n            if (c == \"<\") {\n                out.push(tok(Kind.GOpen, c))\n            } else {\n                out.push(tok(Kind.GClose, c))\n            }\n            i += 1\n            continue\n        }\n        if (c == \"<\") {\n            var marks = genericMarks(cs, i)\n            if (len(marks) > 0) {\n                generic = marks\n                out.push(tok(Kind.GOpen, c))\n                i += 1\n                continue\n            }\n        }\n        if (c == \" \" || c == \"\\t\") {\n            i += 1\n            continue\n        }\n        if (c == \"/\" && i + 1 < n && cs[i + 1] == \"/\") {\n            out.push(tok(Kind.Comment, join(slice(cs, i, n), \"\")))\n            break\n        }\n        if (c == \"\\\"\" || c == \"'\") {\n            var start = i\n            i += 1\n            var depth = 0\n            while (i < n) {\n                if (cs[i] == \"\\\\\") {\n                    i += 2\n                    continue\n                }\n                if (cs[i] == \"$\" && i + 1 < n && cs[i + 1] == \"{\") {\n                    depth += 1\n                    i += 2\n                    continue\n                }\n                if (depth > 0 && cs[i] == \"}\") {\n                    depth -= 1\n                    i += 1\n                    continue\n                }\n                if (depth == 0 && cs[i] == c) {\n                    i += 1\n                    break\n                }\n                i += 1\n            }\n            out.push(tok(Kind.Str, join(slice(cs, start, min(i, n)), \"\")))\n            continue\n        }\n        if (isWordStart(c)) {\n            var start = i\n            while (i < n && isWordChar(cs[i])) {\n                i += 1\n            }\n            out.push(tok(Kind.Word, join(slice(cs, start, i), \"\")))\n            continue\n        }\n        if (isAsciiDigit(c)) {\n            var start = i\n            var hex = false\n            while (i < n) {\n                var d = cs[i]\n                if (d == \"x\" || d == \"X\") {\n                    hex = true\n                }\n                var exponentSign = (d == \"-\" || d == \"+\") && (cs[i - 1] == \"e\" || cs[i - 1] == \"E\") && !hex\n                if (isAsciiAlnum(d) || d == \"_\" || (d == \".\" && i + 1 < n && isAsciiDigit(cs[i + 1])) || exponentSign) {\n                    i += 1\n                } else {\n                    break\n                }\n            }\n            out.push(tok(Kind.Num, join(slice(cs, start, i), \"\")))\n            continue\n        }\n        var two = join(slice(cs, i, min(i + 2, n)), \"\")\n        var three = join(slice(cs, i, min(i + 3, n)), \"\")\n        var four = join(slice(cs, i, min(i + 4, n)), \"\")\n        if (four == \">>>=\") {\n            out.push(tok(Kind.Op, four))\n            i += 4\n            continue\n        }\n        if (contains(THREE_CHAR_OPS, three)) {\n            out.push(tok(Kind.Op, three))\n            i += 3\n            continue\n        }\n        if (contains(TWO_CHAR_OPS, two)) {\n            out.push(tok(Kind.Op, two))\n            i += 2\n            continue\n        }\n        if (c == \"(\" || c == \"[\" || c == \"{\") {\n            out.push(Tok { kind: Kind.Open, text: c, tight: i + 1 < n && !isSpace(cs[i + 1]) })\n        } else if (c == \")\" || c == \"]\" || c == \"}\") {\n            out.push(Tok { kind: Kind.Close, text: c, tight: i > 0 && !isSpace(cs[i - 1]) })\n        } else if (c == \",\") {\n            out.push(tok(Kind.Comma, c))\n        } else if (c == \";\") {\n            out.push(tok(Kind.Semi, c))\n        } else if (c == \":\") {\n            out.push(tok(Kind.Colon, c))\n        } else if (c == \".\") {\n            out.push(tok(Kind.Dot, c))\n        } else {\n            out.push(tok(Kind.Op, c))\n        }\n        i += 1\n    }\n    return out\n}\n\npriv fun isOperandEnd(t: Tok): bool {\n    if (t.kind == Kind.Word) {\n        return !contains(KEYWORDS_SPACE, t.text) || t.text == \"self\"\n    }\n    if (t.kind == Kind.Num || t.kind == Kind.Str || t.kind == Kind.Close || t.kind == Kind.GClose) {\n        return true\n    }\n    if (t.kind == Kind.Op) {\n        return t.text == \"?\" || t.text == \"!!\"\n    }\n    return false\n}\n\npriv fun isRange(t: Tok): bool {\n    return t.kind == Kind.Op && (t.text == \"..\" || t.text == \"..=\")\n}\n\npriv fun isOpen(t: Tok, c: string): bool {\n    return t.kind == Kind.Open && t.text == c\n}\n\npriv fun isClose(t: Tok, c: string): bool {\n    return t.kind == Kind.Close && t.text == c\n}\n\npriv fun isPunct(t: Tok): bool {\n    return t.kind == Kind.Comma || t.kind == Kind.Semi || t.kind == Kind.Colon\n}\n\npriv fun isStructHead(toks: [Tok]): bool {\n    var words: [string] = []\n    for t in toks {\n        if (len(words) == 5) {\n            break\n        }\n        if (t.kind == Kind.Word) {\n            words.push(t.text)\n        } else {\n            words.push(\"\")\n        }\n    }\n    var start = 0\n    if (len(words) > 0 && (words[0] == \"pub\" || words[0] == \"priv\")) {\n        start = 1\n    }\n    if (len(words) <= start || words[start] != \"def\") {\n        return false\n    }\n    for i in start + 1..min(start + 3, len(words)) {\n        if (words[i] == \"struct\") {\n            return true\n        }\n    }\n    return false\n}\n\npriv fun renderLine(toks: [Tok]): string {\n    var parts: [string] = []\n    var genericDepth = 0\n    var head = isStructHead(toks)\n    var parens = 0\n    for idx, t in toks {\n        var space = true\n        if (idx == 0) {\n            space = false\n        } else {\n            var p = toks[idx - 1]\n            if (t.kind == Kind.GOpen || p.kind == Kind.GOpen || t.kind == Kind.GClose) {\n                space = false\n            } else if (p.kind == Kind.GClose && (isOpen(t, \"(\") || isOpen(t, \"[\"))) {\n                space = false\n            } else if (t.kind == Kind.Colon && head && parens == 0) {\n                space = true\n            } else if (t.kind == Kind.Comment) {\n                space = true\n            } else if (p.kind == Kind.Op && p.text == \"@\") {\n                space = false\n            } else if (isOpen(p, \"{\")) {\n                space = !p.tight && !isClose(t, \"}\")\n            } else if (p.kind == Kind.Open) {\n                space = false\n            } else if (isClose(t, \"}\")) {\n                space = !t.tight && !isOpen(p, \"{\")\n            } else if (t.kind == Kind.Close) {\n                space = false\n            } else if (isPunct(t)) {\n                space = false\n            } else if (isPunct(p)) {\n                space = true\n            } else if (t.kind == Kind.Dot || p.kind == Kind.Dot) {\n                space = false\n            } else if (isRange(p) || isRange(t)) {\n                space = false\n            } else if (p.kind == Kind.Op && p.text == \"!!\") {\n                space = !(t.kind == Kind.Dot || isOpen(t, \"(\") || isOpen(t, \"[\"))\n            } else if (t.kind == Kind.Op && (t.text == \"!!\" || t.text == \"?\")) {\n                space = false\n            } else if (p.kind == Kind.Op && (p.text == \"!\" || p.text == \"~\") && isOpen(t, \"(\")) {\n                space = false\n            } else if (p.kind == Kind.Word && isOpen(t, \"(\")) {\n                space = contains(KEYWORDS_SPACE, p.text) && p.text != \"fun\"\n            } else if (p.kind == Kind.Word && t.kind == Kind.Op && t.text == \"<\" && contains(GENERIC_TYPES, p.text)) {\n                genericDepth += 1\n                space = false\n            } else if (p.kind == Kind.Op && p.text == \"<\" && genericDepth > 0) {\n                space = false\n            } else if (t.kind == Kind.Op && t.text == \">\" && genericDepth > 0) {\n                genericDepth -= 1\n                space = false\n            } else if (t.kind == Kind.Op && t.text == \">>\" && genericDepth > 1) {\n                genericDepth -= 2\n                space = false\n            } else if (isOpen(t, \"{\")) {\n                space = true\n            } else if (isOpen(t, \"(\") || isOpen(t, \"[\")) {\n                space = !isOperandEnd(p) || (p.kind == Kind.Word && contains(KEYWORDS_SPACE, p.text))\n            } else if (p.kind == Kind.Op && p.text == \"~\") {\n                space = false\n            } else if (p.kind == Kind.Op && (p.text == \"-\" || p.text == \"!\")) {\n                space = idx >= 2 && isOperandEnd(toks[idx - 2]) && p.text == \"-\"\n            } else {\n                space = true\n            }\n        }\n        if (space && len(parts) > 0) {\n            parts.push(\" \")\n        }\n        parts.push(t.text)\n        if (isOpen(t, \"(\")) {\n            parens += 1\n        } else if (isClose(t, \")\")) {\n            parens -= 1\n        }\n    }\n    return join(parts, \"\")\n}\n\npriv fun splitSegments(toks: [Tok]): [[Tok]] {\n    var n = len(toks)\n    [bool] openMatched = []\n    [bool] closeLocal = []\n    for i in 0..n {\n        openMatched.push(false)\n        closeLocal.push(false)\n    }\n    [int] stack = []\n    for i, t in toks {\n        if (isOpen(t, \"{\")) {\n            stack.push(i)\n        } else if (isClose(t, \"}\") && len(stack) > 0) {\n            var o = pop(stack)\n            openMatched[o] = true\n            closeLocal[i] = true\n        }\n    }\n    [[Tok]] segs = []\n    [Tok] cur = []\n    for i, t in toks {\n        if (isClose(t, \"}\") && !closeLocal[i] && len(cur) > 0) {\n            segs.push(cur)\n            cur = []\n        }\n        cur.push(t)\n        if (isOpen(t, \"{\") && !openMatched[i] && i + 1 < n) {\n            segs.push(cur)\n            cur = []\n        }\n    }\n    if (len(cur) > 0) {\n        segs.push(cur)\n    }\n    [[Tok]] merged = []\n    for seg in segs {\n        if (len(seg) == 1 && seg[0].kind == Kind.Comment && len(merged) > 0) {\n            merged[len(merged) - 1].push(seg[0])\n            continue\n        }\n        merged.push(seg)\n    }\n    return merged\n}\n\npriv fun sourceLines(src: string): [string] {\n    var lines = split(src, \"\\n\")\n    if (len(lines) > 0 && lines[len(lines) - 1] == \"\") {\n        pop(lines)\n    }\n    return lines\n}\n\npriv fun trimEnd(text: string): string {\n    var cs = chars(text)\n    var end = len(cs)\n    while (end > 0 && isSpace(cs[end - 1])) {\n        end -= 1\n    }\n    return join(slice(cs, 0, end), \"\")\n}\n\npriv var ASM_TARGETS = [\"x86_64\", \"arm64\", \"aarch64\", \"bvm\", \"js\"]\n\npriv fun braceBalance(line: string): int {\n    var n = 0\n    for c in chars(line) {\n        if (c == \"{\") {\n            n += 1\n        } else if (c == \"}\") {\n            n -= 1\n        }\n    }\n    return n\n}\n\npriv fun asmSectionHead(line: string): string? {\n    var open = indexOf(line, \"{\")\n    if (open < 0) {\n        return null\n    }\n    var name = trim(substring(line, 0, open))\n    if (!contains(ASM_TARGETS, name)) {\n        return null\n    }\n    return name\n}\n\npriv fun leadingSpace(line: string): int {\n    var n = 0\n    for c in chars(line) {\n        if (c != \" \" && c != \"\\t\") {\n            break\n        }\n        n += 1\n    }\n    return n\n}\n\npriv fun reindented(lines: [string], depth: int): [string] {\n    var anchor = -1\n    for line in lines {\n        var t = trim(line)\n        if (t != \"\" && !endsWith(t, \":\")) {\n            anchor = leadingSpace(line)\n            break\n        }\n    }\n    if (anchor < 0) {\n        anchor = 4 * depth\n    }\n    [string] out = []\n    for line in lines {\n        var t = trim(line)\n        if (t == \"\") {\n            out.push(\"\\n\")\n        } else {\n            var n = leadingSpace(line) - anchor + 4 * depth\n            if (n < 0) {\n                n = 0\n            }\n            out.push(repeat(\" \", n) + trimEnd(t) + \"\\n\")\n        }\n    }\n    return out\n}\n\npriv fun indentFor(seg: [Tok], levels: [int]): int {\n    var before = len(levels)\n    var touched = 0\n    var partial = false\n    var i = 0\n    while (i < len(seg) && seg[i].kind == Kind.Close) {\n        if (len(levels) > 0) {\n            var top = len(levels) - 1\n            levels[top] = levels[top] - 1\n            partial = levels[top] > 0\n            if (!partial) {\n                levels.pop()\n                touched += 1\n            }\n        }\n        i += 1\n    }\n    var indent = before - touched\n    if (i > 0 && partial) {\n        indent = before - touched - 1\n    }\n    var fresh = 0\n    for j in i..len(seg) {\n        var t = seg[j]\n        if (t.kind == Kind.Open) {\n            fresh += 1\n        } else if (t.kind == Kind.Close) {\n            if (fresh > 0) {\n                fresh -= 1\n            } else if (len(levels) > 0) {\n                var top = len(levels) - 1\n                levels[top] = levels[top] - 1\n                if (levels[top] <= 0) {\n                    levels.pop()\n                }\n            }\n        }\n    }\n    if (fresh > 0) {\n        if (i > 0 && partial && len(levels) > 0) {\n            levels[len(levels) - 1] = levels[len(levels) - 1] + fresh\n        } else {\n            levels.push(fresh)\n        }\n    }\n    return indent\n}\n\n/**\n * Formats Burn source code the way `burn fmt` and `burnfmt` do: indentation of four spaces per level, spacing\n * around operators and commas, and blank lines between declarations.\n * @param src the source code of a Burn file\n * @return the formatted source\n * @example\n * import \"tools/fmt\"\n *\n * print(format(\"fun f(){\\nreturn 1\\n}\"))\n */\npub fun format(src: string): string {\n    [string] out = []\n    [int] levels = []\n    var blank = 0\n    var inBlockComment = false\n    var started = false\n    var lastWasClose = false\n    var asmLevel = -1\n    var rawDepth = 0\n    [string] rawLines = []\n    for raw in sourceLines(src) {\n        var line = trim(raw)\n        if (rawDepth > 0) {\n            rawDepth += braceBalance(line)\n            if (rawDepth > 0) {\n                rawLines.push(raw)\n                continue\n            }\n            rawDepth = 0\n            if (line != \"}\") {\n                rawLines.push(raw)\n                for l in reindented(rawLines, len(levels)) {\n                    out.push(l)\n                }\n                rawLines = []\n                indentFor(lexLine(\"}\"), levels)\n                lastWasClose = true\n                continue\n            }\n            for l in reindented(rawLines, len(levels)) {\n                out.push(l)\n            }\n            rawLines = []\n        }\n        if (asmLevel >= 0 && len(levels) == asmLevel + 1 && asmSectionHead(line) != null) {\n            out.push(repeat(\"    \", len(levels)) + line + \"\\n\")\n            var balance = braceBalance(line)\n            if (balance > 0) {\n                indentFor(lexLine(\"{\"), levels)\n                rawDepth = balance\n            }\n            lastWasClose = false\n            blank = 0\n            started = true\n            continue\n        }\n        if (asmLevel >= 0 && len(levels) <= asmLevel) {\n            asmLevel = -1\n        }\n        if (line == \"asm {\" && asmLevel < 0) {\n            asmLevel = len(levels)\n        }\n        if (inBlockComment) {\n            if (startsWith(line, \"*\")) {\n                out.push(repeat(\"    \", len(levels)) + \" \" + line + \"\\n\")\n            } else {\n                out.push(trimEnd(raw) + \"\\n\")\n            }\n            if (contains(line, \"*/\")) {\n                inBlockComment = false\n            }\n            continue\n        }\n        if (startsWith(line, \"/*\")) {\n            if ((started && blank > 0) || lastWasClose) {\n                out.push(\"\\n\")\n            }\n            blank = 0\n            lastWasClose = false\n            started = true\n            out.push(repeat(\"    \", len(levels)) + line + \"\\n\")\n            inBlockComment = !contains(line, \"*/\")\n            continue\n        }\n        if (line == \"\") {\n            blank += 1\n            continue\n        }\n        var first = started && blank > 0\n        blank = 0\n        for si, seg in splitSegments(lexLine(line)) {\n            var leadingClose = 0\n            while (leadingClose < len(seg) && seg[leadingClose].kind == Kind.Close) {\n                leadingClose += 1\n            }\n            var isDecl = (seg[0].kind == Kind.Word && contains(DECL_WORDS, seg[0].text)) || (seg[0].kind == Kind.Op && seg[0].text == \"@\")\n            if ((si == 0 && first && !(leadingClose > 0 && len(seg) == 1)) || (isDecl && lastWasClose)) {\n                out.push(\"\\n\")\n            }\n            lastWasClose = len(seg) == 1 && isClose(seg[0], \"}\")\n            out.push(repeat(\"    \", indentFor(seg, levels)) + renderLine(seg) + \"\\n\")\n        }\n        started = true\n    }\n    for l in rawLines {\n        out.push(trimEnd(l) + \"\\n\")\n    }\n    return join(out, \"\")\n}\n\npriv fun usage() {\n    print(\"burnfmt ${VERSION} - the Burn code formatter, written in Burn\")\n    print(\"\")\n    print(\"Usage:\")\n    print(\"  burnfmt [options] [file...]\")\n    print(\"\")\n    print(\"Options:\")\n    print(\"  -w, --write     write the result back to the files\")\n    print(\"  -l, --check     list files that are not formatted and exit with 1\")\n    print(\"  -h, --help      show this help\")\n    print(\"  -v, --version   show the version\")\n    print(\"\")\n    print(\"Without files, burnfmt formats standard input.\")\n}\n\npriv fun main() {\n    var writeBack = false\n    var check = false\n    [string] files = []\n    for a in args() {\n        if (a == \"-w\" || a == \"--write\") {\n            writeBack = true\n        } else if (a == \"-l\" || a == \"--list\" || a == \"--check\") {\n            check = true\n        } else if (a == \"-h\" || a == \"--help\") {\n            usage()\n            return\n        } else if (a == \"-v\" || a == \"--version\") {\n            print(\"burnfmt ${VERSION}\")\n            return\n        } else if (startsWith(a, \"-\")) {\n            eprint(\"burnfmt: unknown option ${a}\")\n            exit(2)\n        } else {\n            files.push(a)\n        }\n    }\n    if (len(files) == 0) {\n        write(format(readStdin()))\n        return\n    }\n    var code = 0\n    for f in files {\n        if (!fileExists(f)) {\n            eprint(\"burnfmt: cannot read ${f}\")\n            code = 1\n            continue\n        }\n        var src = readFile(f)\n        var formatted = format(src)\n        if (check) {\n            if (formatted != src) {\n                print(\"${f} is not formatted\")\n                code = 1\n            }\n        } else if (writeBack) {\n            if (formatted != src && !writeFile(f, formatted)) {\n                eprint(\"burnfmt: cannot write ${f}\")\n                code = 1\n            }\n        } else {\n            write(formatted)\n        }\n    }\n    exit(code)\n}\n"
