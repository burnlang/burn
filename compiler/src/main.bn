import "build.bn"
import "dump/checked.bn"
import "dump/declarations.bn"
import "dump/index.bn"
import "dump/loading.bn"
import "dump/syntax.bn"
import "std/fs"
import "std/process"

fun outputFor(file: string, target: string): string {
    var ext = "bvm"
    if (target != "bvm") {
        ext = "s"
    }
    if (endsWith(file, ".bn")) {
        return "${substring(file, 0, len(file) - 3)}.${ext}"
    }
    return "${file}.${ext}"
}

const BUILD_USAGE = "usage: main.bn build [--target bvm|asm|runtime] <file.bn> [-o <out>]"

/** The platform native assembly is written for: `BURN_PLATFORM`, or the one `uname` reports. */
fun hostPlatform(): string {
    var p = env("BURN_PLATFORM")
    if (p != "") {
        return p
    }
    var os = trim(Process.output("uname", ["-s"]).out)
    var arch = trim(Process.output("uname", ["-m"]).out)
    if (arch == "arm64") {
        arch = "aarch64"
    }
    if (os == "Darwin") {
        return "macos-${arch}"
    }
    return "${lower(os)}-${arch}"
}

fun compileFor(file: string, target: string): Built {
    if (target == "bvm") {
        return buildBvm(file)
    }
    return buildAssembly(file, target, hostPlatform())
}

fun build(rest: [string]): int {
    string? file = null
    string? output = null
    var target = "bvm"
    var i = 0
    while (i < len(rest)) {
        if (rest[i] == "-o" && i + 1 < len(rest)) {
            output = rest[i + 1]
            i += 2
            continue
        }
        if (rest[i] == "--target" && i + 1 < len(rest)) {
            target = rest[i + 1]
            i += 2
            continue
        }
        if (file != null) {
            eprint(BUILD_USAGE)
            return 2
        }
        file = rest[i]
        i += 1
    }
    if (file == null || !contains(["bvm", "asm", "runtime"], target)) {
        eprint(BUILD_USAGE)
        return 2
    }
    var built = compileFor(file, target)
    if (built.diagnostics != "") {
        eprint(trimEnd(built.diagnostics))
    }
    var text = built.module
    if (text == null) {
        return 1
    }
    var out = output ?? outputFor(file, target)
    if (!writeFile(out, text)) {
        eprint("error: cannot write ${out}")
        return 1
    }
    print("wrote ${out}")
    return 0
}

fun trimEnd(s: string): string {
    var end = len(s)
    while (end > 0 && substring(s, end - 1, end) == "\n") {
        end -= 1
    }
    return substring(s, 0, end)
}

fun main() {
    var files = args()
    if (len(files) > 0 && files[0] == "build") {
        var code = build(slice(files, 1, len(files)))
        if (code != 0) {
            exit(code)
        }
        return
    }
    var mode = "--tokens"
    var modes = ["--tokens", "--ast", "--diagnostics", "--toml", "--project", "--modules", "--decls", "--checked", "--owned", "--bvm", "--index"]
    if (len(files) > 0 && contains(modes, files[0])) {
        mode = files[0]
        files = slice(files, 1, len(files))
    }
    for f in files {
        if (len(files) > 1) {
            print("file ${f}")
        }
        if (mode == "--project") {
            write(dumpProject(f))
            continue
        }
        if (mode == "--modules") {
            write(dumpModules(f))
            continue
        }
        if (mode == "--bvm") {
            write(dumpBvm(f))
            continue
        }
        if (mode == "--index") {
            write(dumpIndex(f))
            continue
        }
        if (mode == "--checked" || mode == "--owned") {
            write(dumpChecked(f, mode == "--owned"))
            continue
        }
        if (mode == "--decls") {
            write(dumpDeclarations(f))
            continue
        }
        var src = readFile(f)
        if (mode == "--ast") {
            write(dumpAst(src))
        } else if (mode == "--diagnostics") {
            write(dumpDiagnostics(f, src))
        } else if (mode == "--toml") {
            write(dumpToml(src))
        } else {
            write(dumpTokens(src))
        }
    }
}
