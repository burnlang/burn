import "../build.bn"
import "../check/body.bn"
import "../check/check.bn"
import "../diag/diag.bn"
import "../project/loader.bn"
import "../project/paths.bn"
import "../project/project.bn"
import "host.bn"
import "std/fs"

/** A program that type-checked: its checker, its checked form and the warnings it got. */
pub def type Compiled {
    Loaded loaded
    Checker checker
    HProgram program
    [LoadDiag] warnings
}

/** How a program is built: without the standard library (`--no-std`), with symbols (`--no-strip`), or natively before running (`burn run --native`). */
pub def struct Options() {
    bool noStd = false
    bool strip = true
    bool native = false
}

priv fun before(a: LoadDiag, b: LoadDiag): bool {
    var ae = a.diag.severity == Severity.Error
    var be = b.diag.severity == Severity.Error
    if (ae != be) {
        return ae
    }
    if (a.file != b.file) {
        return a.file < b.file
    }
    return a.diag.start < b.diag.start
}

/** Errors first, then warnings, each by file and position, keeping the order of equal ones. */
pub fun sortedDiags(all: [LoadDiag]): [LoadDiag] {
    [LoadDiag] out = []
    for d in all {
        var at = len(out)
        while (at > 0 && before(d, out[at - 1])) {
            at -= 1
        }
        insert(out, at, d)
    }
    return out
}

priv fun eprintText(text: string) {
    if (endsWith(text, "\n")) {
        eprint(substring(text, 0, len(text) - 1))
    } else if (text != "") {
        eprint(text)
    }
}

/** Prints diagnostics to stderr the way `burn check` does, with the number of errors at the end. */
pub fun report(files: [SourceFile], diags: [LoadDiag]) {
    var color = colorErrors()
    var out = ""
    var errors = 0
    for d in diags {
        out += renderIn(files[d.file], d.diag, color)
        out += "\n"
        if (d.diag.severity == Severity.Error) {
            errors += 1
        }
    }
    if (errors == 1) {
        out += "1 error found\n"
    } else if (errors > 1) {
        out += "${errors} errors found\n"
    }
    eprintText(out)
}

/** Prints an error that points at no file, such as a file that cannot be read. */
pub fun reportMessage(message: string) {
    var p = colorErrors()
    if (p) {
        eprintText("\u{1b}[1m\u{1b}[31merror\u{1b}[0m: \u{1b}[1m${message}\u{1b}[0m\n\n1 error found\n")
    } else {
        eprintText("error: ${message}\n\n1 error found\n")
    }
}

/** Builds the bytecode of the packages a program imports as `name.bvmc`, like `package_bytecode` in `loader.rs`. */
priv def struct HostBuilder() :: PackageBuilder {
    [string] building = []

    fun build(name: string, dir: string, project: Project, out: string): string {
        if (!isStale(dir, out)) {
            return ""
        }
        if (contains(building, name)) {
            return "the bytecode of `${name}` imports itself through its packages"
        }
        building.push(name)
        var problem = buildPackage(name, dir, project, out)
        building = slice(building, 0, len(building) - 1)
        return problem
    }
}

priv var packageBuilder = new HostBuilder()

/** A loader that builds the bytecode of imported packages when it is out of date. */
pub fun newLoader(): Loader {
    var loader = new Loader()
    loader.builder = packageBuilder
    return loader
}

priv fun buildPackage(name: string, dir: string, project: Project, out: string): string {
    var err = new Problem()
    var main = packageMain(dir, err)
    if (main == null) {
        return err.message
    }
    var loader = newLoader()
    loader.project = project
    loader.projectTried = true
    var root = loader.loadFile(main, err)
    if (root < 0) {
        return err.message
    }
    var loaded = loader.finish(root)
    readLibraries(loaded)
    var r = checkProgram(loaded)
    [LoadDiag] all = []
    for d in loaded.diags {
        all.push(d)
    }
    for d in r.diags {
        all.push(d)
    }
    var first = ""
    var failed = false
    for d in sortedDiags(all) {
        if (d.diag.severity == Severity.Error && !failed) {
            failed = true
            first = d.diag.message
        }
    }
    var p = r.program
    if (p == null || failed) {
        return "the package `${name}` does not compile, so it has no bytecode: ${first}"
    }
    var parent = pathParent(out)
    if (parent != null && parent != "") {
        Files.makeDir(parent)
    }
    var problem = writeBytecode(moduleText(r.checker, p), r.checker.libPaths, out, "")
    if (problem == "") {
        return ""
    }
    var internal = "70\tinternal error: the compiler produced an invalid bvm module: "
    if (startsWith(problem, internal)) {
        return "the bytecode of `${name}` is invalid: ${substring(problem, len(internal), len(problem))}"
    }
    return substring(problem, len("1\terror: "), len(problem))
}

/** Reads the bytecode libraries the program imports, so the checker can import their functions. */
pub fun readLibraries(loaded: Loaded) {
    for l in loaded.libs {
        l.info = libraryInfo(l.path)
    }
}

/** The paths of the bytecode libraries the program imports, in the order the checker numbered them. */
pub fun libraryPaths(c: Compiled): [string] {
    return c.checker.libPaths
}

priv fun checked(loaded: Loaded, opts: Options): Compiled? {
    if (opts.noStd) {
        loaded.noStd = true
    }
    readLibraries(loaded)
    var r = checkProgram(loaded)
    [LoadDiag] all = []
    for d in loaded.diags {
        all.push(d)
    }
    for d in r.diags {
        all.push(d)
    }
    all = sortedDiags(all)
    var failed = false
    for d in all {
        if (d.diag.severity == Severity.Error) {
            failed = true
        }
    }
    var p = r.program
    if (p != null && !failed) {
        if (len(all) > 0) {
            report(loaded.files, all)
        }
        return Compiled { loaded: loaded, checker: r.checker, program: p, warnings: all }
    }
    report(loaded.files, all)
    return null
}

/** Loads and checks the program in `path`; prints its errors, or its warnings when it compiles. */
pub fun compilePath(path: string, opts: Options): Compiled? {
    var loader = newLoader()
    var err = new Problem()
    var root = loader.loadFile(path, err)
    if (root < 0) {
        reportMessage(err.message)
        return null
    }
    return checked(loader.finish(root), opts)
}

/** Loads and checks a program given as source text named `name`, with imports relative to the working directory. */
pub fun compileSource(name: string, src: string, opts: Options): Compiled? {
    var loader = newLoader()
    var root = loader.loadSource(name, src, currentDir())
    return checked(loader.finish(root), opts)
}

/** The program in bvm assembly. */
pub fun moduleOf(c: Compiled): string {
    return moduleText(c.checker, c.program)
}
