import "../check/asm.bn"
import "../native/native.bn"
import "../project/paths.bn"
import "../project/project.bn"
import "compile.bn"
import "host.bn"
import "std/fs"
import "std/process"
import "std/random"
import "std/time"

/** Where `burn build --target native` writes the executable, and what else it keeps. */
pub def type NativeOptions {
    string output
    string? emitAsm
    bool strip
}

/** The platforms native executables can be built for. */
pub const NATIVE_PLATFORMS = ["linux-x86_64", "macos-x86_64", "linux-aarch64", "macos-aarch64"]

/** The platform native executables are built for: `BURN_PLATFORM` when it is set, to cross-compile, or this one. */
pub fun targetPlatform(): string {
    var p = env("BURN_PLATFORM")
    if (p != "") {
        return p
    }
    return platform()
}

/** The folder with the runtime that native executables link against: `BURN_RUNTIME_DIR`, or `share/burn/lib` in a toolchain. */
priv fun runtimeDir(): string {
    var d = env("BURN_RUNTIME_DIR")
    if (d != "") {
        return d
    }
    return pathJoin(shareDir() ?? ".", "lib")
}

/** Why this toolchain cannot build native executables, or null, like `supported` in `native/mod.rs`. */
pub fun nativeUnsupported(): string? {
    var p = targetPlatform()
    if (!contains(NATIVE_PLATFORMS, p)) {
        return "native compilation supports ${join(NATIVE_PLATFORMS, ", ")}, not ${p}; use `burn run`, `--target bvm` or `--target js` on this platform"
    }
    if (!Files.isFile(pathJoin(runtimeDir(), "libburn_runtime.a"))) {
        return "this toolchain has no native runtime library (${pathJoin(runtimeDir(), "libburn_runtime.a")})"
    }
    return null
}

/** A new path in the temporary folder for `burn-<tag>` files; the caller creates and removes it. */
pub fun tempPath(tag: string): string {
    var base = env("TMPDIR")
    if (base == "") {
        base = "/tmp"
    }
    return pathJoin(base, "burn-${tag}-${nowMs()}-${randomInt(0, 999999999)}")
}

priv fun link(asm: string, output: string, strip: bool, runtime: string, libs: string): string? {
    var dir = tempPath("build")
    Files.makeDir(dir)
    var asmPath = pathJoin(dir, "program.s")
    if (!writeFile(asmPath, asm)) {
        Files.remove(dir)
        return "cannot write ${asmPath}"
    }
    var cc = env("BURN_CC")
    if (cc == "") {
        cc = env("CC")
    }
    if (cc == "") {
        cc = "cc"
    }
    [string] args = [asmPath, runtime, "-o", output]
    for l in split(libs, " ") {
        if (trim(l) != "") {
            args.push(trim(l))
        }
    }
    if (startsWith(targetPlatform(), "macos")) {
        args.push("-Wl,-dead_strip")
    } else {
        args.push("-Wl,--gc-sections")
    }
    if (strip) {
        args.push("-s")
    }
    var r = Process.output(cc, args)
    Files.remove(dir)
    if (r.code < 0) {
        return "could not run the linker `${cc}`: ${trim(r.err)} (install a C toolchain or set BURN_CC)"
    }
    if (r.code != 0) {
        return "linking failed:\n${r.err}"
    }
    return null
}

priv fun writeAsm(opts: NativeOptions, asm: string): string? {
    var path = opts.emitAsm
    if (path != null && !writeFile(path, asm)) {
        return "cannot write ${path}"
    }
    return null
}

/** Compiles a checked program to a native executable, like `native::build`. Returns null or the error. */
pub fun buildNative(c: Compiled, opts: NativeOptions): string? {
    [[int]] libs = []
    [string] libFuncs = []
    for path in libraryPaths(c) {
        var info = libraryFunctions(path)
        if (startsWith(info, "error\t")) {
            return substring(info, 6, len(info))
        }
        for name in split(info, "\n") {
            if (name != "") {
                libFuncs.push(name)
            }
        }
        var b = fileBytes(path)
        if (b == null) {
            return "cannot read ${path}"
        }
        libs.push(b)
    }
    var problem = nativeProblem(c.program, libFuncs)
    if (problem != null) {
        return problem
    }
    var arch = "x86_64"
    if (endsWith(targetPlatform(), "aarch64")) {
        arch = "arm64"
    }
    var asmIssue = asmProblem(c.checker, arch)
    if (asmIssue != null) {
        return asmIssue
    }
    var asm = nativeAssembly(c.checker, c.program, libs, targetPlatform())
    var written = writeAsm(opts, asm)
    if (written != null) {
        return written
    }
    var unsupported = nativeUnsupported()
    if (unsupported != null) {
        return unsupported
    }
    var dir = runtimeDir()
    if (c.program.noStd) {
        var core = pathJoin(dir, "libburn_core.a")
        if (!Files.isFile(core)) {
            return "this toolchain has no no-std runtime library (${core})"
        }
        return link(asm, opts.output, opts.strip, core, "-lm")
    }
    if (len(libs) > 0) {
        return bytecodeExecutable(c, opts)
    }
    var libsText = readText(pathJoin(dir, "native-libs.txt")) ?? ""
    return link(asm, opts.output, opts.strip, pathJoin(dir, "libburn_runtime.a"), trim(libsText))
}

/**
 * An executable for a program that imports bytecode libraries: the program is compiled to bytecode, linked with
 * its libraries, and bundled with the launcher, so that it runs on bvm like the libraries do.
 */
priv fun bytecodeExecutable(c: Compiled, opts: NativeOptions): string? {
    var dir = tempPath("build")
    Files.makeDir(dir)
    var tmp = pathJoin(dir, "program.bvmc")
    var written = writeBytecode(moduleOf(c), libraryPaths(c), tmp, "")
    if (written != "") {
        Files.remove(dir)
        var tab = indexOf(written, "\t")
        if (tab >= 0) {
            return substring(written, tab + 1, len(written))
        }
        return written
    }
    var problem = buildLauncher(tmp, opts)
    Files.remove(dir)
    return problem
}

/** Writes the assembly of the runtime library `name` written in Burn to `output`, for `scripts/native-runtime.sh` to assemble. Returns null or the error. */
pub fun buildRuntimeLibrary(c: Compiled, output: string, name: string): string? {
    var problem = runtimeLibraryProblem(c.checker, c.program)
    if (problem != null) {
        return problem
    }
    var arch = "x86_64"
    if (endsWith(targetPlatform(), "aarch64")) {
        arch = "arm64"
    }
    var asmIssue = asmProblem(c.checker, arch)
    if (asmIssue != null) {
        return asmIssue
    }
    if (!writeFile(output, runtimeLibraryAssembly(c.checker, c.program, targetPlatform(), name))) {
        return "cannot write ${output}"
    }
    return null
}

/** The x86-64 assembly of a checked program, as `burn dump --asm` prints it. */
pub fun nativeAssemblyOf(c: Compiled): string {
    [[int]] libs = []
    for path in libraryPaths(c) {
        libs.push(fileBytes(path) ?? [])
    }
    return nativeAssembly(c.checker, c.program, libs, targetPlatform())
}

/** Builds a native executable that runs the bvm module or archive `file`, like `build_bundle`. Returns null or the error. */
pub fun buildLauncher(file: string, opts: NativeOptions): string? {
    var dir = tempPath("build")
    Files.makeDir(dir)
    var tmp = pathJoin(dir, "bundle.bvmc")
    var problem = bundleFile(file, tmp)
    var b = fileBytes(tmp)
    Files.remove(dir)
    if (problem != "") {
        return problem
    }
    if (b == null) {
        return "cannot read ${file}"
    }
    var asm = launcherAssembly(b, targetPlatform())
    var written = writeAsm(opts, asm)
    if (written != null) {
        return written
    }
    var unsupported = nativeUnsupported()
    if (unsupported != null) {
        return unsupported
    }
    var rt = runtimeDir()
    var launcher = pathJoin(rt, "libburn_launcher.a")
    if (!Files.isFile(launcher)) {
        return "this toolchain has no launcher for bytecode (${launcher})"
    }
    var libsText = readText(pathJoin(rt, "native-libs.txt")) ?? ""
    return link(asm, opts.output, opts.strip, launcher, pathJoin(rt, "libburn_runtime.a") + " " + trim(libsText))
}

/** Writes the assembly of a checked program to `output` without linking it, for `--target asm`. Returns null or the error. */
pub fun writeNativeAssembly(c: Compiled, output: string): string? {
    if (len(libraryPaths(c)) > 0) {
        return "a program that imports bytecode libraries cannot be written as assembly"
    }
    var problem = nativeProblem(c.program, [])
    if (problem != null) {
        return problem
    }
    var arch = "x86_64"
    if (endsWith(targetPlatform(), "aarch64")) {
        arch = "arm64"
    }
    var asmIssue = asmProblem(c.checker, arch)
    if (asmIssue != null) {
        return asmIssue
    }
    if (!writeFile(output, nativeAssembly(c.checker, c.program, [], targetPlatform()))) {
        return "cannot write ${output}"
    }
    return null
}
