/** The name the toolchain was started as: `burn`, `burni`, `burnc` or `burn-lsp`. */
@Native("burn.tool")
pub fun toolName(): string

/** The version of the toolchain. */
@Native("burn.version")
pub fun toolchainVersion(): string

/** Whether errors are printed in colour: stderr is a terminal and `NO_COLOR` is not set. */
@Native("burn.colorErrors")
pub fun colorErrors(): bool

/** Runs a module given in bvm assembly, linked with the bytecode libraries in `libs`, then exits with its exit code. */
@Native("burn.runModule")
pub fun runModule(module: string, libs: [string], args: [string]): int

/** Runs a bvm module or archive file with `args`, then exits with its exit code. */
@Native("burn.runFile")
pub fun runFile(path: string, args: [string]): int

/**
 * Links a module given in bvm assembly with the bytecode libraries in `libs`, checks it and writes it as bytecode to
 * `path`, and its assembly to `asmPath` unless that is `""`. Returns `""`, or the exit code and the error, split by a tab.
 */
@Native("burn.writeBytecode")
pub fun writeBytecode(module: string, libs: [string], path: string, asmPath: string): string

/** Writes a runnable archive named `name` holding the module and the libraries to `path`, like `writeBytecode`. */
@Native("burn.writeArchive")
pub fun writeArchive(module: string, name: string, libs: [string], path: string): string

/** How to start this toolchain's `burn` again, for running each test in its own process. */
@Native("burn.launcher")
pub fun launcher(): string

/** The exported functions and types of the bytecode library at `path`, as the checker reads them. */
@Native("burn.library")
pub fun libraryInfo(path: string): string

/** Whether the bytecode `out` of the package in `dir` is missing, older than its sources, or from an older Burn. */
@Native("burn.stale")
pub fun isStale(dir: string, out: string): bool

/** Starts a REPL session: runtime errors stop only the current input, and globals are kept between inputs. */
@Native("burn.replStart")
pub fun replStart(): int

/** Forgets the globals and initialized modules of the REPL session. */
@Native("burn.replReset")
pub fun replReset(): int

/**
 * Runs the module initializers `funcs` (named `inits`) of a REPL input with the globals saved from earlier inputs,
 * and saves them again. Returns `""`, `"error\t<message>"` for a runtime error or `"exit\t<code>"`.
 */
@Native("burn.replEval")
pub fun replEval(module: string, libs: [string], globals: [string], inits: [string], funcs: [int]): string

/** Prints `prompt` and reads a line from stdin without its line break, or null at the end of the input. */
@Native("burn.readLine")
pub fun readLine(prompt: string): string?

/** Starts the language server: caps its memory, and runtime errors stop only the request that raised them. */
@Native("burn.lspStart")
pub fun lspStart(): int

/** Reads one language server message from stdin (a `Content-Length` header, then the body), or null at the end of the input. */
@Native("burn.readMessage")
pub fun readMessage(): string?

/** Writes one language server message to stdout with its `Content-Length` header. */
@Native("burn.send")
pub fun sendMessage(body: string): int

/** The absolute path of `path` with every symbolic link resolved, or null when it does not exist. */
@Native("burn.realPath")
pub fun realPath(path: string): string?

/** Writes `content` to `path` unless it already holds it, creating its folders, and makes the file read-only. */
@Native("burn.writeReadOnly")
pub fun writeReadOnly(path: string, content: string): bool

/** The folder of the running executable, or null when it is unknown. */
@Native("burn.exeDir")
pub fun exeDir(): string?

/**
 * Runs `program` with `args` in the folder `dir`, with `NO_COLOR` set and no input. Returns `"ok"` or `"failed"` and its
 * output, or `"error"` and why it could not start, split by a tab.
 */
@Native("burn.runIn")
pub fun runIn(program: string, args: [string], dir: string): string
