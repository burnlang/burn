import "../check/body.bn"
import "../check/check.bn"
import "../check/hir.bn"
import "../lower/own.bn"
import "arm64.bn"
import "meta.bn"
import "shared.bn"
import "x86.bn"

/** Why the program cannot be compiled to native code, or null, like `validate` in `native/mod.rs`. `libFuncs` names the functions of its bytecode libraries. */
pub fun nativeProblem(p: HProgram, libFuncs: [string]): string? {
    for f in p.funcs {
        if (f.external is External.Native) {
            return "`${f.name}` is marked @Native: functions provided by a host program only exist on bvm, so build this with `--target bvm` or `--target bar`, or run it with burni"
        }
    }
    for f in p.funcs {
        for a in f.annotations {
            if (!contains(MIXINS, a.name)) {
                continue
            }
            var target = strArg(a, "target") ?? ""
            if (contains(libFuncs, target)) {
                continue
            }
            for g in p.funcs {
                if (g.name == target && g.external == null) {
                    return "@${a.name} on `${f.name}` targets `${target}`, which is compiled to native code; mixins can only change bvm bytecode (use burni or `--target bvm`, or target a function in an imported bytecode library)"
                }
            }
            return "@${a.name} on `${f.name}` targets `${target}`, but no imported bytecode library has a function with that name"
        }
    }
    return null
}

/** The x86-64 assembly of a checked program for `platform` (such as `linux-x86_64`), with the bytes of its bytecode libraries, like `assembly` in `native/mod.rs`. */
pub fun nativeAssembly(c: Checker, p: HProgram, libs: [[int]], platform: string): string {
    var meta = encodeMeta(c)
    var funcs = lowerOwnership(c.types, p.funcs)
    var np = NativeProgram { checker: c, funcs: funcs, globals: len(p.globals), entry: p.entry, libs: libs, library: false, name: "" }
    var t = asmTarget(platform)
    if (t.arch == "aarch64") {
        return generateArm64(np, meta, t)
    }
    return generateX86(np, meta, t)
}

/** Why the program cannot be the runtime library, or null: it may only use the types every program has, so that its code works with the type table of whatever program it runs in. */
pub fun runtimeLibraryProblem(c: Checker, p: HProgram): string? {
    var n = c.types.count()
    if (n > FIRST_PROGRAM_TYPE) {
        [string] extra = []
        for t in FIRST_PROGRAM_TYPE..n {
            if (len(extra) < 5) {
                extra.push("`${c.show(t)}`")
            }
        }
        return "a runtime library can only use the built-in types (numbers, `bool`, `string`, `any`, `[string]`, `[int]`, `[any]` and `{string: any}`), but it uses ${join(extra, ", ")}"
    }
    if (len(c.libPaths) > 0) {
        return "a runtime library cannot import bytecode libraries"
    }
    return nativeProblem(p, [])
}

/** The assembly of the runtime library `name` written in Burn for `platform`: its functions, the C functions it exports with @Extern and `burn_<name>_init`, which runs its top-level code. */
pub fun runtimeLibraryAssembly(c: Checker, p: HProgram, platform: string, name: string): string {
    var funcs = lowerOwnership(c.types, p.funcs)
    var np = NativeProgram { checker: c, funcs: funcs, globals: len(p.globals), entry: p.entry, libs: [], library: true, name: name }
    var t = asmTarget(platform)
    if (t.arch == "aarch64") {
        return generateArm64(np, [], t)
    }
    return generateX86(np, [], t)
}

/**
 * The assembly that holds the bvm module or archive `bundle` for an executable that runs it: the bytes, and the C
 * functions `burn_bundle_data` and `burn_bundle_size` with which the launcher written in Burn
 * (`compiler/src/bin/launcher.bn`, linked in as `libburn_launcher.a`) finds them.
 */
pub fun launcherAssembly(bundle: [int], platform: string): string {
    var t = asmTarget(platform)
    var p = t.prefix
    if (t.arch == "aarch64") {
        var page = ""
        var off = ":lo12:"
        var offEnd = ""
        if (t.macos) {
            page = "@PAGE"
            off = ""
            offEnd = "@PAGEOFF"
        }
        var s = ".text\n.globl ${p}burn_bundle_data\n.p2align 2\n${p}burn_bundle_data:\n"
        s += "    adrp x0, burn_bundle${page}\n    add x0, x0, ${off}burn_bundle${offEnd}\n    ret\n"
        s += ".globl ${p}burn_bundle_size\n.p2align 2\n${p}burn_bundle_size:\n"
        s += "    adrp x0, burn_bundle_len${page}\n    add x0, x0, ${off}burn_bundle_len${offEnd}\n    ldr x0, [x0]\n    ret\n"
        return s + bundleData(bundle, t.macos)
    }
    var s = ".intel_syntax noprefix\n.text\n"
    s += ".globl ${p}burn_bundle_data\n${p}burn_bundle_data:\n    lea rax, [rip + burn_bundle]\n    ret\n"
    s += ".globl ${p}burn_bundle_size\n${p}burn_bundle_size:\n    mov rax, qword ptr [rip + burn_bundle_len]\n    ret\n"
    return s + bundleData(bundle, t.macos)
}

priv fun bundleData(bundle: [int], macos: bool): string {
    var s = ""
    if (macos) {
        s += ".section __TEXT,__const\n"
    } else {
        s += ".section .rodata\n"
    }
    s += ".p2align 4\n"
    s += "burn_bundle_len:\n    .quad ${len(bundle)}\n"
    s += "burn_bundle:\n"
    var i = 0
    while (i < len(bundle)) {
        var end = i + 32
        if (end > len(bundle)) {
            end = len(bundle)
        }
        [string] parts = []
        for k in i..end {
            parts.push(toString(bundle[k]))
        }
        s += "    .byte ${join(parts, ",")}\n"
        i = end
    }
    if (!macos) {
        s += ".section .note.GNU-stack,\"\",@progbits\n"
    }
    return s
}

