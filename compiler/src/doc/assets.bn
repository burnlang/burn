/** The declarations of the built-in functions, from `lib/doc/builtins.bn`, written by `compiler/src/bin/gendoc.bn`. */
pub const BUILTINS_SOURCE = "/**\n * Prints its arguments to standard output, separated by spaces, followed by a newline.\n *\n * Values are formatted the same way as in string templates. Without arguments,\n * prints an empty line.\n *\n * @param values the values to print, any number of them\n * @see eprint\n * @see write\n * @group Output\n * @alias println\n * @since 26.1\n * @example\n *     print(\"total:\", 3 * 4)      // total: 12\n *     print([1, 2], {\"a\": true})  // [1, 2] {\"a\": true}\n */\nfun print(values: any...)\n\n/**\n * Prints its arguments to standard error, separated by spaces, followed by a newline.\n *\n * Values are formatted like `print` does. Standard output is flushed first, so\n * messages appear in the order the program wrote them.\n *\n * @param values the values to print, any number of them\n * @see print\n * @group Output\n * @since 26.1\n * @example\n *     eprint(\"warning:\", 3, \"files skipped\")  // warning: 3 files skipped (on standard error)\n */\nfun eprint(values: any...)\n\n/**\n * Prints one value to standard output without a newline.\n *\n * The value is formatted like `print` does. Use it to build a line from several\n * pieces or to show a prompt.\n *\n * @param value the value to print\n * @see print\n * @group Output\n * @since 26.1\n * @example\n *     write(\"3 + 4 = \")\n *     print(3 + 4)  // 3 + 4 = 7\n */\nfun write(value: any)\n\n/**\n * Prints a prompt and reads one line from standard input.\n *\n * The line is returned without its line break (`\\n` or `\\r\\n`). At the end of\n * the input, returns an empty string.\n *\n * @param prompt the text to print before reading, without a newline\n * @return the line that was read\n * @see readStdin\n * @group Input\n * @since 26.1\n * @example\n *     var name = input(\"Name: \")\n *     print(\"Hello, \" + name + \"!\")  // Hello, Ada! (when the user types Ada)\n */\nfun input(prompt: string = \"\"): string\n\n/**\n * Reads all remaining standard input until it ends.\n *\n * Bytes that are not valid UTF-8 are replaced with `U+FFFD`. Returns an empty\n * string when nothing is left.\n *\n * @return everything left on standard input\n * @see input\n * @group Input\n * @since 26.1\n * @example\n *     var lines = split(trim(readStdin()), \"\\n\")\n *     print(len(lines))  // the number of lines piped into the program\n */\nfun readStdin(): string\n\n/**\n * Converts a value to a string.\n *\n * The result is the same text that `print` and string templates produce:\n * strings are returned unchanged and `null` becomes `\"null\"`. Works as a method\n * on every value, including structs: `point.toString()`.\n *\n * @param value the value to convert, anything except `void`\n * @return the value as text\n * @see toInt\n * @see toFloat\n * @group Conversion\n * @alias str\n * @since 26.1\n * @example\n *     toString(42)      // \"42\"\n *     toString(3.0)     // \"3.0\"\n *     toString([1, 2])  // \"[1, 2]\"\n */\nfun toString(value: any): string\n\n/**\n * Converts a string, float, bool or enum value to an `int`.\n *\n * Strings may have surrounding whitespace; a string with a decimal point or an\n * exponent is read as a float and truncated. Floats are truncated toward zero,\n * `true` becomes `1`, and enum values become their position in the enum. An\n * `any` value must already hold an `int`; narrow it with `is` to convert other\n * types.\n *\n * @param value a string, float, int, bool or enum value\n * @return the value as an `int`\n * @throws when a string is not a number, or an `any` value does not hold an `int`\n * @see isInt\n * @see toFloat\n * @group Conversion\n * @alias parseInt\n * @since 26.1\n * @example\n *     toInt(\"42\")   // 42\n *     toInt(\" 7 \")  // 7\n *     toInt(\"3.7\")  // 3\n *     toInt(-3.9)   // -3\n *     toInt(true)   // 1\n */\nfun toInt(value: any): int\n\n/**\n * Converts a string or an `int` to a `float`.\n *\n * Strings may have surrounding whitespace and use exponents such as `\"1e3\"`.\n *\n * @param value a string, int or float\n * @return the value as a `float`\n * @throws when a string is not a number\n * @see isNumber\n * @see toInt\n * @group Conversion\n * @alias parseFloat\n * @since 26.1\n * @example\n *     toFloat(\"2.5\")  // 2.5\n *     toFloat(3)      // 3.0\n *     toFloat(\"1e3\")  // 1000.0\n */\nfun toFloat(value: any): float\n\n/**\n * Tells whether a string holds a whole number.\n *\n * Surrounding whitespace and a leading sign are allowed. Use it to check input\n * before calling `toInt`.\n *\n * @param text the string to test\n * @return `true` if the text is an integer such as `\"42\"` or `\"-7\"`\n * @see isNumber\n * @see toInt\n * @group Conversion\n * @since 26.1\n * @example\n *     isInt(\"42\")    // true\n *     isInt(\" -7 \")  // true\n *     isInt(\"1.5\")   // false\n */\nfun isInt(text: string): bool\n\n/**\n * Tells whether a string holds a number that `toFloat` accepts.\n *\n * Surrounding whitespace, a sign, a decimal point and an exponent are allowed.\n *\n * @param text the string to test\n * @return `true` if `toFloat(text)` succeeds\n * @see isInt\n * @see toFloat\n * @group Conversion\n * @since 26.1\n * @example\n *     isNumber(\"1.5\")  // true\n *     isNumber(\"1e3\")  // true\n *     isNumber(\"abc\")  // false\n */\nfun isNumber(text: string): bool\n\n/**\n * Returns the part of a string between two character indexes.\n *\n * The result starts at `start` and ends before `end`. Indexes count Unicode\n * characters and are clamped to the string, so this never fails; when `start`\n * is not before `end` the result is empty.\n *\n * @param text the string\n * @param start the index of the first character to include\n * @param end the index after the last character to include\n * @return the characters from `start` up to, but not including, `end`\n * @see slice\n * @see charAt\n * @group Strings\n * @since 26.1\n * @example\n *     substring(\"hello\", 1, 3)   // \"el\"\n *     substring(\"hello\", 2)      // \"llo\"\n *     substring(\"hello\", 3, 10)  // \"lo\"\n */\nfun substring(text: string, start: int, end: int = len(text)): string\n\n/**\n * Returns the character at an index as a one-character string.\n *\n * Indexes count Unicode characters. Unlike `text[index]`, an index outside the\n * string gives an empty string instead of an error.\n *\n * @param text the string\n * @param index the position of the character, starting at `0`\n * @return the character, or `\"\"` when the index is out of range\n * @see substring\n * @see chars\n * @group Strings\n * @since 26.1\n * @example\n *     charAt(\"hello\", 1)  // \"e\"\n *     charAt(\"hello\", 9)  // \"\"\n */\nfun charAt(text: string, index: int): string\n\n/**\n * Splits a string at every occurrence of a separator.\n *\n * Empty parts are kept, so two separators in a row produce `\"\"`. The default\n * separator is a single space. An empty separator splits the string into its\n * characters.\n *\n * @param text the string to split\n * @param separator the text between the parts\n * @return the parts, in order\n * @see join\n * @see chars\n * @group Strings\n * @since 26.1\n * @example\n *     split(\"a,b,,c\", \",\")  // [\"a\", \"b\", \"\", \"c\"]\n *     split(\"one two\")      // [\"one\", \"two\"]\n *     \"x-y\".split(\"-\")      // [\"x\", \"y\"]\n */\nfun split(text: string, separator: string = \" \"): [string]\n\n/**\n * Removes whitespace from both ends of a string.\n *\n * Spaces, tabs, line breaks and other Unicode whitespace are removed. Usually\n * called as a method: `line.trim()`.\n *\n * @param text the string\n * @return the string without leading and trailing whitespace\n * @group Strings\n * @since 26.1\n * @example\n *     trim(\"  hi \\n\")  // \"hi\"\n */\nfun trim(text: string): string\n\n/**\n * Converts a string to upper case.\n *\n * Uses the Unicode case rules, so the result can be longer than the input.\n * Usually called as a method: `text.upper()`.\n *\n * @param text the string\n * @return the string in upper case\n * @see lower\n * @group Strings\n * @alias toUpper\n * @alias toUpperCase\n * @since 26.1\n * @example\n *     upper(\"Hello\")    // \"HELLO\"\n *     \"straße\".upper()  // \"STRASSE\"\n */\nfun upper(text: string): string\n\n/**\n * Converts a string to lower case.\n *\n * Uses the Unicode case rules. Usually called as a method: `text.lower()`.\n *\n * @param text the string\n * @return the string in lower case\n * @see upper\n * @group Strings\n * @alias toLower\n * @alias toLowerCase\n * @since 26.1\n * @example\n *     lower(\"Hello\")  // \"hello\"\n *     \"ÄBC\".lower()   // \"äbc\"\n */\nfun lower(text: string): string\n\n/**\n * Tells whether a string begins with a prefix.\n *\n * Every string starts with the empty string. Usually called as a method:\n * `path.startsWith(\"/\")`.\n *\n * @param text the string to test\n * @param prefix the text to look for at the start\n * @return `true` if `text` begins with `prefix`\n * @see endsWith\n * @group Strings\n * @since 26.1\n * @example\n *     startsWith(\"hello\", \"he\")  // true\n *     \"hello\".startsWith(\"lo\")   // false\n */\nfun startsWith(text: string, prefix: string): bool\n\n/**\n * Tells whether a string ends with a suffix.\n *\n * Every string ends with the empty string. Usually called as a method:\n * `name.endsWith(\".bn\")`.\n *\n * @param text the string to test\n * @param suffix the text to look for at the end\n * @return `true` if `text` ends with `suffix`\n * @see startsWith\n * @group Strings\n * @since 26.1\n * @example\n *     endsWith(\"main.bn\", \".bn\")  // true\n *     \"hello\".endsWith(\"he\")      // false\n */\nfun endsWith(text: string, suffix: string): bool\n\n/**\n * Replaces every occurrence of a text in a string.\n *\n * When `target` is empty the string is returned unchanged. Usually called as a\n * method: `text.replace(\"-\", \" \")`.\n *\n * @param text the string to search\n * @param target the text to replace\n * @param replacement the text to put in its place\n * @return a new string with all occurrences replaced\n * @group Strings\n * @since 26.1\n * @example\n *     replace(\"a-b-c\", \"-\", \"+\")  // \"a+b+c\"\n */\nfun replace(text: string, target: string, replacement: string): string\n\n/**\n * Repeats a string a number of times.\n *\n * A count of zero or less gives an empty string.\n *\n * @param text the string to repeat\n * @param count how many copies to join\n * @return `count` copies of `text`, one after another\n * @group Strings\n * @since 26.1\n * @example\n *     repeat(\"ab\", 3)  // \"ababab\"\n *     \"-\".repeat(5)    // \"-----\"\n */\nfun repeat(text: string, count: int): string\n\n/**\n * Splits a string into its characters.\n *\n * Each element is one Unicode character.\n *\n * @param text the string\n * @return the characters, each as a one-character string\n * @see split\n * @see charAt\n * @group Strings\n * @since 26.1\n * @example\n *     chars(\"héy\")  // [\"h\", \"é\", \"y\"]\n */\nfun chars(text: string): [string]\n\n/**\n * Returns the Unicode code point of the first character of a string.\n *\n * @param text the string, usually a single character\n * @return the code point, or `-1` for an empty string\n * @see fromCharCode\n * @group Strings\n * @since 26.1\n * @example\n *     charCode(\"A\")  // 65\n *     charCode(\"é\")  // 233\n *     charCode(\"\")   // -1\n */\nfun charCode(text: string): int\n\n/**\n * Returns the character with a Unicode code point as a string.\n *\n * @param code the code point\n * @return a one-character string, or `\"\"` when `code` is not a valid code point\n * @see charCode\n * @group Strings\n * @since 26.1\n * @example\n *     fromCharCode(97)   // \"a\"\n *     fromCharCode(233)  // \"é\"\n */\nfun fromCharCode(code: int): string\n\n/**\n * Returns the UTF-8 bytes of a string.\n *\n * The result is a packed `[uint8]` array that uses one byte per element.\n *\n * @param text the string\n * @return the bytes of `text`\n * @see fromBytes\n * @group Strings\n * @since 26.1\n * @example\n *     \"hé\".bytes()  // [104, 195, 169]\n */\nfun bytes(text: string): [uint8]\n\n/**\n * Decodes UTF-8 bytes into a string.\n *\n * Bytes that are not valid UTF-8 become the replacement character `\\u{FFFD}`.\n *\n * @param data the bytes\n * @return the decoded string\n * @see bytes\n * @group Strings\n * @since 26.1\n * @example\n *     fromBytes([104, 105])  // \"hi\"\n */\nfun fromBytes(data: [uint8]): string\n\n/**\n * Tells whether every character of a string is a letter.\n *\n * Letters from all scripts count. An empty string gives `false`.\n *\n * @param text the string to test, often a single character\n * @return `true` if the string is not empty and has only letters\n * @see isAlphanumeric\n * @group Strings\n * @since 26.1\n * @example\n *     isLetter(\"abc\")  // true\n *     isLetter(\"é\")    // true\n *     isLetter(\"a1\")   // false\n */\nfun isLetter(text: string): bool\n\n/**\n * Tells whether every character of a string is a digit from `0` to `9`.\n *\n * Only ASCII digits count. An empty string gives `false`.\n *\n * @param text the string to test, often a single character\n * @return `true` if the string is not empty and has only the digits `0` to `9`\n * @see isInt\n * @group Strings\n * @since 26.1\n * @example\n *     isDigit(\"2026\")  // true\n *     isDigit(\"-1\")    // false\n */\nfun isDigit(text: string): bool\n\n/**\n * Tells whether every character of a string is a letter or a number.\n *\n * Letters and numbers from all scripts count, not only ASCII. An empty string\n * gives `false`.\n *\n * @param text the string to test, often a single character\n * @return `true` if the string is not empty and has only letters and numbers\n * @see isLetter\n * @see isDigit\n * @group Strings\n * @since 26.1\n * @example\n *     isAlphanumeric(\"abc123\")  // true\n *     isAlphanumeric(\"a b\")     // false\n */\nfun isAlphanumeric(text: string): bool\n\n/**\n * Tells whether every character of a string is whitespace.\n *\n * Spaces, tabs, line breaks and other Unicode whitespace count. An empty string\n * gives `false`.\n *\n * @param text the string to test, often a single character\n * @return `true` if the string is not empty and has only whitespace\n * @see trim\n * @group Strings\n * @since 26.1\n * @example\n *     isWhitespace(\" \\t\\n\")  // true\n *     isWhitespace(\"\")       // false\n */\nfun isWhitespace(text: string): bool\n\n/**\n * Returns the length of a string, array or map.\n *\n * Strings count Unicode characters, arrays count elements and maps count\n * entries. An `any` value that is `null` has length `0`. It can also be\n * written as a property: `items.length`.\n *\n * @param value a string, array or map\n * @return the number of characters, elements or entries\n * @throws when an `any` value holds something other than a string, array or map\n * @group Arrays\n * @alias length\n * @alias size\n * @since 26.1\n * @example\n *     len(\"héllo\")    // 5\n *     len([1, 2, 3])  // 3\n *     len({\"a\": 1})   // 1\n *     [1, 2].length   // 2\n */\nfun len(value: any): int\n\n/**\n * Adds a value to the end of an array.\n *\n * The array is changed in place. Usually called as a method: `items.push(x)`.\n *\n * @param items the array to change\n * @param value the value to add\n * @see append\n * @see pop\n * @see insert\n * @group Arrays\n * @since 26.1\n * @example\n *     var items = [1, 2]\n *     items.push(3)\n *     items  // [1, 2, 3]\n */\nfun push(items: [T], value: T)\n\n/**\n * Adds a value to the end of an array and returns the array.\n *\n * Works like `push`, but returns the same array, not a copy, so calls can be\n * chained. Usually called as a method: `items.append(x)`.\n *\n * @param items the array to change\n * @param value the value to add\n * @return `items`, after the value was added\n * @see push\n * @group Arrays\n * @since 26.1\n * @example\n *     var items = [1]\n *     items.append(2).append(3)  // [1, 2, 3]\n *     items                      // [1, 2, 3]\n */\nfun append(items: [T], value: T): [T]\n\n/**\n * Removes the last element of an array and returns it.\n *\n * Usually called as a method: `stack.pop()`.\n *\n * @param items the array to change\n * @return the element that was removed\n * @throws when the array is empty\n * @see push\n * @see remove\n * @group Arrays\n * @since 26.1\n * @example\n *     var items = [1, 2, 3]\n *     items.pop()  // 3\n *     items        // [1, 2]\n */\nfun pop(items: [T]): T\n\n/**\n * Inserts a value into an array before an index.\n *\n * Later elements move one place back. An index equal to the length adds the\n * value at the end. Usually called as a method: `items.insert(0, x)`.\n *\n * @param items the array to change\n * @param index the position the new value will have, from `0` to `len(items)`\n * @param value the value to insert\n * @throws when the index is below `0` or greater than the length\n * @see push\n * @see remove\n * @group Arrays\n * @since 26.1\n * @example\n *     var items = [\"a\", \"c\"]\n *     items.insert(1, \"b\")\n *     items  // [\"a\", \"b\", \"c\"]\n */\nfun insert(items: [T], index: int, value: T)\n\n/**\n * Removes the element at an index from an array and returns it.\n *\n * Later elements move one place forward. Given a map, `remove(map, key)`\n * removes the key instead and returns whether it was there; a missing key is\n * not an error. Usually called as a method: `items.remove(0)`.\n *\n * @param items the array to change, or a map\n * @param index the position of the element, or the key for a map\n * @return the element that was removed; for a map, `true` if the key was there\n * @throws when the index is out of bounds\n * @see pop\n * @see insert\n * @group Arrays\n * @since 26.1\n * @example\n *     var items = [10, 20, 30]\n *     items.remove(1)  // 20\n *     items            // [10, 30]\n *     var ages = {\"ada\": 36}\n *     ages.remove(\"ada\")  // true\n *     ages.remove(\"bob\")  // false\n */\nfun remove(items: [T], index: int): T\n\n/**\n * Tells whether an array contains a value.\n *\n * Elements are compared with `==`, so arrays, maps and structs are compared by\n * content. Also works on strings, where it looks for a substring, and on maps,\n * where it looks for a key.\n *\n * @param items the array to search, or a string or map\n * @param value the element to look for; a substring for strings, a key for maps\n * @return `true` if the value was found\n * @see indexOf\n * @see has\n * @group Arrays\n * @since 26.1\n * @example\n *     contains([1, 2, 3], 2)   // true\n *     \"hello\".contains(\"ell\")  // true\n *     contains({\"a\": 1}, \"b\")  // false\n */\nfun contains(items: [T], value: T): bool\n\n/**\n * Returns the index of the first element equal to a value.\n *\n * Elements are compared with `==`. Also works on strings, where it returns the\n * character index of the first occurrence of a substring.\n *\n * @param items the array to search, or a string\n * @param value the element to look for, or a substring for strings\n * @return the index of the first match, or `-1` if there is none\n * @see contains\n * @group Arrays\n * @since 26.1\n * @example\n *     indexOf([10, 20, 30], 20)  // 1\n *     indexOf(\"hello\", \"l\")      // 2\n *     indexOf([1, 2], 5)         // -1\n */\nfun indexOf(items: [T], value: T): int\n\n/**\n * Joins the elements of an array into one string.\n *\n * Elements are converted like `toString` does, so strings are not quoted.\n *\n * @param items the array\n * @param separator the text to put between two elements\n * @return the joined text\n * @see split\n * @group Arrays\n * @since 26.1\n * @example\n *     join([1, 2, 3], \", \")  // \"1, 2, 3\"\n *     join([\"a\", \"b\"])       // \"ab\"\n */\nfun join(items: [T], separator: string = \"\"): string\n\n/**\n * Reverses the order of the elements of an array.\n *\n * The array is changed in place. Given a string, returns a new string with the\n * characters in reverse order instead.\n *\n * @param items the array to change, or a string\n * @see sort\n * @group Arrays\n * @since 26.1\n * @example\n *     var items = [1, 2, 3]\n *     items.reverse()\n *     items           // [3, 2, 1]\n *     reverse(\"abc\")  // \"cba\"\n */\nfun reverse(items: [T])\n\n/**\n * Sorts an array in ascending order.\n *\n * The array is changed in place. Only arrays of `int`, `float`, `string`,\n * `bool`, enum or `any` values can be sorted. Strings are compared byte by\n * byte, so upper case letters come before lower case ones, and enum values are\n * sorted by their position in the enum.\n *\n * @param items the array to sort\n * @see reverse\n * @group Arrays\n * @since 26.1\n * @example\n *     var words = [\"b\", \"a\", \"C\"]\n *     words.sort()\n *     words  // [\"C\", \"a\", \"b\"]\n */\nfun sort(items: [T])\n\n/**\n * Returns a new array with the elements between two indexes.\n *\n * The result starts at `start` and ends before `end`. Indexes are clamped to\n * the array, so this never fails; negative indexes count as `0`. Given a\n * string, returns a substring like `substring` does.\n *\n * @param items the array, or a string\n * @param start the index of the first element to include\n * @param end the index after the last element to include\n * @return a new array; the original is not changed\n * @see substring\n * @see copy\n * @group Arrays\n * @since 26.1\n * @example\n *     slice([1, 2, 3, 4], 1, 3)  // [2, 3]\n *     slice([1, 2, 3, 4], 2)     // [3, 4]\n *     slice(\"hello\", 1, 3)       // \"el\"\n */\nfun slice(items: [T], start: int, end: int = len(items)): [T]\n\n/**\n * Returns a shallow copy of an array.\n *\n * Changing the copy does not change the original, but both share the elements\n * themselves. Maps are not supported.\n *\n * @param items the array to copy\n * @return a new array with the same elements\n * @see slice\n * @group Arrays\n * @since 26.1\n * @example\n *     var a = [1, 2]\n *     var b = copy(a)\n *     b.push(3)\n *     a  // [1, 2]\n */\nfun copy(items: [T]): [T]\n\n/**\n * Removes all elements from an array.\n *\n * The array is changed in place. Maps are not supported. Usually called as a\n * method: `items.clear()`.\n *\n * @param items the array to empty\n * @group Arrays\n * @since 26.1\n * @example\n *     var items = [1, 2]\n *     items.clear()\n *     items  // []\n */\nfun clear(items: [T])\n\n/**\n * Returns the keys of a map.\n *\n * Keys are in insertion order. Usually called as a method: `map.keys()`.\n *\n * @param map the map\n * @return a new array with the keys\n * @see values\n * @group Maps\n * @since 26.1\n * @example\n *     keys({\"b\": 2, \"a\": 1})  // [\"b\", \"a\"]\n */\nfun keys(map: {K: V}): [K]\n\n/**\n * Returns the values of a map.\n *\n * Values are in insertion order of their keys. Usually called as a method:\n * `map.values()`.\n *\n * @param map the map\n * @return a new array with the values\n * @see keys\n * @group Maps\n * @since 26.1\n * @example\n *     values({\"b\": 2, \"a\": 1})  // [2, 1]\n */\nfun values(map: {K: V}): [V]\n\n/**\n * Tells whether a map contains a key.\n *\n * Usually called as a method: `map.has(key)`.\n *\n * @param map the map\n * @param key the key to look for\n * @return `true` if the key is in the map\n * @see get\n * @see contains\n * @group Maps\n * @since 26.1\n * @example\n *     var ages = {\"ada\": 36}\n *     ages.has(\"ada\")  // true\n *     ages.has(\"bob\")  // false\n */\nfun has(map: {K: V}, key: K): bool\n\n/**\n * Returns the value for a key in a map.\n *\n * Without a fallback, a missing key stops the program, like `map[key]`. Given\n * an array and an index, returns the element like `items[index]`. Usually\n * called as a method: `map.get(key, fallback)`.\n *\n * @param map the map\n * @param key the key to look up\n * @param fallback the value to return when the key is missing; if omitted, a\n *     missing key is an error\n * @return the value for the key, or `fallback` when the key is missing\n * @throws when the key is missing and no fallback is given\n * @see has\n * @see remove\n * @group Maps\n * @since 26.1\n * @example\n *     var ages = {\"ada\": 36}\n *     ages.get(\"ada\")     // 36\n *     ages.get(\"bob\", 0)  // 0\n */\nfun get(map: {K: V}, key: K, fallback: V = none): V\n\n/**\n * Returns the absolute value of a number.\n *\n * An `int` argument gives an `int`, a `float` argument a `float`. The\n * smallest `int` has no positive counterpart, so `abs` of it is a runtime\n * error.\n *\n * @param x the number\n * @return `x` without its sign\n * @group Math\n * @since 26.1\n * @example\n *     abs(-5)    // 5\n *     abs(-2.5)  // 2.5\n */\nfun abs(x: float): float\n\n/**\n * Returns the smaller of two numbers.\n *\n * When both arguments are `int` the result is an `int`; otherwise both are\n * converted to `float`.\n *\n * @param a the first number\n * @param b the second number\n * @return the smaller of `a` and `b`\n * @see max\n * @group Math\n * @since 26.1\n * @example\n *     min(3, 7)    // 3\n *     min(2, 3.5)  // 2.0\n */\nfun min(a: float, b: float): float\n\n/**\n * Returns the larger of two numbers.\n *\n * When both arguments are `int` the result is an `int`; otherwise both are\n * converted to `float`.\n *\n * @param a the first number\n * @param b the second number\n * @return the larger of `a` and `b`\n * @see min\n * @group Math\n * @since 26.1\n * @example\n *     max(3, 7)    // 7\n *     max(2.5, 1)  // 2.5\n */\nfun max(a: float, b: float): float\n\n/**\n * Raises a number to a power.\n *\n * When both arguments are `int` the result is an `int`: a negative exponent\n * gives `0` and a result that does not fit in an `int` is a runtime error.\n * Otherwise both are converted to `float`.\n *\n * @param base the number to raise\n * @param exponent the power\n * @return `base` raised to `exponent`\n * @see sqrt\n * @see exp\n * @group Math\n * @since 26.1\n * @example\n *     pow(2, 10)     // 1024\n *     pow(2.0, 0.5)  // 1.4142135623730951\n *     pow(2, -1)     // 0\n */\nfun pow(base: float, exponent: float): float\n\n/**\n * Returns the square root of a number.\n *\n * @param x a number, `int` values are converted to `float`\n * @return the square root, `NaN` for negative numbers\n * @see pow\n * @group Math\n * @since 26.1\n * @example\n *     sqrt(16.0)  // 4.0\n *     sqrt(2)     // 1.4142135623730951\n */\nfun sqrt(x: float): float\n\n/**\n * Adds two integers and wraps around at the edges of their type instead of failing.\n *\n * Use it for hashes and checksums, where overflowing is expected. Works on every\n * integer type; the result has the same type.\n *\n * @param x the first number\n * @param y the number to add\n * @return `x + y`, wrapped to the range of the type\n * @see wrappingSub\n * @see wrappingMul\n * @group Math\n * @since 26.1\n * @example\n *     uint8 b = 250\n *     b.wrappingAdd(10)  // 4\n */\nfun wrappingAdd(x: int, y: int): int\n\n/**\n * Subtracts two integers and wraps around at the edges of their type instead of failing.\n *\n * @param x the first number\n * @param y the number to subtract\n * @return `x - y`, wrapped to the range of the type\n * @see wrappingAdd\n * @group Math\n * @since 26.1\n * @example\n *     uint8 b = 3\n *     b.wrappingSub(5)  // 254\n */\nfun wrappingSub(x: int, y: int): int\n\n/**\n * Multiplies two integers and wraps around at the edges of their type instead of failing.\n *\n * @param x the first number\n * @param y the number to multiply by\n * @return `x * y`, wrapped to the range of the type\n * @see wrappingAdd\n * @group Math\n * @since 26.1\n * @example\n *     uint64 h = 14695981039346656037\n *     h.wrappingMul(1099511628211)  // 12638153115695167455\n */\nfun wrappingMul(x: int, y: int): int\n\n/**\n * Rounds a number down to the nearest `int`.\n *\n * An `int` argument is returned unchanged.\n *\n * @param x the number\n * @return the largest `int` that is less than or equal to `x`\n * @see ceil\n * @see round\n * @group Math\n * @since 26.1\n * @example\n *     floor(2.7)   // 2\n *     floor(-2.5)  // -3\n */\nfun floor(x: float): int\n\n/**\n * Rounds a number up to the nearest `int`.\n *\n * An `int` argument is returned unchanged.\n *\n * @param x the number\n * @return the smallest `int` that is greater than or equal to `x`\n * @see floor\n * @see round\n * @group Math\n * @since 26.1\n * @example\n *     ceil(2.1)   // 3\n *     ceil(-2.1)  // -2\n */\nfun ceil(x: float): int\n\n/**\n * Rounds a number to the nearest `int`.\n *\n * Halfway cases are rounded away from zero. An `int` argument is returned\n * unchanged.\n *\n * @param x the number\n * @return the `int` closest to `x`\n * @see floor\n * @see ceil\n * @group Math\n * @since 26.1\n * @example\n *     round(2.4)   // 2\n *     round(2.5)   // 3\n *     round(-2.5)  // -3\n */\nfun round(x: float): int\n\n/**\n * Returns Euler's number `e` raised to a power.\n *\n * @param x the exponent, `int` values are converted to `float`\n * @return `e` to the power of `x`\n * @see log\n * @see pow\n * @group Math\n * @since 26.1\n * @example\n *     exp(0.0)  // 1.0\n *     exp(1.0)  // 2.718281828459045\n */\nfun exp(x: float): float\n\n/**\n * Returns the natural logarithm of a number.\n *\n * @param x a number, `int` values are converted to `float`\n * @return the logarithm to base `e`; `-Infinity` for `0.0` and `NaN` for\n *     negative numbers\n * @see log10\n * @see exp\n * @group Math\n * @since 26.1\n * @example\n *     log(1.0)                // 0.0\n *     log(2.718281828459045)  // 1.0\n */\nfun log(x: float): float\n\n/**\n * Returns the base 10 logarithm of a number.\n *\n * @param x a number, `int` values are converted to `float`\n * @return the logarithm to base 10; `-Infinity` for `0.0` and `NaN` for\n *     negative numbers\n * @see log\n * @group Math\n * @since 26.1\n * @example\n *     log10(1000.0)  // 3.0\n */\nfun log10(x: float): float\n\n/**\n * Returns the sine of an angle.\n *\n * @param x the angle in radians, `int` values are converted to `float`\n * @return the sine, from `-1.0` to `1.0`\n * @see cos\n * @see asin\n * @group Math\n * @since 26.1\n * @example\n *     sin(0.0)                      // 0.0\n *     sin(3.141592653589793 / 2.0)  // 1.0\n */\nfun sin(x: float): float\n\n/**\n * Returns the cosine of an angle.\n *\n * @param x the angle in radians, `int` values are converted to `float`\n * @return the cosine, from `-1.0` to `1.0`\n * @see sin\n * @see acos\n * @group Math\n * @since 26.1\n * @example\n *     cos(0.0)  // 1.0\n */\nfun cos(x: float): float\n\n/**\n * Returns the tangent of an angle.\n *\n * @param x the angle in radians, `int` values are converted to `float`\n * @return the tangent\n * @see atan\n * @group Math\n * @since 26.1\n * @example\n *     tan(0.0)  // 0.0\n */\nfun tan(x: float): float\n\n/**\n * Returns the arc sine of a number.\n *\n * @param x a number from `-1.0` to `1.0`, `int` values are converted to `float`\n * @return the angle in radians, from `-PI / 2` to `PI / 2`; `NaN` when `x` is\n *     outside the range\n * @see sin\n * @group Math\n * @since 26.1\n * @example\n *     asin(1.0)  // 1.5707963267948966\n */\nfun asin(x: float): float\n\n/**\n * Returns the arc cosine of a number.\n *\n * @param x a number from `-1.0` to `1.0`, `int` values are converted to `float`\n * @return the angle in radians, from `0.0` to `PI`; `NaN` when `x` is outside\n *     the range\n * @see cos\n * @group Math\n * @since 26.1\n * @example\n *     acos(1.0)   // 0.0\n *     acos(-1.0)  // 3.141592653589793\n */\nfun acos(x: float): float\n\n/**\n * Returns the arc tangent of a number.\n *\n * @param x a number, `int` values are converted to `float`\n * @return the angle in radians, from `-PI / 2` to `PI / 2`\n * @see atan2\n * @see tan\n * @group Math\n * @since 26.1\n * @example\n *     atan(1.0)  // 0.7853981633974483\n */\nfun atan(x: float): float\n\n/**\n * Returns the angle of the point `(x, y)` from the positive x axis.\n *\n * Unlike `atan(y / x)`, the signs of both arguments are used to find the\n * quadrant, and `x` may be `0`.\n *\n * @param y the y coordinate, `int` values are converted to `float`\n * @param x the x coordinate, `int` values are converted to `float`\n * @return the angle in radians, from `-PI` to `PI`\n * @see atan\n * @group Math\n * @since 26.1\n * @example\n *     atan2(1.0, 1.0)   // 0.7853981633974483\n *     atan2(1.0, -1.0)  // 2.356194490192345\n */\nfun atan2(y: float, x: float): float\n\n/**\n * Returns a random float from `0.0` up to, but not including, `1.0`.\n *\n * The generator is seeded from the clock when the program starts; call `seed`\n * for a repeatable sequence. It is not suitable for cryptography.\n *\n * @return a random number in the range `[0.0, 1.0)`\n * @see randomInt\n * @see seed\n * @group Random\n * @since 26.1\n * @example\n *     random()  // for example 0.7055475143366563\n */\nfun random(): float\n\n/**\n * Returns a random `int` in a range, both ends included.\n *\n * When `max` is not greater than `min`, returns `min`.\n *\n * @param min the smallest possible result\n * @param max the largest possible result\n * @return a random number from `min` to `max`\n * @see random\n * @see seed\n * @group Random\n * @since 26.1\n * @example\n *     randomInt(1, 6)  // a dice roll, for example 4\n */\nfun randomInt(min: int, max: int): int\n\n/**\n * Seeds the random number generator.\n *\n * After the same seed, `random` and `randomInt` return the same sequence of\n * numbers.\n *\n * @param value the seed\n * @see random\n * @see randomInt\n * @group Random\n * @since 26.1\n * @example\n *     seed(42)\n *     var a = random()\n *     seed(42)\n *     random() == a  // true\n */\nfun seed(value: int)\n\n/**\n * Returns the current time in seconds since the Unix epoch.\n *\n * The epoch is 1 January 1970 UTC. The fractional part holds the sub-second\n * time.\n *\n * @return the seconds since the epoch\n * @see nowMs\n * @see clock\n * @group Time\n * @since 26.1\n * @example\n *     now()  // for example 1790749674.9705174\n */\nfun now(): float\n\n/**\n * Returns the current time in milliseconds since the Unix epoch.\n *\n * The epoch is 1 January 1970 UTC.\n *\n * @return the whole milliseconds since the epoch\n * @see now\n * @see clock\n * @group Time\n * @alias millis\n * @since 26.1\n * @example\n *     nowMs()  // for example 1790749674970\n */\nfun nowMs(): int\n\n/**\n * Returns the value of a monotonic clock in nanoseconds.\n *\n * The clock never goes backwards, even when the system time changes, but its\n * starting point is not fixed. Use it to measure durations by subtracting two\n * values.\n *\n * @return the clock value in nanoseconds\n * @see nowMs\n * @group Time\n * @since 26.1\n * @example\n *     var start = clock()\n *     sleep(20)\n *     (clock() - start) / 1000000 >= 20  // true\n */\nfun clock(): int\n\n/**\n * Pauses the current task for a number of milliseconds.\n *\n * Standard output is flushed first. A `float` is truncated to whole\n * milliseconds, and negative values do not pause. Other async tasks keep\n * running.\n *\n * @param ms how long to pause, in milliseconds\n * @see clock\n * @group Time\n * @since 26.1\n * @example\n *     sleep(500)  // waits half a second\n */\nfun sleep(ms: int)\n\n/**\n * Returns the current local date and time as an array of numbers.\n *\n * The elements are year, month (`1` to `12`), day, hour, minute, second,\n * millisecond, weekday (`0` is Sunday) and the offset from UTC in seconds.\n * This is an internal function used by `std/date` and `std/time`; use `Date`\n * and `Time` from those modules instead. It cannot be called as a method.\n *\n * @return `[year, month, day, hour, minute, second, millisecond, weekday, utcOffset]`\n * @see now\n * @group Time\n * @since 26.1\n * @example\n *     __localTime()  // for example [2026, 9, 30, 6, 23, 21, 692, 3, 0]\n */\nfun __localTime(): [int]\n\n/**\n * Reads a whole file as text.\n *\n * Bytes that are not valid UTF-8 are replaced with `U+FFFD`.\n *\n * @param path the path of the file, relative to the working directory or absolute\n * @return the contents of the file\n * @throws when the file does not exist or cannot be read\n * @see writeFile\n * @see fileExists\n * @group Files\n * @since 26.1\n * @example\n *     writeFile(\"notes.txt\", \"one\\n\")\n *     readFile(\"notes.txt\")  // \"one\\n\"\n */\nfun readFile(path: string): string\n\n/**\n * Writes text to a file, replacing its contents.\n *\n * The file is created if it does not exist; its directory must exist. The\n * content is converted like `toString` does. Failure does not stop the program,\n * so check the result.\n *\n * @param path the path of the file\n * @param content the text to write\n * @return `true` if the file was written, `false` on failure\n * @see appendFile\n * @see readFile\n * @group Files\n * @since 26.1\n * @example\n *     writeFile(\"notes.txt\", \"one\\n\")      // true\n *     writeFile(\"/missing/dir/x.txt\", \"\")  // false\n */\nfun writeFile(path: string, content: any): bool\n\n/**\n * Adds text to the end of a file.\n *\n * The file is created if it does not exist; its directory must exist. The\n * content is converted like `toString` does, and no newline is added.\n *\n * @param path the path of the file\n * @param content the text to add\n * @return `true` if the text was written, `false` on failure\n * @see writeFile\n * @group Files\n * @since 26.1\n * @example\n *     writeFile(\"log.txt\", \"one\\n\")\n *     appendFile(\"log.txt\", \"two\\n\")\n *     readFile(\"log.txt\")  // \"one\\ntwo\\n\"\n */\nfun appendFile(path: string, content: any): bool\n\n/**\n * Tells whether a file or directory exists.\n *\n * @param path the path to test\n * @return `true` if something exists at the path, including a directory\n * @see readFile\n * @group Files\n * @since 26.1\n * @example\n *     writeFile(\"notes.txt\", \"\")\n *     fileExists(\"notes.txt\")    // true\n *     fileExists(\"missing.txt\")  // false\n */\nfun fileExists(path: string): bool\n\n/**\n * Parses JSON text into a value.\n *\n * Objects become `{string: any}` maps, arrays become `[any]`, numbers become\n * `int` or `float`, and `null` becomes `null`. Read the result with indexing\n * (`data[\"name\"]`, `data.tags[0]`) and narrow values with `is`.\n *\n * @param text the JSON text\n * @return the parsed value\n * @throws when the text is not valid JSON\n * @see toJSON\n * @group JSON\n * @since 26.1\n * @example\n *     var data = parseJSON(\"{\\\"name\\\": \\\"Ada\\\", \\\"tags\\\": [\\\"x\\\", \\\"y\\\"]}\")\n *     data[\"name\"]  // \"Ada\"\n *     data.tags[1]  // \"y\"\n */\nfun parseJSON(text: string): any\n\n/**\n * Converts a value to JSON text.\n *\n * The output is compact, without whitespace between values. Maps and structs\n * become objects, arrays become arrays, and `null` becomes `null`. Works as a method on every value,\n * including structs: `point.toJSON()`.\n *\n * @param value the value to convert\n * @return the value as JSON\n * @see parseJSON\n * @group JSON\n * @since 26.1\n * @example\n *     toJSON({\"a\": [1, 2]})  // \"{\\\"a\\\":[1,2]}\"\n *     toJSON(\"hi\")           // \"\\\"hi\\\"\"\n */\nfun toJSON(value: any): string\n\n/**\n * Sends an HTTP request and returns the raw response.\n *\n * The result has three strings: the status code, the body and the response\n * headers, one per line. `http://` URLs are requested directly and `https://`\n * URLs through the system `curl`. When the request fails, the status code is\n * `\"0\"` and the body holds the error message. This is an internal function\n * used by `std/http`; use `HTTP` from that module instead. It cannot be called\n * as a method.\n *\n * @param method the HTTP method, such as `\"GET\"` or `\"POST\"`\n * @param url the URL to request\n * @param body the request body, empty for none\n * @param headers the request headers, each as `\"Name: value\"`\n * @return `[status, body, headers]`\n * @group HTTP\n * @since 26.1\n * @example\n *     var raw = __httpRequest(\"GET\", \"http://127.0.0.1:1/\", \"\", [])\n *     raw[0]  // \"0\" when nothing listens on the port\n *     raw[1]  // \"Connection refused (os error 111)\"\n */\nfun __httpRequest(method: string, url: string, body: string, headers: [string]): [string]\n\n/**\n * Returns the name of the type of a value.\n *\n * For `any` and interface values this is the type of the value at runtime, and\n * `null` gives `\"null\"`. Works as a method on every value, including structs:\n * `shape.typeOf()`.\n *\n * @param value the value\n * @return the type name, such as `\"int\"`, `\"[string]\"` or `\"Point\"`\n * @see annotationsOf\n * @group Types\n * @since 26.1\n * @example\n *     typeOf(1.5)       // \"float\"\n *     typeOf([1, 2])    // \"[int]\"\n *     typeOf({\"a\": 1})  // \"{string: int}\"\n */\nfun typeOf(value: any): string\n\n/**\n * Returns the annotations declared on the type of a value.\n *\n * Only annotations declared with `def annotation` are listed, not built-in ones\n * such as `@Getter`. Narrow each element with `is` to read its fields. For\n * `any` and interface values the type at runtime is used.\n *\n * @param value the value whose type to inspect\n * @return the annotation values, empty when there are none\n * @see typeOf\n * @group Types\n * @since 26.1\n * @example\n *     // Users is declared as: @Route(\"/users\") def struct Users() {}\n *     annotationsOf(new Users())  // [Route { path: \"/users\" }]\n *     annotationsOf(42)           // []\n */\nfun annotationsOf(value: any): [any]\n\n/**\n * Returns the command-line arguments of the program.\n *\n * The program name and the file name are not included.\n *\n * @return the arguments, in order\n * @see env\n * @group Program\n * @since 26.1\n * @example\n *     args()  // [\"a\", \"b\"] for `burn app.bn a b`\n */\nfun args(): [string]\n\n/**\n * Returns the value of an environment variable.\n *\n * @param name the name of the variable\n * @return the value, or `\"\"` when the variable is not set\n * @see args\n * @group Program\n * @since 26.1\n * @example\n *     env(\"HOME\")  // for example \"/home/ada\"\n */\nfun env(name: string): string\n\n/**\n * Ends the program with an exit code.\n *\n * Waits for running async tasks and flushes the output first.\n *\n * @param code the exit code, `0` for success\n * @see panic\n * @group Program\n * @since 26.1\n * @example\n *     if (len(args()) == 0) {\n *         eprint(\"usage: app <file>\")\n *         exit(2)\n *     }\n */\nfun exit(code: int = 0)\n\n/**\n * Stops the program with a runtime error.\n *\n * Prints the message and the source location to standard error and exits with\n * code `1`. The message is converted like `toString` does.\n *\n * @param message the error message\n * @throws always\n * @see assert\n * @see exit\n * @group Program\n * @since 26.1\n * @example\n *     panic(\"unknown command\")  // runtime error: unknown command\n */\nfun panic(message: string = \"explicit panic\")\n\n/**\n * Stops the program with a runtime error when a condition is false.\n *\n * The error reads `assertion failed:` followed by the message. Without a\n * message, the source text of the condition is used.\n *\n * @param condition the condition that must hold\n * @param message the text to show when the condition is false\n * @throws when the condition is false\n * @see panic\n * @group Program\n * @since 26.1\n * @example\n *     var x = 3\n *     assert(x > 5)  // runtime error: assertion failed: x > 5\n */\nfun assert(condition: bool, message: string = \"\")\n\n/**\n * Frees values that only refer to each other, right now.\n *\n * Memory is freed automatically as soon as a value is no longer used, and\n * cycles are found on their own, so this is rarely needed. It can help when\n * measuring memory use.\n *\n * @group Program\n * @since 26.1\n * @example\n *     gc()\n */\nfun gc()\n\n/**\n * Runs a program and waits for it to finish.\n *\n * The result has three strings: the exit code, the standard output and the\n * standard error. When `capture` is `false` the program shares the terminal\n * and both outputs are empty. When the program cannot be started, the exit\n * code is `\"-1\"` and the error message is the third string. This is an\n * internal function used by `std/process`; use `Process` from that module\n * instead. It cannot be called as a method.\n *\n * @param program the program to run, found through `PATH` when it has no slash\n * @param args the arguments passed to the program\n * @param capture whether to collect the output instead of showing it\n * @return `[exitCode, stdout, stderr]`\n * @group Process\n * @since 26.1\n * @example\n *     var raw = __exec(\"echo\", [\"hi\"], true)\n *     raw[1]  // \"hi\\n\"\n */\nfun __exec(program: string, args: [string], capture: bool): [string]\n\n/**\n * Performs a file system operation.\n *\n * The operations are `\"mkdir\"` (with parents), `\"remove\"` (files and whole\n * directories), `\"rename\"`, `\"copy\"` (files), `\"isDir\"`, `\"isFile\"` and\n * `\"chdir\"`. This is an internal function used by `std/fs`; use `Files` from\n * that module instead. It cannot be called as a method.\n *\n * @param op the operation\n * @param path the path to work on\n * @param target the second path for `\"rename\"` and `\"copy\"`, otherwise `\"\"`\n * @return `true` when the operation succeeded, or the answer for `\"isDir\"` and `\"isFile\"`\n * @group Files\n * @since 26.1\n * @example\n *     __fsOp(\"mkdir\", \"out/logs\", \"\")  // true\n */\nfun __fsOp(op: string, path: string, target: string): bool\n\n/**\n * Lists the names in a directory, sorted.\n *\n * This is an internal function used by `std/fs`; use `Files.list` instead.\n * It cannot be called as a method.\n *\n * @param path the directory\n * @return the names of the entries, without the directory, or `[]` if it cannot be read\n * @group Files\n * @since 26.1\n * @example\n *     __listDir(\".\")  // for example [\"README.md\", \"src\"]\n */\nfun __listDir(path: string): [string]\n\n/**\n * Returns the current working directory.\n *\n * This is an internal function used by `std/process`; use `Process.cwd`\n * instead. It cannot be called as a method.\n *\n * @return the absolute path of the working directory\n * @group Process\n * @since 26.1\n * @example\n *     __cwd()  // for example \"/home/ada/project\"\n */\nfun __cwd(): string\n"

/** The search script of `burn doc` sites, from `lib/doc/search.js`. */
pub const SEARCH_JS = "(function () {\n  var q = document.getElementById(\"q\"), box = document.getElementById(\"results\"), data = window.BURNDOC || [], sel = 0, hits = [];\n  function esc(s) { return s.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n  function score(e, t) {\n    var n = e[0].toLowerCase(), last = n.slice(n.lastIndexOf(\".\") + 1);\n    if (n === t || last === t) return 0;\n    if (last.indexOf(t) === 0 || n.indexOf(t) === 0) return 1;\n    if (n.indexOf(t) >= 0) return 2;\n    if (e[3].toLowerCase().indexOf(t) >= 0) return 3;\n    return -1;\n  }\n  function draw() {\n    if (!hits.length) { box.innerHTML = \"<a>No results</a>\"; box.hidden = false; return; }\n    box.innerHTML = hits.map(function (e, i) {\n      return \"<a href=\\\"\" + e[2] + \"\\\"\" + (i === sel ? \" class=\\\"sel\\\"\" : \"\") + \"><span class=\\\"rk\\\">\" + e[1] + \"</span><code>\" + esc(e[0]) + \"</code><span class=\\\"rs\\\">\" + esc(e[3]) + \"</span></a>\";\n    }).join(\"\");\n    box.hidden = false;\n  }\n  q.addEventListener(\"input\", function () {\n    var t = q.value.trim().toLowerCase();\n    if (!t) { box.hidden = true; return; }\n    hits = data.map(function (e) { return [score(e, t), e]; }).filter(function (x) { return x[0] >= 0; })\n      .sort(function (a, b) { return a[0] - b[0] || a[1][0].length - b[1][0].length; }).slice(0, 12).map(function (x) { return x[1]; });\n    sel = 0;\n    draw();\n  });\n  q.addEventListener(\"keydown\", function (ev) {\n    if (box.hidden) return;\n    if (ev.key === \"ArrowDown\") { sel = Math.min(sel + 1, hits.length - 1); draw(); ev.preventDefault(); }\n    else if (ev.key === \"ArrowUp\") { sel = Math.max(sel - 1, 0); draw(); ev.preventDefault(); }\n    else if (ev.key === \"Enter\" && hits[sel]) { location.href = hits[sel][2]; }\n    else if (ev.key === \"Escape\") { box.hidden = true; q.blur(); }\n  });\n  document.addEventListener(\"keydown\", function (ev) {\n    if (ev.key === \"/\" && document.activeElement !== q) { q.focus(); ev.preventDefault(); }\n  });\n  document.addEventListener(\"click\", function (ev) { if (!box.contains(ev.target) && ev.target !== q) box.hidden = true; });\n})();\n"

/** The style sheet of `burn doc` sites, from `lib/doc/style.css`. */
pub const STYLE_CSS = ":root {\n  --bg: #ffffff;\n  --panel: #f7f7f5;\n  --text: #1d1d1f;\n  --muted: #6b6b70;\n  --line: #e4e4e0;\n  --accent: #d9480f;\n  --accent-soft: #fff1ea;\n  --code-bg: #f4f3f0;\n  --kw: #a626a4;\n  --ty: #0b6bcb;\n  --str: #2f8a3c;\n  --num: #b35c00;\n  --com: #8a8a8f;\n  --mono: ui-monospace, SFMono-Regular, \"JetBrains Mono\", Menlo, Consolas, monospace;\n  --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #151517;\n    --panel: #1c1c1f;\n    --text: #e9e9ec;\n    --muted: #9a9aa2;\n    --line: #2d2d31;\n    --accent: #ff7a3d;\n    --accent-soft: #2a1d16;\n    --code-bg: #202024;\n    --kw: #d38ae6;\n    --ty: #66adff;\n    --str: #7fcf8a;\n    --num: #f0a45b;\n    --com: #7c7c85;\n  }\n}\n* { box-sizing: border-box; }\nhtml { scroll-padding-top: 72px; }\nbody { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.6 var(--sans); }\na { color: var(--accent); text-decoration: none; }\na:hover { text-decoration: underline; }\ncode, pre { font-family: var(--mono); font-size: 13.5px; }\np code, li code, td code, dd code { background: var(--code-bg); padding: 1px 5px; border-radius: 4px; }\ntd a code, dd a code, p a code, li a code { color: var(--accent); }\n.top {\n  position: sticky; top: 0; z-index: 10; height: 56px; display: flex; align-items: center; gap: 24px;\n  padding: 0 24px; background: var(--bg); border-bottom: 1px solid var(--line);\n}\n.brand { color: var(--text); font-weight: 650; font-size: 16px; white-space: nowrap; }\n.brand:hover { text-decoration: none; }\n.flame { font-size: 17px; }\n.search { position: relative; flex: 1; max-width: 460px; margin-left: auto; }\n.search input {\n  width: 100%; padding: 7px 12px; border: 1px solid var(--line); border-radius: 8px;\n  background: var(--panel); color: var(--text); font: inherit; font-size: 14px; outline: none;\n}\n.search input:focus { border-color: var(--accent); }\n#results {\n  position: absolute; top: 40px; left: 0; right: 0; max-height: 420px; overflow: auto;\n  background: var(--bg); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 32px rgba(0,0,0,.14);\n}\n#results a { display: block; padding: 8px 12px; color: var(--text); border-bottom: 1px solid var(--line); }\n#results a:last-child { border-bottom: 0; }\n#results a.sel, #results a:hover { background: var(--accent-soft); text-decoration: none; }\n#results .rk { float: right; color: var(--muted); font-size: 12px; }\n#results .rs { display: block; color: var(--muted); font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.wrap { display: flex; max-width: 1280px; margin: 0 auto; }\n.side {\n  width: 250px; flex-shrink: 0; padding: 20px 16px 40px 24px; position: sticky; top: 56px;\n  height: calc(100vh - 56px); overflow: auto; border-right: 1px solid var(--line);\n}\n.side ul { list-style: none; margin: 0 0 18px; padding: 0; }\n.side li a { display: block; padding: 3px 8px; border-radius: 6px; color: var(--text); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.side li a:hover { background: var(--panel); text-decoration: none; }\n.side li a.on { background: var(--accent-soft); color: var(--accent); font-weight: 600; }\n.nav-h { font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 6px 8px 6px; }\n.ic { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 8px; vertical-align: 1px; }\n.i-fn { background: #8f5bd8; } .i-st { background: var(--accent); } .i-if { background: #1f9d74; }\n.i-en { background: #c28a00; } .i-ty { background: #0b6bcb; } .i-va { background: #888; }\nmain { flex: 1; min-width: 0; padding: 28px 40px 60px; max-width: 980px; }\nh1 { font-size: 30px; line-height: 1.25; margin: 6px 0 14px; letter-spacing: -.01em; }\nh1 .kind { display: block; font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 2px; }\nh2 { font-size: 19px; margin: 34px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }\nh3 { font-size: 16px; margin: 0 0 8px; font-family: var(--mono); }\nh3 a { color: var(--text); }\n.crumbs { font-size: 13px; color: var(--muted); }\n.hier { font-family: var(--mono); font-size: 13px; color: var(--muted); margin-bottom: 8px; }\npre.sig {\n  background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--accent);\n  border-radius: 6px; padding: 10px 14px; overflow-x: auto; white-space: pre-wrap; margin: 8px 0 14px;\n}\npre.code { background: var(--code-bg); border-radius: 6px; padding: 10px 14px; overflow-x: auto; margin: 6px 0 12px; }\n.kw, .k { color: var(--kw); }\n.fn { font-weight: 650; }\n.pn { color: var(--text); }\n.prim, .ty, a.ty, .t { color: var(--ty); }\n.s { color: var(--str); } .n { color: var(--num); } .c { color: var(--com); font-style: italic; }\ntable.summary { width: 100%; border-collapse: collapse; font-size: 14.5px; }\ntable.summary td { padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }\ntable.summary tr:hover td { background: var(--panel); }\ntable.summary td.name { width: 38%; }\n.mini { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 2px; word-break: break-word; }\n.badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 0 6px; border-radius: 4px; background: var(--panel); border: 1px solid var(--line); color: var(--muted); vertical-align: 1px; }\n.badge.dep { color: #b42318; border-color: #f3c3bd; background: #fdf1ef; }\nsection.member { padding: 18px 0 8px; border-bottom: 1px solid var(--line); }\nsection.member:target { background: linear-gradient(90deg, var(--accent-soft), transparent 70%); margin: 0 -16px; padding-left: 16px; padding-right: 16px; }\ndl.tags { display: grid; grid-template-columns: 120px 1fr; gap: 6px 16px; margin: 10px 0; font-size: 14px; }\ndl.tags > dt { font-weight: 600; color: var(--muted); }\ndl.tags > dd { margin: 0; }\ndl.params { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 3px 12px; }\ndl.params dt, dl.params dd { margin: 0; }\n.example .label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-top: 10px; }\n.deprecated { border-left: 3px solid #d92d20; background: #fdf1ef; color: #7a271a; padding: 8px 12px; border-radius: 4px; margin: 8px 0; }\n@media (prefers-color-scheme: dark) { .deprecated { background: #2c1714; color: #f5b5ab; } .badge.dep { background: #2c1714; border-color: #5c2a22; color: #f5b5ab; } }\n.ann { font-family: var(--mono); font-size: 13px; color: var(--muted); }\n.inherited { font-size: 14px; margin: 12px 0; color: var(--muted); }\n.undoc { color: var(--muted); font-style: italic; }\nfooter { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }\n@media (max-width: 860px) {\n  .side { display: none; }\n  main { padding: 20px 16px 48px; }\n  .top { padding: 0 16px; gap: 12px; }\n  table.summary td.name { width: 45%; }\n  dl.tags { grid-template-columns: 1fr; }\n}\n"
