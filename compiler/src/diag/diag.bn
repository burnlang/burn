pub def enum Severity { Error, Warning }

/** Replace the bytes from `start` to `end` with `text`. */
pub def type Edit {
    int start
    int end
    string text
}

/** A change the compiler proposes; `applicable` ones are safe for `burn fix` to make. */
pub def type Suggestion {
    string message
    [Edit] edits
    bool applicable
}

/** An error or warning at a byte range of a source file. */
pub def type Diag {
    Severity severity
    int start
    int end
    string message
    [string] notes
    [string] helps
    [Suggestion] suggestions
}

pub fun errorAt(start: int, end: int, message: string): Diag {
    return Diag { severity: Severity.Error, start: start, end: end, message: message, notes: [], helps: [], suggestions: [] }
}

pub fun warningAt(start: int, end: int, message: string): Diag {
    return Diag { severity: Severity.Warning, start: start, end: end, message: message, notes: [], helps: [], suggestions: [] }
}

pub fun addFix(d: Diag, message: string, start: int, end: int, text: string, applicable: bool) {
    d.suggestions.push(Suggestion { message: message, edits: [Edit { start: start, end: end, text: text }], applicable: applicable })
}

/** A source file with the byte offset of every line, for turning offsets into lines and columns. */
pub def struct SourceFile(name: string, src: string) {
    string? path = null
    [uint8] bytes = []
    [int] lineStarts = []

    fun index() {
        if (len(lineStarts) > 0) {
            return
        }
        bytes = src.bytes()
        lineStarts.push(0)
        for i in 0..len(bytes) {
            if (bytes[i] == 10) {
                lineStarts.push(i + 1)
            }
        }
    }

    fun text(from: int, to: int): string {
        return fromBytes(slice(bytes, from, to))
    }

    fun lineOf(offset: int): int {
        index()
        var lo = 0
        var hi = len(lineStarts) - 1
        while (lo < hi) {
            var mid = (lo + hi + 1) / 2
            if (lineStarts[mid] <= offset) {
                lo = mid
            } else {
                hi = mid - 1
            }
        }
        return lo
    }

    /** The 1-based line and column (in characters) of a byte offset. */
    fun lineCol(offset: int): [int] {
        index()
        var at = offset
        if (at > len(bytes)) {
            at = len(bytes)
        }
        var line = lineOf(at)
        var col = len(text(lineStarts[line], at))
        return [line + 1, col + 1]
    }

    fun lineCount(): int {
        index()
        return len(lineStarts)
    }

    fun lineStart(line: int): int {
        index()
        if (line >= 1 && line - 1 < len(lineStarts)) {
            return lineStarts[line - 1]
        }
        if (line < 1) {
            return lineStarts[0]
        }
        return len(bytes)
    }

    /** The text of a 1-based line, without its line break. */
    fun lineText(line: int): string {
        index()
        var start = lineStarts[line - 1]
        var end = len(bytes)
        if (line < len(lineStarts)) {
            end = lineStarts[line] - 1
        }
        if (end < start) {
            end = start
        }
        while (end > start && bytes[end - 1] == 13) {
            end -= 1
        }
        return text(start, end)
    }
}

def type Patch {
    int line
    string text
    string marks
}

fun rightAligned(n: int, width: int): string {
    var s = toString(n)
    return repeat(" ", width - len(s)) + s
}

fun digitCount(n: int): int {
    return len(toString(n))
}

fun patched(f: SourceFile, s: Suggestion): Patch? {
    if (len(s.edits) == 0) {
        return null
    }
    var line = f.lineCol(s.edits[0].start)[0]
    var start = f.lineStart(line)
    var text = f.lineText(line)
    var end = start + len(text.bytes())
    [Edit] edits = []
    for e in s.edits {
        var at = len(edits)
        while (at > 0 && edits[at - 1].start > e.start) {
            at -= 1
        }
        insert(edits, at, e)
    }
    var out = ""
    var marks = ""
    var pos = start
    for e in edits {
        if (e.start < pos || e.end > end || contains(e.text, "\n")) {
            return null
        }
        var kept = f.text(pos, e.start)
        out += kept
        marks += repeat(" ", len(kept))
        out += e.text
        var n = len(e.text)
        if (e.start == e.end) {
            marks += repeat("+", n)
        } else {
            if (n < 1) {
                n = 1
            }
            marks += repeat("~", n)
        }
        pos = e.end
    }
    out += f.text(pos, end)
    while (endsWith(marks, " ")) {
        marks = substring(marks, 0, len(marks) - 1)
    }
    return Patch { line: line, text: out, marks: marks }
}

/** The terminal colour codes of a rendered diagnostic, all empty without colours. */
def type Paint {
    string red
    string yellow
    string blue
    string cyan
    string green
    string bold
    string reset
}

fun paint(color: bool): Paint {
    if (color) {
        return Paint {
            red: "\u{1b}[31m",
            yellow: "\u{1b}[33m",
            blue: "\u{1b}[34m",
            cyan: "\u{1b}[36m",
            green: "\u{1b}[32m",
            bold: "\u{1b}[1m",
            reset: "\u{1b}[0m"
        }
    }
    return Paint { red: "", yellow: "", blue: "", cyan: "", green: "", bold: "", reset: "" }
}

/** A diagnostic as `burn check` prints it, without colours. */
pub fun render(f: SourceFile, d: Diag): string {
    return renderIn(f, d, false)
}

/** A diagnostic as `burn check` prints it, in colour when `color` is set. */
pub fun renderIn(f: SourceFile, d: Diag, color: bool): string {
    var p = paint(color)
    var label = "error"
    var c = p.red
    if (d.severity == Severity.Warning) {
        label = "warning"
        c = p.yellow
    }
    var out = "${p.bold}${c}${label}${p.reset}: ${p.bold}${d.message}${p.reset}\n"
    var lc = f.lineCol(d.start)
    var line = lc[0]
    var col = lc[1]
    var elc = f.lineCol(d.end)
    var gutter = digitCount(line)
    [Patch?] patches = []
    for s in d.suggestions {
        var pt = patched(f, s)
        patches.push(pt)
        if (pt != null && digitCount(pt.line) > gutter) {
            gutter = digitCount(pt.line)
        }
    }
    var blank = repeat(" ", gutter)
    var bar = "${p.blue}${blank} |${p.reset}\n"
    out += "${p.blue}${blank}--> ${p.reset}${f.name}:${line}:${col}\n"
    if (line <= f.lineCount()) {
        var text = f.lineText(line)
        out += bar
        out += "${p.blue}${rightAligned(line, gutter)} |${p.reset} ${text}\n"
        var width = 1
        if (elc[0] == line) {
            width = elc[1] - col
        } else {
            width = len(text) + 1 - col
        }
        if (width < 1) {
            width = 1
        }
        var pad = ""
        var k = 0
        for ch in text {
            if (k >= col - 1) {
                break
            }
            if (ch == "\t") {
                pad += "\t"
            } else {
                pad += " "
            }
            k += 1
        }
        out += "${p.blue}${blank} |${p.reset} ${pad}${c}${repeat("^", width)}${p.reset}\n"
    }
    for n in d.notes {
        out += "${p.blue}${blank} = ${p.reset}${p.bold}note${p.reset}: ${n}\n"
    }
    for h in d.helps {
        out += "${p.blue}${blank} = ${p.reset}${p.bold}help${p.reset}: ${h}\n"
    }
    for i in 0..len(d.suggestions) {
        out += "${p.bold}${p.cyan}help${p.reset}: ${d.suggestions[i].message}\n"
        var pt = patches[i]
        if (pt != null) {
            out += bar
            out += "${p.blue}${rightAligned(pt.line, gutter)} |${p.reset} ${pt.text}\n"
            if (len(pt.marks) > 0) {
                out += "${p.blue}${blank} |${p.reset} ${p.green}${pt.marks}${p.reset}\n"
            }
        }
    }
    return out
}
