import "../bvm/tool.bn"
import "../cli/cli.bn"
import "../cli/host.bn"
import "std/process"

/** The Burn toolchain: the `burn` command line when started as `burn`, `burni`, `burnc` or `burn-lsp`, and bvm otherwise. */
fun main() {
    if (toolName() == "") {
        exit(bvmMain(args()))
    }
    exit(cliMain(args()))
}
