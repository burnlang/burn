import "../bvm/binary.bn"
import "../bvm/files.bn"
import "../bvm/tool.bn"
import "std/process"

/** bvm written in Burn. `copy <in> <out>` sends a module through the decoder and the encoder. */
fun main() {
    var a = args()
    if (len(a) == 3 && a[0] == "copy") {
        var bytes = readBytes(a[1])
        if (bytes == null) {
            eprint("error: could not read ${a[1]}")
            exit(1)
        }
        var d = decode(bytes)
        if (d.error != "" || !writeBytes(a[2], encode(d.module))) {
            eprint("error: ${a[1]}: ${d.error}")
            exit(1)
        }
        return
    }
    exit(bvmMain(a))
}
