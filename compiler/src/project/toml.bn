/** A TOML value. The variants match `Value` in `project.rs`. */
pub def enum TomlValue {
    Str(text: string),
    Int(value: int),
    Float(value: float),
    Bool(value: bool),
    Array(items: [TomlValue]),
    Table(entries: [TomlEntry])
}

/** One `key = value` of a table, kept in the order of the file. */
pub def type TomlEntry {
    string key
    TomlValue value
}

/** A parsed file, or the error that stopped the parser (`line N: ...`). */
pub def type TomlDoc {
    [TomlEntry] table
    string error
}

pub fun lookup(t: [TomlEntry], key: string): TomlValue? {
    for e in t {
        if (e.key == key) {
            return e.value
        }
    }
    return null
}

pub fun textOf(v: TomlValue?): string? {
    if (v is TomlValue.Str) {
        return v.text
    }
    return null
}

pub fun tableOf(v: TomlValue?): [TomlEntry]? {
    if (v is TomlValue.Table) {
        return v.entries
    }
    return null
}

const TAB = 9
const LF = 10
const CR = 13
const SPACE = 32
const DQUOTE = 34
const HASH = 35
const SQUOTE = 39
const PLUS = 43
const COMMA = 44
const MINUS = 45
const DOT = 46
const EQ = 61
const LBRACKET = 91
const BACKSLASH = 92
const RBRACKET = 93
const UNDERSCORE = 95
const LBRACE = 123
const RBRACE = 125

fun isKeyByte(c: int): bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == UNDERSCORE || c == MINUS
}

fun isWordByte(c: int): bool {
    return isKeyByte(c) || c == PLUS || c == DOT
}

fun hexValue(c: int): int {
    if (c >= 48 && c <= 57) {
        return c - 48
    }
    if (c >= 97 && c <= 102) {
        return c - 87
    }
    if (c >= 65 && c <= 70) {
        return c - 55
    }
    return -1
}

def struct TomlParser(s: [uint8]) {
    int i = 0
    int line = 1
    string error = ""

    fun peek(): int {
        if (i < len(s)) {
            return s[i]
        }
        return 0
    }

    fun at(k: int): int {
        if (i + k < len(s)) {
            return s[i + k]
        }
        return 0
    }

    fun text(from: int, to: int): string {
        return fromBytes(slice(s, from, to))
    }

    fun fail(msg: string) {
        error = "line ${line}: ${msg}"
    }

    fun ws() {
        while (peek() == SPACE || peek() == TAB) {
            i += 1
        }
    }

    fun comment() {
        if (peek() == HASH) {
            while (i < len(s) && peek() != LF) {
                i += 1
            }
        }
    }

    fun skipBlank() {
        while (true) {
            ws()
            comment()
            var c = peek()
            if (c == LF) {
                line += 1
                i += 1
            } else if (c == CR) {
                i += 1
            } else {
                return
            }
        }
    }

    fun endOfLine(): bool {
        ws()
        comment()
        var c = peek()
        if (c == 0 || c == CR || c == LF) {
            return true
        }
        fail("unexpected `${fromCharCode(c)}` after the value")
        return false
    }

    fun expect(c: int): bool {
        if (peek() == c) {
            i += 1
            return true
        }
        fail("expected `${fromCharCode(c)}`")
        return false
    }

    fun keyPath(): [string]? {
        var first = key()
        if (first == null) {
            return null
        }
        [string] path = [first]
        while (true) {
            ws()
            if (peek() != DOT) {
                return path
            }
            i += 1
            ws()
            var next = key()
            if (next == null) {
                return null
            }
            path.push(next)
        }
    }

    fun key(): string? {
        var c = peek()
        if (c == DQUOTE) {
            return basicString()
        }
        if (c == SQUOTE) {
            return literalString()
        }
        var start = i
        while (isKeyByte(peek())) {
            i += 1
        }
        if (start == i) {
            fail("expected a key")
            return null
        }
        return text(start, i)
    }

    fun unicode(): string? {
        var code = 0
        var digits = 0
        for k in 0..4 {
            var c = at(k)
            if (k == 0 && c == PLUS) {
                continue
            }
            var h = hexValue(c)
            if (h < 0) {
                fail("bad \\u escape")
                return null
            }
            code = code * 16 + h
            digits += 1
        }
        if (digits == 0 || (code >= 55296 && code <= 57343)) {
            fail("bad \\u escape")
            return null
        }
        i += 4
        return fromCharCode(code)
    }

    fun basicString(): string? {
        i += 1
        var out = ""
        var run = i
        while (true) {
            var c = peek()
            if (c == 0 || c == LF) {
                i += 1
                fail("unterminated string")
                return null
            }
            if (c == DQUOTE) {
                out += text(run, i)
                i += 1
                return out
            }
            if (c != BACKSLASH) {
                i += 1
                continue
            }
            out += text(run, i)
            i += 1
            var e = peek()
            i += 1
            if (e == 110) {
                out += "\n"
            } else if (e == 116) {
                out += "\t"
            } else if (e == 114) {
                out += "\r"
            } else if (e == DQUOTE) {
                out += "\""
            } else if (e == BACKSLASH) {
                out += "\\"
            } else if (e == 117) {
                var ch = unicode()
                if (ch == null) {
                    return null
                }
                out += ch
            } else {
                fail("unknown escape in string")
                return null
            }
            run = i
        }
    }

    fun literalString(): string? {
        i += 1
        var start = i
        while (peek() != SQUOTE && peek() != LF && peek() != 0) {
            i += 1
        }
        if (peek() != SQUOTE) {
            fail("unterminated string")
            return null
        }
        var out = text(start, i)
        i += 1
        return out
    }

    fun value(): TomlValue? {
        var c = peek()
        if (c == DQUOTE) {
            var s = basicString()
            if (s == null) {
                return null
            }
            return TomlValue.Str(s)
        }
        if (c == SQUOTE) {
            var s = literalString()
            if (s == null) {
                return null
            }
            return TomlValue.Str(s)
        }
        if (c == LBRACKET) {
            i += 1
            [TomlValue] items = []
            while (true) {
                skipBlank()
                if (peek() == RBRACKET) {
                    i += 1
                    return TomlValue.Array(items)
                }
                var item = value()
                if (item == null) {
                    return null
                }
                items.push(item)
                skipBlank()
                if (peek() == COMMA) {
                    i += 1
                } else if (peek() != RBRACKET) {
                    fail("expected `,` or `]` in the array")
                    return null
                }
            }
        }
        if (c == LBRACE) {
            i += 1
            [TomlEntry] t = []
            while (true) {
                ws()
                if (peek() == RBRACE) {
                    i += 1
                    return TomlValue.Table(t)
                }
                var k = key()
                if (k == null) {
                    return null
                }
                ws()
                if (!expect(EQ)) {
                    return null
                }
                ws()
                var v = value()
                if (v == null) {
                    return null
                }
                t.push(TomlEntry { key: k, value: v })
                ws()
                if (peek() == COMMA) {
                    i += 1
                } else if (peek() != RBRACE) {
                    fail("expected `,` or `}` in the inline table")
                    return null
                }
            }
        }
        var start = i
        while (isWordByte(peek())) {
            i += 1
        }
        var word = text(start, i)
        if (word == "true") {
            return TomlValue.Bool(true)
        }
        if (word == "false") {
            return TomlValue.Bool(false)
        }
        if (word == "") {
            fail("expected a value")
            return null
        }
        var clean = replace(word, "_", "")
        if (isInt(clean)) {
            return TomlValue.Int(toInt(clean))
        }
        if (isNumber(clean)) {
            return TomlValue.Float(toFloat(clean))
        }
        fail("`${word}` is not a value; put text in quotes")
        return null
    }

    fun tableAt(root: [TomlEntry], path: [string]): [TomlEntry]? {
        var t = root
        for k in path {
            var found = lookup(t, k)
            if (found == null) {
                t.push(TomlEntry { key: k, value: TomlValue.Table([]) })
                found = lookup(t, k)
            }
            [TomlEntry]? next = null
            if (found is TomlValue.Table) {
                next = found.entries
            } else if (found is TomlValue.Array && len(found.items) > 0) {
                next = tableOf(found.items[len(found.items) - 1])
            }
            if (next == null) {
                fail("`${k}` is not a table")
                return null
            }
            t = next
        }
        return t
    }
}

fun failed(p: TomlParser): TomlDoc {
    return TomlDoc { table: [], error: p.error }
}

/** Parses the subset of TOML that `burn.toml` and `burn.lock` use, the same way `project::parse` does. */
pub fun parseToml(src: string): TomlDoc {
    var p = new TomlParser(src.bytes())
    [TomlEntry] root = []
    [string] current = []
    while (true) {
        p.skipBlank()
        if (p.i >= len(p.s)) {
            break
        }
        if (p.peek() == LBRACKET) {
            var array = p.at(1) == LBRACKET
            if (array) {
                p.i += 2
            } else {
                p.i += 1
            }
            p.ws()
            var path = p.keyPath()
            if (path == null) {
                return failed(p)
            }
            p.ws()
            if (!p.expect(RBRACKET) || (array && !p.expect(RBRACKET)) || !p.endOfLine()) {
                return failed(p)
            }
            if (array) {
                var last = path[len(path) - 1]
                var parent = p.tableAt(root, slice(path, 0, len(path) - 1))
                if (parent == null) {
                    return failed(p)
                }
                var existing = lookup(parent, last)
                if (existing == null) {
                    parent.push(TomlEntry { key: last, value: TomlValue.Array([TomlValue.Table([])]) })
                } else if (existing is TomlValue.Array) {
                    existing.items.push(TomlValue.Table([]))
                } else {
                    p.fail("`${last}` is not an array of tables")
                    return failed(p)
                }
            } else if (p.tableAt(root, path) == null) {
                return failed(p)
            }
            current = path
            continue
        }
        var path = p.keyPath()
        if (path == null) {
            return failed(p)
        }
        p.ws()
        if (!p.expect(EQ)) {
            return failed(p)
        }
        p.ws()
        var v = p.value()
        if (v == null || !p.endOfLine()) {
            return failed(p)
        }
        var last = path[len(path) - 1]
        var full = slice(current, 0, len(current))
        for k in slice(path, 0, len(path) - 1) {
            full.push(k)
        }
        var t = p.tableAt(root, full)
        if (t == null) {
            return failed(p)
        }
        if (lookup(t, last) != null) {
            p.fail("`${last}` is defined twice")
            return failed(p)
        }
        t.push(TomlEntry { key: last, value: v })
    }
    return TomlDoc { table: root, error: "" }
}
