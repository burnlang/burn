/**
 * The JIT of the bvm written in Burn: functions that run often, and loops that turn often, are compiled from their
 * prepared instruction records to x86-64 machine code while the program runs.
 *
 * Compiled code keeps the interpreter's frame: the locals of a call at `rbx` (its base, `bp`) and its operand stack
 * after them. The depth of the operand stack is known for every instruction, so each stack slot is a fixed offset from
 * `rbx` and no stack pointer is kept while code runs. `r13` holds the interpreter state and `r12` the top of the
 * stack whenever code calls something. Because the frames are the same, interpreted and compiled functions call each
 * other freely, and the interpreter can jump into the compiled code of a function in the middle of a loop (on-stack
 * replacement). Instructions without a fast machine code form call `burn_bvm_slow`, which runs them like the
 * interpreter does.
 *
 * `BURN_JIT=0` turns the JIT off, and `BURN_JIT_THRESHOLD` sets how many calls or loop turns make code hot (1000).
 */
import "layout.bn"
import "std/memory"
import "std/process"

@Extern("mmap")
fun cMmap(addr: int, size: int, prot: int, flags: int, fd: int, off: int): int

@Extern("mprotect")
fun cMprotect(addr: int, size: int, prot: int): Int32

@Extern("burn_rt_platform")
fun rtPlatform(): int

@Extern("burn_release")
fun rtReleaseText(p: int): int

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R12 = 12
const R13 = 13

const CC_O = 0
const CC_NO = 1
const CC_B = 2
const CC_AE = 3
const CC_E = 4
const CC_NE = 5
const CC_A = 7

/** The x86-64 condition code of each comparison, in the order of `Cmp`: eq, ne, lt, le, gt, ge. */
const CMP_CC = [4, 5, 12, 14, 15, 13]

const ARG_REGS = [7, 6, 2, 1, 8, 9]

var state = -1
var limit = 1000
var macos = false
var enterThunk = 0
var osrThunk = 0
var helperSlow = 0
var helperCall = 0
var helperCallee = 0
var helperOverflow = 0
var addrRetain = 0
var addrRelease = 0
var addrErrOverflow = 0

/** Machine code being written. */
def struct Asm() {
    [int] b = []

    fun byte(x: int) {
        b.push(x & 255)
    }

    fun i32(x: int) {
        b.push(x & 255)
        b.push((x >> 8) & 255)
        b.push((x >> 16) & 255)
        b.push((x >> 24) & 255)
    }

    fun i64(x: int) {
        for k in 0..8 {
            b.push((x >> (8 * k)) & 255)
        }
    }

    fun pos(): int {
        return len(b)
    }

    /** Points the 32-bit relative jump ending at `at + 4` to `target`. */
    fun patch(at: int, target: int) {
        var rel = target - (at + 4)
        b[at] = rel & 255
        b[at + 1] = (rel >> 8) & 255
        b[at + 2] = (rel >> 16) & 255
        b[at + 3] = (rel >> 24) & 255
    }
}

fun fits32(v: int): bool {
    return v >= -2147483648 && v <= 2147483647
}

fun rexw(a: Asm, reg: int, rm: int) {
    a.byte(72 | ((reg >> 3) << 2) | (rm >> 3))
}

fun rexOpt(a: Asm, reg: int, rm: int) {
    var r = 64 | ((reg >> 3) << 2) | (rm >> 3)
    if (r != 64) {
        a.byte(r)
    }
}

/** The ModRM (and SIB) bytes and 32-bit displacement of `[base + disp]` with register field `reg`. */
fun mem(a: Asm, reg: int, base: int, disp: int) {
    a.byte(128 | ((reg & 7) << 3) | (base & 7))
    if ((base & 7) == 4) {
        a.byte(36)
    }
    a.i32(disp)
}

fun rr(a: Asm, reg: int, rm: int) {
    a.byte(192 | ((reg & 7) << 3) | (rm & 7))
}

/** `mov dst, [base + disp]` */
fun ld(a: Asm, dst: int, base: int, disp: int) {
    rexw(a, dst, base)
    a.byte(139)
    mem(a, dst, base, disp)
}

/** `mov [base + disp], src` */
fun st(a: Asm, base: int, disp: int, src: int) {
    rexw(a, src, base)
    a.byte(137)
    mem(a, src, base, disp)
}

/** `mov dst, imm` */
fun movri(a: Asm, dst: int, imm: int) {
    if (fits32(imm)) {
        rexw(a, 0, dst)
        a.byte(199)
        rr(a, 0, dst)
        a.i32(imm)
    } else {
        a.byte(72 | (dst >> 3))
        a.byte(184 + (dst & 7))
        a.i64(imm)
    }
}

/** `mov qword [base + disp], imm32` */
fun stimm(a: Asm, base: int, disp: int, imm: int) {
    rexw(a, 0, base)
    a.byte(199)
    mem(a, 0, base, disp)
    a.i32(imm)
}

/** An instruction `opc dst, [base + disp]`: 3 add, 43 sub, 35 and, 11 or, 51 xor, 59 cmp, 139 mov. */
fun aluRM(a: Asm, opc: int, dst: int, base: int, disp: int) {
    rexw(a, dst, base)
    a.byte(opc)
    mem(a, dst, base, disp)
}

/** An instruction `opc dst, src` with the register field `src`: 1 add, 41 sub, 57 cmp, 133 test, 137 mov. */
fun aluRR(a: Asm, opc: int, src: int, dst: int) {
    rexw(a, src, dst)
    a.byte(opc)
    rr(a, src, dst)
}

/** An instruction `op dst, imm32` with opcode extension `ext`: 0 add, 5 sub, 7 cmp. */
fun aluRI(a: Asm, ext: int, dst: int, imm: int) {
    rexw(a, 0, dst)
    a.byte(129)
    rr(a, ext, dst)
    a.i32(imm)
}

/** An instruction `op qword [base + disp], imm32` with opcode extension `ext`. */
fun aluMI(a: Asm, ext: int, base: int, disp: int, imm: int) {
    rexw(a, 0, base)
    a.byte(129)
    mem(a, ext, base, disp)
    a.i32(imm)
}

fun lea(a: Asm, dst: int, base: int, disp: int) {
    rexw(a, dst, base)
    a.byte(141)
    mem(a, dst, base, disp)
}

/** `cmp byte [base + disp], imm8` */
fun cmp8(a: Asm, base: int, disp: int, imm: int) {
    rexOpt(a, 0, base)
    a.byte(128)
    mem(a, 7, base, disp)
    a.byte(imm)
}

/** `mov dst32, dword [base + disp]`, which clears the upper half. */
fun ld32(a: Asm, dst: int, base: int, disp: int) {
    rexOpt(a, dst, base)
    a.byte(139)
    mem(a, dst, base, disp)
}

/** `setcc al; movzx eax, al` */
fun setcc(a: Asm, cc: int) {
    a.byte(15)
    a.byte(144 + cc)
    a.byte(192)
    a.byte(15)
    a.byte(182)
    a.byte(192)
}

/** A conditional jump with a 32-bit offset still to patch, whose position it gives. */
fun jcc(a: Asm, cc: int): int {
    a.byte(15)
    a.byte(128 + cc)
    var at = a.pos()
    a.i32(0)
    return at
}

/** A jump with a 32-bit offset still to patch, whose position it gives. */
fun jmp(a: Asm): int {
    a.byte(233)
    var at = a.pos()
    a.i32(0)
    return at
}

/** `call reg` */
fun callR(a: Asm, r: int) {
    rexOpt(a, 0, r)
    a.byte(255)
    rr(a, 2, r)
}

/** Calls the C function at `addr` (the arguments are already in their registers). */
fun callAbs(a: Asm, addr: int) {
    movri(a, RAX, addr)
    callR(a, RAX)
}

fun bytesOf(xs: [int], a: Asm) {
    for x in xs {
        a.byte(x)
    }
}

/** Whether the JIT is on: on x86-64 unless `BURN_JIT=0`. Sets it up the first time. */
pub fun jitThreshold(): int {
    if (state < 0) {
        state = 0
        unsafe {
            var p = rtPlatform()
            var platform = __str(p)
            rtReleaseText(p)
            macos = startsWith(platform, "macos")
            if (endsWith(platform, "x86_64") && env("BURN_JIT") != "0") {
                state = 1
            }
        }
        var t = trim(env("BURN_JIT_THRESHOLD"))
        if (t != "" && isInt(t) && toInt(t) > 0) {
            limit = toInt(t)
        }
    }
    if (state == 1) {
        return limit
    }
    return -1
}

/** Hands the JIT the addresses of the helpers compiled code calls. */
pub fun jitSetup(slow: int, call: int, callee: int, overflow: int, retain: int, release: int, errOverflow: int) {
    helperSlow = slow
    helperCall = call
    helperCallee = callee
    helperOverflow = overflow
    addrRetain = retain
    addrRelease = release
    addrErrOverflow = errOverflow
}

/** Executable memory holding the machine code `a`, or 0. */
unsafe fun install(a: Asm): int {
    var n = a.pos()
    var size = (n + 4095) / 4096 * 4096
    var flags = 34
    if (macos) {
        flags = 4098
    }
    var p = cMmap(0, size, 3, flags, -1, 0)
    if (p == -1 || p == 0) {
        return 0
    }
    for i in 0..n {
        Memory.store8(p + i, a.b[i])
    }
    if (cMprotect(p, size, 5) != 0) {
        return 0
    }
    return p
}

/** Saves the registers C keeps, the way both thunks start. */
fun thunkStart(a: Asm) {
    bytesOf([85, 72, 137, 229, 83, 65, 84, 65, 85, 65, 86, 65, 87, 72, 131, 236, 8], a)
}

fun thunkEnd(a: Asm) {
    bytesOf([72, 131, 196, 8, 65, 95, 65, 94, 65, 93, 65, 92, 91, 93, 195], a)
}

/** Sets the lowest address the native stack may reach, 4 MB below the first entry, unless it is set. */
fun stackLimit(a: Asm) {
    aluMI(a, 7, R13, VM_RSPLIMIT, 0)
    var set = jcc(a, CC_NE)
    lea(a, RAX, RSP, -4194304)
    st(a, R13, VM_RSPLIMIT, RAX)
    a.patch(set, a.pos())
}

unsafe fun thunks(): bool {
    if (enterThunk != 0) {
        return true
    }
    var e = new Asm()
    thunkStart(e)
    aluRR(e, 137, RSI, R12)
    aluRR(e, 137, RDX, R13)
    stackLimit(e)
    callR(e, RDI)
    thunkEnd(e)
    var o = new Asm()
    thunkStart(o)
    aluRR(o, 137, RDX, R13)
    stackLimit(o)
    callR(o, RDI)
    thunkEnd(o)
    enterThunk = install(e)
    osrThunk = install(o)
    return enterThunk != 0 && osrThunk != 0
}

/** Calls the C function `f` with three arguments. */
unsafe fun call3(f: int, x: int, y: int, z: int): int {
    var fp = f
    var a = x
    var b = y
    var c = z
    var r = 0
    asm {
        x86_64 {
            push r12
            mov rax, {fp}
            mov rdi, {a}
            mov rsi, {b}
            mov rdx, {c}
            mov r12, rsp
            and rsp, -16
            call rax
            mov rsp, r12
            pop r12
            mov {r}, rax
        }
        else {
            r = 0
        }
    }
    return r
}

/** Calls the C function `f` with four arguments. */
unsafe fun call4(f: int, x: int, y: int, z: int, w: int): int {
    var fp = f
    var a = x
    var b = y
    var c = z
    var d = w
    var r = 0
    asm {
        x86_64 {
            push r12
            mov rax, {fp}
            mov rdi, {a}
            mov rsi, {b}
            mov rdx, {c}
            mov rcx, {d}
            mov r12, rsp
            and rsp, -16
            call rax
            mov rsp, r12
            pop r12
            mov {r}, rax
        }
        else {
            r = 0
        }
    }
    return r
}

/** Runs compiled function `code` with its arguments on the operand stack at `sp` of `vm`, and gives its result. */
pub unsafe fun enterJit(code: int, sp: int, vm: int): int {
    return call3(enterThunk, code, sp, vm)
}

/** Resumes compiled function `osr` at machine code `target` with the frame at `bp`, and gives what the call returns. */
pub unsafe fun resumeJit(osr: int, bp: int, vm: int, target: int): int {
    return call4(osrThunk, osr, bp, vm, target)
}

/** How long the fused instruction `op` is, in records. */
fun width(op: int): int {
    if (op == OP_LOAD2 || op == OP_LOADK || op == OP_LOADFIELD) {
        return 2
    }
    if (op == OP_INC || op == OP_INCOV || op >= OP_JLL && op < OP_ICMP) {
        return 4
    }
    return 1
}

/** A function being compiled: its machine code and where each instruction's code starts. */
def struct Job(fi: int, prog: int) {
    Asm a = new Asm()
    [int] starts = []
    [int] depths = []
    [int] fixAt = []
    [int] fixTo = []
    [int] toEnd = []
    int locals = 0
    int code = 0
    bool ok = true

    /** The displacement from `rbx` of operand stack slot `d`. */
    fun slot(d: int): int {
        return 8 * (locals + d)
    }

    /** Notes that instruction `t` is reached with `d` values on the stack. */
    fun reach(t: int, d: int) {
        if (t < 0 || t >= len(depths)) {
            ok = false
            return
        }
        if (depths[t] < 0) {
            depths[t] = d
        } else if (depths[t] != d) {
            ok = false
        }
    }

    /** A jump to instruction `t`, with `d` values on the stack there. */
    fun jumpTo(at: int, t: int, d: int) {
        reach(t, d)
        fixAt.push(at)
        fixTo.push(t)
    }

    fun target(addr: int): int {
        return (addr - code) / OP_SIZE
    }

    /** Runs the instruction at `pc` with `burn_bvm_slow`, with `d` values on the stack. */
    fun slow(pc: int, d: int) {
        lea(a, RDX, RBX, slot(d))
        st(a, R13, VM_SP, RDX)
        aluRR(a, 137, R13, RDI)
        movri(a, RSI, pc)
        callAbs(a, helperSlow)
    }

    /** Stops with an integer overflow at `loc` unless the last instruction left the overflow flag clear. */
    fun overflowCheck(loc: int) {
        var fine = jcc(a, CC_NO)
        movri(a, RDI, loc)
        callAbs(a, addrErrOverflow)
        a.patch(fine, a.pos())
    }

    /** Calls the function in `rsi` (or `fi`, when it is not 0) with its arguments ending at slot `end`; the result goes to slot `result`. */
    fun call(fi: int, end: int, result: int) {
        lea(a, R12, RBX, slot(end))
        if (fi != 0) {
            movri(a, RSI, fi)
        }
        ld(a, RAX, RSI, F_JIT)
        aluRR(a, 133, RAX, RAX)
        var interp = jcc(a, CC_E)
        callR(a, RAX)
        var done = jmp(a)
        a.patch(interp, a.pos())
        aluRR(a, 137, R13, RDI)
        aluRR(a, 137, R12, RDX)
        callAbs(a, helperCall)
        a.patch(done, a.pos())
        st(a, RBX, slot(result), RAX)
    }

    /** The fast path of `getfield` on the record in slot `d - 1`, falling back to `pc`. */
    fun getField(i: int, d: int, pc: int) {
        ld(a, RAX, RBX, slot(d - 1))
        aluRR(a, 133, RAX, RAX)
        var s1 = jcc(a, CC_E)
        cmp8(a, RAX, 0, 3)
        var s2 = jcc(a, CC_NE)
        ld32(a, RCX, RAX, 8)
        aluRI(a, 7, RCX, 24 + 8 * i)
        var s3 = jcc(a, CC_B)
        ld(a, RAX, RAX, 16 + 8 * i)
        st(a, RBX, slot(d - 1), RAX)
        var done = jmp(a)
        a.patch(s1, a.pos())
        a.patch(s2, a.pos())
        a.patch(s3, a.pos())
        slow(pc, d)
        a.patch(done, a.pos())
    }

    /** Compiles instruction record `pc` (index `i`) with `d` values on the stack; gives the depth after it, or -1 when nothing follows it. */
    unsafe fun op(pc: int, i: int, d: int): int {
        var k = Memory.load64(pc)
        var x = Memory.load64(pc + 8)
        var y = Memory.load64(pc + 16)
        var z = Memory.load64(pc + 24)
        if (k == OP_LOAD) {
            ld(a, RAX, RBX, 8 * x)
            st(a, RBX, slot(d), RAX)
            return d + 1
        }
        if (k == OP_CONST) {
            if (fits32(x)) {
                stimm(a, RBX, slot(d), x)
            } else {
                movri(a, RAX, x)
                st(a, RBX, slot(d), RAX)
            }
            return d + 1
        }
        if (k == OP_STORE) {
            ld(a, RAX, RBX, slot(d - 1))
            st(a, RBX, 8 * x, RAX)
            return d - 1
        }
        if (k == OP_TEE) {
            ld(a, RAX, RBX, slot(d - 1))
            st(a, RBX, 8 * x, RAX)
            return d
        }
        if (k == OP_LOAD2) {
            ld(a, RAX, RBX, 8 * x)
            st(a, RBX, slot(d), RAX)
            ld(a, RAX, RBX, 8 * y)
            st(a, RBX, slot(d + 1), RAX)
            return d + 2
        }
        if (k == OP_LOADK) {
            ld(a, RAX, RBX, 8 * x)
            st(a, RBX, slot(d), RAX)
            stimm(a, RBX, slot(d + 1), y)
            return d + 2
        }
        if (k == OP_JZ || k == OP_JNZ) {
            ld(a, RAX, RBX, slot(d - 1))
            aluRR(a, 133, RAX, RAX)
            var cc = CC_E
            if (k == OP_JNZ) {
                cc = CC_NE
            }
            jumpTo(jcc(a, cc), target(x), d - 1)
            return d - 1
        }
        if (k == OP_JZK || k == OP_JNZK) {
            ld(a, RAX, RBX, slot(d - 1))
            aluRR(a, 133, RAX, RAX)
            var cc = CC_E
            if (k == OP_JNZK) {
                cc = CC_NE
            }
            jumpTo(jcc(a, cc), target(x), d)
            return d
        }
        if (k == OP_JMP) {
            jumpTo(jmp(a), target(x), d)
            return -1
        }
        if (k >= OP_JLL && k < OP_JLC) {
            ld(a, RAX, RBX, 8 * x)
            aluRM(a, 59, RAX, RBX, 8 * y)
            jumpTo(jcc(a, CMP_CC[k - OP_JLL] ^ 1), target(z), d)
            return d
        }
        if (k >= OP_JLC && k < OP_ICMP) {
            ld(a, RAX, RBX, 8 * x)
            aluRI(a, 7, RAX, y)
            jumpTo(jcc(a, CMP_CC[k - OP_JLC] ^ 1), target(z), d)
            return d
        }
        if (k >= OP_ICMP && k < OP_IADD) {
            ld(a, RAX, RBX, slot(d - 2))
            aluRM(a, 59, RAX, RBX, slot(d - 1))
            setcc(a, CMP_CC[k - OP_ICMP])
            st(a, RBX, slot(d - 2), RAX)
            return d - 1
        }
        if (k == OP_IADD || k == OP_ISUB || k == OP_IADDOV || k == OP_ISUBOV || k == OP_AND || k == OP_OR || k == OP_XOR) {
            var opc = 3
            if (k == OP_ISUB || k == OP_ISUBOV) {
                opc = 43
            } else if (k == OP_AND) {
                opc = 35
            } else if (k == OP_OR) {
                opc = 11
            } else if (k == OP_XOR) {
                opc = 51
            }
            ld(a, RAX, RBX, slot(d - 2))
            aluRM(a, opc, RAX, RBX, slot(d - 1))
            if (k == OP_IADDOV || k == OP_ISUBOV) {
                overflowCheck(x)
            }
            st(a, RBX, slot(d - 2), RAX)
            return d - 1
        }
        if (k == OP_IMUL || k == OP_IMULOV) {
            ld(a, RAX, RBX, slot(d - 2))
            rexw(a, RAX, RBX)
            a.byte(15)
            a.byte(175)
            mem(a, RAX, RBX, slot(d - 1))
            if (k == OP_IMULOV) {
                overflowCheck(x)
            }
            st(a, RBX, slot(d - 2), RAX)
            return d - 1
        }
        if (k == OP_INC || k == OP_INCOV) {
            aluMI(a, 0, RBX, 8 * x, y)
            if (k == OP_INCOV) {
                overflowCheck(z)
            }
            return d
        }
        if (k == OP_INEG) {
            ld(a, RAX, RBX, slot(d - 1))
            rexw(a, 0, RAX)
            a.byte(247)
            rr(a, 3, RAX)
            st(a, RBX, slot(d - 1), RAX)
            return d
        }
        if (k == OP_SHL || k == OP_SHR || k == OP_USHR) {
            ld(a, RCX, RBX, slot(d - 1))
            ld(a, RAX, RBX, slot(d - 2))
            var ext = 4
            if (k == OP_SHR) {
                ext = 7
            } else if (k == OP_USHR) {
                ext = 5
            }
            rexw(a, 0, RAX)
            a.byte(211)
            rr(a, ext, RAX)
            st(a, RBX, slot(d - 2), RAX)
            return d - 1
        }
        if (k == OP_NOT) {
            ld(a, RAX, RBX, slot(d - 1))
            aluRR(a, 133, RAX, RAX)
            setcc(a, CC_E)
            st(a, RBX, slot(d - 1), RAX)
            return d
        }
        if (k == OP_POP) {
            return d - 1
        }
        if (k == OP_DUP) {
            ld(a, RAX, RBX, slot(d - 1))
            st(a, RBX, slot(d), RAX)
            return d + 1
        }
        if (k == OP_SWAP) {
            ld(a, RAX, RBX, slot(d - 1))
            ld(a, RCX, RBX, slot(d - 2))
            st(a, RBX, slot(d - 1), RCX)
            st(a, RBX, slot(d - 2), RAX)
            return d
        }
        if (k == OP_GLOAD || k == OP_GSTORE || k == OP_GTEE) {
            movri(a, RCX, Memory.load64(prog + P_GLOBALS))
            if (k == OP_GLOAD) {
                ld(a, RAX, RCX, 8 * x)
                st(a, RBX, slot(d), RAX)
                return d + 1
            }
            ld(a, RAX, RBX, slot(d - 1))
            st(a, RCX, 8 * x, RAX)
            if (k == OP_GSTORE) {
                return d - 1
            }
            return d
        }
        if (k == OP_RET) {
            ld(a, RAX, RBX, slot(d - 1))
            toEnd.push(jmp(a))
            return -1
        }
        if (k == OP_RETV) {
            bytesOf([49, 192], a)
            toEnd.push(jmp(a))
            return -1
        }
        if (k == OP_CALL) {
            var params = Memory.load64(x + F_PARAMS)
            call(x, d, d - params)
            return d - params + 1
        }
        if (k == OP_CALLIND || k == OP_DISPATCH) {
            lea(a, RDX, RBX, slot(d))
            st(a, R13, VM_SP, RDX)
            aluRR(a, 137, R13, RDI)
            movri(a, RSI, pc)
            callAbs(a, helperCallee)
            aluRR(a, 137, RAX, RSI)
            if (k == OP_CALLIND) {
                call(0, d - 1, d - 1 - x)
                return d - x
            }
            call(0, d, d - y)
            return d - y + 1
        }
        if (k == OP_RT) {
            if (y > 6) {
                ok = false
                return -1
            }
            lea(a, R12, RBX, slot(d))
            st(a, R13, VM_SP, R12)
            for j in 0..y {
                ld(a, ARG_REGS[j], RBX, slot(d - y + j))
            }
            callAbs(a, x)
            st(a, RBX, slot(d - y), RAX)
            return d - y + 1
        }
        if (k == OP_RETAIN) {
            ld(a, RDI, RBX, slot(d - 1))
            callAbs(a, addrRetain)
            return d
        }
        if (k == OP_RELEASE) {
            lea(a, R12, RBX, slot(d))
            st(a, R13, VM_SP, R12)
            ld(a, RDI, RBX, slot(d - 1))
            callAbs(a, addrRelease)
            st(a, RBX, slot(d - 1), RAX)
            return d
        }
        if (k == OP_GETFIELD) {
            getField(x, d, pc)
            return d
        }
        if (k == OP_LOADFIELD) {
            ld(a, RAX, RBX, 8 * x)
            st(a, RBX, slot(d), RAX)
            getField(y, d + 1, pc + OP_SIZE)
            return d + 1
        }
        if (k == OP_INDEX) {
            ld(a, RAX, RBX, slot(d - 2))
            ld(a, RCX, RBX, slot(d - 1))
            aluRR(a, 133, RAX, RAX)
            var s1 = jcc(a, CC_E)
            cmp8(a, RAX, 0, 2)
            var s2 = jcc(a, CC_NE)
            cmp8(a, RAX, 3, 0)
            var s3 = jcc(a, CC_NE)
            aluRM(a, 59, RCX, RAX, 16)
            var s4 = jcc(a, CC_AE)
            ld(a, RDX, RAX, 32)
            bytesOf([72, 139, 4, 202], a)
            st(a, RBX, slot(d - 2), RAX)
            var done = jmp(a)
            a.patch(s1, a.pos())
            a.patch(s2, a.pos())
            a.patch(s3, a.pos())
            a.patch(s4, a.pos())
            slow(pc, d)
            a.patch(done, a.pos())
            return d - 1
        }
        if (k == OP_LEN) {
            ld(a, RAX, RBX, slot(d - 1))
            aluRR(a, 133, RAX, RAX)
            var s1 = jcc(a, CC_E)
            cmp8(a, RAX, 0, 2)
            var s2 = jcc(a, CC_NE)
            ld(a, RAX, RAX, 16)
            st(a, RBX, slot(d - 1), RAX)
            var done = jmp(a)
            a.patch(s1, a.pos())
            a.patch(s2, a.pos())
            slow(pc, d)
            a.patch(done, a.pos())
            return d
        }
        slow(pc, d)
        if (k == OP_IDIV || k == OP_IREM || k == OP_UCMP || k == OP_FCMP || k == OP_SETFIELD || k >= OP_FADD && k <= OP_FREM) {
            return d - 1
        }
        if (k == OP_SETINDEX) {
            return d - 2
        }
        if (k == OP_HOST || k == OP_SPAWN || k == OP_NEWRECORD || k == OP_NEWARRAY) {
            return d - y + 1
        }
        return d
    }

    /** Compiles the function; gives false when it cannot. */
    unsafe fun run(): bool {
        code = Memory.load64(fi + F_CODE)
        var n = Memory.load64(fi + F_NOPS)
        var params = Memory.load64(fi + F_PARAMS)
        locals = Memory.load64(fi + F_LOCALS)
        for i in 0..n + 1 {
            starts.push(-1)
            depths.push(-1)
        }
        bytesOf([85, 72, 137, 229, 83, 72, 131, 236, 8], a)
        aluRR(a, 137, RSI, RBX)
        bytesOf([255, 225], a)
        var entry = a.pos()
        bytesOf([85, 72, 137, 229, 83, 72, 131, 236, 8], a)
        aluRM(a, 59, RSP, R13, VM_RSPLIMIT)
        var ovf1 = jcc(a, CC_B)
        lea(a, RBX, R12, -8 * params)
        lea(a, RAX, RBX, 8 * Memory.load64(fi + F_FRAME))
        aluRM(a, 59, RAX, R13, VM_STACK_END)
        var ovf2 = jcc(a, CC_A)
        for k in params..locals {
            stimm(a, RBX, 8 * k, 0)
        }
        depths[0] = 0
        var i = 0
        var d = 0
        var falls = true
        while (i < n && ok) {
            if (!falls) {
                d = depths[i]
                if (d < 0) {
                    var w = width(Memory.load64(code + OP_SIZE * i))
                    i += w
                    continue
                }
            } else {
                reach(i, d)
            }
            starts[i] = a.pos()
            var pc = code + OP_SIZE * i
            var w = width(Memory.load64(pc))
            var after = op(pc, i, d)
            falls = after >= 0
            if (falls) {
                d = after
            }
            i += w
        }
        if (!ok || falls) {
            return false
        }
        for k in 0..len(fixAt) {
            var t = starts[fixTo[k]]
            if (t < 0) {
                return false
            }
            a.patch(fixAt[k], t)
        }
        var end = a.pos()
        for at in toEnd {
            a.patch(at, end)
        }
        bytesOf([72, 139, 93, 248, 201, 195], a)
        a.patch(ovf1, a.pos())
        a.patch(ovf2, a.pos())
        callAbs(a, helperOverflow)
        unsafe {
            var base = install(a)
            if (base == 0) {
                return false
            }
            var map = Memory.alloc(8 * n + 8)
            for k in 0..n {
                if (starts[k] >= 0) {
                    Memory.store64(map + 8 * k, base + starts[k])
                }
            }
            Memory.store64(fi + F_OSRMAP, map)
            Memory.store64(fi + F_OSR, base)
            Memory.store64(fi + F_JIT, base + entry)
        }
        return true
    }
}

/** Compiles function record `fi` of program `prog` to machine code; gives whether it worked. */
pub fun jitCompile(fi: int, prog: int): bool {
    unsafe {
        if (jitThreshold() < 0 || !thunks()) {
            return false
        }
        if (Memory.load64(fi + F_JIT) != 0) {
            return true
        }
        var job = new Job(fi, prog)
        if (job.run()) {
            return true
        }
        Memory.store64(fi + F_HITS, -4611686018427387904)
        return false
    }
}
