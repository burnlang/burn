/**
 * The JIT of the bvm written in Burn: functions that run often, and loops that turn often, are compiled from their
 * prepared instruction records to machine code while the program runs, x86-64 (`jit_x86.bn`) or arm64
 * (`jit_arm64.bn`).
 *
 * Compiled code keeps the interpreter's frame: the locals of a call at the frame base (`bp`) and its operand stack
 * after them. The depth of the operand stack is known for every instruction, so each stack slot is a fixed offset from
 * the frame base and no stack pointer is kept while code runs. While it compiles, the JIT tracks what each slot holds
 * (`jitbase.bn`): a constant, the value of a local or the value in the accumulator register are only written to the
 * slot when something needs it there (a jump, a call or a jump target), so most instructions work on registers.
 * Because the frames are the same, interpreted and compiled functions call each other freely, and the interpreter can
 * jump into the compiled code of a function in the middle of a loop (on-stack replacement). Integer arithmetic,
 * comparisons, division, fields, array reads and writes and reference counting are compiled inline, falling back to
 * the runtime for the rare cases; instructions without a fast machine code form call `burn_bvm_slow`, which runs them
 * like the interpreter does.
 *
 * `BURN_JIT=0` turns the JIT off, and `BURN_JIT_THRESHOLD` sets how many calls or loop turns make code hot (1000).
 */
import "jitbase.bn"
import "jit_arm64.bn"
import "jit_x86.bn"
import "layout.bn"
import "std/memory"
import "std/process"

@Extern("burn_rt_platform")
fun rtPlatform(): int

@Extern("burn_release")
fun rtReleaseText(p: int): int

@Extern("burn_release_zero")
fun rtReleaseZero(p: int): int

@Extern("burn_possible_root")
fun rtPossibleRoot(p: int): int

@Extern("burn_rt_mt_cell")
fun rtMtCell(): int

var state = -1
var limit = 1000
var macos = false
var arm = false
var enterThunk = 0
var osrThunk = 0
var helpers = Helpers { slow: 0, call: 0, callee: 0, overflow: 0, retain: 0, release: 0, releaseZero: 0, possibleRoot: 0, errOverflow: 0, mtCell: 0 }

/** How many calls or loop turns make code hot, or -1 when the JIT is off. Sets it up the first time. */
pub fun jitThreshold(): int {
    if (state < 0) {
        state = 0
        unsafe {
            var p = rtPlatform()
            var platform = __str(p)
            rtReleaseText(p)
            macos = startsWith(platform, "macos")
            arm = endsWith(platform, "aarch64")
            if ((endsWith(platform, "x86_64") || arm) && env("BURN_JIT") != "0") {
                state = 1
            }
        }
        var t = trim(env("BURN_JIT_THRESHOLD"))
        if (t != "" && isInt(t) && toInt(t) > 0) {
            limit = toInt(t)
        }
    }
    if (state == 1) {
        return limit
    }
    return -1
}

/** Hands the JIT the addresses of the helpers compiled code calls. */
pub fun jitSetup(slow: int, call: int, callee: int, overflow: int, retain: int, release: int, errOverflow: int) {
    helpers.slow = slow
    helpers.call = call
    helpers.callee = callee
    helpers.overflow = overflow
    helpers.retain = retain
    helpers.release = release
    helpers.errOverflow = errOverflow
}

unsafe fun thunks(): bool {
    if (enterThunk != 0) {
        return true
    }
    var t = x86Thunks()
    if (arm) {
        t = armThunks()
    }
    enterThunk = install(t[0], macos)
    osrThunk = install(t[1], macos)
    return enterThunk != 0 && osrThunk != 0
}

/** Calls the C function `f` with three arguments. */
unsafe fun call3(f: int, x: int, y: int, z: int): int {
    var fp = f
    var a = x
    var b = y
    var c = z
    var r = 0
    asm {
        x86_64 {
            push r12
            mov rax, {fp}
            mov rdi, {a}
            mov rsi, {b}
            mov rdx, {c}
            mov r12, rsp
            and rsp, -16
            call rax
            mov rsp, r12
            pop r12
            mov {r}, rax
        }
        arm64 {
            ldr x0, {a}
            ldr x1, {b}
            ldr x2, {c}
            ldr x9, {fp}
            blr x9
            str x0, {r}
        }
    }
    return r
}

/** Calls the C function `f` with four arguments. */
unsafe fun call4(f: int, x: int, y: int, z: int, w: int): int {
    var fp = f
    var a = x
    var b = y
    var c = z
    var d = w
    var r = 0
    asm {
        x86_64 {
            push r12
            mov rax, {fp}
            mov rdi, {a}
            mov rsi, {b}
            mov rdx, {c}
            mov rcx, {d}
            mov r12, rsp
            and rsp, -16
            call rax
            mov rsp, r12
            pop r12
            mov {r}, rax
        }
        arm64 {
            ldr x0, {a}
            ldr x1, {b}
            ldr x2, {c}
            ldr x3, {d}
            ldr x9, {fp}
            blr x9
            str x0, {r}
        }
    }
    return r
}

/** Runs compiled function `code` with its arguments on the operand stack at `sp` of `vm`, and gives its result. */
pub unsafe fun enterJit(code: int, sp: int, vm: int): int {
    return call3(enterThunk, code, sp, vm)
}

/** Resumes compiled function `osr` at machine code `target` with the frame at `bp`, and gives what the call returns. */
pub unsafe fun resumeJit(osr: int, bp: int, vm: int, target: int): int {
    return call4(osrThunk, osr, bp, vm, target)
}

/** Compiles function record `fi` of program `prog` to machine code; gives whether it worked. */
pub fun jitCompile(fi: int, prog: int): bool {
    unsafe {
        if (jitThreshold() < 0 || !thunks()) {
            return false
        }
        if (Memory.load64(fi + F_JIT) != 0) {
            return true
        }
        if (helpers.mtCell == 0) {
            helpers.mtCell = rtMtCell()
            helpers.releaseZero = __cfun(rtReleaseZero)
            helpers.possibleRoot = __cfun(rtPossibleRoot)
        }
        var ok = false
        if (arm) {
            ok = new JobA64(fi, prog, helpers, macos).run()
        } else {
            ok = new JobX86(fi, prog, helpers, macos).run()
        }
        if (ok) {
            return true
        }
        Memory.store64(fi + F_HITS, -4611686018427387904)
        return false
    }
}
