/** The address of each runtime function, in the order of `RT_NAMES`. */
pub unsafe fun runtimeAddresses(): [int] {
    return [
        __cfun(rtInit),
        __cfun(rtSetArgs),
        __cfun(rtExit),
        __cfun(rtStrConcat),
        __cfun(rtStrEq),
        __cfun(rtStrCmp),
        __cfun(rtStrLen),
        __cfun(rtStrIndex),
        __cfun(rtStrSub),
        __cfun(rtStrFind),
        __cfun(rtStrContains),
        __cfun(rtStrReplace),
        __cfun(rtStrSplit),
        __cfun(rtStrTrim),
        __cfun(rtStrUpper),
        __cfun(rtStrLower),
        __cfun(rtStrStarts),
        __cfun(rtStrEnds),
        __cfun(rtStrRepeat),
        __cfun(rtStrChars),
        __cfun(rtStrCode),
        __cfun(rtCharClass),
        __cfun(rtStrFromCode),
        __cfun(rtStrToBytes),
        __cfun(rtStrFromBytes),
        __cfun(rtToStr),
        __cfun(rtParseInt),
        __cfun(rtParseFloat),
        __cfun(rtIsIntStr),
        __cfun(rtIsFloatStr),
        __cfun(rtPrint),
        __cfun(rtPrintRaw),
        __cfun(rtInput),
        __cfun(rtPrintErr),
        __cfun(rtReadStdin),
        __cfun(rtArrNew),
        __cfun(rtArrLen),
        __cfun(rtArrGet),
        __cfun(rtArrSet),
        __cfun(rtArrPush),
        __cfun(rtArrPop),
        __cfun(rtArrInsert),
        __cfun(rtArrRemove),
        __cfun(rtArrConcat),
        __cfun(rtArrSlice),
        __cfun(rtArrCopy),
        __cfun(rtArrIndexOf),
        __cfun(rtArrContains),
        __cfun(rtArrJoin),
        __cfun(rtArrReverse),
        __cfun(rtArrSort),
        __cfun(rtArrClear),
        __cfun(rtMapNew),
        __cfun(rtMapSet),
        __cfun(rtMapGet),
        __cfun(rtMapGetOr),
        __cfun(rtMapFind),
        __cfun(rtMapHas),
        __cfun(rtMapRemove),
        __cfun(rtMapKeys),
        __cfun(rtMapValues),
        __cfun(rtMapLen),
        __cfun(rtStructNew),
        __cfun(rtBox),
        __cfun(rtIsType),
        __cfun(rtCast),
        __cfun(rtUnwrap),
        __cfun(rtDestroy),
        __cfun(rtAlive),
        __cfun(rtEq),
        __cfun(rtCmp),
        __cfun(rtTypeName),
        __cfun(rtAnyIndex),
        __cfun(rtAnyLen),
        __cfun(rtFMath),
        __cfun(rtFPow),
        __cfun(rtFAtan2),
        __cfun(rtFMod),
        __cfun(rtIPow),
        __cfun(rtIAbs),
        __cfun(rtIMin),
        __cfun(rtIMax),
        __cfun(rtFMin),
        __cfun(rtFMax),
        __cfun(rtRandom),
        __cfun(rtRandomInt),
        __cfun(rtSeed),
        __cfun(rtNowMs),
        __cfun(rtNowSec),
        __cfun(rtClockNs),
        __cfun(rtSleep),
        __cfun(rtLocalTime),
        __cfun(rtHttpRequest),
        __cfun(rtJsonParse),
        __cfun(rtJsonStringify),
        __cfun(rtReadFile),
        __cfun(rtWriteFile),
        __cfun(rtAppendFile),
        __cfun(rtFileExists),
        __cfun(rtEnv),
        __cfun(rtArgs),
        __cfun(rtExec),
        __cfun(rtFsOp),
        __cfun(rtListDir),
        __cfun(rtCwd),
        __cfun(rtExitNow),
        __cfun(rtPanic),
        __cfun(rtAssert),
        __cfun(rtErrIndex),
        __cfun(rtErrDivZero),
        __cfun(rtShiftCheck),
        __cfun(rtErrShift),
        __cfun(rtErrOverflow),
        __cfun(rtNumFit),
        __cfun(rtNumConv),
        __cfun(rtNumWrap),
        __cfun(rtUAdd),
        __cfun(rtUSub),
        __cfun(rtUMul),
        __cfun(rtUDiv),
        __cfun(rtUMod),
        __cfun(rtU2F),
        __cfun(rtF2Num),
        __cfun(rtF32Round),
        __cfun(rtErrNull),
        __cfun(rtErrReturn),
        __cfun(rtSpawn),
        __cfun(rtAwait),
        __cfun(rtGcCollect),
        __cfun(rtRetain),
        __cfun(rtRelease),
        __cfun(rtReleaseZero),
        __cfun(rtPossibleRoot),
        __cfun(rtStrAppend),
        __cfun(rtParseIntRadix),
        __cfun(rtIsIntRadix),
        __cfun(rtIntToStrRadix),
        __cfun(rtFail),
