/**
 * The arm64 code generator of the JIT, for Linux and macOS (Apple silicon). `x19` holds the frame base (the locals of
 * the call, then its operand stack), `x20` the interpreter state and `x21` the top of the stack whenever code calls
 * something; `x9` is the accumulator whose value the operand stack tracks, `x10` to `x12` hold the other operands of
 * an instruction, and `x16` and `x17` are scratch. Calls follow the C calling convention, with the arguments in `x0`
 * to `x5` and the result in `x0`.
 */
import "jitbase.bn"
import "layout.bn"
import "std/memory"

const ACC = 9
const T1 = 10
const T2 = 11
const T3 = 12
const S0 = 16
const S1 = 17
const BP = 19
const VMR = 20
const SPR = 21
const ZR = 31

const EQ = 0
const NE = 1
const HS = 2
const LO = 3
const VC = 7
const HI = 8

/** The condition of each comparison, in the order of `Cmp`: eq, ne, lt, le, gt, ge. */
const A64_CC = [0, 1, 11, 13, 12, 10]

/** The comparison of each `Cmp` with its operands swapped. */
const A64_SWAP = [0, 1, 4, 5, 2, 3]

const ADD = 0x8B000000
const ADDS = 0xAB000000
const SUB = 0xCB000000
const SUBS = 0xEB000000
const AND = 0x8A000000
const ORR = 0xAA000000
const EOR = 0xCA000000
const LSLV = 0x9AC02000
const LSRV = 0x9AC02400
const ASRV = 0x9AC02800
const SDIV = 0x9AC00C00
const MUL = 0x9B007C00
const SMULH = 0x9B407C00

const KIND_FREED = 238

fun ins(a: Asm, w: int) {
    a.i32(w)
}

/** An instruction `op rd, rn, rm` on 64-bit registers. */
fun rrr(a: Asm, op: int, rd: int, rn: int, rm: int) {
    ins(a, op | (rm << 16) | (rn << 5) | rd)
}

/** `mov rd, rm` */
fun movr(a: Asm, rd: int, rm: int) {
    ins(a, 0xAA0003E0 | (rm << 16) | rd)
}

/** `mov rd, imm` with `movz`, `movn` and `movk`. */
fun movri(a: Asm, rd: int, v: int) {
    if (v >= 0 && v < 0x10000) {
        ins(a, 0xD2800000 | (v << 5) | rd)
        return
    }
    if (v < 0 && v >= -0x10000) {
        ins(a, 0x92800000 | (((-1 - v) & 0xFFFF) << 5) | rd)
        return
    }
    [int] hs = []
    var ones = 0
    var zeros = 0
    for k in 0..4 {
        var x = (v >> (16 * k)) & 0xFFFF
        hs.push(x)
        if (x == 0xFFFF) {
            ones += 1
        } else if (x == 0) {
            zeros += 1
        }
    }
    var fill = 0
    if (ones > zeros) {
        fill = 0xFFFF
    }
    var first = true
    for k in 0..4 {
        if (hs[k] == fill) {
            continue
        }
        if (first) {
            if (fill == 0) {
                ins(a, 0xD2800000 | (k << 21) | (hs[k] << 5) | rd)
            } else {
                ins(a, 0x92800000 | (k << 21) | ((hs[k] ^ 0xFFFF) << 5) | rd)
            }
            first = false
        } else {
            ins(a, 0xF2800000 | (k << 21) | (hs[k] << 5) | rd)
        }
    }
    if (first) {
        if (fill == 0) {
            ins(a, 0xD2800000 | rd)
        } else {
            ins(a, 0x92800000 | rd)
        }
    }
}

/** `add rd, rn, #imm` for any `imm` (through `x17` when it does not fit); `rn` may be `sp`. */
fun addImm(a: Asm, rd: int, rn: int, imm: int) {
    if (imm >= 0 && imm < 4096) {
        ins(a, 0x91000000 | (imm << 10) | (rn << 5) | rd)
    } else if (imm < 0 && imm > -4096) {
        ins(a, 0xD1000000 | ((-imm) << 10) | (rn << 5) | rd)
    } else {
        movri(a, S1, imm)
        rrr(a, ADD, rd, rn, S1)
    }
}

/** `ldr rt, [rn, #off]`, through `x17` when the offset does not fit. */
fun ld(a: Asm, rt: int, rn: int, off: int) {
    if (off >= 0 && off % 8 == 0 && off < 32768) {
        ins(a, 0xF9400000 | ((off / 8) << 10) | (rn << 5) | rt)
    } else {
        movri(a, S1, off)
        ins(a, 0xF8606800 | (S1 << 16) | (rn << 5) | rt)
    }
}

/** `str rt, [rn, #off]`, through `x17` when the offset does not fit. */
fun st(a: Asm, rt: int, rn: int, off: int) {
    if (off >= 0 && off % 8 == 0 && off < 32768) {
        ins(a, 0xF9000000 | ((off / 8) << 10) | (rn << 5) | rt)
    } else {
        movri(a, S1, off)
        ins(a, 0xF8206800 | (S1 << 16) | (rn << 5) | rt)
    }
}

/** `ldr rt, [rn, rm, lsl #3]` */
fun ldIdx(a: Asm, rt: int, rn: int, rm: int) {
    ins(a, 0xF8607800 | (rm << 16) | (rn << 5) | rt)
}

/** `str rt, [rn, rm, lsl #3]` */
fun stIdx(a: Asm, rt: int, rn: int, rm: int) {
    ins(a, 0xF8207800 | (rm << 16) | (rn << 5) | rt)
}

/** `ldr wt, [rn, #off]` */
fun ld32(a: Asm, rt: int, rn: int, off: int) {
    ins(a, 0xB9400000 | ((off / 4) << 10) | (rn << 5) | rt)
}

/** `str wt, [rn, #off]` */
fun st32(a: Asm, rt: int, rn: int, off: int) {
    ins(a, 0xB9000000 | ((off / 4) << 10) | (rn << 5) | rt)
}

/** `ldrb wt, [rn, #off]` */
fun ld8(a: Asm, rt: int, rn: int, off: int) {
    ins(a, 0x39400000 | (off << 10) | (rn << 5) | rt)
}

/** `cmp rn, rm` */
fun cmpr(a: Asm, rn: int, rm: int) {
    rrr(a, SUBS, ZR, rn, rm)
}

/** `cmp rn, #imm` for any `imm` (through `x17` when it does not fit). */
fun cmpi(a: Asm, rn: int, imm: int) {
    if (imm >= 0 && imm < 4096) {
        ins(a, 0xF100001F | (imm << 10) | (rn << 5))
    } else if (imm < 0 && imm > -4096) {
        ins(a, 0xB100001F | ((-imm) << 10) | (rn << 5))
    } else {
        movri(a, S1, imm)
        cmpr(a, rn, S1)
    }
}

/** `cmp wn, #imm` */
fun cmpw(a: Asm, rn: int, imm: int) {
    ins(a, 0x7100001F | (imm << 10) | (rn << 5))
}

/** `cset rd, cc` */
fun cset(a: Asm, rd: int, cc: int) {
    ins(a, 0x9A9F07E0 | ((cc ^ 1) << 12) | rd)
}

/** A conditional branch with its offset still to patch, whose position it gives. */
fun bcond(a: Asm, cc: int): int {
    var at = a.pos()
    ins(a, 0x54000000 | cc)
    return at
}

/** `b` with its offset still to patch, whose position it gives. */
fun bra(a: Asm): int {
    var at = a.pos()
    ins(a, 0x14000000)
    return at
}

/** `cbz rt` (or `cbnz` when `nonzero`) with its offset still to patch; `w` tests the 32-bit register. */
fun cbz(a: Asm, rt: int, nonzero: bool, w: bool): int {
    var at = a.pos()
    var op = 0xB4000000
    if (w) {
        op = 0x34000000
    }
    if (nonzero) {
        op = op | 0x01000000
    }
    ins(a, op | rt)
    return at
}

/** `tbz rt, #bit` (or `tbnz` when `nonzero`) with its offset still to patch. */
fun tbz(a: Asm, rt: int, bit: int, nonzero: bool): int {
    var at = a.pos()
    var op = 0x36000000
    if (nonzero) {
        op = 0x37000000
    }
    ins(a, op | (bit << 19) | rt)
    return at
}

/** Points the branch at `at` to `to`. */
fun patch(a: Asm, at: int, to: int) {
    var w = a.word(at)
    var off = (to - at) / 4
    if ((w >> 26) == 5) {
        w = (w & 0xFC000000) | (off & 0x3FFFFFF)
    } else if (((w >> 25) & 63) == 27) {
        w = (w & 0xFFF8001F) | ((off & 0x3FFF) << 5)
    } else {
        w = (w & 0xFF00001F) | ((off & 0x7FFFF) << 5)
    }
    a.setWord(at, w)
}

fun blr(a: Asm, rn: int) {
    ins(a, 0xD63F0000 | (rn << 5))
}

/** Calls the C function at `addr` (the arguments are already in their registers). */
fun callAbs(a: Asm, addr: int) {
    movri(a, S0, addr)
    blr(a, S0)
}

/** `stp x29, x30, [sp, #-size]!; mov x29, sp` */
fun frameStart(a: Asm, size: int) {
    ins(a, 0xA9807BFD | (((-size / 8) & 127) << 15))
    addImm(a, 29, ZR, 0)
}

/** `ldp x29, x30, [sp], #size; ret` */
fun frameEnd(a: Asm, size: int) {
    ins(a, 0xA8C07BFD | (((size / 8) & 127) << 15))
    ins(a, 0xD65F03C0)
}

/** Saves the registers C keeps that compiled code uses, the way both thunks start. */
fun thunkStart(a: Asm) {
    frameStart(a, 48)
    ins(a, 0xA90153F3)
    st(a, SPR, ZR, 32)
}

fun thunkEnd(a: Asm) {
    ins(a, 0xA94153F3)
    ld(a, SPR, ZR, 32)
    frameEnd(a, 48)
}

/** Sets the lowest address the native stack may reach, 4 MB below the first entry, unless it is set. */
fun stackLimit(a: Asm) {
    ld(a, S0, VMR, VM_RSPLIMIT)
    var set = cbz(a, S0, true, false)
    addImm(a, S0, ZR, 0)
    movri(a, S1, 4194304)
    rrr(a, SUB, S0, S0, S1)
    st(a, S0, VMR, VM_RSPLIMIT)
    patch(a, set, a.pos())
}

/** The two thunks C calls compiled code through: `enter(code, sp, vm)` and `resume(osr, bp, vm, target)`. */
pub fun armThunks(): [Asm] {
    var e = new Asm()
    thunkStart(e)
    movr(e, SPR, 1)
    movr(e, VMR, 2)
    stackLimit(e)
    blr(e, 0)
    thunkEnd(e)
    var o = new Asm()
    thunkStart(o)
    movr(o, VMR, 2)
    stackLimit(o)
    blr(o, 0)
    thunkEnd(o)
    return [e, o]
}

/** A function being compiled to arm64 machine code. */
pub def struct JobA64(fi: int, prog: int, h: Helpers, macos: bool) :: Job(fi, prog, h, macos) {
    int ovf1 = 0
    int ovf2 = 0

    /** Puts the value of stack entry `j` into register `r`. */
    fun load(j: int, r: int) {
        var k = vk[j]
        if (k == V_MEM) {
            ld(a, r, BP, slot(j))
        } else if (k == V_CONST) {
            movri(a, r, vv[j])
        } else if (k == V_LOCAL) {
            ld(a, r, BP, 8 * vv[j])
        } else if (r != ACC) {
            movr(a, r, ACC)
        }
    }

    fun flush(j: int): void {
        var k = vk[j]
        if (k == V_CONST) {
            if (vv[j] == 0) {
                st(a, ZR, BP, slot(j))
            } else {
                movri(a, S0, vv[j])
                st(a, S0, BP, slot(j))
            }
        } else if (k == V_LOCAL) {
            ld(a, S0, BP, 8 * vv[j])
            st(a, S0, BP, slot(j))
        } else if (k == V_ACC) {
            st(a, ACC, BP, slot(j))
        }
        vk[j] = V_MEM
    }

    /** Loads stack entries `js` into registers `regs`, after writing any other value in the accumulator to its slot. */
    fun take(js: [int], regs: [int]) {
        var held = -1
        for k in 0..len(js) {
            if (vk[js[k]] == V_ACC) {
                held = k
            }
        }
        if (held < 0) {
            spillAcc()
        } else if (regs[held] != ACC) {
            movr(a, regs[held], ACC)
        }
        for k in 0..len(js) {
            if (k != held) {
                load(js[k], regs[k])
            }
        }
    }

    /** A binary integer instruction `op` on the two values on top, leaving the result in the accumulator; `imm` is the opcode of its immediate form, or 0. */
    fun binary(op: int, imm: int, swaps: bool) {
        var d = len(vk)
        var l = d - 2
        var r = d - 1
        if (vk[r] == V_ACC) {
            if (swaps) {
                l = d - 1
                r = d - 2
            } else {
                movr(a, T1, ACC)
                load(l, ACC)
                rrr(a, op, ACC, ACC, T1)
                drop(2)
                push(V_ACC, 0)
                return
            }
        }
        if (vk[l] != V_ACC) {
            spillAcc()
            load(l, ACC)
        }
        if (imm != 0 && vk[r] == V_CONST && vv[r] >= 0 && vv[r] < 4096) {
            ins(a, imm | (vv[r] << 10) | (ACC << 5) | ACC)
        } else {
            load(r, T1)
            rrr(a, op, ACC, ACC, T1)
        }
        drop(2)
        push(V_ACC, 0)
    }

    /** Stops with an integer overflow at `loc` unless condition `fine` holds. */
    fun overflowCheck(loc: int, fine: int) {
        var at = bcond(a, fine)
        movri(a, 0, loc)
        callAbs(a, h.errOverflow)
        patch(a, at, a.pos())
    }

    /** Runs the instruction at `pc` with `burn_bvm_slow`, with `d` values on the stack. */
    fun slow(pc: int, d: int) {
        addImm(a, 2, BP, slot(d))
        st(a, 2, VMR, VM_SP)
        movr(a, 0, VMR)
        movri(a, 1, pc)
        callAbs(a, h.slow)
    }

    /** The slow path of an instruction whose operands are in `regs` (from the deepest): writes them to their slots, runs it with `burn_bvm_slow` and loads its result into the accumulator. */
    fun fallback(pc: int, regs: [int]) {
        var d = len(vk)
        var base = d - len(regs)
        for k in 0..len(regs) {
            st(a, regs[k], BP, slot(base + k))
        }
        slow(pc, d)
        ld(a, ACC, BP, slot(base))
    }

    /** Calls the C function `f` with the value in `x10`, keeping the value in the accumulator unless it is entry `except`. */
    fun callWith(f: int, except: int) {
        var held = inAcc()
        if (held >= 0 && held != except) {
            st(a, ACC, BP, slot(held))
        }
        addImm(a, 2, BP, slot(len(vk)))
        st(a, 2, VMR, VM_SP)
        movr(a, 0, T1)
        callAbs(a, f)
        if (held >= 0 && held != except) {
            ld(a, ACC, BP, slot(held))
        }
    }

    /** Branches taken when the object in `x10` is null or static. */
    fun rcChecks(): [int] {
        var none = cbz(a, T1, false, false)
        ld8(a, S0, T1, 2)
        var fixed = tbz(a, S0, 0, true)
        return [none, fixed]
    }

    /** Branches taken when the object in `x10` was freed or other threads run, so the runtime must change its count. */
    fun rcShared(): [int] {
        ld8(a, S0, T1, 0)
        cmpw(a, S0, KIND_FREED)
        var freed = bcond(a, EQ)
        movri(a, S0, h.mtCell)
        ld(a, S0, S0, 0)
        var shared = cbz(a, S0, true, false)
        return [freed, shared]
    }

    /** `retain` of the value on top, inline unless the runtime has to do it. */
    fun retain() {
        var j = len(vk) - 1
        if (vk[j] == V_CONST && vv[j] == 0) {
            return
        }
        load(j, T1)
        var skips = rcChecks()
        var slows = rcShared()
        ld32(a, S0, T1, 12)
        ins(a, 0x11000000 | (1 << 10) | (S0 << 5) | S0)
        st32(a, S0, T1, 12)
        var done = bra(a)
        patch(a, slows[0], a.pos())
        patch(a, slows[1], a.pos())
        callWith(h.retain, -1)
        patch(a, done, a.pos())
        patch(a, skips[0], a.pos())
        patch(a, skips[1], a.pos())
    }

    /** `release` of the value on top, inline unless the object dies or the runtime has to do it; leaves 0 on top. */
    fun release() {
        var j = len(vk) - 1
        if (vk[j] == V_CONST && vv[j] == 0) {
            return
        }
        load(j, T1)
        var skips = rcChecks()
        var slows = rcShared()
        ld32(a, S0, T1, 12)
        ins(a, 0x71000000 | (1 << 10) | (S0 << 5) | S0)
        st32(a, S0, T1, 12)
        var zero = bcond(a, EQ)
        ld8(a, S0, T1, 2)
        var untracked = tbz(a, S0, 2, false)
        callWith(h.possibleRoot, j)
        var done1 = bra(a)
        patch(a, zero, a.pos())
        callWith(h.releaseZero, j)
        var done2 = bra(a)
        patch(a, slows[0], a.pos())
        patch(a, slows[1], a.pos())
        callWith(h.release, j)
        patch(a, done1, a.pos())
        patch(a, done2, a.pos())
        patch(a, untracked, a.pos())
        patch(a, skips[0], a.pos())
        patch(a, skips[1], a.pos())
        vk[j] = V_CONST
        vv[j] = 0
    }

    /** Calls the function in `x12` (or `fi`, when it is not 0) with its arguments ending at slot `end`; the result is in the accumulator. */
    fun call(fi: int, end: int) {
        addImm(a, SPR, BP, slot(end))
        if (fi != 0) {
            movri(a, T3, fi)
        }
        ld(a, S0, T3, F_JIT)
        var interp = cbz(a, S0, false, false)
        blr(a, S0)
        var done = bra(a)
        patch(a, interp, a.pos())
        movr(a, 0, VMR)
        movr(a, 1, T3)
        movr(a, 2, SPR)
        callAbs(a, h.call)
        patch(a, done, a.pos())
        movr(a, ACC, 0)
    }

    /** The fast path of `getfield` on the record on top, falling back to `pc`. */
    fun getField(i: int, pc: int) {
        take([len(vk) - 1], [ACC])
        var s1 = cbz(a, ACC, false, false)
        ld8(a, S0, ACC, 0)
        cmpw(a, S0, 3)
        var s2 = bcond(a, NE)
        ld32(a, S0, ACC, 8)
        cmpi(a, S0, 24 + 8 * i)
        var s3 = bcond(a, LO)
        ld(a, ACC, ACC, 16 + 8 * i)
        var done = bra(a)
        patch(a, s1, a.pos())
        patch(a, s2, a.pos())
        patch(a, s3, a.pos())
        fallback(pc, [ACC])
        patch(a, done, a.pos())
        drop(1)
        push(V_ACC, 0)
    }

    /** Branches to the slow path unless the accumulator is an array of plain words and `x10` an index in it. */
    fun arrayChecks(): [int] {
        var s1 = cbz(a, ACC, false, false)
        ld8(a, S0, ACC, 0)
        cmpw(a, S0, 2)
        var s2 = bcond(a, NE)
        ld8(a, S0, ACC, 3)
        var s3 = cbz(a, S0, true, true)
        ld(a, S0, ACC, 16)
        cmpr(a, T1, S0)
        var s4 = bcond(a, HS)
        return [s1, s2, s3, s4]
    }

    /** Compares the accumulator with stack entry value `k`/`v` (at `at` when it is in memory). */
    fun compareWith(k: int, v: int, at: int) {
        if (k == V_CONST) {
            cmpi(a, ACC, v)
        } else if (at >= 0) {
            ld(a, T1, BP, at)
            cmpr(a, ACC, T1)
        } else {
            load(len(vk) - 1, T1)
            cmpr(a, ACC, T1)
        }
    }

    /** Compares the two values on top and branches on the result when instruction `next` is `jz` or `jnz` that no jump reaches; otherwise leaves 0 or 1. */
    unsafe fun compare(c: int, i: int, next: int) {
        var d = len(vk)
        var l = d - 2
        var r = d - 1
        var cc = c
        if (vk[r] == V_ACC) {
            l = d - 1
            r = d - 2
            cc = A64_SWAP[c]
        }
        if (vk[l] != V_ACC) {
            spillAcc()
            load(l, ACC)
        }
        var n = Memory.load64(next)
        if ((n == OP_JZ || n == OP_JNZ) && i + 1 < count && !targets[i + 1]) {
            var rk = vk[r]
            var rv = vv[r]
            var at = place(r)
            drop(2)
            flushAll()
            compareWith(rk, rv, at)
            var jc = A64_CC[cc]
            if (n == OP_JZ) {
                jc = jc ^ 1
            }
            jumpTo(bcond(a, jc), target(Memory.load64(next + 8)), len(vk))
            skip = 1
            return
        }
        if (vk[r] == V_CONST) {
            cmpi(a, ACC, vv[r])
        } else {
            load(r, T1)
            cmpr(a, ACC, T1)
        }
        cset(a, ACC, A64_CC[cc])
        drop(2)
        push(V_ACC, 0)
    }

    fun op(pc: int, i: int): int {
        unsafe {
            return gen(pc, i)
        }
    }

    /** Compiles instruction record `pc` (index `i`), like `op`. */
    unsafe fun gen(pc: int, i: int): int {
        var k = Memory.load64(pc)
        var x = Memory.load64(pc + 8)
        var y = Memory.load64(pc + 16)
        var z = Memory.load64(pc + 24)
        var d = len(vk)
        if (k == OP_LOAD) {
            push(V_LOCAL, x)
            return d + 1
        }
        if (k == OP_CONST) {
            push(V_CONST, x)
            return d + 1
        }
        if (k == OP_LOAD2) {
            push(V_LOCAL, x)
            push(V_LOCAL, y)
            return d + 2
        }
        if (k == OP_LOADK) {
            push(V_LOCAL, x)
            push(V_CONST, y)
            return d + 2
        }
        if (k == OP_STORE || k == OP_TEE) {
            var j = d - 1
            if (vk[j] == V_LOCAL && vv[j] == x) {
                if (k == OP_STORE) {
                    drop(1)
                }
                return len(vk)
            }
            flushLocal(x, j)
            if (vk[j] == V_CONST && vv[j] == 0) {
                st(a, ZR, BP, 8 * x)
            } else if (vk[j] == V_ACC) {
                st(a, ACC, BP, 8 * x)
            } else {
                load(j, T1)
                st(a, T1, BP, 8 * x)
                if (vk[j] != V_CONST) {
                    vk[j] = V_LOCAL
                    vv[j] = x
                }
            }
            if (k == OP_STORE) {
                drop(1)
            }
            return len(vk)
        }
        if (k == OP_JZ || k == OP_JNZ) {
            var j = d - 1
            var at = place(j)
            if (at < 0) {
                take([j], [ACC])
            }
            drop(1)
            flushAll()
            var r = ACC
            if (at >= 0) {
                ld(a, T1, BP, at)
                r = T1
            }
            jumpTo(cbz(a, r, k == OP_JNZ, false), target(x), d - 1)
            return d - 1
        }
        if (k == OP_JZK || k == OP_JNZK) {
            flushAll()
            ld(a, T1, BP, slot(d - 1))
            jumpTo(cbz(a, T1, k == OP_JNZK, false), target(x), d)
            return d
        }
        if (k == OP_JMP) {
            flushAll()
            jumpTo(bra(a), target(x), d)
            return -1
        }
        if (k >= OP_JLL && k < OP_JLC) {
            flushAll()
            ld(a, T1, BP, 8 * x)
            ld(a, T2, BP, 8 * y)
            cmpr(a, T1, T2)
            jumpTo(bcond(a, A64_CC[k - OP_JLL] ^ 1), target(z), d)
            return d
        }
        if (k >= OP_JLC && k < OP_ICMP) {
            flushAll()
            ld(a, T1, BP, 8 * x)
            cmpi(a, T1, y)
            jumpTo(bcond(a, A64_CC[k - OP_JLC] ^ 1), target(z), d)
            return d
        }
        if (k >= OP_ICMP && k < OP_IADD) {
            compare(k - OP_ICMP, i, pc + OP_SIZE)
            return len(vk)
        }
        if (k == OP_IADD) {
            binary(ADD, 0x91000000, true)
            return d - 1
        }
        if (k == OP_IADDOV) {
            binary(ADDS, 0xB1000000, true)
            overflowCheck(x, VC)
            return d - 1
        }
        if (k == OP_ISUB) {
            binary(SUB, 0xD1000000, false)
            return d - 1
        }
        if (k == OP_ISUBOV) {
            binary(SUBS, 0xF1000000, false)
            overflowCheck(x, VC)
            return d - 1
        }
        if (k == OP_AND || k == OP_OR || k == OP_XOR) {
            var op = AND
            if (k == OP_OR) {
                op = ORR
            } else if (k == OP_XOR) {
                op = EOR
            }
            binary(op, 0, true)
            return d - 1
        }
        if (k == OP_IMUL) {
            binary(MUL, 0, true)
            return d - 1
        }
        if (k == OP_IMULOV) {
            take([d - 2, d - 1], [ACC, T1])
            rrr(a, SMULH, T2, ACC, T1)
            rrr(a, MUL, ACC, ACC, T1)
            ins(a, 0xEB80001F | (ACC << 16) | (63 << 10) | (T2 << 5))
            drop(2)
            push(V_ACC, 0)
            overflowCheck(x, EQ)
            return d - 1
        }
        if (k == OP_IDIV || k == OP_IREM) {
            take([d - 2, d - 1], [ACC, T1])
            var s1 = cbz(a, T1, false, false)
            cmpi(a, T1, -1)
            var s2 = bcond(a, EQ)
            rrr(a, SDIV, T2, ACC, T1)
            if (k == OP_IDIV) {
                movr(a, ACC, T2)
            } else {
                ins(a, 0x9B008000 | (T1 << 16) | (ACC << 10) | (T2 << 5) | ACC)
            }
            var done = bra(a)
            patch(a, s1, a.pos())
            patch(a, s2, a.pos())
            fallback(pc, [ACC, T1])
            patch(a, done, a.pos())
            drop(2)
            push(V_ACC, 0)
            return d - 1
        }
        if (k == OP_INC || k == OP_INCOV) {
            flushLocal(x, -1)
            ld(a, T2, BP, 8 * x)
            var flags = 0
            if (k == OP_INCOV) {
                flags = 0x20000000
            }
            if (y >= 0 && y < 4096) {
                ins(a, (0x91000000 | flags) | (y << 10) | (T2 << 5) | T2)
            } else if (y < 0 && y > -4096) {
                ins(a, (0xD1000000 | flags) | ((-y) << 10) | (T2 << 5) | T2)
            } else {
                movri(a, T3, y)
                rrr(a, ADD | flags, T2, T2, T3)
            }
            st(a, T2, BP, 8 * x)
            if (k == OP_INCOV) {
                overflowCheck(z, VC)
            }
            return d
        }
        if (k == OP_INEG) {
            take([d - 1], [ACC])
            rrr(a, SUB, ACC, ZR, ACC)
            drop(1)
            push(V_ACC, 0)
            return d
        }
        if (k == OP_SHL || k == OP_SHR || k == OP_USHR) {
            var op = LSLV
            if (k == OP_SHR) {
                op = ASRV
            } else if (k == OP_USHR) {
                op = LSRV
            }
            take([d - 2, d - 1], [ACC, T1])
            rrr(a, op, ACC, ACC, T1)
            drop(2)
            push(V_ACC, 0)
            return d - 1
        }
        if (k == OP_NOT) {
            take([d - 1], [ACC])
            cmpi(a, ACC, 0)
            cset(a, ACC, EQ)
            drop(1)
            push(V_ACC, 0)
            return d
        }
        if (k == OP_POP) {
            drop(1)
            return d - 1
        }
        if (k == OP_DUP) {
            var j = d - 1
            if (vk[j] == V_ACC) {
                flush(j)
                push(V_ACC, 0)
            } else if (vk[j] == V_MEM) {
                spillAcc()
                ld(a, ACC, BP, slot(j))
                push(V_ACC, 0)
            } else {
                push(vk[j], vv[j])
            }
            return d + 1
        }
        if (k == OP_SWAP) {
            flush(d - 1)
            flush(d - 2)
            ld(a, T1, BP, slot(d - 1))
            ld(a, T2, BP, slot(d - 2))
            st(a, T2, BP, slot(d - 1))
            st(a, T1, BP, slot(d - 2))
            return d
        }
        if (k == OP_GLOAD) {
            spillAcc()
            movri(a, S0, Memory.load64(prog + P_GLOBALS))
            ld(a, ACC, S0, 8 * x)
            push(V_ACC, 0)
            return d + 1
        }
        if (k == OP_GSTORE || k == OP_GTEE) {
            take([d - 1], [ACC])
            movri(a, S0, Memory.load64(prog + P_GLOBALS))
            st(a, ACC, S0, 8 * x)
            drop(1)
            if (k == OP_GSTORE) {
                return d - 1
            }
            push(V_ACC, 0)
            return d
        }
        if (k == OP_RET) {
            load(d - 1, ACC)
            toEnd.push(bra(a))
            return -1
        }
        if (k == OP_RETV) {
            movri(a, ACC, 0)
            toEnd.push(bra(a))
            return -1
        }
        if (k == OP_CALL) {
            var params = Memory.load64(x + F_PARAMS)
            flushTop(params)
            call(x, d)
            drop(params)
            push(V_ACC, 0)
            return d - params + 1
        }
        if (k == OP_CALLIND || k == OP_DISPATCH) {
            var n = x + 1
            if (k == OP_DISPATCH) {
                n = y
            }
            flushTop(n)
            addImm(a, 2, BP, slot(d))
            st(a, 2, VMR, VM_SP)
            movr(a, 0, VMR)
            movri(a, 1, pc)
            callAbs(a, h.callee)
            movr(a, T3, 0)
            if (k == OP_CALLIND) {
                call(0, d - 1)
            } else {
                call(0, d)
            }
            drop(n)
            push(V_ACC, 0)
            return d - n + 1
        }
        if (k == OP_RT) {
            if (y > 6) {
                ok = false
                return -1
            }
            var held = inAcc()
            if (held >= 0 && held < d - y) {
                flush(held)
            }
            addImm(a, SPR, BP, slot(d))
            st(a, SPR, VMR, VM_SP)
            for j in 0..y {
                load(d - y + j, j)
            }
            callAbs(a, x)
            movr(a, ACC, 0)
            drop(y)
            push(V_ACC, 0)
            return d - y + 1
        }
        if (k == OP_RETAIN) {
            retain()
            return d
        }
        if (k == OP_RELEASE) {
            release()
            return d
        }
        if (k == OP_GETFIELD) {
            getField(x, pc)
            return d
        }
        if (k == OP_LOADFIELD) {
            push(V_LOCAL, x)
            getField(y, pc + OP_SIZE)
            return d + 1
        }
        if (k == OP_INDEX) {
            take([d - 2, d - 1], [ACC, T1])
            var s = arrayChecks()
            ld(a, S0, ACC, 32)
            ldIdx(a, ACC, S0, T1)
            var done = bra(a)
            for at in s {
                patch(a, at, a.pos())
            }
            fallback(pc, [ACC, T1])
            patch(a, done, a.pos())
            drop(2)
            push(V_ACC, 0)
            return d - 1
        }
        if (k == OP_SETINDEX) {
            take([d - 3, d - 2, d - 1], [ACC, T1, T2])
            var s = arrayChecks()
            ld(a, S0, ACC, 32)
            stIdx(a, T2, S0, T1)
            movr(a, ACC, T2)
            var done = bra(a)
            for at in s {
                patch(a, at, a.pos())
            }
            fallback(pc, [ACC, T1, T2])
            patch(a, done, a.pos())
            drop(3)
            push(V_ACC, 0)
            return d - 2
        }
        if (k == OP_LEN) {
            take([d - 1], [ACC])
            var s1 = cbz(a, ACC, false, false)
            ld8(a, S0, ACC, 0)
            cmpw(a, S0, 2)
            var s2 = bcond(a, NE)
            ld(a, ACC, ACC, 16)
            var done = bra(a)
            patch(a, s1, a.pos())
            patch(a, s2, a.pos())
            fallback(pc, [ACC])
            patch(a, done, a.pos())
            drop(1)
            push(V_ACC, 0)
            return d
        }
        flushAll()
        slow(pc, d)
        var after = slowDepth(k, y, d)
        memOnly(after)
        return after
    }

    fun begin(params: int, frame: int): int {
        frameStart(a, 32)
        st(a, BP, ZR, 16)
        movr(a, BP, 1)
        ins(a, 0xD61F0000 | (3 << 5))
        var entry = a.pos()
        frameStart(a, 32)
        st(a, BP, ZR, 16)
        ld(a, S0, VMR, VM_RSPLIMIT)
        addImm(a, S1, ZR, 0)
        cmpr(a, S1, S0)
        ovf1 = bcond(a, LO)
        addImm(a, BP, SPR, -8 * params)
        addImm(a, S0, BP, 8 * frame)
        ld(a, S1, VMR, VM_STACK_END)
        cmpr(a, S0, S1)
        ovf2 = bcond(a, HI)
        for k in params..locals {
            st(a, ZR, BP, 8 * k)
        }
        return entry
    }

    fun finish(): bool {
        var end = a.pos()
        for at in toEnd {
            patch(a, at, end)
        }
        movr(a, 0, ACC)
        ld(a, BP, ZR, 16)
        frameEnd(a, 32)
        patch(a, ovf1, a.pos())
        patch(a, ovf2, a.pos())
        callAbs(a, h.overflow)
        return a.pos() < 1000000
    }

    fun patchJump(at: int, to: int): void {
        patch(a, at, to)
    }
}
