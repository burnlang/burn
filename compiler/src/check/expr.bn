import "../diag/diag.bn"
import "../syntax/ast.bn"
import "body.bn"
import "builtins.bn"
import "calls.bn"
import "check.bn"
import "closures.bn"
import "generics.bn"
import "hir.bn"
import "numeric.bn"
import "stmt.bn"
