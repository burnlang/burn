import "runtime.bn"

/** `min(a, b)` on ints. */
@Runtime("imin")
pub fun intMin(a: int, b: int): int {
    if (b < a) {
        return b
    }
    return a
}

/** `max(a, b)` on ints. */
@Runtime("imax")
pub fun intMax(a: int, b: int): int {
    if (b > a) {
        return b
    }
    return a
}

priv const MAX_INT = 9223372036854775807
priv const MIN_INT = -9223372036854775807 - 1

priv fun productFits(a: int, b: int): bool {
    if (a == 0 || b == 0) {
        return true
    }
    if (a > 0) {
        if (b > 0) {
            return a <= MAX_INT / b
        }
        return b >= MIN_INT / a
    }
    if (b > 0) {
        return a >= MIN_INT / b
    }
    return a >= MAX_INT / b
}

priv fun overflow() {
    __fail("integer overflow", -1)
}

/** `abs(n)` on ints. */
@Runtime("iabs")
pub fun intAbs(n: int): int {
    if (n == MIN_INT) {
        overflow()
    }
    if (n < 0) {
        return -n
    }
    return n
}

/** `pow(base, exponent)` on ints: 0 for a negative exponent. */
@Runtime("ipow")
pub fun intPow(base: int, exponent: int): int {
    if (exponent < 0) {
        return 0
    }
    var b = base
    var e = exponent
    var r = 1
    while (e > 0) {
        if (e & 1 == 1) {
            if (!productFits(r, b)) {
                overflow()
            }
            r = r * b
        }
        e = e >> 1
        if (e > 0) {
            if (!productFits(b, b)) {
                overflow()
            }
            b = b * b
        }
    }
    return r
}
