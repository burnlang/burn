/**
 * Files, directories, the environment, other programs and the local time, like the file and process parts of
 * `api.rs`.
 */
import "fmt.bn"
import "heap.bn"
import "io.bn"
import "meta.bn"
import "sys.bn"
import "text.bn"

@Extern("strerror")
fun cStrerror(code: int): int

@Extern("fopen")
fun cFopen(path: int, mode: int): int

@Extern("fwrite")
fun cFwrite(p: int, size: int, n: int, f: int): int

@Extern("fclose")
fun cFclose(f: int): Int32

@Extern("stat")
fun cStat(path: int, out: int): Int32

@Extern("lstat")
fun cLstat(path: int, out: int): Int32

@Extern("dlsym")
fun cDlsym(handle: int, name: int): int

@Extern("chmod")
fun cChmod(path: int, mode: int): Int32

@Extern("mkdir")
fun cMkdir(path: int, mode: int): Int32

@Extern("rmdir")
fun cRmdir(path: int): Int32

@Extern("unlink")
fun cUnlink(path: int): Int32

@Extern("rename")
fun cRename(from: int, to: int): Int32

@Extern("chdir")
fun cChdir(path: int): Int32

@Extern("getcwd")
fun cGetcwd(buf: int, size: int): int

@Extern("opendir")
fun cOpendir(path: int): int

@Extern("readdir")
fun cReaddir(dir: int): int

@Extern("closedir")
fun cClosedir(dir: int): Int32

@Extern("localtime_r")
fun cLocaltime(t: int, out: int): int

@Extern("pipe2", macos: "pipe")
fun cPipe(fds: int, flags: int): Int32

@Extern("close")
fun cCloseFd(fd: int): Int32

@Extern("poll")
fun cPoll(fds: int, n: int, timeout: int): Int32

