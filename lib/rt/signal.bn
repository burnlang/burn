/**
 * Turns crashes into runtime errors, like `signal.rs`: a segmentation fault near the main stack is reported as a
 * stack overflow, on a separate signal stack so the handler still has room to run.
 */
import "heap.bn"
import "io.bn"
import "sys.bn"
import "win.bn"

@Extern("sigaction", windows: "burn_rt_unavailable")
fun cSigaction(sig: int, act: int, old: int): Int32

@Extern("sigaltstack", windows: "burn_rt_unavailable")
fun cSigaltstack(ss: int, old: int): Int32

var stackBase = 0

unsafe fun writeText(s: string) {
    var t = s
    writeAll(2, __addr(t) + STR_BYTES, ld64(__addr(t) + STR_LEN))
}

/** The signal handler: says what went wrong and ends the program. */
@Extern("burn_rt_on_signal")
unsafe fun onSignal(sig: int, info: int, ctx: int): int {
    var addr = 0
    if (isMacos()) {
        addr = ld64(info + 24)
    } else {
        addr = ld64(info + 16)
    }
    var base = stackBase
    flushForSignal()
    if (base != 0 && addr < base && base - addr < 1073741824) {
        writeText("runtime error: stack overflow (recursion is too deep)\n")
    } else {
        writeText("runtime error: segmentation fault (this is a bug in Burn, please report it)\n")
    }
    cExitNow(1)
    return 0
}

/** Installs the handler for SIGSEGV and SIGBUS; `base` is the top of the main thread's stack. */
pub unsafe fun installSignals(base: int) {
    stackBase = base
    if (isWindows()) {
        winCrashHandler()
        return
    }
    var size = 65536
    var mem = cMalloc(size)
    if (mem == 0) {
        return
    }
    var ss = zalloc(32)
    st64(ss, mem)
    if (isMacos()) {
        st64(ss + 8, size)
        st32(ss + 16, 0)
    } else {
        st32(ss + 8, 0)
        st64(ss + 16, size)
    }
    var r = cSigaltstack(ss, 0)
    cFree(ss)
    if (r != 0) {
        return
    }
    var act = zalloc(160)
    st64(act, __cfun(onSignal))
    var bus = 7
    if (isMacos()) {
        st32(act + 12, 65)
        bus = 10
    } else {
        st32(act + 136, 134217732)
    }
    cSigaction(11, act, 0)
    cSigaction(bus, act, 0)
    cFree(act)
}

var crashCode = 0
var crashStack = 0

/** `winOverflow` and `winCrash` as Windows calls them, through their Win64 entries. */
@Extern("burn_win_overflow", windows: "burn_win_overflow_w64")
fun winOverflowEntry(info: int): int

@Extern("burn_win_crash", windows: "burn_win_crash_w64")
fun winCrashEntry(info: int): int

/** Where a crash continues on Windows, on a stack of its own: prints what happened and stops the program. */
@Extern("burn_win_crashed")
pub unsafe fun winCrashed(): int {
    flushForSignal()
    if (crashCode == 3221225725) {
        writeText("runtime error: stack overflow (recursion is too deep)\n")
    } else {
        writeText("runtime error: segmentation fault (this is a bug in Burn, please report it)\n")
    }
    cExitNow(1)
    return 0
}

/**
 * The filter Windows calls for an exception nothing handles. On a stack overflow there is almost no stack left, so it
 * only points the thread at `winCrashed` on the crash stack and lets it continue there.
 */
@Extern("burn_win_crash")
pub unsafe fun winCrash(info: int): int {
    var code = ld32(ld64(info))
    if (code != 3221225725 && code != 3221225477) {
        return 0
    }
    crashCode = code
    var ctx = ld64(info + 8)
    st64(ctx + 152, crashStack - 8)
    st64(ctx + 248, __cfun(winCrashed))
    return -1
}

/**
 * Stack overflows are caught first, before other handlers that would need stack, such as the one of the thread
 * library; other crashes only when nothing else handles them.
 */
@Extern("burn_win_overflow")
pub unsafe fun winOverflow(info: int): int {
    if (ld32(ld64(info)) != 3221225725) {
        return 0
    }
    return winCrash(info)
}

/** Reports stack overflows and invalid memory accesses like the signal handlers do elsewhere. */
pub unsafe fun winCrashHandler() {
    var size = 262144
    crashStack = (cMalloc(size) + size) & -16
    var room = zalloc(8)
    st64(room, 32768)
    cSetThreadStackGuarantee(room)
    cFree(room)
    cAddVectoredExceptionHandler(1, __cfun(winOverflowEntry))
    cSetUnhandledExceptionFilter(__cfun(winCrashEntry))
}
