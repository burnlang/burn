import "json"

/**
 * The response to an HTTP request.
 *
 * @param statusCode the HTTP status code, for example `200`, or `0` if the request failed
 * @param body the response body, or the error message if `statusCode` is `0`
 * @param headers the response header lines in the form `Name: value`, without the status line
 * @see HTTP.request
 * @since 26.1
 */
pub def type HTTPResponse {
    int statusCode
    string body
    [string] headers
}

/**
 * The header lines sent with every request.
 *
 * Starts with a `BurnLang/26.1` user agent and an `Accept` header that
 * accepts any content type. Change it with {@link HTTP.setHeaders} and
 * {@link HTTP.addHeader}.
 *
 * @since 26.1
 */
priv var defaultHeaders: [string] = ["User-Agent: BurnLang/26.1", "Accept: */*"]

/**
 * A simple HTTP client.
 *
 * `http://` URLs are handled by the runtime itself, `https://` URLs are
 * sent through the `curl` command, which must be installed. Redirects are
 * not followed. Requests never stop the program: a failure is reported as
 * a response with status code `0`.
 *
 * @see HTTPResponse
 * @since 26.1
 * @example
 *     var response = HTTP.get("https://example.com")
 *     if (response.statusCode == 200) {
 *         print(response.body)
 *     }
 */
pub def static struct HTTP {
    /**
     * Sends an HTTP request with the default headers.
     *
     * @param method the HTTP method, for example `"GET"` or `"POST"`
     * @param url the `http://` or `https://` URL to request
     * @param body the request body, or `""` to send none
     * @return the response, with status code `0` and the error message as body if the request failed
     * @see HTTP.get
     * @see HTTP.post
     * @since 26.1
     * @example
     *     var response = HTTP.request("OPTIONS", "https://example.com", "")
     *     print(response.statusCode)
     */
    static fun request(method: string, url: string, body: string): HTTPResponse {
        var raw = __httpRequest(method, url, body, defaultHeaders)
        var headers: [string] = []
        for line in split(raw[2], "\n") {
            if (len(trim(line)) > 0) {
                push(headers, line)
            }
        }
        return HTTPResponse { statusCode: toInt(raw[0]), body: raw[1], headers: headers }
    }

    /**
     * Sends a `GET` request.
     *
     * @param url the URL to request
     * @return the response
     * @see HTTP.request
     * @since 26.1
     * @example
     *     var response = HTTP.get("https://example.com")
     *     print(response.body)
     */
    static fun get(url: string): HTTPResponse {
        return HTTP.request("GET", url, "")
    }

    /**
     * Sends a `POST` request with a body.
     *
     * @param url the URL to request
     * @param body the request body
     * @return the response
     * @see HTTP.request
     * @since 26.1
     * @example
     *     HTTP.addHeader("Content-Type: application/json")
     *     var response = HTTP.post("https://example.com/items", JSON.stringify({"name": "Ada"}))
     */
    static fun post(url: string, body: string): HTTPResponse {
        return HTTP.request("POST", url, body)
    }

    /**
     * Sends a `PUT` request with a body.
     *
     * @param url the URL to request
     * @param body the request body
     * @return the response
     * @see HTTP.request
     * @since 26.1
     */
    static fun put(url: string, body: string): HTTPResponse {
        return HTTP.request("PUT", url, body)
    }

    /**
     * Sends a `PATCH` request with a body.
     *
     * @param url the URL to request
     * @param body the request body
     * @return the response
     * @see HTTP.request
     * @since 26.1
     */
    static fun patch(url: string, body: string): HTTPResponse {
        return HTTP.request("PATCH", url, body)
    }

    /**
     * Sends a `DELETE` request.
     *
     * @param url the URL to request
     * @return the response
     * @see HTTP.request
     * @since 26.1
     */
    static fun delete(url: string): HTTPResponse {
        return HTTP.request("DELETE", url, "")
    }

    /**
     * Replaces the header lines sent with every request.
     *
     * The list is copied, so changing it later does not affect requests.
     *
     * @param headers the header lines in the form `Name: value`
     * @return always `true`
     * @see HTTP.addHeader
     * @since 26.1
     * @example
     *     HTTP.setHeaders(["User-Agent: my-app/1.0", "Accept: application/json"])
     */
    static fun setHeaders(headers: [string]): bool {
        defaultHeaders = copy(headers)
        return true
    }

    /**
     * Adds a header line to the headers sent with every request.
     *
     * @param header the header line in the form `Name: value`
     * @see HTTP.setHeaders
     * @since 26.1
     * @example
     *     HTTP.addHeader("Authorization: Bearer my-token")
     */
    static fun addHeader(header: string) {
        push(defaultHeaders, header)
    }

    /**
     * Returns the value of a response header.
     *
     * The name is matched without regard to case, and the first matching
     * header wins.
     *
     * @param response the response to search
     * @param name the header name, for example `"Content-Type"`
     * @return the trimmed header value, or `""` if the response has no such header
     * @since 26.1
     * @example
     *     var response = HTTP.get("https://example.com")
     *     var contentType = HTTP.getHeader(response, "content-type")
     */
    static fun getHeader(response: HTTPResponse, name: string): string {
        var wanted = lower(name)
        for header in response.headers {
            var i = indexOf(header, ":")
            if (i > 0 && lower(trim(substring(header, 0, i))) == wanted) {
                return trim(substring(header, i + 1))
            }
        }
        return ""
    }

    /**
     * Parses a response body as JSON.
     *
     * Same as {@link JSON.parse}.
     *
     * @param body the JSON text, usually `response.body`
     * @return the parsed value
     * @throws when the body is not valid JSON
     * @see JSON.parse
     * @since 26.1
     * @example
     *     var response = HTTP.get("https://api.example.com/user")
     *     var user = HTTP.parseJSON(response.body)
     */
    static fun parseJSON(body: string): any {
        return JSON.parse(body)
    }
}
