pub def static struct JSON {
    static fun parse(text: string): any {
        return parseJSON(text)
    }

    static fun stringify(value: any): string {
        return toJSON(value)
    }

    static fun get(value: any, key: string): any {
        return value[key]
    }

    static fun at(value: any, index: int): any {
        return value[index]
    }

    static fun isObject(value: any): bool {
        return value is {string: any}
    }

    static fun isArray(value: any): bool {
        return value is [any]
    }
}
