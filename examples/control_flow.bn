var x = 3
var counter = 0

if (x > 5) {
    print("x is greater than 5")
} else if (x == 5) {
    print("x equals 5")
} else {
    print("x is less than 5")
}

while (counter < 3) {
    print("Counter: " + counter)
    counter += 1
}

for (var i = 0; i < 3; i = i + 1) {
    print("Loop iteration: " + i)
}

for i in 0..3 {
    print("Range iteration: " + i)
}

for fruit in ["apple", "banana", "cherry"] {
    print(fruit)
}
