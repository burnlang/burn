def annotation Route {
    string path
    string method = "GET"
}

@Getter
@Setter
def struct Account(owner: string, balance: int, frozen: bool) {}

@Route("/accounts")
def struct AccountHandler {
    int calls = 0
}

@Route("/health", method: "HEAD")
def struct HealthHandler {
    int calls = 0
}

@Deprecated("use describe instead")
fun summary(a: Account): string {
    return a.getOwner()
}

fun describe(a: Account): string {
    var state = "active"
    if (a.isFrozen()) {
        state = "frozen"
    }
    return a.getOwner() + " has " + a.getBalance().toString() + " (" + state + ")"
}

fun routeOf(handler: any): string {
    for a in annotationsOf(handler) {
        if (a is Route) {
            return a.method + " " + a.path
        }
    }
    return "no route"
}

fun main() {
    var acc = new Account("Ada", 100, false)
    acc.setBalance(acc.getBalance() + 50)
    print(describe(acc))
    print(routeOf(new AccountHandler()))
    print(routeOf(new HealthHandler()))
    print(routeOf(acc))
}
