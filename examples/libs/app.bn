import "geometry.bvmc"

@Export
fun hostName(): string {
    return "the example app"
}

@Inject(target: "describe", at: "return")
fun bracket(p: Point, result: string): string {
    return "<" + result + ">"
}

fun main() {
    var a = point(0, 0)
    var b = Point { x: 3, y: 4 }
    print(dist(a, b))
    print(describe(b))
    print(greeting())
}
